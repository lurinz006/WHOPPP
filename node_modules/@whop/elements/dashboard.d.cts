/**
 * Options for `whop.dashboard.create()`: the controller's props plus its `on<Event>` callbacks. In React, these are the `<Dashboard>` component's props.
 * @example
 * ```ts
 * import { loadWhop } from "@whop/elements";
 * 
 * const whop = (await loadWhop())({ locale: "en" });
 * const dashboard = whop.dashboard.create({}); // options: props + on<Event> callbacks
 * ```
 * @see https://docs.whop.com/elements/latest/dashboard/overview
 */
export interface DashboardOptions {
	/**
	 * A scoped token every surface under this handle reads with. Mint one token for the whole handle on your server with `POST /api/v1/access_tokens`, and set a fresh one with `update({ accessToken })` before it expires. Reading payments needs `payment:basic:read`; buyer emails additionally need `member:email:read`, the customer journey `member:basic:read`, the tracking column `shipment:basic:read`, and the product and plan names on a payment `access_pass:basic:read` and `plan:basic:read`. The banners need `payout:account:read`, and starting verification from the action bar `identity:write`. Omitted, the reads carry the viewer's own session, which only answers same-origin.
	 */
	accessToken?: string;
	/**
	 * Account or user ID whose records these surfaces read. Account IDs are prefixed `biz_`; user IDs are prefixed `user_`, can read only the viewer's own outstanding actions, and have no payments.
	 */
	accountId: string;
	/**
	 * Runs when the grouped loading state changes. The value is `true` while any mounted element is still loading.
	 */
	onLoadingChange?: ((loading: boolean) => void);
	/**
	 * Set `false` to turn off Whop's built-in usage analytics for this handle and its elements. The analytics identity is never threaded to its frames. A reserved option, not element data.
	 */
	analytics?: false;
	/**
	 * Visual customization for this group's elements. Overrides the global `WhopElements({ appearance })`. Change it live with `update({ appearance })`.
	 */
	appearance?: import("./_framework.js").Appearance;
	/**
	 * Locale for this group's element UI text. Set it to one of the app's built locales to override the global configuration. Any other value falls back to the default locale.
	 */
	locale?: import("./_framework.js").WhopElementsLocale;
}

/**
 * Consumer props for the "required-actions" element. Set at create (or as `<RequiredActionsElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/dashboard/required-actions
 */
export interface RequiredActionsElementProps {
	/**
	 * Which verification the Verify button starts. `individual` (KYC) is what unlocks payouts and a Whop card. `business` (KYB) covers that and additionally unlocks financing and business cards — use it for a company that will need those.
	 * @default "individual"
	 */
	kind?: "individual" | "business";
}

/**
 * The live handle for a mounted "required-actions" element. Returned by `create("required-actions")`; in React, the component's `ref`.
 * @see https://docs.whop.com/elements/latest/dashboard/required-actions
 */
export interface RequiredActionsElementHandle {
	/**
	 * Re-read the account. Call it when the viewer returns from verifying or depositing so the banners reflect the new state without waiting for the cache to expire.
	 */
	refresh: () => Promise<void>;
	/**
	 * Mounts the element in `target` and starts loading. React components mount themselves.
	 */
	mount: (target: string | HTMLElement) => void;
	/**
	 * Removes the element and releases its frame and subscriptions. You can call it more than once. React removes the element automatically.
	 */
	destroy: () => void;
	/**
	 * Merges new props into the mounted element. In React, change the component props instead.
	 */
	update: (options: Partial<RequiredActionsElementProps>) => void;
}

/**
 * Options for `create("required-actions")`: the consumer props plus event callbacks and lifecycle hooks.
 * @example
 * ```ts
 * const required_actions = dashboard.create("required-actions", {}); // this interface: props + on<Event> callbacks
 * required_actions.mount("#dashboard-required-actions");
 * ```
 * @see https://docs.whop.com/elements/latest/dashboard/required-actions
 */
export interface RequiredActionsElementCreateOptions {
	/**
	 * Which verification the Verify button starts. `individual` (KYC) is what unlocks payouts and a Whop card. `business` (KYB) covers that and additionally unlocks financing and business cards — use it for a company that will need those.
	 * @default "individual"
	 */
	kind?: "individual" | "business";
	/**
	 * The viewer pressed a banner button. Fires for every action, including ones the element also handles itself.
	 */
	onActionRequested?: ((payload: { action: "deposit_funds" | "review_held_payments" | "submit_information_request" | "update_automatic_withdrawal_method" | "reauthorize_payout_methods" | "update_payout_profile" | "card_usage_review" | "verify_identity" | "scale_account_setup" | "sign_formation_documents" | "setup_apple_pay_domains" | "configure_tax_remitter" | "add_vat_registration" | "accept_payout_terms" | "enable_two_factor_authentication"; accountId: string; }) => void);
	/**
	 * The viewer pressed Verify on a `verify_identity` action the element can start. The element opens identity verification itself — this fires alongside, so a host can record the trip.
	 */
	onIdentityVerificationRequested?: ((payload: { accountId: string; }) => void);
	/**
	 * The viewer pressed Add money. The element never opens a deposit flow itself — mount your own, such as the `wallet` controller’s `deposit` element, in answer to this.
	 */
	onDepositRequested?: ((payload: Record<string, never>) => void);
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

