/**
 * Consumer props for the "withdraw" element. Set at create (or as `<WithdrawElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/wallet/withdraw
 */
export interface WithdrawElementProps {
	/**
	 * A scoped token for listing payout methods and creating the payout — needs `payout:withdraw_funds`, `payout:destination:read`, and `payout:create_destination` to add a bank. Omitted, the calls carry the viewer's own session, which only answers same-origin.
	 */
	accessToken?: string;
	/**
	 * Whether the confirmed payout was created successfully.
	 * @default false
	 */
	succeeded?: boolean;
	/**
	 * Saved payout methods with quotes for the current amount.
	 * @default []
	 */
	methods?: WithdrawalMethod[];
	/**
	 * Settled balance available to standard payout methods.
	 * @default 0
	 */
	availableBalance?: number;
	/**
	 * Pending balance that may be available to instant payout methods.
	 * @default 0
	 */
	pendingBalance?: number;
	/**
	 * The payout account's ISO 3166-1 alpha-2 country.
	 * @default "US"
	 */
	payoutCountry?: string;
	/**
	 * Payout methods available to add in the selected country, including required fields.
	 * @default []
	 */
	supportedMethods?: WithdrawalSupportedMethod[];
	/**
	 * Whether supported payout methods are loading for the selected country.
	 * @default false
	 */
	supportedMethodsLoading?: boolean;
	/**
	 * Live standard and instant payout limits.
	 * @default {"standard":{"maxAmount":0},"instant":{"maxAmount":0}}
	 */
	limits?: WithdrawalLimits;
	/**
	 * Whether payout methods and limits are loading.
	 * @default false
	 */
	loading?: boolean;
	/**
	 * Whether the current amount is being repriced.
	 * @default false
	 */
	quoteLoading?: boolean;
	/**
	 * Whether this payout must use an exact provider-backed quote before confirmation.
	 * @default false
	 */
	payoutQuoteRequired?: boolean;
	/**
	 * The exact short-lived payout quote for confirmation. Include recommendedMethod to offer a cheaper method through the connection flow without changing the selected method.
	 * @default null
	 */
	payoutQuote?: WithdrawalPayoutQuote | null;
	/**
	 * Whether an exact payout quote is being created.
	 * @default false
	 */
	payoutQuoteLoading?: boolean;
	/**
	 * The error from the current exact payout quote request, if any.
	 * @default ""
	 */
	payoutQuoteError?: string;
	/**
	 * Whether the last quote request was inconclusive and must be retried with the same request ID.
	 * @default false
	 */
	payoutQuoteRetryRequired?: boolean;
	/**
	 * Whether the last payout result was inconclusive and must be retried exactly.
	 * @default false
	 */
	withdrawalRetryRequired?: boolean;
	/**
	 * The exact unresolved payout request to retry after the element remounts.
	 * @default null
	 */
	unresolvedWithdrawalRequest?: WithdrawalRequest | null;
	/**
	 * Whether a new payout method is being saved.
	 * @default false
	 */
	savingMethod?: boolean;
	/**
	 * Whether the confirmed payout is being created.
	 * @default false
	 */
	submitting?: boolean;
	/**
	 * A host-side error to show inside the current screen.
	 * @default ""
	 */
	error?: string;
	/**
	 * True when the last payout was refused because the bank could not confirm the account holder name. Shows a fix-or-confirm choice; confirming re-emits withdrawalRequested with acknowledgeBankWarning set. Set this back to false when handling each withdrawalRequested — the choice appears on the change to true, so a flag left true hides every later refusal.
	 * @default false
	 */
	bankWarning?: boolean;
	/**
	 * The most recently created method, selected when it appears in methods.
	 * @default ""
	 */
	createdMethodId?: string;
	/**
	 * Set when the payer backed out of Plaid Link or it failed to open. Unlocks manual entry on a rail that otherwise requires linking.
	 * @default false
	 */
	plaidUnavailable?: boolean;
	/**
	 * Whether a bank link is in progress — the Plaid session is open, or the linked method is being saved.
	 * @default false
	 */
	linkingBank?: boolean;
}

