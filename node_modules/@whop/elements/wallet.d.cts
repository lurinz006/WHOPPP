/**
 * Options for `whop.wallet.create()`: the controller's props plus its `on<Event>` callbacks. In React, these are the `<Wallet>` component's props.
 * @example
 * ```ts
 * import { loadWhop } from "@whop/elements";
 * 
 * const whop = (await loadWhop())({ locale: "en" });
 * const wallet = whop.wallet.create({}); // options: props + on<Event> callbacks
 * ```
 * @see https://docs.whop.com/elements/latest/wallet/overview
 */
export interface WalletOptions {
	/**
	 * Three-letter ISO 4217 currency code for amount fields. An unknown code falls back to `usd`.
	 * @default "usd"
	 */
	currency?: string;
	/**
	 * Optional scoped token projected to data-backed wallet children. Without it, reads use the viewer session.
	 */
	accessToken?: string;
	/**
	 * Show a holding's balance page in place of the balances chart and list when a row is clicked. Off by default so a host that routes on `balanceSelected` is not covered by a second screen.
	 * @default false
	 */
	openHoldingOnSelect?: boolean;
	/**
	 * Account or user ID whose money these surfaces read. Account IDs are prefixed `biz_`; user IDs are prefixed `user_` and can read only the viewer's own balance.
	 */
	accountId: string;
	/**
	 * A deposit requires identity verification. Handle this callback to open your settings or verification flow; Wallet does not navigate.
	 */
	onIdentityVerificationRequested?: ((payload: { accountId: string; }) => void);
	/**
	 * Runs when the grouped loading state changes. The value is `true` while any mounted element is still loading.
	 */
	onLoadingChange?: ((loading: boolean) => void);
	/**
	 * Set `false` to turn off Whop's built-in usage analytics for this handle and its elements. The analytics identity is never threaded to its frames. A reserved option, not element data.
	 */
	analytics?: false;
	/**
	 * Visual customization for this group's elements. Overrides the global `WhopElements({ appearance })`. Change it live with `update({ appearance })`.
	 */
	appearance?: import("./_framework.js").Appearance;
	/**
	 * Locale for this group's element UI text. Set it to one of the app's built locales to override the global configuration. Any other value falls back to the default locale.
	 */
	locale?: import("./_framework.js").WhopElementsLocale;
}

