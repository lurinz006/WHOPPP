	onSendCompleted?: ((payload: { recipient: SendRecipient | Omit<SendRecipient, "kind"> & { kind: "bill_pay"; after?: string | undefined; methodName: string; destinationCurrency: string; }; amount: number; currency: string; }) => void);
	/**
	 * A claim link was created. Refresh anything on your side reading the account's balance.
	 */
	onLinkCreated?: ((payload: { claimUrl: string; amount: number; redeemableCount: number; }) => void);
