	 */
	refresh: () => Promise<void>;
	/**
	 * Mounts the element in `target` and starts loading. React components mount themselves.
	 */
	mount: (target: string | HTMLElement) => void;
	/**
	 * Removes the element and releases its frame and subscriptions. You can call it more than once. React removes the element automatically.
	 */
	destroy: () => void;
	/**
	 * Merges new props into the mounted element. In React, change the component props instead.
	 */
	update: (options: Partial<CardTransactionsElementProps>) => void;
}

/**
 * Options for the "cards" sub handle's `create("cardTransactions")`: the consumer props plus event callbacks and lifecycle hooks.
 * @see https://docs.whop.com/elements/latest/wallet/overview
 */
export interface CardTransactionsElementCreateOptions {
	/**
	 * A scoped token for the reads. Rows and card labels need `payout:account:read`; cardholder names also need `company:authorized_user:read`. Omitted, calls carry the viewer's own session, which only answers same-origin.
	 */
	accessToken?: string;
	/**
	 * Off, the table performs no reads and renders empty.
	 * @default true
	 */
	enabled?: boolean;
	/**
	 * Restrict the table to these cards. Empty shows every card on the account.
	 * @default []
	 */
	cardIds?: string[];
	/**
	 * Restrict the table to these cardholders. Empty shows every cardholder on the account.
	 * @default []
	 */
	cardholderIds?: string[];
	/**
	 * Restrict the table to these statuses — `completed`, `pending`, `declined` or `reversed`. Anything else is ignored. Empty shows every status.
	 * @default []
	 */
	statuses?: string[];
	/**
	 * Show the cardholder column and its filter. Off for an account whose cards all belong to one person.
	 * @default true
	 */
	showCardholders?: boolean;
	/**
	 * How many transactions to read per page.
	 * @default 50
	 */
	pageSize?: number;
	/**
	 * A row was pressed. Open your own detail surface in answer to this — the element never navigates.
	 */
	onTransactionSelected?: ((payload: { transactionId: string; }) => void);
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

/**
 * The "cards" sub-handle, minted by `handle.create("cards", …)`. Mounts the sub-controller's elements and carries its actions.
 * @see https://docs.whop.com/elements/latest/wallet/overview
 */
export interface CardsSubHandle {
	/**
	 * Lists the account's active issued cards, most recently issued first. Needs an `accessToken`. The title and rows are click targets that emit events instead of navigating — a host wires up its own routing and card-detail UI.
	 */
	create(name: "cards", options?: CardsElementCreateOptions): CardsElementHandle;
	/**
	 * A sortable table of every issued card on an account, including cardholder, last month's spend, limit, and creation date. Rows and the create button emit events so the host owns card details and issuance flows.
	 */
	create(name: "cardsTable", options?: CardsTableElementCreateOptions): CardsTableElementHandle;
	/**
	 * A business account's card spend over time, using the same interactive bar chart as Whop's cards dashboard. The period picker changes the mounted chart and emits an event so the host can persist the selection.
	 */
	create(name: "cardsChart", options?: CardsChartElementCreateOptions): CardsChartElementHandle;
	/**
	 * Renders one issued Whop Card. The element prefetches authorized secrets immediately after it mounts with a card ID, but keeps them masked until the viewer clicks it or selects `View details`. The API remains the permission authority. Includes lock and unlock controls by default.
	 */
	create(name: "whopCard", options?: WhopCardElementCreateOptions): WhopCardElementHandle;
	/**
	 * Every card transaction on an account, as the sortable table the dashboard shows: date, merchant, amount, cashback, status, card and cardholder, with filters for status, card and cardholder. A host can seed any of those three so the table opens on a narrowed view the reader can still widen. Card and cardholder narrow the read itself; search and status narrow the rows already loaded, so the count and total describe the current view rather than the account's lifetime. Selecting a row reports it — the element never opens a drawer of its own.
	 */
	create(name: "cardTransactions", options?: CardTransactionsElementCreateOptions): CardTransactionsElementHandle;
	/**
	 * Merges new props and callbacks into the sub-controller.
	 */
	update(options: Partial<CardsSubOptions>): void;
	/**
	 * Destroys the sub-controller and its elements, then frees its exclusive slot. A later `create("cards")` starts fresh.
	 */
	destroy(): void;
}

/**
 * The Wallet handle, returned by `whop.wallet.create()` (React: `useWallet()`). Mounts the elements and carries the controller's actions.
 * @see https://docs.whop.com/elements/latest/wallet/overview
 */
export interface WalletHandle {
	/**
	 * The account action row from Whop's balance dashboard. Deposit, Send, Withdraw, and Convert open the Wallet controller's built-in overlays. Accept opens Whop's checkout-link creator for a business account or company creation for a personal account. Each button also emits its requested event so the embedding page can observe the action.
	 */
	create(name: "actions", options?: ActionsElementCreateOptions): ActionsElementHandle;
	/**
	 * An account's ledger activity: every movement of money in or out, newest first. The list pages as the viewer scrolls, and rows report which one was tapped instead of navigating, so you can open your own detail screen.
	 */
	create(name: "activity", options?: ActivityElementCreateOptions): ActivityElementHandle;
	/**
	 * A standalone detail drawer for one movement. Point it at a prefetched financial-activity row, a ledger activity ID, or a card transaction ID — a prefetched row takes precedence, otherwise the element retrieves the record itself. A card transaction opens the card receipt: merchant, amount, status, the card it was charged to, its cardholder on a company account, the settlement date, category, currency conversion and cashback.
	 */
	createOverlay(name: "activityDetail", options?: ActivityDetailElementCreateOptions): ActivityDetailElementOverlayHandle;
	/**
	 * Funds a Whop account. Renders an amount field and the account's live funding rails — crypto (a per-network deposit address with its QR) and bank transfer (the wire fields for each settlement currency). A business account's rails resolve with no credentials, so they work on any page; a personal (`user_`) account only reveals its rails to itself, so pass `accessToken` for it — omitted, the viewer's own same-origin session covers it. Cards and platform balance are opt-in: pass `savedCards`, `allowNewCard`, or `showPlatformBalance` and the element collects the amount and the choice, then emits `cardDepositRequested` / `addCardRequested` / `platformBalanceSelected` and waits for you to call `showStep({ step: 'amount' })` when your own screen is done.
	 */
	create(name: "deposit", options?: DepositElementCreateOptions): DepositElementHandle;
	/**
	 * Funds a Whop account. Renders an amount field and the account's live funding rails — crypto (a per-network deposit address with its QR) and bank transfer (the wire fields for each settlement currency). A business account's rails resolve with no credentials, so they work on any page; a personal (`user_`) account only reveals its rails to itself, so pass `accessToken` for it — omitted, the viewer's own same-origin session covers it. Cards and platform balance are opt-in: pass `savedCards`, `allowNewCard`, or `showPlatformBalance` and the element collects the amount and the choice, then emits `cardDepositRequested` / `addCardRequested` / `platformBalanceSelected` and waits for you to call `showStep({ step: 'amount' })` when your own screen is done.
	 */
	createOverlay(name: "deposit", options?: DepositElementCreateOptions): DepositElementOverlayHandle;
	/**
	 * Converts an account's USD balance to Gold or Coinbase Wrapped Bitcoin, and back, through Whop's public swaps API. A cross-origin mount needs an `accessToken` scoped to `company:balance:read` plus `crypto_wallet:swap` or `crypto_wallet:manage`.
	 */
	create(name: "convert", options?: ConvertElementCreateOptions): ConvertElementHandle;
	/**
	 * Converts an account's USD balance to Gold or Coinbase Wrapped Bitcoin, and back, through Whop's public swaps API. A cross-origin mount needs an `accessToken` scoped to `company:balance:read` plus `crypto_wallet:swap` or `crypto_wallet:manage`.
	 */
	createOverlay(name: "convert", options?: ConvertElementCreateOptions): ConvertElementOverlayHandle;
	/**
	 * Collects a payout amount and saved payout method, groups standard and instant delivery choices with live fees and arrival estimates, and collects a new payout method when needed. When the host does not drive the flow, the element lists methods and creates the payout itself — pass `accessToken` (or rely on the viewer's same-origin session). A host that already talks to the payouts API can still supply methods, limits, and loading flags; confirming then emits `withdrawalRequested` for that host to create.
	 */
	create(name: "withdraw", options?: WithdrawElementCreateOptions): WithdrawElementHandle;
	/**
	 * Collects a payout amount and saved payout method, groups standard and instant delivery choices with live fees and arrival estimates, and collects a new payout method when needed. When the host does not drive the flow, the element lists methods and creates the payout itself — pass `accessToken` (or rely on the viewer's same-origin session). A host that already talks to the payouts API can still supply methods, limits, and loading flags; confirming then emits `withdrawalRequested` for that host to create.
	 */
	createOverlay(name: "withdraw", options?: WithdrawElementCreateOptions): WithdrawElementOverlayHandle;
	/**
	 * Sends money from an account to a recipient — a user, another account, or a public claim link anyone can redeem. Direct transfers use the source account's configured fiat or crypto rail. Renders its own recipient search resolved from the account ID with no credentials beyond the account's own token. Needs an `accessToken` scoped to `payout:transfer_funds` for direct transfers and `payout:withdraw_funds` for recipient lists; account recipient search additionally needs `company:authorized_user:read` and `member:basic:read`, and account claim links need `airdrop_link:manage` — a host without one of those scopes should turn off the matching prop rather than leave a row that will 403.
	 */
	create(name: "send", options?: SendElementCreateOptions): SendElementHandle;
	/**
	 * Sends money from an account to a recipient — a user, another account, or a public claim link anyone can redeem. Direct transfers use the source account's configured fiat or crypto rail. Renders its own recipient search resolved from the account ID with no credentials beyond the account's own token. Needs an `accessToken` scoped to `payout:transfer_funds` for direct transfers and `payout:withdraw_funds` for recipient lists; account recipient search additionally needs `company:authorized_user:read` and `member:basic:read`, and account claim links need `airdrop_link:manage` — a host without one of those scopes should turn off the matching prop rather than leave a row that will 403.
	 */
	createOverlay(name: "send", options?: SendElementCreateOptions): SendElementOverlayHandle;
	/**
	 * One card and what has been spent on it: the card itself, what it has spent against its limit, and its latest transactions. Opens as a drawer. The card face, its reveal and its lock come from the `whopCard` element composed inside, so a host gets one surface rather than assembling three. Pressing a transaction, or asking for the full list, reports the request — the drawer never navigates.
	 */
	createOverlay(name: "cardDetails", options?: CardDetailsElementCreateOptions): CardDetailsElementOverlayHandle;
	/**
	 * Three views of an account's money. The balance view shows the total, a chart of how it changed, and a picker for the time range. The list view shows the holdings that make up that total, valued in dollars. The breakdown view splits one currency into available, pending, reserve, and negative amounts without money-movement controls. When `openHoldingOnSelect` is on, a list row replaces this unit's canvas — the chart and the list — with that holding's balance page instead of only reporting the click.
	 */
	create(name: "balances", options?: BalancesSubOptions): BalancesSubHandle;
	/**
	 * Balance history and the financial activity behind it, including CSV exports. Account statements are available in the Whop dashboard.
	 */
	create(name: "reports", options?: ReportsSubOptions): ReportsSubHandle;
	/**
	 * An account's card surfaces, mounted from one place: the compact issued-card list, the full sortable roster, the spend chart, and a single revealable card. Mount the faces the page needs — they share the account and the credential this unit is minted with, so a page showing a chart above a roster wires them once.
	 */
	create(name: "cards", options?: CardsSubOptions): CardsSubHandle;
	/**
	 * Merges new handle options into every mounted element. In React, change the namespace props instead.
	 */
	update(options: Partial<WalletOptions>): void;
	/**
	 * Destroys every element and sub-controller this handle created, removes the controller frame, and releases its subscriptions. You can call it more than once, but a destroyed handle refuses any other call — create a new handle to start over. React removes the group automatically when the provider unmounts.
	 */
	destroy(): void;
}

