	hideTotal?: boolean;
	/**
	 * Hide the chart, leaving the total and the range buttons.
	 * @default false
	 */
	hideChart?: boolean;
	/**
	 * How tall the chart is drawn, in pixels.
	 * @default 210
	 */
	height?: number;
}

