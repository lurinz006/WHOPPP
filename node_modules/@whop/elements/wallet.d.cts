/**
 * Consumer props for the "deposit" element. Set at create (or as `<DepositElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/wallet/deposit
 */
export interface DepositElementProps {
	/**
	 * A scoped token that lets the rails resolution read a personal (`user_`) account — needs `payout:account:read`, plus `payout:account:update` for the bank rail to provision. Mint it on your server with `POST /api/v1/access_tokens`. Omitted, the call carries the viewer's own session, which only answers same-origin; business accounts resolve without any credential.
	 */
	accessToken?: string;
	/**
	 * Prefill the amount and make it read-only — for flows that already know what is owed. An amount at or below zero is ignored, as is one longer than 12 whole digits; the rest is rounded to the currency’s decimal places.
	 * @default ""
	 */
	amount?: string;
	/**
	 * Offer the crypto rail when the account has a deposit address.
	 * @default true
	 */
	showCrypto?: boolean;
	/**
	 * Offer the bank-transfer rail. Shown even before the account has bank details — choosing it then asks the viewer to verify their identity when that is what the account still owes, and reports the rail as not available yet when it is not.
	 * @default true
	 */
	showBank?: boolean;
	/**
	 * Cards you already hold for this payer, rendered as funding rows. Choosing one emits `cardDepositRequested` with the amount — the element never collects a card payment.
	 * @default []
	 */
	savedCards?: DepositSavedCard[];
	/**
	 * Add an "Add card" row that emits `addCardRequested` so you can open your own card-collection flow.
	 * @default false
	 */
	allowNewCard?: boolean;
	/**
	 * Offer a "Platform balance" row that emits `platformBalanceSelected` immediately, with no amount step.
	 * @default false
	 */
	showPlatformBalance?: boolean;
	/**
	 * Processing fees to preview under the amount when a card row is selected. `percentageFee` is in percentage POINTS (`2.9` is 2.9%); `fixedFee` and `radarFee` are major units (`0.3` is $0.30).
	 * @default null
	 */
	cardFee?: DepositCardFee | null;
	/**
	 * Override the account’s deposit fees under the rail picker, keyed by rail (`bank`, `crypto`). Omitted rails use the fees returned by the account. `percentageFee` is in percentage POINTS (`1.5` is 1.5%); `fixedFeeUsd` is USD major units (`2` is $2.00) whatever the deposit currency. Shows the rate before an amount is typed and the charged amount after.
	 * @default {}
	 */
	depositRailFees?: Partial<Record<"bank" | "crypto", DepositRailFee>>;
	/**
	 * Preselect a rail by id (`bank`, `crypto`, `platform_balance`, or a saved card id). Continue stays disabled while that rail is not yet offered, rather than funding through another one.
	 * @default ""
	 */
	preferredMethodId?: string;
	/**
	 * Emit `bankSelected` and stay on the amount screen instead of showing the wire fields — for hosts that run their own step after the account already has a virtual bank account.
	 * @default false
	 */
	deferBankToHost?: boolean;
	/**
	 * Show an "I have deposited my funds" button on the crypto screen that emits `depositConfirmed`, so you can start watching for the transfer.
	 * @default false
	 */
	confirmCryptoDeposit?: boolean;
	/**
	 * Open straight onto a rail instead of the picker. `crypto` and `bank` need no amount; their back button emits `dismissed` because there is no picker behind them.
	 * @default "amount"
	 */
	initialStep?: "amount" | "bank" | "crypto";
}

/**
 * The live handle for a mounted "deposit" element. Returned by `create("deposit")`; in React, the component's `ref`.
 * @see https://docs.whop.com/elements/latest/wallet/deposit
 */
export interface DepositElementHandle {
	/**
	 * Move the element to a screen. `{ step: "amount" }` is how you hand control back after settling a card or platform-balance deposit on your side.
	 */
	showStep: (input: { step: "amount" | "bank" | "crypto"; }) => Promise<void>;
	/**
	 * Re-resolve the account's funding rails. Call it after anything on your side changes what the account can offer — finishing bank onboarding, for instance — so the new rail appears without waiting for the cache to expire.
	 */
	refresh: () => Promise<void>;
	/**
	 * Mounts the element in `target` and starts loading. React components mount themselves.
	 */
	mount: (target: string | HTMLElement) => void;
	/**
	 * Removes the element and releases its frame and subscriptions. You can call it more than once. React removes the element automatically.
	 */
	destroy: () => void;
	/**
	 * Merges new props into the mounted element. In React, change the component props instead.
	 */
	update: (options: Partial<DepositElementProps>) => void;
}

/**
 * Options for `create("deposit")`: the consumer props plus event callbacks and lifecycle hooks.
 * @example
 * ```ts
 * const deposit = wallet.create("deposit", {}); // this interface: props + on<Event> callbacks
 * deposit.mount("#wallet-deposit");
 * ```
 * @see https://docs.whop.com/elements/latest/wallet/deposit
 */
export interface DepositElementCreateOptions {
	/**
	 * A scoped token that lets the rails resolution read a personal (`user_`) account — needs `payout:account:read`, plus `payout:account:update` for the bank rail to provision. Mint it on your server with `POST /api/v1/access_tokens`. Omitted, the call carries the viewer's own session, which only answers same-origin; business accounts resolve without any credential.
	 */
	accessToken?: string;
	/**
	 * Prefill the amount and make it read-only — for flows that already know what is owed. An amount at or below zero is ignored, as is one longer than 12 whole digits; the rest is rounded to the currency’s decimal places.
	 * @default ""
	 */
	amount?: string;
	/**
	 * Offer the crypto rail when the account has a deposit address.
	 * @default true
	 */
	showCrypto?: boolean;
	/**
	 * Offer the bank-transfer rail. Shown even before the account has bank details — choosing it then asks the viewer to verify their identity when that is what the account still owes, and reports the rail as not available yet when it is not.
	 * @default true
	 */
	showBank?: boolean;
	/**
	 * Cards you already hold for this payer, rendered as funding rows. Choosing one emits `cardDepositRequested` with the amount — the element never collects a card payment.
	 * @default []
	 */
	savedCards?: DepositSavedCard[];
	/**
	 * Add an "Add card" row that emits `addCardRequested` so you can open your own card-collection flow.
	 * @default false
	 */
	allowNewCard?: boolean;
	/**
	 * Offer a "Platform balance" row that emits `platformBalanceSelected` immediately, with no amount step.
	 * @default false
	 */
	showPlatformBalance?: boolean;
	/**
	 * Processing fees to preview under the amount when a card row is selected. `percentageFee` is in percentage POINTS (`2.9` is 2.9%); `fixedFee` and `radarFee` are major units (`0.3` is $0.30).
	 * @default null
	 */
	cardFee?: DepositCardFee | null;
	/**
	 * Override the account’s deposit fees under the rail picker, keyed by rail (`bank`, `crypto`). Omitted rails use the fees returned by the account. `percentageFee` is in percentage POINTS (`1.5` is 1.5%); `fixedFeeUsd` is USD major units (`2` is $2.00) whatever the deposit currency. Shows the rate before an amount is typed and the charged amount after.
	 * @default {}
	 */
	depositRailFees?: Partial<Record<"bank" | "crypto", DepositRailFee>>;
	/**
	 * Preselect a rail by id (`bank`, `crypto`, `platform_balance`, or a saved card id). Continue stays disabled while that rail is not yet offered, rather than funding through another one.
	 * @default ""
	 */
	preferredMethodId?: string;
	/**
	 * Emit `bankSelected` and stay on the amount screen instead of showing the wire fields — for hosts that run their own step after the account already has a virtual bank account.
	 * @default false
	 */
	deferBankToHost?: boolean;
	/**
	 * Show an "I have deposited my funds" button on the crypto screen that emits `depositConfirmed`, so you can start watching for the transfer.
	 * @default false
	 */
	confirmCryptoDeposit?: boolean;
	/**
	 * Open straight onto a rail instead of the picker. `crypto` and `bank` need no amount; their back button emits `dismissed` because there is no picker behind them.
	 * @default "amount"
	 */
	initialStep?: "amount" | "bank" | "crypto";
	/**
	 * The payer confirmed an amount and a rail. Fires for every rail, before any instructions render — the analytics/funnel hook.
	 */
	onDepositInitiated?: ((payload: { method: "bank" | "crypto" | "card" | "platform_balance"; amount: number; currency: string; paymentMethodId?: string | undefined; }) => void);
	/**
	 * A saved card was chosen. Collect the payment on your side, then call `showStep({ step: "amount" })` to return the element to the picker.
	 */
	onCardDepositRequested?: ((payload: { amount: number; currency: string; paymentMethodId: string; }) => void);
	/**
	 * The "Add card" row was picked — open your card-collection flow.
	 */
	onAddCardRequested?: ((payload: Record<string, never>) => void);
	/**
	 * The bank rail was chosen while `deferBankToHost` is set — run your step, then show the fields yourself or call `showStep({ step: "bank" })`.
	 */
	onBankSelected?: ((payload: Record<string, never>) => void);
	/**
	 * The viewer chose bank transfer before this account has a virtual bank account. The element stays on the amount screen and never navigates — mount your own verification, such as the `verifications` controller, in answer to this.
	 */
	onIdentityVerificationRequested?: ((payload: { accountId: string; }) => void);
	/**
	 * The platform-balance row was picked. It carries no amount — your own screen collects that.
	 */
	onPlatformBalanceSelected?: ((payload: Record<string, never>) => void);
	/**
	 * The payer said they sent the crypto. `since` is a unix-seconds floor to start matching incoming transfers from (it looks slightly back in time, so a transfer sent moments before the click still matches).
	 */
	onDepositConfirmed?: ((payload: { network: string; token: string; networkLabel: string; since: number; }) => void);
	/**
	 * The visible screen changed.
	 */
	onStepChanged?: ((payload: { step: "amount" | "bank" | "crypto"; }) => void);
	/**
	 * The payer backed out of a rail the element was opened directly onto — close the surface holding it.
	 */
	onDismissed?: ((payload: Record<string, never>) => void);
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

