 * @see https://docs.whop.com/elements/latest/checkout/expressCheckout
 */
export interface ExpressCheckoutElementCreateOptions {
	/**
	 * Which wallets may render. Set `applePay`, `googlePay`, or `payPal` to `'never'` to leave that button out; each key defaults to `'auto'`, a filter over what the buyer’s device and the seller actually offer. The element never shows a wallet the device, the served matrix, or the checkout’s payment method configuration cannot back, and the render order stays best-native-first, with PayPal last. A list of wallet types (`['apple_pay', 'google_pay']`) is still accepted as an allowlist but is deprecated and will be removed in the next major version; an empty list renders nothing (warned in dev builds). Every wallet needs the page’s domain verified as a [payment method domain](/api-reference/beta/payment-method-domains/payment-method-domain) — first-party whop.com pages are pre-approved; on any other site, register and verify the domain or the buttons stay hidden. Offering Google Pay on your own site is subject to the [Google Pay API Terms of Service](https://payments.developers.google.com/terms/sellertos).
	 * 
	 * `wallets` as an array is deprecated and will be removed in the next major version. Pass `{ applePay, googlePay, payPal }` with `"auto"` or `"never"` instead.
	 * @default {}
	 */
	wallets?: { applePay?: "auto" | "never" | undefined; googlePay?: "auto" | "never" | undefined; payPal?: "auto" | "never" | undefined; } | ("apple_pay" | "google_pay" | "paypal_express")[];
	/**
	 * How the buttons stack. `auto` follows the element’s own container — stacked in narrow containers, side by side in wide ones; `horizontal` and `vertical` force one arrangement.
