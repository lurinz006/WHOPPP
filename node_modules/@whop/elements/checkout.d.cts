	layout?: "auto" | "horizontal" | "vertical";
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

/**
 * The Checkout handle, returned by `whop.checkout.create()` (React: `useCheckout()`). Mounts the elements and carries the controller's actions.
 * @see https://docs.whop.com/elements/latest/checkout/overview
 */
export interface CheckoutHandle {
	/**
	 * The full checkout surface — order summary with the live quote, promo code entry, the currency the buyer pays in, everything this checkout has to collect from the buyer, the composed payment methods surface, and the pay flow. What it collects is whatever the seller set up (email, their own questions, a phone number, a shipping address for physical goods, an explicit agreement to their terms), rendered together on one screen in the order they chose — so a seller who starts asking for something new needs no change here. Renders the whole purchase; the checkout controller owns the session and the credential. After a payment that needs an off-site step, this same surface renders the outcome the server reports when the buyer comes back.
	 * Exclusive slot `entry`. Mount exactly one of: checkout | expressCheckout.
	 */
	create(name: "checkout", options?: CheckoutElementCreateOptions): CheckoutElementHandle;
	/**
	 * One-press Apple Pay, Google Pay and PayPal buttons for a checkout — the wallet collects whatever the session still needs (the buyer's email, a shipping address for physical goods, a phone number where the seller collects one in Apple Pay and Google Pay, and in Apple Pay a promo code where the seller offers entry) and one press finishes the purchase. It shares the checkout's entry slot with the full checkout element, so a handle mounts exactly one of the two: this button alone where the purchase is simple enough for a sheet to finish, or the full checkout surface for everything else. Renders only the wallets the buyer's device can actually pay with — and the checkout's own payment method configuration allows — using the served button art, and renders nothing where no wallet is available. PayPal appears where the seller accepts it, opens in its own window, and saves the buyer's PayPal account with the purchase, so a renewal, a free trial and later charges the seller makes work like a saved card. All three wallets require the page's domain to be a verified payment method domain: first-party whop.com pages are pre-approved, and any other site must register its domain through the Payment Method Domains API before any of these buttons renders there. Offering Google Pay on your own site is subject to the Google Pay API Terms of Service. A checkout the sheet cannot honestly finish — a waitlist join, a transfer, a form question only a page can ask — refuses loudly instead of rendering a doomed button.
	 * Exclusive slot `entry`. Mount exactly one of: checkout | expressCheckout.
	 */
	create(name: "expressCheckout", options?: ExpressCheckoutElementCreateOptions): ExpressCheckoutElementHandle;
	/**
	 * Merges new handle options into every mounted element. In React, change the namespace props instead.
	 */
	update(options: Partial<CheckoutOptions>): void;
	/**
	 * Destroys every element and sub-controller this handle created, removes the controller frame, and releases its subscriptions. You can call it more than once, but a destroyed handle refuses any other call — create a new handle to start over. React removes the group automatically when the provider unmounts.
	 */
	destroy(): void;
}

/**
 * Checkout's static actions, callable with nothing mounted: `whop.checkout.<method>()` (React: `useWhop().checkout.<method>()`).
 * @see https://docs.whop.com/elements/latest/checkout/overview
 */
export interface CheckoutStatics {}

/**
 * Declared from the app's `CheckoutItemInput`, referenced by a host-capability surface.
 */
export interface CheckoutItemInput {
	/**
	 * Existing plan ID, prefixed `plan_`.
	 */
	plan: string;
	/**
	 * Number of units to purchase. Defaults to 1; plans can disallow quantities above 1.
	 */
	quantity?: number | undefined;
}

/**
 * Checkout attribution recorded with the session. The element maps these fields to `POST /api/v1/checkout_sessions`; empty values are omitted, and `country` is resolved by the API.
 * Declared from the app's `CheckoutAttributionInput`, referenced by a host-capability surface.
 */
export interface CheckoutAttributionInput {
	utmSource?: string | undefined;
	utmMedium?: string | undefined;
	utmCampaign?: string | undefined;
	utmTerm?: string | undefined;
	utmContent?: string | undefined;
	trackingLinkId?: string | undefined;
	funnelId?: string | undefined;
	source?: string | undefined;
}

/**
 * The buyer paid.
 * Declared from the app's `CheckoutPaymentCompletion`, referenced by a host-capability surface.
 */
export interface CheckoutPaymentCompletion {
	/**
	 * The checkout session, prefixed `chs_`.
	 */
	sessionId: string;
	result: "payment";
	/**
	 * The payment, prefixed `pay_` — the id to record the purchase under.
	 */
	paymentId: string;
}

/**
 * The buyer joined a waitlist; nothing was charged.
 * Declared from the app's `CheckoutWaitlistCompletion`, referenced by a host-capability surface.
 */
export interface CheckoutWaitlistCompletion {
	/**
	 * The checkout session, prefixed `chs_`.
	 */
	sessionId: string;
	result: "waitlist_entry";
	/**
	 * The waitlist entry, prefixed `ent_`.
	 */
	entryId: string;
}

/**
 * A setup-mode checkout saved the buyer's payment method; nothing was charged.
 * Declared from the app's `CheckoutSetupCompletion`, referenced by a host-capability surface.
 */
export interface CheckoutSetupCompletion {
	/**
	 * The checkout session, prefixed `chs_`.
	 */
	sessionId: string;
	result: "setup";
	/**
	 * The saved setup, prefixed `sint_`.
	 */
	setupIntentId: string;
}
