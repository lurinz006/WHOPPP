/**
 * Options for `whop.checkout.create()`: the controller's props plus its `on<Event>` callbacks. In React, these are the `<Checkout>` component's props.
 * @example
 * ```ts
 * import { loadWhop } from "@whop/elements";
 * 
 * const whop = (await loadWhop())({ locale: "en" });
 * const checkout = whop.checkout.create({}); // options: props + on<Event> callbacks
 * ```
 * @see https://docs.whop.com/elements/latest/checkout/overview
 */
export interface CheckoutOptions {
	/**
	 * Existing plan ID, prefixed `plan_`. Shorthand for an `items` array containing this plan and `quantity`. The plan defines the price; nothing about amounts can be asserted client-side. Pass either `plan`, `items`, or a `checkoutConfiguration`. Set at create only: the session is minted from it, and changing it later refuses.
	 */
	plan?: string;
	/**
	 * How many units to purchase. Plans that disallow multiples refuse values above 1. Set at create only: the session is minted with it, and changing it later refuses. @default 1
	 */
	quantity?: number;
	/**
	 * The plans in this checkout and how many units of each to purchase. Every item must belong to the same seller and use compatible billing terms; the API validates the complete cart and prices it as one charge. Pass this instead of `plan`, `quantity`, or `checkoutConfiguration`. Set at create only: the session is minted from this exact cart, and changing it later refuses.
	 */
	items?: CheckoutItemInput[];
	/**
	 * Existing checkout configuration ID, prefixed `ch_`. The element creates the checkout session from it: the configuration names the plan being sold (or, in `setup` mode, no plan — the checkout saves a payment method and charges nothing) and seeds its own affiliate code, metadata, redirect and payment-method presets — an option passed here beside it wins over the configuration’s copy, field by field. Pass `plan` alongside only to set `quantity`; it must be the configuration’s own plan, which can never be swapped out from under its presets. Set at create only.
	 */
	checkoutConfiguration?: string;
	/**
	 * A promo code to apply before the buyer ever sees the price — the discount is on the first quote, and the buyer can still change or remove it. Pass the code a marketing link carried: a code that has expired or was never valid opens the checkout at full price with the reason on the promo row, never a checkout that will not open. Set at create only.
	 */
	promoCode?: string;
	/**
	 * The affiliate this checkout is attributed to. Set at create only.
	 */
	affiliateCode?: string;
	/**
	 * Where this sale came from, for the account's reporting: the campaign parameters of the link the buyer arrived on (`utmSource`, `utmMedium`, `utmCampaign`, `utmTerm`, `utmContent`, a Whop `trackingLinkId`, a `funnelId`, and your own `source`). Everything here is recorded against the order and is never shown to the buyer. Set at create only.
	 */
	attribution?: CheckoutAttributionInput;
	/**
	 * Your own key/value pairs to record against the order and read back on the payment — order IDs, cart IDs, or anything you reconcile against. Up to 40 string pairs. Set at create only.
	 */
	metadata?: Record<string, string>;
	/**
	 * Where the buyer lands after an off-site payment step, whatever its outcome. The tab arrives with `payment` (the `pay_` ID; `setup` with the `sint_` ID for a setup-mode checkout) and `status` (`succeeded`, `failed`, or `canceled`) appended, and your other query parameters intact. Branch on `status` before showing a success page: a declined or abandoned off-site step lands here too. Fulfill from webhooks, not from this visit. Https-only (http for localhost). Set at create only.
	 */
	returnUrl?: string;
	/**
	 * Fires once per mount when the checkout completes and its result stands. `result` says what stands: `payment` (the buyer paid — `paymentId`), `waitlist_entry` (the buyer joined a waitlist — `entryId`) or `setup` (a setup-mode checkout saved the payment method — `setupIntentId`); `sessionId` is the checkout session either way. Fires before any `returnUrl` navigation, so this is where your own analytics or ad pixels record the purchase. Fulfill from webhooks, not from this callback: a checkout restored on a later page load fires it again for the same result.
	 */
	onComplete?: ((payload: CheckoutPaymentCompletion | CheckoutWaitlistCompletion | CheckoutSetupCompletion) => void);
	/**
	 * Runs when the grouped loading state changes. The value is `true` while any mounted element is still loading.
	 */
	onLoadingChange?: ((loading: boolean) => void);
	/**
	 * Set `false` to turn off Whop's built-in usage analytics for this handle and its elements. The analytics identity is never threaded to its frames. A reserved option, not element data.
	 */
	analytics?: false;
	/**
	 * Visual customization for this group's elements. Overrides the global `WhopElements({ appearance })`. Change it live with `update({ appearance })`.
	 */
	appearance?: import("./_framework.js").Appearance;
	/**
	 * Locale for this group's element UI text. Set it to one of the app's built locales to override the global configuration. Any other value falls back to the default locale.
	 */
	locale?: import("./_framework.js").WhopElementsLocale;
}

/**
 * Consumer props for the "checkout" element. Set at create (or as `<CheckoutElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/checkout/checkout
 */
export interface CheckoutElementProps {
	/**
	 * Prefills the buyer email the host page already knows: the authenticated first-party viewer’s, the one a checkout link carried, or the one a merchant page collected before mounting. A session that already holds its buyer’s email wins over it. Empty (default) leaves the field for the buyer.
	 * @default ""
	 */
	buyerEmail?: string;
	/**
	 * Keeps the buyer from editing the prefilled `buyerEmail` — an invoice link names who it was issued to. Only holds while the field still shows that email; a session email that already differs is never locked to it, and without a `buyerEmail` there is nothing to lock.
	 * @default false
	 */
	lockBuyerEmail?: boolean;
	/**
	 * Prefills what the host page already knows about the buyer. The buyer can edit every prefilled field, and a phone number or complete shipping address the session already holds wins over it. `phone` fills the checkout's phone number field when the seller collects one, in E.164 format such as `+14155552671`; when that field exists it also supplies the billing phone for methods that need one, so pass `phone` rather than `billingDetails.phone`. `shippingAddress` fills the shipping address when the checkout collects one (`country` is an ISO 3166-1 alpha-2 code; with a country the form cannot use, only the name is prefilled). `billingDetails` prefills the payment method's billing details like the payment element's `defaultValues.billingDetails`. Use `buyerEmail` for the email.
	 */
	defaultValues?: { phone?: string | undefined; shippingAddress?: { name?: string | undefined; line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country?: string | undefined; } | undefined; billingDetails?: { name?: string | undefined; phone?: string | undefined; address?: { line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country?: string | undefined; } | undefined; } | undefined; };
}

/**
 * The live handle for a mounted "checkout" element. Returned by `create("checkout")`; in React, the component's `ref`.
 * @see https://docs.whop.com/elements/latest/checkout/checkout
 */
export interface CheckoutElementHandle {
	/**
	 * Mounts the element in `target` and starts loading. React components mount themselves.
	 */
	mount: (target: string | HTMLElement) => void;
	/**
	 * Removes the element and releases its frame and subscriptions. You can call it more than once. React removes the element automatically.
	 */
	destroy: () => void;
	/**
	 * Merges new props into the mounted element. In React, change the component props instead.
	 */
	update: (options: Partial<CheckoutElementProps>) => void;
}

/**
 * Options for `create("checkout")`: the consumer props plus event callbacks and lifecycle hooks.
 * @example
 * ```ts
 * const checkout = checkout.create("checkout", {}); // this interface: props + on<Event> callbacks
 * checkout.mount("#checkout-checkout");
 * ```
 * @see https://docs.whop.com/elements/latest/checkout/checkout
 */
export interface CheckoutElementCreateOptions {
	/**
	 * Prefills the buyer email the host page already knows: the authenticated first-party viewer’s, the one a checkout link carried, or the one a merchant page collected before mounting. A session that already holds its buyer’s email wins over it. Empty (default) leaves the field for the buyer.
	 * @default ""
	 */
	buyerEmail?: string;
	/**
	 * Keeps the buyer from editing the prefilled `buyerEmail` — an invoice link names who it was issued to. Only holds while the field still shows that email; a session email that already differs is never locked to it, and without a `buyerEmail` there is nothing to lock.
	 * @default false
	 */
	lockBuyerEmail?: boolean;
	/**
	 * Prefills what the host page already knows about the buyer. The buyer can edit every prefilled field, and a phone number or complete shipping address the session already holds wins over it. `phone` fills the checkout's phone number field when the seller collects one, in E.164 format such as `+14155552671`; when that field exists it also supplies the billing phone for methods that need one, so pass `phone` rather than `billingDetails.phone`. `shippingAddress` fills the shipping address when the checkout collects one (`country` is an ISO 3166-1 alpha-2 code; with a country the form cannot use, only the name is prefilled). `billingDetails` prefills the payment method's billing details like the payment element's `defaultValues.billingDetails`. Use `buyerEmail` for the email.
	 */
	defaultValues?: { phone?: string | undefined; shippingAddress?: { name?: string | undefined; line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country?: string | undefined; } | undefined; billingDetails?: { name?: string | undefined; phone?: string | undefined; address?: { line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country?: string | undefined; } | undefined; } | undefined; };
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

/**
 * Consumer props for the "expressCheckout" element. Set at create (or as `<ExpressCheckoutElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/checkout/expressCheckout
 */
export interface ExpressCheckoutElementProps {
	/**
	 * Which wallets may render. Set `applePay`, `googlePay`, or `payPal` to `'never'` to leave that button out; each key defaults to `'auto'`, a filter over what the buyer’s device and the seller actually offer. The element never shows a wallet the device, the served matrix, or the checkout’s payment method configuration cannot back, and the render order stays best-native-first, with PayPal last. A list of wallet types (`['apple_pay', 'google_pay']`) is still accepted as an allowlist but is deprecated and will be removed in the next major version; an empty list renders nothing (warned in dev builds). Every wallet needs the page’s domain verified as a [payment method domain](/api-reference/beta/payment-method-domains/payment-method-domain) — first-party whop.com pages are pre-approved; on any other site, register and verify the domain or the buttons stay hidden. Offering Google Pay on your own site is subject to the [Google Pay API Terms of Service](https://payments.developers.google.com/terms/sellertos).
	 * 
	 * `wallets` as an array is deprecated and will be removed in the next major version. Pass `{ applePay, googlePay, payPal }` with `"auto"` or `"never"` instead.
	 * @default {}
	 */
	wallets?: { applePay?: "auto" | "never" | undefined; googlePay?: "auto" | "never" | undefined; payPal?: "auto" | "never" | undefined; } | ("apple_pay" | "google_pay" | "paypal_express")[];
	/**
	 * How the buttons stack. `auto` follows the element’s own container — stacked in narrow containers, side by side in wide ones; `horizontal` and `vertical` force one arrangement.
	 * @default "auto"
	 */
	layout?: "auto" | "horizontal" | "vertical";
}

/**
 * The live handle for a mounted "expressCheckout" element. Returned by `create("expressCheckout")`; in React, the component's `ref`.
 * @see https://docs.whop.com/elements/latest/checkout/expressCheckout
