 * @see https://docs.whop.com/elements/latest/ads/overview
 */
export interface TableElementCreateOptions {
	/**
	 * What happens when a viewer asks to edit — from a row menu, a draft row, or Edit ad in the details overlay. On by default: the campaign builder opens over the page, on the campaign and step they asked for, so editing works with nothing wired up. Turn it off to handle campaign editing yourself — nothing opens, and the request comes back on `editRequested`.
	 * @default true
	 */
	useCampaignCreator?: boolean;
	/**
	 * How rows are broken down — by country, platform, placement — or `null` for whole rows.
	 * @default null
	 */
	breakdown?: "age" | "gender" | "age_gender" | "placement" | "publisher_platform" | "device_platform" | "impression_device" | "country" | "region" | "hour" | null;
	/**
	 * The columns on show, by name — standard ones like `impressions` and `roas`, and any pixel events the viewer added. Unset, the table opens on its own defaults. Comes back whole on `columnsChanged`; store the list and pass it here to have the layout stick.
	 * @default null
	 */
	columns?: string[] | null;
	/**
	 * Columns computed from the figures already in the table — a formula that you name and format. The table can edit them, and every change comes back on `customMetricsChanged` as the whole new list; persist it and pass it here to have it stick.
	 * @default []
	 */
	customMetrics?: CustomMetricDefinition[];
	/**
	 * What the All tab is drilled into, as a source path: `null` for the roots, `ext:*` for a platform list, `ext:<platform>:*` for that platform’s campaigns. Comes back on `viewChanged`.
	 * @default null
	 */
	sourcesDrill?: string | null;
	/**
	 * What the Ads tab’s search box is filtered to.
	 * @default ""
	 */
	query?: string;
	/**
	 * Whether paused campaigns are listed.
	 * @default true
	 */
	showPausedCampaigns?: boolean;
	/**
	 * Whether paused ad groups are listed.
	 * @default true
	 */
	showPausedAdGroups?: boolean;
	/**
	 * Whether paused ads are listed.
	 * @default true
	 */
	showPausedAds?: boolean;
	/**
	 * The open tab changed. Mirror it into your own URL if you want it to survive a reload.
	 */
	onTabChanged?: ((payload: { tab: "ads" | "all" | "campaigns" | "ad-groups"; }) => void);
	/**
	 * The viewer narrowed the view — by ticking rows, or by clicking through a campaign to its ad groups. Every surface under the same handle has already followed it.
	 */
	onFilterChanged?: ((payload: { campaignIds: string[]; adGroupIds: string[]; adIds: string[]; }) => void);
	/**
	 * The viewer showed or hid a column. Carries every column now on show, standard and pixel-event alike — store the list and pass it straight back as `columns`, or the layout resets on the next mount.
	 */
	onColumnsChanged?: ((payload: { columns: string[]; }) => void);
	/**
	 * The viewer added, edited, or removed a computed column. Carries the entire list either way — store it as given and pass it back as `customMetrics`, or they are gone on the next mount.
	 */
	onCustomMetricsChanged?: ((payload: { customMetrics: CustomMetricDefinition[]; }) => void);
	/**
	 * The viewer moved one of the table’s own controls — the All tab’s drill, the breakdown, the search box, the paused toggle on any of the three tabs. Carries all of them whichever moved; store them and pass them back as props, or they reset on the next mount.
	 */
	onViewChanged?: ((payload: { sourcesDrill: string | null; breakdown: "age" | "gender" | "age_gender" | "placement" | "publisher_platform" | "device_platform" | "impression_device" | "country" | "region" | "hour" | null; query: string; showPausedCampaigns: boolean; showPausedAdGroups: boolean; showPausedAds: boolean; }) => void);
	/**
	 * What the All tab is now looking at, as source paths ready to hand to a chart: `null` off the All tab (Whop advertising alone), `[]` for every source, otherwise the ticked rows or the drilled-into group. Every surface under the same handle has already followed it.
	 */
	onSourcesChanged?: ((payload: { sources: string[] | null; }) => void);
	/**
	 * The viewer changed which touch gets the credit, from the picker on the All tab. Every surface under the same handle has already re-credited; persist it and pass it back as `attributionModel`, or it reverts to last touch on the next mount.
	 */
	onAttributionModelChanged?: ((payload: { attributionModel: "last_touch" | "first_touch"; }) => void);
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

/**
 * The "reporting" sub-handle, minted by `handle.create("reporting", …)`. Mounts the sub-controller's elements and carries its actions.
 * @see https://docs.whop.com/elements/latest/ads/overview
 */
export interface ReportingSubHandle {
	/**
	 * An account’s performance over a window, with a picker for what to plot — spend, impressions, clicks, or any conversion the account records. Read-only.
	 */
	create(name: "chart", options?: ChartElementCreateOptions): ChartElementHandle;
	/**
	 * An advertising account's campaigns, ad groups, and ads in one table, with the tabs that move between them: pick rows to narrow the level below, search, sort, break the numbers down, choose your columns, and pause, resume, duplicate, or delete straight from a row. The window it reports on and the rows it is filtered to live on the handle, so a chart mounted beside it reports on exactly the same thing.
	 */
	create(name: "table", options?: TableElementCreateOptions): TableElementHandle;
	/**
	 * Merges new props and callbacks into the sub-controller.
	 */
	update(options: Partial<ReportingSubOptions>): void;
	/**
	 * Destroys the sub-controller and its elements, then frees its exclusive slot. A later `create("reporting")` starts fresh.
	 */
	destroy(): void;
}

/**
 * The Ads handle, returned by `whop.ads.create()` (React: `useAds()`). Mounts the elements and carries the controller's actions.
 * @see https://docs.whop.com/elements/latest/ads/overview
 */
export interface AdsHandle {
	/**
	 * Which payment methods ad spend bills against: a primary used first, and an optional backup for when it fails. Both are chosen from the methods already saved on the account, and picking one saves it immediately — there is no separate submit. Adding a card opens a card form over your page and returns to the slot that asked for it. The account's own balance appears alongside its cards wherever the account has one.
	 */
	create(name: "billing-setup", options?: BillingSetupElementCreateOptions): BillingSetupElementHandle;
	/**
	 * The advertising campaign builder: objective and budget, ad groups with their targeting and schedule, and the ads themselves with their creative — the whole flow through to launch. Opens empty to build a new campaign, or on an existing one when you pass `campaignId`. It runs the pixel checker too: a launch is gated on the ad group’s conversion event being live on the destination URL, and the `pixel-setup` wizard opens inside this element to fix an install that is missing. A launch is also gated on the account having signed the Whop Ads agreement: when it has not, the handle opens `ads-agreement` over the builder and the launch carries on once it is signed. Budgets are entered and shown in the account’s `ads_reporting_currency` — the currency its reports already use — and converted to and billed in USD at the current exchange rate. The one token you set on the `ads` handle must carry the pixel scopes alongside the campaign scopes — `ad_campaign:create` and `company:basic:read` — rather than using a separate token per element.
	 */
	createOverlay(name: "campaign-creator", options?: CampaignCreatorElementCreateOptions): CampaignCreatorElementOverlayHandle;
	/**
	 * Signs the Whop Ads Services and Payment Authorization Agreement for an account. Saving the account's ad-spend billing opens the agreement; until an authorized representative signs it, no campaign can launch. The signer types their full legal name and, optionally, their title, accepts the terms, and the typed signature is filed with the agreement. Once it is signed this shows who signed it and when; before billing is set up there is nothing to sign and it says so. `campaign-creator` opens this over the builder by itself when a launch needs a signature, so mount it yourself only to offer signing ahead of time — on a settings or onboarding page, say.
	 */
	create(name: "ads-agreement", options?: AdsAgreementElementCreateOptions): AdsAgreementElementHandle;
	/**
	 * Signs the Whop Ads Services and Payment Authorization Agreement for an account. Saving the account's ad-spend billing opens the agreement; until an authorized representative signs it, no campaign can launch. The signer types their full legal name and, optionally, their title, accepts the terms, and the typed signature is filed with the agreement. Once it is signed this shows who signed it and when; before billing is set up there is nothing to sign and it says so. `campaign-creator` opens this over the builder by itself when a launch needs a signature, so mount it yourself only to offer signing ahead of time — on a settings or onboarding page, say.
	 */
	createOverlay(name: "ads-agreement", options?: AdsAgreementElementCreateOptions): AdsAgreementElementOverlayHandle;
	/**
	 * An advertising account's reporting: what it spent and what came back, over a window, at whatever level you narrow to. Mount `chart`, `table`, or both — they read the same window, the same credit rule, and the same selection, so two surfaces side by side can never disagree about what they are showing. The `ads` handle's `links` configuration wires the table's click and result counts to your own pages — the ones where you mounted the `tracking` namespace's `people` and `events`.
	 */
	create(name: "reporting", options?: ReportingSubOptions): ReportingSubHandle;
	/**
	 * Merges new handle options into every mounted element. In React, change the namespace props instead.
	 */
	update(options: Partial<AdsOptions>): void;
	/**
	 * Destroys every element and sub-controller this handle created, removes the controller frame, and releases its subscriptions. You can call it more than once, but a destroyed handle refuses any other call — create a new handle to start over. React removes the group automatically when the provider unmounts.
	 */
	destroy(): void;
}

/**
 * Ads's static actions, callable with nothing mounted: `whop.ads.<method>()` (React: `useWhop().ads.<method>()`).
 * @see https://docs.whop.com/elements/latest/ads/overview
 */
export interface AdsStatics {}

/**
 * The consumer-facing shape of an element's `links` prop. `people`/`events` are base URLs the canonical query params are appended to; `person` is a template whose `{personId}` and `{identifier}` placeholders are replaced with the row's URL-encoded values.
 * Declared from the app's `CrossLinksConfig`, referenced by a host-capability surface.
 */
export interface CrossLinksConfig {
	people?: string | undefined;
	events?: string | undefined;
	person?: string | undefined;
}

/**
 * What a builder href asks to edit, once it has been read back out of the route.
 * Declared from the app's `AdsEditTarget`, referenced by a host-capability surface.
 */
export interface AdsEditTarget {
	campaignId: string;
	adGroupId?: string | undefined;
	adId?: string | undefined;
}

/**
 * A computed column as anyone outside this module needs it. `id` is deliberately absent — it is a within-render column key (`customMetricColumnVisibility`), never persisted and never meaningful to a caller, so it is minted on the way in rather than carried around.
 * Declared from the app's `CustomMetricDefinition`, referenced by a host-capability surface.
 */
export interface CustomMetricDefinition {
	name: string;
	formula: string;
	format: "number" | "currency" | "percent";
	enabled: boolean;
}
