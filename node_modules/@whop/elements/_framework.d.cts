/** The locales this app's elements are built with (the default locale first) — element UI
 *  text ships in each of these. Any other value falls back to the default locale. Validate
 *  dynamic strings with `WHOP_ELEMENTS_LOCALES.includes(...)` from the package root. */
export type WhopElementsLocale = "en" | "es" | "zh" | "nl" | "pt" | "de" | "hu" | "it" | "fr" | "ja" | "pl" | "tr";

/**
 * A CSS property value, as a string (include units: `"12px"`, not `12`).
 */
export type CSSValue = string;

/**
 * A style declaration object that maps CSS properties to values, like React's `CSSProperties`.
 * Property names can use camel case (`fontWeight`) or kebab case (`font-weight`). The framework
 * normalizes each name and checks it against the list of safe properties before applying it.
 */
export type CSSProps = Record<string, CSSValue>;

/**
 * Style declarations for each `whop-*` class name. Each entry restyles one documented part of an
 * element. See the Styling section on each element page for its class list. The framework checks
 * each declaration, then injects the sanitized result inside the element's frame because page
 * stylesheets cannot reach it.
 *
 * @example
 * ```typescript
 * classes: {
 *   "whop-TipSummary": { fontWeight: "600", borderRadius: "8px" },
 * }
 * ```
 */
export type Classes = Record<string, CSSProps>;

/**
 * CSS custom properties (variables) that can be used to customize element styles.
 * Keys must start with `--` prefix.
 */
export type Variables = Record<`--${string}`, string>;

/**
 * Available accent colors for theming elements.
 *
 * These colors are used for primary UI elements like buttons, links, and highlights.
 */
export type AccentColor =
	| "ruby"
	| "blue"
	| "red"
	| "yellow"
	| "green"
	| "gray"
	| "tomato"
	| "crimson"
	| "pink"
	| "plum"
	| "purple"
	| "violet"
	| "iris"
	| "cyan"
	| "teal"
	| "jade"
	| "grass"
	| "brown"
	| "orange"
	| "indigo"
	| "sky"
	| "mint"
	| "amber"
	| "lime"
	| "lemon"
	| "magenta"
	| "gold"
	| "bronze";

/**
 * Theme configuration for customizing the visual appearance of elements.
 *
 * @example
 * ```typescript
 * const theme: Theme = {
 *   appearance: "dark",
 *   accentColor: "blue",
 *   grayColor: "slate",
 * };
 * ```
 */
export type Theme = {
	/**
	 * The color scheme to use.
	 * - `"light"` - Light mode with dark text on light backgrounds
	 * - `"dark"` - Dark mode with light text on dark backgrounds
	 */
	appearance?: "light" | "dark";
	/**
	 * The primary accent color used for interactive elements.
	 */
	accentColor?: AccentColor;
	/**
	 * The gray color palette to use for neutral elements.
	 * Use `"auto"` to automatically match the accent color.
	 */
	grayColor?: "gray" | "mauve" | "slate" | "sage" | "olive" | "sand" | "auto";
	/**
	 * The color used for error states and destructive actions.
	 */
	dangerColor?: "ruby" | "red" | "tomato";
	/**
	 * The color used for warning states.
	 */
	warningColor?: "yellow" | "amber";
	/**
	 * The color used for success states.
	 */
	successColor?: "green" | "teal" | "jade" | "grass";
	/**
	 * The color used for informational states.
	 */
	infoColor?: "sky" | "blue";
};

/**
 * Configuration for customizing the visual appearance of Whop elements.
 *
 * Use this to match the embedded components to your application's design.
 *
 * @example
 * ```typescript
 * const appearance: Appearance = {
 *   theme: {
 *     appearance: "dark",
 *     accentColor: "blue",
 *   },
 * };
 *
 * const whopElements = WhopElements({ appearance });
 * ```
 */
export type Appearance = {
	/**
	 * CSS custom properties to override default styles.
	 */
	variables?: Variables | null;
	/**
	 * Custom CSS classes to apply to elements.
	 */
	classes?: Classes | null;
	/**
	 * Theme settings for colors and appearance mode.
	 */
	theme?: Theme | null;
};

/**
 * Framework-provided global config — NOT authored. Set on `WhopElements(config)` and
 * delivered by the framework: `theme`/`locale` ride the iframe URL params (so the boot
 * script applies them before first paint — anti-flash), `appearance` rides `init`, and
 * `baseUrl` selects the element origin. Merged with any Root app globals (currently none).
 */
export interface FrameworkGlobals {
	/** Visual customization for every element — `theme` (light/dark + palettes), `variables`
	 *  (CSS custom properties), and `classes` (per-part style declarations). The color scheme is
	 *  applied before an element's first paint, so dark pages never flash light. */
	appearance?: Appearance;
	/** Locale for element UI text — one of the app's built locales; any other value falls back
	 *  to the default locale. @default "en" */
	locale?: WhopElementsLocale;
	/** Which Whop API environment the elements talk to — `"sandbox"` targets the sandbox API
	 *  (test data; no real money moves). Choosing an environment is the only way to change where
	 *  the elements send what a buyer types, and both environments are Whop's own. The sandbox
	 *  environment is not yet generally available. @default "production" */
	environment?: "production" | "sandbox";
	/** Whether elements may show toast notifications on your page — brief status messages
	 *  ("Payment method added", "Payment failed") rendered in the bottom-right corner. Set
	 *  `false` to turn them off entirely. @default true */
	toasts?: boolean;
	/** Skip linking element analytics to the Whop pixel's visitor id on pages that run the
	 *  pixel — a one-time identity link that makes element activity joinable to your
	 *  ad-attribution data in Whop's identity graph. Usage analytics themselves are unaffected
	 *  (turn those off per handle with `analytics: false`). @default false */
	skipPixel?: boolean;
	/** Origin serving the hosted element pages — for testing against a different environment.
	 *  Cannot change after load.
	 *  @internal */
	baseUrl?: string;
}
