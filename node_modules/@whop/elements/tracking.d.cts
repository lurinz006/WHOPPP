/**
 * The Tracking handle, returned by `whop.tracking.create()` (React: `useTracking()`). Mounts the elements and carries the controller's actions.
 * @see https://docs.whop.com/elements/latest/tracking/overview
 */
export interface TrackingHandle {
	/**
	 * Everyone the account has seen — visitors and customers resolved from pixel activity, with their source, spend, and activity counters. Search, filter by source, event, geography, or device, sort any column, and page through. A row click follows `links.person` when the handle configures it, and otherwise comes back to you as `personOpened`.
	 */
	create(name: "people", options?: PeopleElementCreateOptions): PeopleElementHandle;
	/**
	 * Every event the account measured — page views, leads, purchases, and custom pixel events — as a raw, filterable stream. The rows behind any metric: filter by event, source, geography, or device over the handle’s window, or search one person’s identifier to read their whole journey. A person cell follows `links.person` when the handle configures it, and otherwise comes back to you as `personOpened`.
	 */
	create(name: "events", options?: EventsElementCreateOptions): EventsElementHandle;
	/**
	 * Everything the account knows about one person: who they are, where they came from, what they have spent, and every event they have performed, in order. The view a person click leads to: mount it on the page `links.person` points at, or present it over your own page when `people` or `events` raise `personOpened`. `identifier` takes any identifier a person has been seen under, so a `personOpened` payload resolves here unchanged.
	 */
	create(name: "person", options?: PersonElementCreateOptions): PersonElementHandle;
	/**
	 * Everything the account knows about one person: who they are, where they came from, what they have spent, and every event they have performed, in order. The view a person click leads to: mount it on the page `links.person` points at, or present it over your own page when `people` or `events` raise `personOpened`. `identifier` takes any identifier a person has been seen under, so a `personOpened` payload resolves here unchanged.
	 */
	createOverlay(name: "person", options?: PersonElementCreateOptions): PersonElementOverlayHandle;
	/**
	 * Merges new handle options into every mounted element. In React, change the namespace props instead.
	 */
	update(options: Partial<TrackingOptions>): void;
	/**
	 * Destroys every element and sub-controller this handle created, removes the controller frame, and releases its subscriptions. You can call it more than once, but a destroyed handle refuses any other call — create a new handle to start over. React removes the group automatically when the provider unmounts.
	 */
	destroy(): void;
}

/**
 * Tracking's static actions, callable with nothing mounted: `whop.tracking.<method>()` (React: `useWhop().tracking.<method>()`).
 * @see https://docs.whop.com/elements/latest/tracking/overview
 */
export interface TrackingStatics {}

/**
 * The consumer-facing shape of an element's `links` prop. `people`/`events` are base URLs the canonical query params are appended to; `person` is a template whose `{personId}` and `{identifier}` placeholders are replaced with the row's URL-encoded values.
 * Declared from the app's `CrossLinksConfig`, referenced by a host-capability surface.
 */
export interface CrossLinksConfig {
	people?: string | undefined;
	events?: string | undefined;
	person?: string | undefined;
}

/**
 * Consumer-facing filters for the People element. The element maps these camelCase options to `/api/v1/people` query parameters.
 * Declared from the app's `PeopleFilterBag`, referenced by a host-capability surface.
 */
export interface PeopleFilterBag {
	source: string;
	eventName: string;
	customEvent: string;
	utmSource: string;
	country: string;
	device: string;
	browser: string;
	os: string;
	hasPurchased: string;
	query: string;
	audienceId: string;
	eventFrom: string;
	eventTo: string;
}

/**
 * Consumer-facing filters for the Events element. The element maps these camelCase options to `/api/v1/events` query parameters.
 * Declared from the app's `EventsFilterBag`, referenced by a host-capability surface.
 */
export interface EventsFilterBag {
	identifier: string;
	event: string;
	source: string;
	country: string;
	utmSource: string;
	device: string;
	browser: string;
	os: string;
	from: string;
	to: string;
}
