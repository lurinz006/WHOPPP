/**
 * Options for `whop.verifications.create()`: the controller's props plus its `on<Event>` callbacks. In React, these are the `<Verifications>` component's props.
 * @example
 * ```ts
 * import { loadWhop } from "@whop/elements";
 * 
 * const whop = (await loadWhop())({ locale: "en" });
 * const verifications = whop.verifications.create({}); // options: props + on<Event> callbacks
 * ```
 * @see https://docs.whop.com/elements/latest/verifications/overview
 */
export interface VerificationsOptions {
	/**
	 * Use `individual` for KYC or `business` for KYB. The mounted element owns the matching intake form.
	 * @default "individual"
	 */
	kind?: "individual" | "business";
	/**
	 * The account being verified: a company `biz_…` tag or the viewer's own `user_…` tag.
	 */
	accountId: string;
	/**
	 * Called on your page before the element mounts. Return a fresh bearer credential with `identity:read` and `identity:write`; omit it only for a same-origin Whop session.
	 */
	getToken?: (() => Promise<string>);
	/**
	 * Runs when the grouped loading state changes. The value is `true` while any mounted element is still loading.
	 */
	onLoadingChange?: ((loading: boolean) => void);
	/**
	 * Set `false` to turn off Whop's built-in usage analytics for this handle and its elements. The analytics identity is never threaded to its frames. A reserved option, not element data.
	 */
	analytics?: false;
	/**
	 * Visual customization for this group's elements. Overrides the global `WhopElements({ appearance })`. Change it live with `update({ appearance })`.
	 */
	appearance?: import("./_framework.js").Appearance;
	/**
	 * Locale for this group's element UI text. Set it to one of the app's built locales to override the global configuration. Any other value falls back to the default locale.
	 */
	locale?: import("./_framework.js").WhopElementsLocale;
}

/**
 * Consumer props for the "kyc" element. Set at create (or as `<KycElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/verifications/kyc
 */
export interface KycElementProps {}

/**
 * The live handle for a mounted "kyc" element. Returned by `create("kyc")`; in React, the component's `ref`.
 * @see https://docs.whop.com/elements/latest/verifications/kyc
 */
export interface KycElementHandle {
	/**
	 * Fetch the latest verification status immediately. Pending and review states also poll automatically.
	 */
	refresh: () => Promise<{ verificationId: string; status: "not_started" | "pending" | "processing" | "manual_review" | "approved" | "rejected" | "action_required"; } | null>;
	/**
	 * Abandon the current attempt and start a fresh hosted session immediately.
	 */
	restart: () => Promise<void>;
	/**
	 * Mounts the element in `target` and starts loading. React components mount themselves.
	 */
	mount: (target: string | HTMLElement) => void;
	/**
	 * Removes the element and releases its frame and subscriptions. You can call it more than once. React removes the element automatically.
	 */
	destroy: () => void;
	/**
	 * Merges new props into the mounted element. In React, change the component props instead.
	 */
	update: (options: Partial<KycElementProps>) => void;
}

/**
 * Options for `create("kyc")`: the consumer props plus event callbacks and lifecycle hooks.
 * @example
 * ```ts
 * const kyc = verifications.create("kyc", {}); // this interface: props + on<Event> callbacks
 * kyc.mount("#verifications-kyc");
 * ```
 * @see https://docs.whop.com/elements/latest/verifications/kyc
 */
export interface KycElementCreateOptions {
	/**
	 * The verification entered a new status, including the status found on first mount.
	 */
	onStatusChanged?: ((payload: { verificationId: string; status: "not_started" | "pending" | "processing" | "manual_review" | "approved" | "rejected" | "action_required"; }) => void);
	/**
	 * Verification was approved. Fires once when the element first observes `approved`.
	 */
	onCompleted?: ((payload: { verificationId: string; }) => void);
	/**
	 * Whop needs follow-up information. The element renders and submits the requested fields itself.
	 */
	onActionRequired?: ((payload: { verificationId: string; requestedInformation: ActionRequiredItem[]; }) => void);
	/**
	 * The initial load, intake submission, follow-up submission, or an explicit restart failed.
	 */
	onLoadFailed?: ((payload: { reason: "access_denied" | "unavailable"; }) => void);
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

