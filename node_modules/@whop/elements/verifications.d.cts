/**
 * Options for `create("rfi")`: the consumer props plus event callbacks and lifecycle hooks.
 * @example
 * ```ts
 * const rfi = verifications.create("rfi", {}); // this interface: props + on<Event> callbacks
 * rfi.mount("#verifications-rfi");
 * ```
 * @see https://docs.whop.com/elements/latest/verifications/rfi
 */
export interface RfiElementCreateOptions {
	/**
	 * Hide the rows that are already with a reviewer, leaving only what the viewer can act on.
	 * @default false
	 */
	hideUnderReview?: boolean;
	/**
	 * One group of requirements was answered. Fires per group, not once per field.
	 */
	onSubmitted?: ((payload: { source: "identity" | "payout" | "audit" | "card_issuing" | "bank" | "ads" | "application" | "airwallex"; itemIds: string[]; }) => void);
	/**
	 * Nothing is outstanding any more. Fires when the element first observes an empty list, including on mount.
	 */
	onCompleted?: ((payload: { accountId: string; }) => void);
	/**
	 * The outstanding requests could not be read, or answering one failed.
	 */
	onLoadFailed?: ((payload: { reason: "access_denied" | "unavailable"; }) => void);
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

/**
 * The Verifications handle, returned by `whop.verifications.create()` (React: `useVerifications()`). Mounts the elements and carries the controller's actions.
 * @see https://docs.whop.com/elements/latest/verifications/overview
 */
export interface VerificationsHandle {
	/**
	 * A complete identity-verification flow. It collects individual KYC or business KYB details, starts or resumes the hosted provider session, handles follow-up information and document requests, polls status, and renders the final result without requiring the host to build verification UI.
	 */
	create(name: "kyc", options?: KycElementCreateOptions): KycElementHandle;
	/**
	 * The account's verification standing: whether individual and business verification are done, and which capabilities that unlocks. Read-only — pressing a verify button reports `verificationRequested` and stays put, so the host mounts its own flow, such as this namespace's `kyc` element. Both halves can be hidden, so a host that only wants the capability list, or only the two verification rows, can drop the other.
	 */
	create(name: "capabilities", options?: CapabilitiesElementCreateOptions): CapabilitiesElementHandle;
	/**
	 * Everything the account still owes compliance, and the forms to answer it. Each row is one group of requirements — grouped by the system that asked, because each relays to its provider once its own items are answered — and pressing it opens that group’s form in place. Rows already with a reviewer are shown but not answerable. Renders an all-clear once nothing is outstanding, so it can sit permanently in a settings page.
	 */
	create(name: "rfi", options?: RfiElementCreateOptions): RfiElementHandle;
	/**
	 * Merges new handle options into every mounted element. In React, change the namespace props instead.
	 */
	update(options: Partial<VerificationsOptions>): void;
	/**
	 * Destroys every element and sub-controller this handle created, removes the controller frame, and releases its subscriptions. You can call it more than once, but a destroyed handle refuses any other call — create a new handle to start over. React removes the group automatically when the provider unmounts.
	 */
	destroy(): void;
}

/**
 * Verifications's static actions, callable with nothing mounted: `whop.verifications.<method>()` (React: `useWhop().verifications.<method>()`).
 * @see https://docs.whop.com/elements/latest/verifications/overview
 */
export interface VerificationsStatics {}

/**
 * Declared from the app's `ActionRequiredItem`, referenced by a host-capability surface.
 */
export interface ActionRequiredItem {
	id: string;
	requirement: string;
	type: string;
	label: string;
	source?: "identity" | "payout" | "audit" | "card_issuing" | "bank" | "ads" | "application" | "airwallex" | undefined;
	optional?: boolean | undefined;
	options?: string[] | undefined;
	errors?: { code: string; reason: string; }[] | undefined;
}
