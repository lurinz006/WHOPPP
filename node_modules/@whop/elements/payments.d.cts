/**
 * Consumer props for the "payment" element. Set at create (or as `<PaymentElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/payments/payment
 */
export interface PaymentElementProps {
	/**
	 * Controls display order in either layout. Listed types appear first in order. Unlisted types retain their relative order. Does not affect availability.
	 * @default []
	 */
	order?: string[];
	/**
	 * Controls which wallets the element offers. Each key defaults to `'auto'`, which offers the wallet wherever the account, the buyer's device, and the charge support it. `'never'` removes that wallet from the method list. Use it when your page draws its own Apple Pay, Google Pay, or PayPal buttons with `paymentRequest`, so buyers see each wallet once. `payPal: 'never'` removes the PayPal method. Saved payment methods are unaffected.
	 * @default {}
	 */
	wallets?: { applePay?: "never" | "auto" | undefined; googlePay?: "never" | "auto" | undefined; payPal?: "never" | "auto" | undefined; };
	/**
	 * Controls billing-details collection. `billingDetails: 'minimal'` (default) follows each method's matrix. Methods collect name and the complete country format by default. An override may collect only the declared minimum or nothing. For cards, the minimum is name on card, country, and postal code. `'full'` requires name and the complete country format for every fresh method. `'never'` hides the block. `phone: 'never'` hides only the billing phone input when your form already collects it; pass `billingDetails.phone` to `createConfirmationToken` for methods that require it. Pass the address to `createConfirmationToken` instead. The country selector includes only countries supported by the method and payment currency. With an installment plan selected, it narrows to the countries the plan serves — the billing country is the transaction country the charge processes under. It locks when only one is available.
	 * @default {"billingDetails":"minimal"}
	 */
	fields?: { billingDetails?: "full" | "minimal" | "never" | undefined; phone?: "never" | "auto" | undefined; };
	/**
	 * Prefills the billing details when each method's billing block first renders. The buyer can edit every prefilled field. `address.country` is an ISO 3166-1 alpha-2 code and applies only when the selected method accepts it. `phone` fills the billing phone input for methods that collect one, in E.164 format such as `+14155552671`; a number outside the method's supported phone countries is ignored. Only fields the block renders are prefilled and sent. Pass anything else to `createConfirmationToken` in `billingDetails`.
	 */
	defaultValues?: { billingDetails?: { name?: string | undefined; phone?: string | undefined; address?: { line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country?: string | undefined; } | undefined; } | undefined; };
	/**
	 * Picker layout. `accordion` (default) stacks methods and expands details inline. `horizontal` shows equal-width, non-scrolling tiles with selected details below. After four methods, a More tile opens a native selector. The method picked there occupies the final tile until the next selection. Selection and confirmation behave identically.
	 * @default "accordion"
	 */
	layout?: "accordion" | "horizontal";
	/**
	 * `accordion` only. Adds spacing and separate card styling between methods. Ignored when `layout` is `horizontal`.
	 * @default false
	 */
	separated?: boolean;
	/**
	 * Whether to select the first offered method after resolution. The default `true` respects `order` and emits `selected` and `change` like a buyer interaction. It runs once before buyer interaction and does nothing when no method is offered. Set `false` to mount unselected. Independently, if an update removes the selected method, selection falls back to the first offered method. An already unselected element stays unselected.
	 * @default true
	 */
	autoSelect?: boolean;
}

/**
 * The live handle for a mounted "payment" element. Returned by `create("payment")`; in React, the component's `ref`.
 * @see https://docs.whop.com/elements/latest/payments/payment
 */
export interface PaymentElementHandle {
	/**
	 * Select a method through the same path as a buyer interaction. For example, `select('cashapp')` expands the tile and emits `selected` and `change`. Cards remain `complete: false` until their fields are complete. Unknown, unavailable, or amount-gated methods reject with code `METHOD_NOT_OFFERED`. `select(null)` clears selection and emits `change` with `complete: false`. Use with `autoSelect={false}` for full external control.
	 */
	select: (input: string | null) => Promise<void>;
	/**
	 * Mounts the element in `target` and starts loading. React components mount themselves.
	 */
	mount: (target: string | HTMLElement) => void;
	/**
	 * Removes the element and releases its frame and subscriptions. You can call it more than once. React removes the element automatically.
	 */
	destroy: () => void;
	/**
	 * Merges new props into the mounted element. In React, change the component props instead.
	 */
	update: (options: Partial<PaymentElementProps>) => void;
}

/**
 * Options for `create("payment")`: the consumer props plus event callbacks and lifecycle hooks.
 * @example
 * ```ts
 * const payment = payments.create("payment", {}); // this interface: props + on<Event> callbacks
 * payment.mount("#payments-payment");
 * ```
 * @see https://docs.whop.com/elements/latest/payments/payment
 */
export interface PaymentElementCreateOptions {
	/**
	 * Controls display order in either layout. Listed types appear first in order. Unlisted types retain their relative order. Does not affect availability.
	 * @default []
	 */
	order?: string[];
	/**
	 * Controls which wallets the element offers. Each key defaults to `'auto'`, which offers the wallet wherever the account, the buyer's device, and the charge support it. `'never'` removes that wallet from the method list. Use it when your page draws its own Apple Pay, Google Pay, or PayPal buttons with `paymentRequest`, so buyers see each wallet once. `payPal: 'never'` removes the PayPal method. Saved payment methods are unaffected.
	 * @default {}
	 */
	wallets?: { applePay?: "never" | "auto" | undefined; googlePay?: "never" | "auto" | undefined; payPal?: "never" | "auto" | undefined; };
	/**
	 * Controls billing-details collection. `billingDetails: 'minimal'` (default) follows each method's matrix. Methods collect name and the complete country format by default. An override may collect only the declared minimum or nothing. For cards, the minimum is name on card, country, and postal code. `'full'` requires name and the complete country format for every fresh method. `'never'` hides the block. `phone: 'never'` hides only the billing phone input when your form already collects it; pass `billingDetails.phone` to `createConfirmationToken` for methods that require it. Pass the address to `createConfirmationToken` instead. The country selector includes only countries supported by the method and payment currency. With an installment plan selected, it narrows to the countries the plan serves — the billing country is the transaction country the charge processes under. It locks when only one is available.
	 * @default {"billingDetails":"minimal"}
	 */
	fields?: { billingDetails?: "full" | "minimal" | "never" | undefined; phone?: "never" | "auto" | undefined; };
	/**
	 * Prefills the billing details when each method's billing block first renders. The buyer can edit every prefilled field. `address.country` is an ISO 3166-1 alpha-2 code and applies only when the selected method accepts it. `phone` fills the billing phone input for methods that collect one, in E.164 format such as `+14155552671`; a number outside the method's supported phone countries is ignored. Only fields the block renders are prefilled and sent. Pass anything else to `createConfirmationToken` in `billingDetails`.
	 */
	defaultValues?: { billingDetails?: { name?: string | undefined; phone?: string | undefined; address?: { line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country?: string | undefined; } | undefined; } | undefined; };
	/**
	 * Picker layout. `accordion` (default) stacks methods and expands details inline. `horizontal` shows equal-width, non-scrolling tiles with selected details below. After four methods, a More tile opens a native selector. The method picked there occupies the final tile until the next selection. Selection and confirmation behave identically.
	 * @default "accordion"
	 */
	layout?: "accordion" | "horizontal";
	/**
	 * `accordion` only. Adds spacing and separate card styling between methods. Ignored when `layout` is `horizontal`.
	 * @default false
	 */
	separated?: boolean;
	/**
	 * Whether to select the first offered method after resolution. The default `true` respects `order` and emits `selected` and `change` like a buyer interaction. It runs once before buyer interaction and does nothing when no method is offered. Set `false` to mount unselected. Independently, if an update removes the selected method, selection falls back to the first offered method. An already unselected element stays unselected.
	 * @default true
	 */
	autoSelect?: boolean;
	/**
	 * Fires when selection changes. `complete: true` means the buyer selected a method and completed its card fields or required inputs. Use it to enable confirmation. `paymentMethod` is the selected payment method, saved or new, or `null` while nothing is selected: `displayName` and `icons` name the pick the way the element shows it (with `balance.imageUrl`, a balance owner's image), `card` carries a card's network, last four digits and funding, `requiresBillingPhone` says whether the method needs a phone in billing details, and `countries` lists where the method can pay from in the charge's currency. `type`, `requiresBillingPhone` and `method` at the top level are deprecated: read them from `paymentMethod`. `supportsBuyerFee` at the top level is deprecated too, with no replacement: Whop prices its buyer service fee itself.
	 */
	onChange?: ((payload: PaymentElementChangeEvent) => void);
	/**
	 * Fires about 300 ms after the internal billing address changes. Use it for tax, shipping, or other address-dependent updates. `country` is an ISO 3166-1 alpha-2 code. The payload omits other address keys when empty or unused for that country. `complete: true` means the billing block is valid and complete. This event fires only while the payment element owns address collection. With `fields.billingDetails: 'never'`, use your address source. With a mounted `AddressElement`, use its `change` event.
	 */
	onAddressChange?: ((payload: { complete: boolean; address: { line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country: string; }; }) => void);
	/**
	 * Runs after the loading skeleton first paints and before `onReady`.
	 */
	onLoaderStart?: (() => void);
	/**
	 * Runs after the element's first complete paint.
	 */
	onReady?: (() => void);
	/**
	 * Runs when the element fails to load or crashes. The fallback remains visible. Use `code` for programmatic handling. `sourceKey` identifies a failed host-state source.
	 */
	onError?: ((e: { message: string; code?: string | undefined; sourceKey?: string | undefined; }) => void);
}

/**
 * Consumer props for the "address" element. Set at create (or as `<AddressElement />` JSX props), and updatable live via `update()`.
 * @see https://docs.whop.com/elements/latest/payments/address
 */
export interface AddressElementProps {
	/**
	 * Which address this collects: `billing` (default) or `shipping`. Also sets the browser autocomplete purpose. You can mount one of each under one handle. Billing details come from the billing element, or from the shipping element when no billing element is mounted.
	 * @default "billing"
	 */
	mode?: "billing" | "shipping";
	/**
	 * The name row: one full-name field (default), split first/last fields, or none.
	 * @default "combined"
	 */
	name?: "split" | "none" | "combined";
	/**
	 * Address line 2: always visible (default), revealed by a text button (`toggle`), or never collected.
	 * @default "always"
	 */
	line2?: "never" | "toggle" | "always";
	/**
	 * Seed values applied once before first paint (`address.country` is an ISO 3166-1 alpha-2 country code). Takes precedence over IP-country detection.
	 */
	defaultValues?: { name?: string | undefined; address?: { name?: string | undefined; first_name?: string | undefined; last_name?: string | undefined; organization?: string | undefined; organization_type?: "business" | "individual" | undefined; line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country?: string | undefined; } | undefined; };
	/**
	 * `full` (default) stacks labeled fields. `compact` groups placeholder-labeled fields within one border. `wrap` keeps `full`'s separate fields and also puts city, state and postal code side by side. Those and the pairs `full` already sets side by side (first and last name, organization) fit as many to a row as the width allows and wrap as it narrows.
	 * @default "full"
	 */
	layout?: "full" | "compact" | "wrap";
	/**
	 * `above` (default) keeps each label outside its field: above it in the `full` layout, as its placeholder in `compact`. `floating` uses each label as the placeholder of its field, in either layout, then shows a small label above the typed text once the field has a value.
	 * @default "above"
	 */
	labelMode?: "above" | "floating";
	/**
	 * `full` (default) follows the selected country's complete address format. `minimal` collects only country and postal code. `name` independently adds required name fields. Set `name` to `none` to omit them. This element does not add fields required by a payment method. Card confirmation requires a name, country, and postal code, so keep `name` enabled or pass `billingDetails.name`.
	 * @default "full"
	 */
	scope?: "full" | "minimal";
	/**
	 * Organization fields: none (default), name only, or name with a business/individual selector.
	 * @default "none"
	 */
	organization?: "none" | "name" | "name_with_type";
	/**
	 * Default the country from the buyer's IP (resolved before first paint). Falls back to the controller's `countryHint`, then US.
	 * @default true
	 */
	detectCountry?: boolean;
	/**
	 * Allowed ISO 3166-1 alpha-2 country codes. With one code, the selector remains visible but offers only that country.
	 */
	allowedCountries?: string[];
	/**
	 * Enables Google Places suggestions for the street address. If no match appears or Places is blocked, the list reports no matches and lets buyers enter the address manually. On a phone, the suggestions open full screen from a search button in the street field instead of under it, where the keyboard would cover them. Set `false` for a plain input.
	 * @default true
	 */
	autocomplete?: boolean;
	/**
	 * Shows every address field from the start. By default (`false`) the form opens with the street address and reveals the rest once the buyer picks a suggestion, types an address, or chooses to enter it manually.
	 * @default false
	 */
	expanded?: boolean;
	/**
	 * Additional fields rendered with the address form. Values are validated and emitted in the separate `custom` map.
	 */
	customFields?: ({ key: string; label: string; type: "phone" | "text" | "select" | "date"; position: "after_name" | "after_organization" | "before_country" | "after_address"; required?: boolean | undefined; options?: string[] | undefined; format?: string | undefined; autocomplete?: string | undefined; })[];
	/**
	 * Fallback country after `defaultValues` and IP detection. Use an ISO 3166-1 alpha-2 code. An empty value falls back to `US`.
	 * @default ""
	 */
	countryHint?: string;
}

/**
 * The live handle for a mounted "address" element. Returned by `create("address")`; in React, the component's `ref`.
 * @see https://docs.whop.com/elements/latest/payments/address
 */
export interface AddressElementHandle {
	/**
	 * Validates the form, reveals all inline errors, and never throws. Returns `complete`, `address`, and `errors`. `errors` is empty exactly when `complete` is true. Keys use contract names such as `postal_code` and `line1`, `custom:<key>` for custom fields, and transient `form` while loading.
	 */
	validate: () => Promise<{ complete: boolean; address: { name?: string | undefined; first_name?: string | undefined; last_name?: string | undefined; organization?: string | undefined; organization_type?: "business" | "individual" | undefined; line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country: string; }; errors: Record<string, string>; }>;
	/**
	 * Returns `address` and `custom` without validation or revealing errors.
	 */
	getValues: () => Promise<{ address: { name?: string | undefined; first_name?: string | undefined; last_name?: string | undefined; organization?: string | undefined; organization_type?: "business" | "individual" | undefined; line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; country: string; }; custom: Record<string, string>; }>;
	/**
	 * Mounts the element in `target` and starts loading. React components mount themselves.
	 */
	mount: (target: string | HTMLElement) => void;
	/**
	 * Removes the element and releases its frame and subscriptions. You can call it more than once. React removes the element automatically.
	 */
	destroy: () => void;
	/**
	 * Merges new props into the mounted element. In React, change the component props instead.
	 */
	update: (options: Partial<AddressElementProps>) => void;
}

