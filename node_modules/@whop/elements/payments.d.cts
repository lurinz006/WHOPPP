	tokenize: (input: { accountId?: string | undefined; }) => Promise<{ token: string; }>;
	/**
	 * `payments.createConfirmationToken()` calls this action for `cardFields`. Don't call it directly. It tokenizes the fields and returns the data used to create the confirmation token.
	 */
	collect: (input: { billingDetails?: { email?: string | undefined; name?: string | undefined; address?: { country?: string | undefined; line1?: string | undefined; city?: string | undefined; postal_code?: string | undefined; } | undefined; } | undefined; }) => Promise<{ paymentMethod: { type: string; category: string; card: { token: string; }; }; billingDetails: { email: string; name?: string | undefined; address?: { country?: string | undefined; line1?: string | undefined; city?: string | undefined; postal_code?: string | undefined; } | undefined; }; }>;
	/**
	 * Merges new props and callbacks into the sub-controller.
	 */
	update(options: Partial<CardFieldsSubOptions>): void;
	/**
	 * Destroys the sub-controller and its elements, then frees its exclusive slot. A later `create("cardFields")` starts fresh.
	 */
	destroy(): void;
}

/**
 * Options for `whop.payments.paymentRequest.create()` — the "paymentRequest" resource's create options.
 * @see https://docs.whop.com/elements/latest/payments/paymentRequest
 */
export interface PaymentRequestResourceOptions {
	/**
	 * Account ID, prefixed `biz_`, that scopes every client-side call.
	 */
	accountId: string;
	/**
	 * Three-letter ISO 4217 payment currency code.
	 */
	currency: string;
	/**
	 * Payment amount in minor units.
	 * Change it later with `update()`.
	 */
	amount: number;
	/**
	 * Set only after displaying save consent. Marks the token for `off_session` or `on_session` use.
	 */
	setupFutureUsage?: "off_session" | "on_session";
	/**
	 * Payment method filters in the API's `enabled`, `disabled`, and `include_platform_defaults` format. They narrow the wallets `canMakePayment()` reports: `disabled` removes types, `enabled` restores offered types, and `include_platform_defaults: false` leaves only enabled types. They never add a method the account doesn't offer. PayPal follows the `paypal` type.
	 */
	paymentMethodConfiguration?: PaymentMethodConfigurationShape;
	/**
	 * Ask the sheet for the payer's email — the confirmation token requires one.
	 * @default true
	 */
	requestPayerEmail?: boolean;
	/**
	 * Ask the sheet for the payer's phone number, delivered as `payer.phone` on the result — in E.164 where it parses against the country of the contact that supplied it, as the wallet gave it otherwise; `payer.country` is the billing country. Google Pay collects it through the billing address the sheet already asks for.
	 * @default false
	 */
	requestPayerPhone?: boolean;
	/**
	 * Ask the sheet for a shipping address (and offer `shippingOptions` when given). PayPal always asks for an address, since it is the address tax is computed on, and returns it as `shipping` only when this is set.
	 * @default false
	 */
	requestShipping?: boolean;
	/**
	 * Offer the sheet's own promo code field and answer `onPromoCodeChange`. Apple Pay shows the field on devices that support Apple Pay version 12 (iOS 15 and macOS 12); Google Pay shows it where the account's Google Pay setup allows offers. Other devices open the sheet without it.
	 * @default false
	 */
	requestPromoCode?: boolean;
	/**
	 * A promo code already applied to the charge, prefilled into the sheet so the buyer can see, replace or remove it.
	 */
	appliedPromoCode?: string;
	/**
	 * What `appliedPromoCode` does, shown next to the code in Google Pay. Apple Pay's coupon field has no caption.
	 */
	appliedPromoDescription?: string;
	/**
	 * Account ISO 3166-1 alpha-2 country code for the Apple Pay sheet. Omit it to use the account's published registration country. The sheet defaults to `US` when neither is available.
	 */
	countryCode?: string;
	/**
	 * Line items the sheet lists under the total.
	 * Change it later with `update()`.
	 */
	lineItems?: PaymentRequestLineItem[];
	/**
	 * Shipping options the sheet offers when `requestShipping` is set. Display-only — update `amount` from your change handler. The sheet opens with the first option selected and fires no `onShippingOptionChange` for it, so `amount` must already include its price.
	 * Change it later with `update()`.
	 */
	shippingOptions?: PaymentRequestShippingOption[];
}

/**
 * A minted "paymentRequest" resource — returned by `whop.payments.paymentRequest.create()`. Low-level Apple Pay, Google Pay, or PayPal sheet for custom buttons, express checkout, and shipping callbacks. Wallet tiles automate this flow through `payments.createConfirmationToken`. Await `canMakePayment()` to check availability and prime the wallet, then call `show(type)` synchronously in the user-interaction handler. The resolved `ctok` is a `ctok_`-prefixed confirmation token. Confirm it server-side like an element-minted token. A PayPal token charges at most the total PayPal showed the buyer.
 * @see https://docs.whop.com/elements/latest/payments/paymentRequest
 */
export interface PaymentRequestResource {
	/**
	 * Returns availability for each wallet when the account offers it, the device supports it, and this page's origin is approved for the account (first-party whop.com pages are pre-approved; a merchant page needs its domain registered and verified as a [payment method domain](/api-reference/beta/payment-method-domains/payment-method-domain), and offering Google Pay there is subject to the [Google Pay API Terms of Service](https://payments.developers.google.com/terms/sellertos)). On a page that is itself inside an iframe, Apple Pay checks the top-level page's domain instead when the browser exposes it. Apple Pay on non-WebKit browsers is the desktop iPhone-handoff flow, so mobile devices there report it unavailable — native Apple Pay on iOS browsers is unaffected. `order` ranks the wallets by which sheet is native to the browser — Apple Pay first on Safari, Google Pay first elsewhere, PayPal last — so express buttons can stack best-first. `payPal` reports PayPal where the account offers it in this currency, the amount is within PayPal's limits, the request does not ask for the payer's phone (an `off_session` request may be $0, which saves PayPal without a charge), PayPal's scripts load on this page, and this page's origin is approved for the account like the other wallets'. A page with a Content Security Policy must allow PayPal's hosts, which `contentSecurityPolicy()` includes. A page that already loads PayPal's own v5 JavaScript SDK reports `payPal: false`. Pass `types` to check only the wallets you list; `show(type)` needs that wallet checked. `wallets` carries each available wallet's official button art (`light` and `dark` color and image). This primes `show()`. Always await it first.
	 */
	canMakePayment: (filter?: { types?: ("apple_pay" | "google_pay" | "paypal_express")[] | undefined; } | undefined) => Promise<WalletAvailability>;
	/**
	 * Open the selected wallet after awaiting `canMakePayment()`, synchronously in the press: Apple requires session creation within the gesture stack, and PayPal opens its window there — a pop-up on desktop, PayPal's in-page window when the pop-up is blocked and on mobile. Pass `email` when your page already collected one — the wallet takes it and never asks for a second. With `requestPayerEmail: false`, passing one is required, and the wallet refuses to open without it because confirmation tokens require an email. While the sheet is open, `update()` throws: answer the change events to change it.
	 * Call synchronously during user activation. Await prerequisites first because browsers revoke activation across asynchronous steps.
	 */
	show: (type: "apple_pay" | "google_pay" | "paypal_express", provided?: { email?: string | undefined; } | undefined) => Promise<PaymentRequestResult>;
	/**
	 * Change `amount`, `lineItems` and `shippingOptions` on this instance. Every other option is fixed at `create()`: create a new instance to change it.
	 */
	update: (patch: { amount?: number | undefined; lineItems?: PaymentRequestLineItem[] | undefined; shippingOptions?: PaymentRequestShippingOption[] | undefined; }) => void;
	/**
	 * The buyer chose a shipping address (redacted pre-authorization: city, state, postal code and country only; Apple Pay cuts a US ZIP code to five digits and drops the last three characters of a Canadian or UK postal code). Answer with the totals for the address and the selected shipping option: the first one until the buyer picks another. `shippingOptions` replaces the options (an empty list changes nothing). A picked option stays selected while the answer keeps its `id`; when the answer drops it, the first option becomes the selection without an `onShippingOptionChange`, so price that one. Every error in the answer stays on the address until a later answer for an address clears it: one that names a `field` (`city`, `state`, `postal_code`, `country`) marks that field in Apple Pay, and Google Pay shows the message alone. Pay is refused while an error stands on the address. Refuse an address you can't ship to with a `shipping_address_unserviceable` error and no `field`. On Apple Pay, Google Pay and PayPal, a handler that hasn't answered within 25 seconds fails the address, the way a throwing one does, and its later answer is ignored. PayPal fires it with the address the buyer picks, and an error naming a `field` refuses that part of the address inside PayPal.
	 * Call `updateWith(…)` exactly once per event. A handler that throws or rejects before calling it fails that update right away.
	 * Returns the unsubscribe function.
	 */
	onShippingAddressChange(handler: (ev: ShippingAddressChangeEvent) => void): () => void;
	/**
	 * The buyer picked a shipping option, or Apple Pay re-announced the selected one: once the address changes are all answered and none is waiting, Apple Pay fires it for the option still selected. It never fires after an answer that drops the selected option, which makes the first option the selection without an event, so every total you answer prices the selected option: the first one until the buyer picks another, the pick while your answers keep its `id`, and the first again once an answer drops it. Amount-only contract: `updateWith` carries amount/lineItems/shippingOptions/errors. An answer with `errors` refuses the option until the buyer picks one your handler accepts. Apple Pay has no error slot for a shipping option, so it keeps the last accepted total whatever else the answer carries, and the first error's message shows when the buyer taps Pay. Google Pay shows the message when the option is picked. On Apple Pay, Google Pay and PayPal, a handler that hasn't answered within 25 seconds refuses the option, the way a throwing one does, and its later answer is ignored.
	 * Call `updateWith(…)` exactly once per event. A handler that throws or rejects before calling it fails that update right away.
	 * Returns the unsubscribe function.
	 */
	onShippingOptionChange(handler: (ev: ShippingOptionChangeEvent) => void): () => void;
	/**
	 * The buyer selected a card, with its redacted billing address (city, state, postal code and country only): reprice the total for the address the charge taxes off. Apple Pay fires it when the buyer selects a card, and Google Pay when the sheet opens and each time the buyer switches cards. Answer `updateWith({ amount })` in minor units, `updateWith({})` to keep the current total, or `updateWith({ errors })` to refuse the card. Every event is answered exactly once: a handler that throws, rejects, or doesn't answer within 10 seconds refuses the card, so the buyer picks another one. On Apple Pay and Google Pay the same selection then fires `paymentMethodChange`, and the sheet updates once both are answered. PayPal fires it with each shipping address the buyer picks in PayPal, which is the address its token bills and taxes on, and a refusal there refuses that address inside PayPal.
	 * Call `updateWith(…)` exactly once per event. A handler that throws or rejects before calling it fails that update right away.
	 * Returns the unsubscribe function.
	 */
	onBillingAddressChange(handler: (ev: BillingAddressChangeEvent) => void): () => void;
	/**
	 * The buyer selected a payment method: reprice the total for it, such as a surcharge on credit cards. Apple Pay fires it when the buyer selects a card, and Google Pay when the sheet opens and each time the buyer switches cards, each right after that card's `billingAddressChange`. `paymentMethod.type` is `card`. `paymentMethod.card` carries what the wallet tells about a card before the buyer authorizes: Apple Pay reports its `funding` (Apple usually withholds the network until then), and Google Pay its `network`. `paymentMethod.billingAddress` is the card's redacted billing address. Answer `updateWith({ amount, lineItems })` to reprice, `updateWith({})` to keep the current total, or `updateWith({ errors })` to refuse the method; `shippingOptions` is ignored. Apple Pay marks a refusal on the card's billing contact (on the named `field` when one is given) and holds its Pay button until the buyer picks another method. Google Pay shows the message on the card and refuses a Pay tap on it until the buyer picks a card you accept. A refused card leaves the totals as they were, whatever this answer or its `billingAddressChange` answer priced. Every event is answered exactly once: a handler that throws, rejects, or doesn't answer within 10 seconds refuses the method. Each sheet waits for your answer before the buyer can pay. PayPal never fires it.
	 * Call `updateWith(…)` exactly once per event. A handler that throws or rejects before calling it fails that update right away.
	 * Returns the unsubscribe function.
	 */
	onPaymentMethodChange(handler: (ev: PaymentMethodChangeEvent) => void): () => void;
	/**
	 * The buyer typed, changed, or removed a code in the sheet's promo field (`requestPromoCode`). Answer `updateWith({ amount })` to apply the code at a new total, `updateWith({})` to apply it at the current total, or `updateWith({ error })` to refuse it in place. A removal arrives with `code` null and is answered the same way. Replacing an applied code arrives as one event with the new code, never a removal first, and a refused new code leaves the applied one in place. When `shippingOptions` drops the selected option, the first one becomes the selection without an `onShippingOptionChange`, so price that one. `appliedDescription` captions the code in Google Pay; Apple Pay's coupon field has no caption, so put anything the buyer must see in a line item label. A handler that throws, rejects, or doesn't answer within 10 seconds refuses the code.
	 * Call `updateWith(…)` exactly once per event. A handler that throws or rejects before calling it fails that update right away.
	 * Returns the unsubscribe function.
	 */
	onPromoCodeChange(handler: (ev: PromoCodeChangeEvent) => void): () => void;
	/**
	 * The buyer authorized the payment, and no confirmation token exists yet. Subscribe to approve or refuse it first: the sheet waits for your answer, and without a handler the token is created at once. The event carries the payer, the payment method (with its redacted billing address, and in `displayName` the wallet's own label for it, such as `Visa 1234`), the shipping address and option, and the total and line items the buyer authorized. Answer `respondWith({ approved: true })` to create the token, which `show()` and `onConfirmationToken` then deliver as usual. Answer `respondWith({ approved: false, message })` to refuse: no token is created, Apple Pay and Google Pay show `message` in the sheet, and the buyer can change something and pay again, or close the sheet. PayPal can't show your message, so a refusal there ends the attempt: `show()` rejects with `payment_request_refused`, and the buyer can press PayPal again. Every event is answered exactly once, and only `approved: true` creates a token: a handler that throws, rejects, or doesn't answer within 25 seconds refuses the payment, early enough for Apple Pay and Google Pay to show the refusal before their own 30-second limit.
	 * Call `respondWith(…)` exactly once per event. A handler that throws or rejects before calling it fails that update right away.
	 * Returns the unsubscribe function.
	 */
	onPaymentAuthorization(handler: (ev: PaymentAuthorizationEvent) => void): () => void;
	/**
	 * The sheet created a confirmation token, heard once the sheet has closed. This is the same result that `show()` returns.
	 * Returns the unsubscribe function.
	 */
	onConfirmationToken(handler: (ev: PaymentRequestResult) => void): () => void;
	/**
	 * The buyer dismissed the sheet or closed PayPal.
	 * Returns the unsubscribe function.
	 */
	onCancel(handler: () => void): () => void;
}

/**
 * The Payments handle, returned by `whop.payments.create()` (React: `usePayments()`). Mounts the elements and carries the controller's actions.
 * @see https://docs.whop.com/elements/latest/payments/overview
 */
export interface PaymentsHandle {
	/**
	 * Shows available payment methods and collects the selected method's required fields and disclosures. Use `change` to enable your pay button. In its activation handler, call `payments.createConfirmationToken()`. Confirm the token server-side, then pass any pending step to `payments.handleNextAction(…)`. Use `addressChange` for address-dependent updates.
	 * Exclusive slot `entry`. Mount exactly one of: payment | card | cardFields.
	 */
	create(name: "payment", options?: PaymentElementCreateOptions): PaymentElementHandle;
	/**
	 * Collects a billing or shipping address. Fields, order, and validation follow the selected country. Includes street autocomplete (full screen on phones) and methods to read or validate the address.
	 * One per "mode": call once per "mode" value; a second "address" with the same "mode" throws. "mode" is fixed at create.
	 */
	create(name: "address", options?: AddressElementCreateOptions): AddressElementHandle;
	/**
	 * Prearranged fields for card number, expiration, and security code. Create with `payments.create("card")`, enable your payment button from `onChange`, and confirm with `payments.createConfirmationToken()`. Card numbers remain in PCI-isolated hosted fields. `layout` supports `stacked` (default) and `compact`.
	 * Exclusive slot `entry`. Mount exactly one of: payment | card | cardFields.
	 */
	create(name: "card", options?: CardElementCreateOptions): CardElementHandle;
	/**
	 * Collects the buyer's email and passes it to `payments.createConfirmationToken()` while mounted. Explicit `billingDetails.email` wins. A matching Whop account shows optional sign-in with code verification. Successful sign-in unlocks saved payment methods in the payment element. Buyers can continue as guests.
	 */
	create(name: "email", options?: EmailElementCreateOptions): EmailElementHandle;
	/**
	 * Collects a business tax registration accepted by the API. Labels use buyer-facing names. The placeholder matches the selected format. `country` preselects a type. `onChange` emits committed pairs. The host supplies API validation errors.
	 */
	create(name: "taxId", options?: TaxIdElementCreateOptions): TaxIdElementHandle;
	/**
	 * Whop's merchant-of-record notice: the buyer's agreement to Whop's Buyer Terms of Service and Privacy Policy, with the Whop wordmark. Required — the payment, card and card fields elements stay in their loading state until it is mounted, and payments cannot be confirmed without it.
	 */
	create(name: "branding", options?: BrandingElementCreateOptions): BrandingElementHandle;
	/**
	 * Creates a confirmation token for the selected method from your pay button. Pass the checkout's billing details. They must include `email`. Supply `phone` for methods that require it when billing collection is disabled. Cards also need `name` and an address containing `line1` and `country`. Wallet selections open their sheet during the pay-button interaction. When the account offers in-page bank linking (`bank_debit.bank_connection` on its bank account payment method type), a bank account selection opens Plaid Link during it too, and the call resolves once the buyer has linked an account. That needs a whop.com page or a domain verified as a [payment method domain](/api-reference/beta/payment-method-domains/payment-method-domain), and a Content Security Policy that allows the Plaid hosts `contentSecurityPolicy()` returns. Otherwise the buyer links the account after submitting instead. If the buyer closes the sheet or Link, the call rejects with `payment_request_cancelled`: treat it as a cancel, not a payment error, and let the buyer pay again. Confirm the returned `confirmationToken` server-side, then call `WhopElements.payments.handleNextAction(…)`.
	 * Runs on your page (host-side), not in the controller iframe.
	 */
	createConfirmationToken: (input: { billingDetails?: { email?: string | undefined; name?: string | undefined; phone?: string | undefined; address?: { country?: string | undefined; line1?: string | undefined; line2?: string | undefined; city?: string | undefined; state?: string | undefined; postal_code?: string | undefined; } | undefined; } | undefined; }) => Promise<{ confirmationToken: string; type: string; }>;
	/**
	 * Three separately mountable, PCI-isolated card fields for custom layouts: number, expiration, and security code. Create with `payments.create("cardFields")`, place each field, enable your payment button from `onChange`, and confirm with `payments.createConfirmationToken()`. Card numbers remain in hosted fields.
	 * Exclusive slot `entry`. Mount exactly one of: payment | card | cardFields.
	 */
	create(name: "cardFields", options?: CardFieldsSubOptions): CardFieldsSubHandle;
	/**
	 * Merges new handle options into every mounted element. In React, change the namespace props instead.
	 */
	update(options: Partial<PaymentsOptions>): void;
	/**
	 * Destroys every element and sub-controller this handle created, removes the controller frame, and releases its subscriptions. You can call it more than once, but a destroyed handle refuses any other call — create a new handle to start over. React removes the group automatically when the provider unmounts.
	 */
	destroy(): void;
}

/**
 * Payments's static actions, callable with nothing mounted: `whop.payments.<method>()` (React: `useWhop().payments.<method>()`).
 * @see https://docs.whop.com/elements/latest/payments/overview
 */
export interface PaymentsStatics {
	/**
	 * Completes a confirmed payment's pending step without mounting an element. `clientSecret` identifies the payment. You don't need a payment ID. Inline steps open in a dialog and resolve with `redirected: false`. Dismissing the dialog returns the payment's current status, which can remain pending. Full-page steps redirect with `redirected: true` to `return_url`, or a hosted receipt when the payment has no return URL. Inside an iframe they navigate the top-level tab. If the embedding page refuses that navigation, they reject with code `TAB_NAVIGATION_BLOCKED`, and the payment stays pending. Set `returnUrl` to update the destination before presentation. An update failure rejects before any step runs. Inline steps never navigate to that URL. A payment whose charge is still being decided is polled until a step appears or it settles; a decided payment with no step resolves immediately.
	 */
	handleNextAction: (input: { clientSecret: string; returnUrl?: string | undefined; pollIntervalMs?: number | undefined; }) => Promise<{ status: string; redirected: boolean; lastPaymentError: { code?: string | null | undefined; decline_code?: string | null | undefined; message?: string | null | undefined; } | null; }>;
	/**
	 * Low-level Apple Pay, Google Pay, or PayPal sheet for custom buttons, express checkout, and shipping callbacks. Wallet tiles automate this flow through `payments.createConfirmationToken`. Await `canMakePayment()` to check availability and prime the wallet, then call `show(type)` synchronously in the user-interaction handler. The resolved `ctok` is a `ctok_`-prefixed confirmation token. Confirm it server-side like an element-minted token. A PayPal token charges at most the total PayPal showed the buyer.
	 * Mint with `whop.payments.paymentRequest.create(options)` — nothing needs to be mounted.
	 */
	paymentRequest: { create(options: PaymentRequestResourceOptions): PaymentRequestResource };
}

/**
 * Declared from the app's `WalletButtonArt`, referenced by a host-capability surface.
