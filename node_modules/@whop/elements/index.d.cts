import type { FrameworkGlobals, WhopElementsLocale } from "./_framework.js";
import type { PaymentsHandle, PaymentsOptions, PaymentsStatics } from "./payments.js";
import type { VerificationsHandle, VerificationsOptions, VerificationsStatics } from "./verifications.js";
import type { CheckoutHandle, CheckoutOptions, CheckoutStatics } from "./checkout.js";
import type { AdsHandle, AdsOptions, AdsStatics } from "./ads.js";
import type { TrackingHandle, TrackingOptions, TrackingStatics } from "./tracking.js";
import type { WalletHandle, WalletOptions, WalletStatics } from "./wallet.js";
import type { WebsitesHandle, WebsitesOptions, WebsitesStatics } from "./websites.js";
import type { DashboardHandle, DashboardOptions, DashboardStatics } from "./dashboard.js";

/** Global configuration for `WhopElements(config)`, inherited by every namespace handle (`appearance`, `locale`, …). */
export interface WhopGlobalConfig extends FrameworkGlobals {}

/** The configured instance: one accessor per namespace, each carrying `create()` plus that namespace's static actions. */
export interface Whop {
	/**
	 * Collect a payment from a `plan_` ID or inline currency and amount, or save a payment method without charging with `mode: "setup"`. Mount PaymentElement, CardElement, or CardFields, then call `payments.createConfirmationToken` with billing details. Wallet selections open their sheet automatically. When the account offers in-page bank linking (`bank_debit.bank_connection` on its bank account payment method type), a bank account selection opens Plaid Link on the page too. A buyer who closes either one rejects the call with `payment_request_cancelled`, which your pay handler should treat as a cancel. Confirm the token server-side, then pass the payment's or setup intent's `client_secret` to `handleNextAction` for any pending step.
	 */
	payments: { create(options: PaymentsOptions): PaymentsHandle } & PaymentsStatics;
	/**
	 * Collects and verifies identity information for an account. Mount `kyc` for a complete KYC or KYB flow backed by the Verifications API.
	 */
	verifications: { create(options: VerificationsOptions): VerificationsHandle } & VerificationsStatics;
	/**
	 * Drives a full hosted checkout for one or more plans — itemized price summary, promo codes, the currency the buyer pays in, and the whole payment collection surface (the payments elements, composed inside) — against the Whop checkout sessions API. Mount it with `items`, a single `plan`, or a `checkoutConfiguration` you authored and the element opens the checkout session itself; the session credential never leaves the element. A setup-mode checkout configuration mounts the same element as a payment-method save: nothing is charged, the buyer’s method is stored for you to charge later, and the finished checkout redirects with `setup_intent_id`. The buyer pays inside the element, and a finished checkout redirects the current tab to `returnUrl`, including the page that contains the element. Fulfill from webhooks rather than a browser callback. Without a `returnUrl`, the buyer rests on the element’s own success face. The element automatically drives an off-site payment step, such as 3DS or a bank page. On whop.com, it brings the buyer back into the restored checkout; in an embed, the buyer returns to the same `returnUrl` whatever the outcome, with `payment` and `status` query parameters (`succeeded`, `failed`, or `canceled`), so the page at `returnUrl` must read `status` before it treats the visit as a sale. A payment that fails inside the element reopens the same checkout with the reason shown, so the buyer can pay again. Every option is set at creation: the element mints a checkout session from these values when it mounts. Changing one later with `update()` or new React props fails instead of changing the existing order. Mount a new checkout to change what is being purchased.
	 */
	checkout: { create(options: CheckoutOptions): CheckoutHandle } & CheckoutStatics;
	/**
	 * An advertising account. Scope it to a Whop account with `accountId` — the ad account underneath is assigned server-side and never surfaces here — then mount `reporting` for what the account spent and what came back, `campaign-creator` to build a campaign, or `ads-agreement` to sign the Whop Ads agreement a launch requires.
	 */
	ads: { create(options: AdsOptions): AdsHandle } & AdsStatics;
	/**
	 * An account's tracked audience: everyone its pixel has seen, and every event they performed. Scope it to an account with `accountId`, then mount `people`, `events`, or both. They read the same window and the same credit rule, so two surfaces side by side can never disagree about what they are showing. `person` is where a click on either of them leads: one person's whole record, mountable inline or presentable over your page. `links` wires their person links to your own pages.
	 */
	tracking: { create(options: TrackingOptions): TrackingHandle } & TrackingStatics;
	/**
	 * Drives an account's money surfaces. `actions` renders the Deposit, Accept, Send, and Convert controls: Deposit, Send, and Convert open their Wallet overlays, while Accept opens Whop's checkout-link creator for a business account or company creation for a personal account. `deposit` returns live funding rails; `convert` swaps USD with Gold or Bitcoin and exposes FX currencies when the host enables `fxEnabled`; `send` moves money to a recipient or creates a public claim link; `withdraw` lists payout methods and creates the payout when the host does not already drive that API; `balances` holds two faces — the holdings list, and the balance block drawing value over a window; `cards` is the compact issued-card list; `cardsTable` renders the full sortable card roster; `cardsChart` plots card spend; `whopCard` renders one revealable card; `activity` lists ledger movements; `activityDetail` renders a prefetched movement, or retrieves one by activity ID or card transaction ID, in a standalone drawer. The outstanding-action bar and the identity nudge live on the `dashboard` controller. Every data-backed surface can use the viewer's session when no token is provided.
	 */
	wallet: { create(options: WalletOptions): WalletHandle } & WalletStatics;
	/**
	 * An account's websites: every site built on whop.site plus every domain the Whop Pixel reports, with traffic and attributed revenue per domain. Mount `websites` and it lists them with visitors, page views, sales, revenue, trend, and most-viewed pages. Mount `pixel-setup` alongside it and a site whose pixel the wizard just proved live gets a waiting row automatically, because its first events take a few minutes to reach the stats API and the site would otherwise look lost — you wire nothing up for that, and the row is kept on your page so it is still there if the merchant reloads. Reading stats is privileged, so it needs an `accessToken` — except inside Whop's own app, where the viewer's session carries the read.
	 */
	websites: { create(options: WebsitesOptions): WebsitesHandle } & WebsitesStatics;
	/**
	 * An account's own dashboard surfaces, embedded on your site. Scope it to an account with `accountId`, then mount `paymentsTable` for the account's payments, `paymentDetail` for one payment, `required-actions` for the outstanding-action banners Whop's own dashboard shows above the balance — identity verification, deposits, tax, and the rest — and `verification` for the identity-only nudge. Every surface reads with the same credential, so two side by side always show the same account. The banners render nothing once the account has nothing outstanding, so they can sit permanently in a layout, and they report the presses they cannot answer themselves — Add money and Verify — so the host mounts its own deposit or verification flow, such as the `wallet` controller's `deposit` element or the `verifications` controller's `kyc` element.
	 */
	dashboard: { create(options: DashboardOptions): DashboardHandle } & DashboardStatics;
}

/** The global `window.WhopElements`. Call it with the global config to get a `Whop` instance. */
export interface WhopConstructor {
	(config?: WhopGlobalConfig): Whop;
}

/** The hosted SDK bundle `loadWhop()` loads. The URL carries the release train, so it follows this package's major. */
export declare const SDK_URL: string;

/** The promise `loadWhop()` returns: the load itself, plus `retry()`, which starts a fresh load after a failure. While a load is in flight or has succeeded, `retry()` is that same load. */
export type WhopLoad = Promise<WhopConstructor> & { retry(): WhopLoad };

/** Load the hosted SDK: injects the `<script data-whop-elements>` tag once and resolves the global constructor. Safe to call any number of times: one script, one shared promise. A failed load is held, so every later call returns the same rejected promise and nothing retries on its own; call `retry()` on it to load again. */
export declare function loadWhop(): WhopLoad;

/** One `<link>` hint: render it into `<head>`, or send the list as a `Link` header. */
export interface PreloadHint {
	rel: string;
	href: string;
	as?: string;
	crossOrigin?: "anonymous";
}

/** Which connections `preloadHints()` warms beyond the hosted SDK. Unknown keys are ignored. */
export interface PreloadHintsOptions {
	/** Which environment to warm for: the Whop API, and each provider's sandbox hosts in sandbox. Defaults to production. */
	environment?: NonNullable<WhopGlobalConfig["environment"]>;
	/**
	 * Apple Pay, Google Pay, and PayPal: preloads its scripts and warms the connections it opens from your page. Pass false on pages that don't show it.
	 */
	wallets?: boolean;
	/**
	 * Plaid bank account linking: preloads its scripts and warms the connections it opens from your page. Pass false on pages that don't show it.
	 */
	bankConnections?: boolean;
}

/** The hints `preloadHints()` returns: an array of {@link PreloadHint}, plus ways to apply it. `filter`, `slice`, `concat`, `toSorted` and `toReversed` keep these methods; `map` returns a plain array. */
export interface WhopPreloadHints<T extends PreloadHint = PreloadHint> extends Array<T> {
	filter<S extends T>(predicate: (value: T, index: number, array: T[]) => value is S, thisArg?: unknown): WhopPreloadHints<S>;
	filter(predicate: (value: T, index: number, array: T[]) => unknown, thisArg?: unknown): WhopPreloadHints<T>;
	slice(start?: number, end?: number): WhopPreloadHints<T>;
	concat(...items: (T | ConcatArray<T>)[]): WhopPreloadHints<T>;
	toSorted(compareFn?: (a: T, b: T) => number): WhopPreloadHints<T>;
	toReversed(): WhopPreloadHints<T>;
	/** The hints as one `Link` header value (servers and CDNs can turn it into 103 Early Hints). */
	toLinkHeader(): string;
	/** The hints as `<link>` tags, for server-rendered templates. */
	toHtml(): string;
	/** Append the hints to a response's `Link` header. */
	applyTo(headers: Headers): void;
}

/** Resource hints (preconnect/preload) for the hosted SDK, the Whop API, and the scripts and connections elements use on your page. Render them into `<head>` to start the fetch before `loadWhop()` runs. */
export declare function preloadHints(options?: PreloadHintsOptions): WhopPreloadHints;

/** Which origins the policy allows. Unknown keys are ignored. */
export interface ContentSecurityPolicyOptions {
	/** Which environment the policy allows: the Whop API, and each provider's sandbox hosts in sandbox. Defaults to production. */
	environment?: NonNullable<WhopGlobalConfig["environment"]>;
	/**
	 * Apple Pay, Google Pay, and PayPal: allows the origins it reaches from your page. Pass false on pages that don't show it.
	 */
	wallets?: boolean;
	/**
	 * Plaid bank account linking: allows the origins it reaches from your page. Pass false on pages that don't show it.
	 */
	bankConnections?: boolean;
}

/** The Content Security Policy sources elements need on your page. Merge them into your own policy; on their own they block everything else your page loads. */
export interface WhopContentSecurityPolicy {
	/** The sources elements need, by directive. */
	readonly directives: { readonly "frame-src": readonly string[]; readonly "script-src": readonly string[]; readonly "connect-src": readonly string[]; readonly "img-src": readonly string[] };
	/** Only the sources elements need, as a policy string, leaving out a directive with none. Merge it into your own policy; used alone it blocks everything else. */
	toString(): string;
	/** Your policy with these sources added. A directive you don't set is left alone, except that one falling back to `default-src` starts from those values. */
	merge(policy: string): string;
	/** Your directives object, in helmet's shape, with these sources added. It assumes helmet's defaults (`useDefaults: true`), which fill every directive you leave out, so these directives are always written, starting from your value, else what helmet would send: `'self'` for `script-src`, `'self' data:` for `img-src`, and your `child-src` or `default-src` (else `'self'`) for the others. Other keys are returned as they were. */
	merge<T extends Record<string, unknown>>(directives: T): T;
	/** Merge these sources into the response's `Content-Security-Policy` (and `Content-Security-Policy-Report-Only`) headers. Does nothing to a response that sets neither. */
	applyTo(headers: Headers): void;
	/** Your policy, merged, as a `<meta http-equiv>` tag. A meta tag works only when it is your page's whole policy: the browser also enforces any header policy on top of it. */
	toHtml(policy: string): string;
}

/** The Content Security Policy sources elements need on your page: the hosted frames and SDK, the Whop API, and the origins elements reach from your page. The scripts elements load for Apple Pay, Google Pay, and PayPal and Plaid bank account linking come from other companies and can load resources beyond these: check each provider's Content Security Policy guidance. A modal element dims the page behind it with an inline style, which a `style-src` without inline styles leaves out; the modal still works. */
export declare function contentSecurityPolicy(options?: ContentSecurityPolicyOptions): WhopContentSecurityPolicy;

/** The locales this app's elements are built with, the default locale first: exactly the values `locale` accepts. `includes()` accepts any string and narrows it to `WhopElementsLocale`, so use it to validate dynamic values; anything unlisted falls back to the default locale. */
export declare const WHOP_ELEMENTS_LOCALES: readonly WhopElementsLocale[] & {
	includes(value: string, fromIndex?: number): value is WhopElementsLocale;
};

export type { WhopElementsLocale };

export type { Appearance, Theme, AccentColor, Classes, Variables, CSSProps, CSSValue, FrameworkGlobals } from "./_framework.js";
