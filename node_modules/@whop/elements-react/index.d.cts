import type { ReactNode } from "react";
import type { Whop, WhopConstructor, WhopGlobalConfig } from "@whop/elements";

/** Props for `<WhopElements>`: the SDK (or its loader promise) plus the global config every namespace inherits (appearance, locale, …). */
export interface WhopElementsProps extends WhopGlobalConfig {
	/** The subtree that can use Whop Elements. Every component and hook must render below this provider. */
	children: ReactNode;
	/** The loaded constructor, or a promise of it (e.g. `loadWhop()` from the vanilla package). `null` defers initialization; `undefined` throws. */
	elements: WhopConstructor | Promise<WhopConstructor | null> | null;
	/** Called when the SDK fails to load. With it set the provider does not throw: the subtree stays mounted with its elements still loading, and `retry()` starts a fresh load in place — from a button, or your own backoff. Without it the error reaches the nearest error boundary. */
	onLoadError?: (error: Error, retry: () => void) => void;
}

/** The app-level provider: put it once above everything that uses Whop Elements and hand it the SDK via `elements={loadWhop()}`. */
export declare function WhopElements(props: WhopElementsProps): ReactNode;

/** The resolved `Whop` instance, or `null` while the loader promise is still pending. Throws if used outside `<WhopElements>`. */
export declare function useWhop(): Whop | null;

/** Re-exported from the vanilla peer: the app's built locale set (default locale first) and its literal-union type. `includes()` narrows dynamic strings to `WhopElementsLocale`. */
export { WHOP_ELEMENTS_LOCALES } from "@whop/elements";
export type { WhopElementsLocale } from "@whop/elements";
export type { Appearance, Theme, AccentColor, Classes, Variables, CSSProps, CSSValue } from "@whop/elements";

