type ElementProps<Options, Handle> = Options & {
	/** The element's live handle (same surface as the vanilla `create` return). */
	ref?: Ref<Handle>;
	/** Applied to the element's mount container (the wrapper this component renders; the element itself lives in its own frame, see the Styling docs for restyling it). */
	className?: string;
	/** Applied to the element's mount container (the wrapper this component renders). */
	style?: CSSProperties;
	/** Shown until the element is fully loaded. When omitted, the element's own internal loading UI is shown instead. */
	fallback?: ReactNode;
};

/**
 * Drives a full hosted checkout for one or more plans — itemized price summary, promo codes, the currency the buyer pays in, and the whole payment collection surface (the payments elements, composed inside) — against the Whop checkout sessions API. Mount it with `items`, a single `plan`, or a `checkoutConfiguration` you authored and the element opens the checkout session itself; the session credential never leaves the element. A setup-mode checkout configuration mounts the same element as a payment-method save: nothing is charged, the buyer’s method is stored for you to charge later, and the finished checkout redirects with `setup_intent_id`. The buyer pays inside the element, and a finished checkout redirects the current tab to `returnUrl`, including the page that contains the element. Fulfill from webhooks rather than a browser callback. Without a `returnUrl`, the buyer rests on the element’s own success face. The element automatically drives an off-site payment step, such as 3DS or a bank page. On whop.com, it brings the buyer back into the restored checkout; in an embed, the buyer returns to the same `returnUrl` whatever the outcome, with `payment` and `status` query parameters (`succeeded`, `failed`, or `canceled`), so the page at `returnUrl` must read `status` before it treats the visit as a sale. A payment that fails inside the element reopens the same checkout with the reason shown, so the buyer can pay again. Every option is set at creation: the element mints a checkout session from these values when it mounts. Changing one later with `update()` or new React props fails instead of changing the existing order. Mount a new checkout to change what is being purchased.
 * Provider component: creates the CheckoutHandle and drives the element components rendered as children. `fallback` shows until every child element has loaded (grouped); `ref` exposes the live handle. Unmounting it destroys the handle and everything it created.
 * @example
 * ```tsx
 * import { WhopElements, Checkout, CheckoutElement, ExpressCheckoutElement } from "@whop/elements-react";
 * import { loadWhop } from "@whop/elements";
 * 
 * function Example() {
 *   return (
 *     <WhopElements elements={loadWhop()}>
 *       <Checkout>
 *         <CheckoutElement />
 *         <ExpressCheckoutElement />
 *       </Checkout>
 *     </WhopElements>
 *   );
 * }
 * ```
 * @see https://docs.whop.com/elements/latest/checkout/overview
 */
export declare function Checkout(
	props: CheckoutOptions & { children?: ReactNode; fallback?: ReactNode; ref?: Ref<{ handle: CheckoutHandle | null }> },
): ReactNode;
/**
 * The nearest `<Checkout>` ancestor's live handle, `null` until it boots. Must be called under a `<Checkout>`.
 * @see https://docs.whop.com/elements/latest/checkout/overview
 */
export declare function useCheckout(): CheckoutHandle | null;

/**
 * The full checkout surface — order summary with the live quote, promo code entry, the currency the buyer pays in, everything this checkout has to collect from the buyer, the composed payment methods surface, and the pay flow. What it collects is whatever the seller set up (email, their own questions, a phone number, a shipping address for physical goods, an explicit agreement to their terms), rendered together on one screen in the order they chose — so a seller who starts asking for something new needs no change here. Renders the whole purchase; the checkout controller owns the session and the credential. After a payment that needs an off-site step, this same surface renders the outcome the server reports when the buyer comes back.
 * @example
 * ```tsx
 * import { WhopElements, Checkout, CheckoutElement } from "@whop/elements-react";
 * import { loadWhop } from "@whop/elements";
 * 
 * function Example() {
 *   return (
 *     <WhopElements elements={loadWhop()}>
 *       <Checkout>
 *         <CheckoutElement />
 *       </Checkout>
 *     </WhopElements>
 *   );
 * }
 * ```
 * @see https://docs.whop.com/elements/latest/checkout/checkout
 */
export declare function CheckoutElement(props: ElementProps<CheckoutElementCreateOptions, CheckoutElementHandle>): ReactNode;
/**
 * One-press Apple Pay, Google Pay and PayPal buttons for a checkout — the wallet collects whatever the session still needs (the buyer's email, a shipping address for physical goods, a phone number where the seller collects one in Apple Pay and Google Pay, and in Apple Pay a promo code where the seller offers entry) and one press finishes the purchase. It shares the checkout's entry slot with the full checkout element, so a handle mounts exactly one of the two: this button alone where the purchase is simple enough for a sheet to finish, or the full checkout surface for everything else. Renders only the wallets the buyer's device can actually pay with — and the checkout's own payment method configuration allows — using the served button art, and renders nothing where no wallet is available. PayPal appears where the seller accepts it, opens in its own window, and saves the buyer's PayPal account with the purchase, so a renewal, a free trial and later charges the seller makes work like a saved card. All three wallets require the page's domain to be a verified payment method domain: first-party whop.com pages are pre-approved, and any other site must register its domain through the Payment Method Domains API before any of these buttons renders there. Offering Google Pay on your own site is subject to the Google Pay API Terms of Service. A checkout the sheet cannot honestly finish — a waitlist join, a transfer, a form question only a page can ask — refuses loudly instead of rendering a doomed button.
 * @example
 * ```tsx
 * import { WhopElements, Checkout, ExpressCheckoutElement } from "@whop/elements-react";
 * import { loadWhop } from "@whop/elements";
 * 
 * function Example() {
 *   return (
 *     <WhopElements elements={loadWhop()}>
 *       <Checkout>
 *         <ExpressCheckoutElement />
 *       </Checkout>
 *     </WhopElements>
 *   );
 * }
 * ```
 * @see https://docs.whop.com/elements/latest/checkout/expressCheckout
 */
export declare function ExpressCheckoutElement(props: ElementProps<ExpressCheckoutElementCreateOptions, ExpressCheckoutElementHandle>): ReactNode;
