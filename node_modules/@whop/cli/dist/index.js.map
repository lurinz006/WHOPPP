														"type": "string"
													},
													"alternative_document_label": {
														"description": "A document that answers this item in place of `value`, such as an IRS EIN letter when the EIN could not be matched. Send its pages in `files`, with or without a corrected `value`. Absent when only `value` is accepted.",
														"example": "IRS EIN letter (CP 575 or 147C) that shows your business's legal name and your EIN on the same letter",
														"type": "string"
													},
													"details_label": {
														"description": "Follow-up prompt shown with this requirement.",
														"type": "string"
													},
													"details_required": {
														"description": "Whether the follow-up response is required when visible.",
														"type": "boolean"
													},
