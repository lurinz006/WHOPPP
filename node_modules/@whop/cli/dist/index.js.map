			"post": {
				"description": "Creates a draft invoice backed by a receipt, with saved items, quantities, prices, and recipients. Issue the draft to resolve final tax and open the invoice. The pay_ ID stays the same when paid.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"additionalProperties": false,
								"properties": {
									"account_id": {
										"description": "The issuing account.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"billing_address": {
										"additionalProperties": false,
										"description": "Create a billing address linked to this member.",
										"properties": {
											"city": {
												"example": "New York",
												"type": "string"
											},
											"country": {
												"description": "ISO 3166-1 alpha-2 country code.",
												"example": "US",
												"type": "string"
											},
											"line1": {
												"example": "123 Main St",
												"type": "string"
											},
											"line2": {
												"type": ["string", "null"]
											},
											"name": {
												"type": ["string", "null"]
											},
											"phone": {
												"type": ["string", "null"]
											},
											"postal_code": {
												"example": "10001",
												"type": "string"
											},
											"state": {
												"example": "NY",
												"type": ["string", "null"]
											}
										},
										"required": ["line1", "city", "postal_code", "country"],
										"type": ["object", "null"]
									},
									"buyer_fee_percentage": {
										"description": "The buyer's adjustable fee in percentage points, with at most two decimal places.",
										"example": 2.5,
										"maximum": 100,
										"minimum": 0,
										"type": "number"
									},
									"customer_name": {
										"description": "The contact name when creating an email-only member.",
										"type": ["string", "null"]
									},
									"due_at": {
										"description": "When payment is due, as an ISO 8601 timestamp.",
										"format": "date-time",
										"type": ["string", "null"]
									},
									"email_address": {
