								"$ref": "#/components/schemas/File"
							},
							{
								"type": "null"
							}
						]
					},
					"three_ds_level": {
						"description": "3D Secure behavior for supported on-session card payments. `mandate_challenge` requires a 3DS challenge before payment processing; `mandate_if_required` mandates a challenge only when the payment processor requires it; `frictionless_if_required` uses the regular frictionless 3DS flow. Payments of $1,000 or more use `mandate_if_required` unless `mandate_challenge` is selected. Risk and authentication recovery requirements can override the preference. `null` uses the standard checkout flow.",
						"enum": [
							"mandate_challenge",
							"mandate_if_required",
							"frictionless_if_required",
							null
						],
						"example": "mandate_challenge",
						"type": ["string", "null"]
					},
