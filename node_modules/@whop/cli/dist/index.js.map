											"example": "+15551234567",
											"type": ["string", "null"]
										},
										"registration_number": {
											"description": "Number the business was registered under in its place of incorporation, such as a state file number in the US or a Company Number in the UK. Business verifications only; `null` until the business verification is approved.",
											"example": "7654321",
											"type": ["string", "null"]
										},
										"requested_information": {
											"description": "What Whop still needs before review can continue — one requirement per entry. Answer with Update Verification; nothing from the response is echoed back. Keys that don't apply are omitted.",
											"items": {
												"properties": {
