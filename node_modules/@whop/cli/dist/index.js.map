							"type": "integer"
						}
					},
					{
						"description": "People metric only: known equals this value. Applies to the current person profile for every time bucket. LTV and AOV are in USD. Not accepted by the Events metric.",
						"in": "query",
						"name": "known",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "People metric only: has_email equals this value. Applies to the current person profile for every time bucket. LTV and AOV are in USD. Not accepted by the Events metric.",
						"in": "query",
						"name": "has_email",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
