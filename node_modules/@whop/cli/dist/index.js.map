						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"$ref": "#/components/schemas/AppInstallation"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												}
											},
											"required": [
												"end_cursor",
												"start_cursor",
												"has_next_page",
												"has_previous_page"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "app installations listed"
