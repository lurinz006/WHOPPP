			"post": {
				"description": "Issues a virtual card, or applies for card issuing. An account with no application files one here and gets back a `202`; call again to issue the card once it is approved. An account whose application was denied or canceled applies again the same way, replacing that application.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "The owning account ID (a biz_ identifier). Provide this or user_id.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"assigned_user_id": {
										"description": "The account member (a user_ identifier) to assign the card to. Required for business card issuing accounts. When this call files the card application, the member applies with their identity; a company API key that sends neither this nor kind is refused.",
										"example": "user_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"billing": {
										"description": "The card's initial billing address. On a company card it also registers the assigned member as a cardholder if they are not one yet. For an individual card, region is also required.",
										"properties": {
											"city": {
												"description": "Billing city.",
												"example": "Austin",
												"type": "string"
											},
											"country_code": {
												"description": "Billing country code, ISO 3166-1 alpha-2.",
												"example": "US",
												"type": "string"
											},
											"line1": {
												"description": "Street address line 1.",
												"example": "4180 Burnet Rd",
												"type": "string"
											},
											"line2": {
												"description": "Street address line 2.",
												"example": "Suite 210",
												"type": "string"
											},
