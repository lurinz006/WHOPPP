		"/payments/{id}/generate_pdf": {
			"post": {
				"description": "Generates the payment's receipt (invoice) as a PDF and returns a short-lived link to download it. Each call generates a new file and link, so this endpoint does not replay `Idempotency-Key` responses.",
				"operationId": "generate_pdf",
