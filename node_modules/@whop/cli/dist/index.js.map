										"ads_reporting_currency": {
											"description": "Lowercase ISO currency code, such as `usd` or `eur`, used to display ad spend and stats. Defaults to `usd`.",
											"example": "usd",
											"type": "string"
										},
										"ads_scheduling_timezone": {
											"description": "IANA timezone (e.g. `America/New_York`) used to interpret campaign start/end times and to bucket reports. Defaults to `America/New_York` until explicitly overridden.",
											"example": "America/New_York",
											"type": "string"
										},
										"ads_triple_whale_integration": {
											"description": "The account's Triple Whale integration, which pushes Whop ad spend to Triple Whale's Data-In API so it reports as a `whop` channel. Available to any Triple Whale customer — Shopify, WooCommerce, or a custom checkout — by setting `shop_domain`. Requires the `ad_campaign:create` scope. Once connected, ad click-through URLs Whop serves carry `tw_source=whop` and `tw_adid=<ad id>` query parameters so Triple Whale's pixel attributes conversions back to the originating ad — no destination URL changes are needed.",
											"properties": {
												"masked_api_key": {
													"description": "The leading characters of the stored Data-In API key, followed by asterisks. The full key is never returned. `null` when no key is stored.",
													"example": "tw_live_********",
													"type": ["string", "null"]
												},
												"shop_domain": {
													"description": "The shop domain spend is reported for, such as `acme.myshopify.com` or a custom domain for a non-Shopify store. `null` when none is set.",
													"example": "shinetime.myshopify.com",
													"type": ["string", "null"]
												},
												"status": {
													"description": "Where the integration stands. `requires_shop_domain` means no shop domain is configured — set `shop_domain` before spend can be reported.",
													"enum": [
														"connected",
														"not_connected",
														"requires_shop_domain"
													],
													"example": "requires_shop_domain",
													"type": "string"
												}
											},
											"required": ["status", "masked_api_key", "shop_domain"],
											"type": "object"
										},
										"cards_auto_top_up": {
											"description": "Whether incoming funds are automatically moved to the account's cards balance. `false` when the account has no cards balance.",
											"example": false,
											"type": "boolean"
										},
										"cards_notifications": {
											"description": "Whether Whop Card notifications reach this account's team. `true` by default, including when the account has no cards balance. Set it to `false` to stop every card email and push notification for the account — application status, verification and action-required alerts, card-ready alerts, declines, large charges, and cashback summaries. Cardholder onboarding invitations still send, because they carry the only link an invited cardholder can onboard with. Requesting a card is rejected while notifications are off, since the request reaches nobody. Cards on personal accounts are unaffected.",
											"example": true,
											"type": "boolean"
										},
										"covers_connected_account_negative_balances": {
											"description": "Whether this account covers its connected accounts' negative balances. When a connected account's balance drops below zero (from refunds, disputes, or fees), this account's available balance in the same currency pays it back, up to what is available. Refunds on its connected accounts may also take them negative by up to this account's available balance. `null` when the account has no connected accounts.",
											"example": true,
											"type": ["boolean", "null"]
										},
										"customer_tracking": {
											"description": "The saved customer tracking settings for the hosted tracking page and Element, exactly as saved. `null` until set; tracking is off unless `enabled` is `true`.",
											"oneOf": [
												{
													"$ref": "#/components/schemas/CustomerTrackingPreferences"
												},
												{
													"example": null,
													"type": "null"
												}
											]
										},
										"dispute_fighter_enabled": {
											"description": "Whether Whop assembles and files the evidence response when this account's payments are disputed. Off by default; enabling it also opts the account into the success fee charged only on disputes it wins.",
											"example": false,
											"type": "boolean"
										},
										"economic_intelligence": {
											"description": "Whether Economic Intelligence is on for the account. It turns off automatically at `economic_intelligence_ends_at`.",
											"example": false,
											"type": "boolean"
										},
										"economic_intelligence_auto_renew": {
											"description": "Whether Economic Intelligence renews itself every week, with no end date. Turn it on with the `weekly` offer. Set it to `false` to stop renewing, which keeps Economic Intelligence on until the end of the current week, shown in `economic_intelligence_ends_at`; stopping before the first renewal charges the rest of that week at the `7_days` offer's fee. Set it back to `true` before then to keep renewing at the weekly fee.",
											"example": false,
											"type": "boolean"
										},
										"economic_intelligence_ends_at": {
											"description": "When the account's committed Economic Intelligence period ends, as an ISO 8601 timestamp. Economic Intelligence can't be turned off before then. `null` when Economic Intelligence is off or renews automatically.",
											"example": "2026-01-01T12:00:00.000Z",
											"type": ["string", "null"]
										},
										"economic_intelligence_fee_percentage": {
											"description": "Percentage of volume charged while Economic Intelligence is on, such as `1.5` for 1.5%. `null` when Economic Intelligence is off.",
											"example": 1.5,
											"type": ["number", "null"]
										},
										"economic_intelligence_first_renewal_at": {
											"description": "When auto-renew first renews, as an ISO 8601 timestamp. Turning auto-renew off before then charges the rest of that week at the `7_days` offer's fee. `null` when auto-renew is off.",
											"example": null,
											"type": ["string", "null"]
										},
										"economic_intelligence_offers": {
											"description": "What the account can choose now to turn on Economic Intelligence, each with its fee. Every offer while Economic Intelligence is off; only the `weekly` auto-renew offer while a committed period is running, as an upgrade; empty while it renews automatically.",
											"items": {
												"properties": {
													"auto_renew": {
														"description": "Whether this offer renews every period until auto-renew is turned off, rather than ending after one.",
														"example": true,
														"type": "boolean"
													},
													"duration": {
														"description": "What period of time Economic Intelligence stays on. For an auto-renew offer, the length of each period it renews for.",
														"example": 7,
														"type": "integer"
													},
													"duration_unit": {
														"description": "The unit of time the duration is in (hours or days)",
														"enum": ["hours", "days"],
														"example": "days",
														"type": "string"
													},
													"fee_percentage": {
														"description": "Percentage of volume charged while Economic Intelligence is on, such as `1.5` for 1.5%.",
														"example": 1,
														"type": "number"
													},
													"key": {
														"description": "The unique identifier for this offer. Pass this value as `economic_intelligence_duration_key` to turn it on.",
														"enum": ["weekly", "7_days", "1_day", "1_hour"],
														"example": "weekly",
														"type": "string"
													},
													"recommended": {
														"description": "Whether Whop recommends this offer. At most one offer is recommended.",
														"example": true,
														"type": "boolean"
													}
												},
												"required": [
													"key",
													"duration",
													"duration_unit",
													"fee_percentage",
													"auto_renew",
													"recommended"
												],
												"type": "object"
											},
											"type": "array"
										},
										"economic_intelligence_previous_period": {
											"description": "The account's last Economic Intelligence period, once it has ended. `null` while Economic Intelligence is on, or when it has never been on.",
											"properties": {
												"ended_at": {
													"description": "When the period ended, as an ISO 8601 timestamp.",
													"type": "string"
												},
												"fee_percentage": {
													"description": "Percentage of volume charged during the period, such as `3` for 3%.",
													"type": "number"
												}
											},
											"required": ["ended_at", "fee_percentage"],
											"type": ["object", "null"]
										},
										"feedback_options": {
											"description": "The account's own cancel reasons, in the order members see them when they cancel. Each is filed under a standard category, saved as the membership's `cancel_option`, so reports keep grouping cancellations. Empty when the account uses Whop's default reasons.",
											"items": {
												"properties": {
													"category": {
														"description": "The category saved as the membership's `cancel_option` when a member picks this option.",
														"enum": [
															"too_expensive",
															"switching",
															"missing_features",
															"technical_issues",
															"bad_experience",
															"unused",
															"other"
														],
														"example": "bad_experience",
														"type": "string"
													},
													"id": {
														"description": "Feedback option ID, prefixed `fo_`. Pass it as `feedback_option_id` when canceling a membership, or back in `feedback_options` to keep the option when changing the list.",
														"example": "fo_xxxxxxxxxxxxxx",
														"type": "string"
													},
													"label": {
														"description": "The cancel reason as members see it. Up to 100 characters.",
														"example": "The detail missed spots",
														"type": "string"
													}
												},
												"required": ["id", "label", "category"],
												"type": "object"
											},
											"type": "array"
										},
										"preferred_settlement_currency": {
											"description": "Lowercase ISO currency code every new sale settles into, regardless of the plan's currency or what the buyer paid in. Sales converted this way carry an additional 0.5% FX fee. `null` when the account settles each sale in its plan's currency.",
											"enum": ["usd", "eur", "gbp", "cad", "aud", null],
											"example": "eur",
											"type": ["string", "null"]
										},
										"preferred_settlement_currency_changeable_at": {
											"description": "When `preferred_settlement_currency` may next be changed or turned off, as an ISO 8601 timestamp. It can change at most once a day. `null` when it may change now.",
											"example": "2026-01-01T12:00:00.000Z",
											"type": ["string", "null"]
										},
										"subscription_failure_behavior": {
											"description": "What happens to a subscription once every retry of a renewal payment has failed. `cancel` (the default) cancels it. `none` leaves it past due and keeps billing it each period; access follows the account's past-due access setting.",
											"enum": ["cancel", "none"],
											"example": "cancel",
											"type": "string"
										}
									},
									"required": [
										"ads_payment_methods",
										"ads_reporting_currency",
										"ads_scheduling_timezone",
										"ads_agreement",
										"ads_certifications",
										"ads_triple_whale_integration",
										"cards_auto_top_up",
										"cards_notifications",
										"covers_connected_account_negative_balances",
										"dispute_fighter_enabled",
										"feedback_options",
										"economic_intelligence",
										"economic_intelligence_auto_renew",
										"economic_intelligence_ends_at",
										"economic_intelligence_fee_percentage",
										"economic_intelligence_first_renewal_at",
										"economic_intelligence_offers",
										"economic_intelligence_previous_period",
										"preferred_settlement_currency",
										"preferred_settlement_currency_changeable_at",
										"subscription_failure_behavior",
										"customer_tracking"
									],
									"type": "object"
								}
							}
						},
