						"description": "People metric only: last_seen_at within this many days of now. Applies to the current person profile for every time bucket. LTV and AOV are in USD. Not accepted by the Events metric.",
						"in": "query",
						"name": "last_seen_within_days",
						"required": false,
						"schema": {
