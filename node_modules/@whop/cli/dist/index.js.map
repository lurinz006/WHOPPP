								"2": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"3": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"4": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"5": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"6": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"7": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"8": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"9": {
									"$ref": "#/components/schemas/FunnelStep"
								},
								"10": {
									"$ref": "#/components/schemas/FunnelStep"
								}
							},
							"required": ["1", "2"],
							"type": "object"
						},
						"style": "deepObject"
					},
					{
						"description": "Funnel only. The breakdown value to use as baseline for whole-window final conversion. Requires breakdown_by and mature_only=true; defaults confidence_level to 0.95.",
						"in": "query",
						"name": "compare_to",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Funnel only. Confidence level for whole-window final conversion intervals, for example 0.95. Requires mature_only=true. Exposure steps must each filter one user-randomized experiment.",
						"in": "query",
						"name": "confidence_level",
						"required": false,
						"schema": {
							"exclusiveMaximum": 1,
							"exclusiveMinimum": 0,
							"type": "number"
						}
					},
					{
						"description": "People metric only: contactable equals this value. Applies to the current person profile for every time bucket. LTV and AOV are in USD. Not accepted by the Events metric.",
						"in": "query",
						"name": "contactable",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "People metric only: has_purchased equals this value. Applies to the current person profile for every time bucket. LTV and AOV are in USD. Not accepted by the Events metric.",
						"in": "query",
						"name": "has_purchased",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "People metric only: first_seen_at greater than or equal this value. Applies to the current person profile for every time bucket. LTV and AOV are in USD. Not accepted by the Events metric.",
						"in": "query",
						"name": "first_seen_after",
						"required": false,
