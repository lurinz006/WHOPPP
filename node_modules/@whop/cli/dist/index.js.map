						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "The field to sort alerts by.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"default": "created_at",
							"enum": ["created_at", "reported_at", "amount"],
							"type": "string"
						}
					},
					{
						"description": "Sort direction.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"default": "desc",
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Only alerts Whop received before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only alerts Whop received after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
