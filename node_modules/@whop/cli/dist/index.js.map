																"enum": [
																	"any",
																	"none",
																	"eq",
																	"neq",
																	"gt",
																	"gte",
																	"lt",
																	"lte"
																],
																"example": "any",
																"type": "string"
															},
															"type": {
																"description": "`user_id` — match on subject user ID; `account_id` — match on account ID (prefixed `biz_`); `property` — match on a named user property (requires `field`).",
																"enum": ["user_id", "account_id", "property"],
																"example": "user_id",
																"type": "string"
															},
															"value": {
																"description": "Value or list of values to match against. Pass an array for `any`/`none`, a scalar for the others."
															}
														},
														"required": ["type", "operator", "value"],
														"type": "object"
													},
													"type": "array"
												},
												"type": {
													"description": "`include` — users matching this rule qualify; `exclude` — users matching this rule are always excluded, overriding any include rule. Defaults to `include`.",
													"enum": ["include", "exclude"],
													"example": "include",
													"type": "string"
												}
											},
											"required": ["conditions"],
											"type": "object"
										},
										"type": "array"
									},
									"variants": {
										"description": "Grow treatment allocation. Pass every existing treatment with an equal-or-higher weight; append new names to add arms. Weights never decrease and arms are never removed. Omit to leave unchanged.",
										"items": {
											"properties": {
												"name": {
													"description": "Treatment name. Pass every existing treatment (weights equal or higher); append new names to add arms. `control` is reserved.",
													"example": "treatment",
													"type": "string"
												},
												"related_resource": {
													"$ref": "#/components/schemas/ExperimentResourceReference",
													"nullable": true
												},
												"weight": {
													"description": "Percentage assigned to treatment; allocation may only grow.",
													"example": 80,
													"type": "integer"
												}
											},
											"required": ["name"],
											"type": "object"
										},
										"type": "array"
									}
								},
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
