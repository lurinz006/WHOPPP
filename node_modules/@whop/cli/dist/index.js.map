						"description": "Customer-visible variant description. Maximum 1000 characters. `null` if no description is set.",
						"example": "Two hand washes a month, interior vacuum, and a quarterly sealant top-up.",
						"type": ["string", "null"]
					},
					"expiration_days": {
						"description": "Access duration in days for expiration-based variants, such as 365 for a one-year pass. `null` for variants without an expiration.",
						"example": 365,
						"type": ["number", "null"]
					},
					"formatted_price": {
						"description": "Human-readable price for display (currency + interval) in `currency`, e.g. \"$10 / month\".",
						"example": "$59.00 / month",
						"type": "string"
					},
					"id": {
						"description": "Variant ID, prefixed `plan_`.",
						"example": "plan_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"image": {
						"description": "Pricing-tier image (`url`, `blurhash`) shown on the product page; `null` when no image is set.",
						"example": {
							"blurhash": "LA6bDXT$E3b:R6i+RibEIWbp%ej1",
							"url": "https://whop-assets-example.s3.amazonaws.com/uploads/image/2026-01-01/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
						},
						"type": ["object", "null"]
					},
					"initial_price": {
						"description": "Initial purchase price, in `currency`.",
						"example": 0,
						"type": "number"
					},
					"initial_price_due": {
						"$ref": "#/components/schemas/Money",
						"description": "Total charged at checkout for one unit, before promo codes and tax: `initial_price` plus the first `renewal_price` for recurring variants, or `initial_price` alone while a free trial applies. The trial does not apply when the viewing user has already used one for this variant. Stated in `currency`."
					},
					"internal_notes": {
						"description": "Private notes not shown to customers. `null` unless the actor has the `plan:basic:read` scope on the variant's account.",
						"example": "Maintenance tier. Upsell the interior shampoo add-on at renewal.",
						"type": ["string", "null"]
					},
					"invoice": {
						"description": "Invoice this variant was generated for; `null` unless created for an invoice.",
						"example": {
							"id": "inv_xxxxxxxxxxxxxx"
						},
						"type": ["object", "null"]
					},
					"member_count": {
						"description": "Active memberships through this variant. `null` unless the actor has the `plan:basic:read` scope on the variant's account.",
						"example": 0,
						"type": ["number", "null"]
					},
					"metadata": {
						"description": "Custom key-value pairs stored on the variant. Included in webhook payloads for payment and membership events. Maximum 50 keys, 100 characters per key, 500 characters per value. The reserved keys `custom_cta` and `custom_cta_url`, when set, override the product's checkout call to action for this variant.",
						"example": {
							"custom_cta": "subscribe",
							"custom_cta_url": "https://shinetime.example/wash-club"
						},
						"type": ["object", "null"]
					},
					"offer_cancel_discount": {
						"description": "Whether a cancellation discount is offered. `null` unless the actor has the `plan:basic:read` scope on the variant's account.",
						"example": true,
						"type": ["boolean", "null"]
					},
					"payment_method_configuration": {
						"description": "Payment method configuration (`enabled`, `disabled`, `include_platform_defaults`); `null` when variant uses default settings.",
						"example": {
							"disabled": ["crypto"],
							"enabled": ["card"],
							"include_platform_defaults": true
						},
						"type": ["object", "null"]
					},
					"plan_type": {
						"description": "Billing model for this variant.",
						"enum": ["renewal", "one_time"],
						"example": "renewal",
						"type": "string"
					},
					"product": {
						"description": "Product this variant belongs to; `null` for standalone variants.",
						"example": {
							"id": "prod_xxxxxxxxxxxxxx",
							"title": "Ceramic Coating Package"
						},
						"type": ["object", "null"]
					},
					"purchase_url": {
						"description": "URL where customers can purchase this variant directly.",
						"example": "https://whop.com/checkout/plan_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"release_method": {
						"description": "Sales method for this variant.",
						"enum": ["buy_now", "waitlist"],
						"example": "buy_now",
						"type": "string"
					},
					"renewal_price": {
						"description": "Recurring price charged every billing period, in `currency`.",
						"example": 59,
						"type": "number"
					},
					"sku": {
						"description": "Stock keeping unit, free text set by the seller (e.g. `TSHIRT-LARGE-BLUE`). Not enforced unique. `null` when unset.",
						"example": "CERAMIC-COATING-S-BLUE",
						"type": ["string", "null"]
					},
					"split_pay_required_payments": {
						"description": "Installment payments required before the subscription pauses. Must be greater than 1. `null` if split pay is not configured.",
						"example": 4,
						"type": ["number", "null"]
					},
					"stock": {
						"description": "Units available for purchase. `null` unless the actor has the `plan:basic:read` scope on the variant's account.",
						"example": 0,
						"type": ["number", "null"]
					},
					"strike_through_initial_price": {
						"description": "Original initial price shown with a strikethrough, in `currency`. `null` when no strikethrough is set.",
						"example": 99,
						"type": ["number", "null"]
					},
					"strike_through_renewal_price": {
						"description": "Original renewal price shown with a strikethrough, in `currency`. `null` when no strikethrough is set.",
						"example": 79,
						"type": ["number", "null"]
					},
					"three_ds_level": {
						"description": "3D Secure behavior for supported on-session card payments. `mandate_challenge` requires a 3DS challenge before payment processing; `mandate_if_required` mandates a challenge only when the payment processor requires it; `frictionless_if_required` uses the regular frictionless 3DS flow. Payments of $1,000 or more use `mandate_if_required` unless `mandate_challenge` is selected. Risk and authentication recovery requirements can override the preference. `null` inherits the account default.",
						"enum": [
							"mandate_challenge",
							"mandate_if_required",
							"frictionless_if_required",
							null
						],
						"example": "frictionless_if_required",
						"type": ["string", "null"]
					},
					"title": {
						"description": "Variant display name shown to customers. Maximum 30 characters. A variant created without one defaults to its attribute values joined with ` / `. `null` if no title has been set.",
						"example": "Unlimited Wash Club",
						"type": ["string", "null"]
					},
					"trial_period_days": {
						"description": "Free trial days before the first renewal charge. `null` if no trial is configured or the user has already used a trial for this variant.",
						"example": 7,
						"type": ["number", "null"]
					},
					"unlimited_stock": {
						"description": "Whether the variant has unlimited stock. When `true`, the `stock` field is ignored; waitlist variants always report `true`.",
						"example": false,
						"type": "boolean"
					},
					"updated_at": {
						"description": "When the variant was last updated, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"visibility": {
						"description": "Controls where this variant can be seen. When `hidden`, the variant is reachable only by its direct link.",
						"enum": ["visible", "hidden", "archived", "quick_link"],
						"example": "visible",
						"type": "string"
					}
				},
				"required": [
					"id",
					"created_at",
					"updated_at",
					"visibility",
					"plan_type",
					"release_method",
					"currency",
					"account",
					"product",
					"invoice",
					"billing_period",
					"title",
					"description",
					"purchase_url",
					"expiration_days",
					"initial_price",
					"renewal_price",
					"initial_price_due",
					"formatted_price",
					"trial_period_days",
					"three_ds_level",
					"member_count",
					"internal_notes",
					"metadata",
					"sku",
					"attributes",
					"stock",
					"unlimited_stock",
					"split_pay_required_payments",
					"adaptive_pricing_enabled",
					"strike_through_initial_price",
					"strike_through_renewal_price",
					"checkout_styling",
					"offer_cancel_discount",
					"cancel_discount_percentage",
					"cancel_discount_intervals",
					"payment_method_configuration",
					"image",
					"custom_fields"
				],
				"type": "object"
			},
			"WaitlistEntry": {
				"properties": {
					"account_id": {
						"description": "The seller account, prefixed `biz_`.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"approval_failure_reason": {
						"description": "Why the last approval attempt failed, or `null` when none has. `plan_unavailable` — the variant, product, or seller account was deleted. `already_member` — the user already has a membership on a one-per-user product. `checkout_failed` — checkout failed, usually a declined payment, and the signup was denied. `unknown` — another failure; retry. Cleared when approval is requeued.",
						"enum": [
							"plan_unavailable",
							"already_member",
							"checkout_failed",
							"unknown",
							null
						],
						"example": "plan_unavailable",
						"type": ["string", "null"]
					},
					"buyer_account": {
						"description": "The account the signup was submitted on behalf of, or `null` when the user signed up for themselves.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/StorefrontAccount"
							},
							{
								"type": "null"
							}
						]
					},
					"buyer_account_id": {
						"description": "The account the signup was submitted on behalf of, prefixed `biz_`, or `null` when the user signed up for themselves.",
						"example": null,
						"type": ["string", "null"]
					},
					"created_at": {
						"description": "When this signup was submitted, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"custom_field_responses": {
						"items": {
							"$ref": "#/components/schemas/WaitlistEntryCustomFieldResponse",
							"description": "The buyer's answers to checkout questions."
						},
						"type": "array"
					},
					"id": {
						"description": "The waitlist signup ID, prefixed `entry_`.",
						"example": "entry_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"membership_id": {
						"description": "The membership created for this signup, prefixed `mem_`, or `null` when there is none. Check the membership's status to determine access.",
						"example": null,
						"type": ["string", "null"]
					},
					"metadata": {
						"description": "Custom key-value metadata associated with this signup.",
						"example": {},
						"type": "object"
					},
					"plan_id": {
						"description": "The variant this signup belongs to, prefixed `plan_`.",
						"example": "plan_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"product": {
						"description": "The product this signup belongs to, or `null` when the variant has no product.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/WaitlistEntryProduct"
							},
							{
								"type": "null"
							}
						]
					},
					"product_id": {
						"description": "The product this signup belongs to, prefixed `prod_`, or `null` when the variant has no product.",
						"example": "prod_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"status": {
						"description": "The signup's current state. Approval runs asynchronously, so a signup stays `pending` until processing completes. `approved` alone does not prove an active membership; check `membership_id`.",
						"enum": ["pending", "approved", "denied", "canceled"],
						"example": "canceled",
						"type": "string"
					},
					"updated_at": {
						"description": "When this signup last changed, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"user": {
						"$ref": "#/components/schemas/UserSummary",
						"description": "The user who submitted this signup. For a signup an account's own credential submitted, the account's owner."
					},
					"user_id": {
						"description": "The user who submitted this signup, prefixed `user_`. For a signup an account's own credential submitted, the account's owner.",
						"example": "user_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"variant": {
						"$ref": "#/components/schemas/WaitlistEntryVariant",
						"description": "The variant this signup belongs to."
					}
				},
				"required": [
					"id",
					"status",
					"approval_failure_reason",
					"plan_id",
					"account_id",
					"product_id",
					"user_id",
					"buyer_account_id",
					"membership_id",
					"custom_field_responses",
					"metadata",
					"created_at",
					"updated_at",
					"user",
					"buyer_account",
					"product",
					"variant"
				],
				"type": "object"
			},
			"WaitlistEntryCustomFieldResponse": {
				"properties": {
					"answer": {
						"description": "The buyer's answer.",
						"type": "string"
					},
					"id": {
						"description": "The answer's ID, prefixed `cfrp_`.",
						"type": "string"
					},
					"question": {
						"description": "The question shown when the signup was submitted.",
						"type": "string"
					}
				},
				"required": ["id", "question", "answer"],
				"type": "object"
			},
			"WaitlistEntryProduct": {
				"properties": {
					"id": {
						"description": "Product ID, prefixed `prod_`.",
						"example": "prod_xxxxxxxxxxxxxx",
