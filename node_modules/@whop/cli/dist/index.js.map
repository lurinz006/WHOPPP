															"example": "ubo",
															"type": "string"
														},
														"type": "array"
													},
													"status": {
														"description": "Where the owner's own verification stands, in the same states as `status`. `action_required` when their documents need sending again.",
														"enum": [
															"not_started",
															"pending",
															"processing",
															"manual_review",
															"approved",
															"rejected",
															"action_required"
