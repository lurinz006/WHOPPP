		"/trades": {
			"get": {
				"description": "Lists trades you can access, newest first. User credentials see their own trades and those of accounts they belong to, including connected accounts; account credentials see their account and its connected accounts.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Only return trades for this account or user, prefixed `biz_` or `user_`.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return trades with this status.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": [
								"pending",
								"processing",
								"in_review",
								"completed",
								"failed"
							],
							"type": "string"
						}
					},
					{
						"description": "Only return trades of this type.",
						"in": "query",
						"name": "type",
						"required": false,
						"schema": {
							"enum": ["close", "order", "deposit", "withdraw"],
							"type": "string"
						}
					},
					{
						"description": "Field to sort by.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"default": "created_at",
							"enum": ["created_at", "updated_at"],
							"type": "string"
						}
					},
					{
						"description": "Sort direction.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"default": "desc",
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"$ref": "#/components/schemas/Trade"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": null,
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												}
											},
											"required": [
												"start_cursor",
												"end_cursor",
												"has_next_page",
												"has_previous_page"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "trades listed"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "status is invalid"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "authentication is missing"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "selected account is not authorized"
					}
				},
				"security": [
					{
						"bearerAuth": ["crypto_wallet:trade:read"]
					},
					{
						"bearerAuth": ["crypto_wallet:trade"]
					},
					{
						"bearerAuth": ["crypto_wallet:manage"]
					}
				],
				"summary": "List Trades",
				"tags": ["Trades"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "List"
					}
				}
			},
			"post": {
				"description": "Places an order, closes a perpetual position, or deposits to or withdraws from the trading balance, from the Whop-managed wallet of an account or user. Answers `201` with the trade in `pending`; it runs in the background, so read it with `GET /trades/:id` until its `status` is `completed`, `failed` or `in_review`. Trades run alongside each other, except a second order on one market at a different leverage, which answers `409`. A retry with the same `Idempotency-Key` returns the same trade.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "The account or user whose wallet trades, prefixed `biz_` or `user_`.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"amount": {
										"description": "Only for a deposit or withdraw, and required for both. For a deposit, the USDT0 to send from the wallet, with at most 6 decimals. For a withdraw, the USDC to send back, at least 1 with at most 6 decimals, or `all`.",
										"type": "string"
									},
									"client_order_id": {
										"description": "Only for an order. Your own ID for the trade, 1 to 128 characters, unique for the account. Sending it again with the same order returns the same trade; with a different order it answers `409`.",
										"type": "string"
									},
									"instrument_type": {
										"description": "`perpetual` or `spot`. Required for an order. A spot order first switches the trading account to Hyperliquid's unified account mode, where spot and perpetuals share one USDC balance.",
										"enum": ["perpetual", "spot"],
										"example": "perpetual",
										"type": "string"
									},
									"leverage": {
										"description": "Only for a perpetual order. The cross leverage, from 1 to the market's maximum. Required unless `reduce_only`; not accepted on a reduce-only order.",
										"example": 10,
										"type": "integer"
									},
									"market": {
										"description": "The market: a perpetual such as `BTC`, or for spot a pair priced in USDC such as `HYPE/USDC`. Required for an order or close, and a close takes only a perpetual; not accepted for a deposit or withdraw.",
										"example": "BTC",
										"type": "string"
									},
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"description": "Only for an order. Free-form string-to-string annotations: up to 50 keys of at most 40 characters, values up to 500 characters.",
										"type": "object"
									},
									"notional": {
										"description": "Only for an order. The order value in USD, as a decimal string; the size is rounded down to the market's decimals. Send exactly one of `size` or `notional`.",
										"type": "string"
									},
									"order_type": {
										"description": "`market` fills now within `slippage_bps` of the mid price; `limit` fills now at `price` or better. Anything unfilled is canceled. Required for an order.",
										"enum": ["market", "limit"],
										"example": "market",
										"type": "string"
									},
									"price": {
										"description": "Only for an order. The limit price in USD, as a decimal string Hyperliquid accepts without rounding. Required for a limit order; not accepted for a market order.",
										"type": "string"
									},
									"reduce_only": {
										"description": "Only for a perpetual order. Only reduce an open position; defaults to `false`. A reduce-only order takes no `leverage`.",
										"type": "boolean"
									},
									"side": {
										"description": "`buy` or `sell`. Required for an order.",
										"enum": ["buy", "sell"],
										"example": "buy",
										"type": "string"
									},
									"size": {
										"description": "Only for an order. The size in units of the market, as a decimal string, with at most the market's size decimals. Send exactly one of `size` or `notional`. The order must be worth at least 10 USD, unless reduce-only, and at most 5000 USD.",
										"example": "0.001",
										"type": "string"
									},
									"slippage_bps": {
										"description": "Only for a market order or a close. The worst price as basis points from the mid price, from 1 to 1000; defaults to 100.",
										"type": "integer"
									},
									"type": {
										"description": "`order` places one order from the trading balance, setting cross `leverage` first on a perpetual; when the balance is short, it bridges the USDT0 it needs from the wallet first. `deposit` bridges `amount` USDT0 from the wallet to the trading balance. `withdraw` sends `amount` USDC (or `all`) from the trading balance back to the wallet. `close` closes the whole position in `market` with a market reduce-only order; when the account is then flat, a `withdraw` trade sends the trading balance back to the wallet.",
										"enum": ["close", "order", "deposit", "withdraw"],
										"example": "order",
										"type": "string"
									}
								},
								"required": ["type", "account_id"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Trade"
								}
							}
						},
						"description": "trade created"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "the body is invalid"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "authentication is missing"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "trading is not allowed"
					},
					"409": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/V1ErrorResponse"
								}
							}
						},
						"description": "an order on the market at another leverage is running, or the client_order_id is taken"
					},
					"503": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/V1ErrorResponse"
								}
							}
						},
						"description": "trading is not available"
					}
				},
				"security": [
					{
						"accountApiKeyOrAccountTokenOrAccountUserTokenOrOauthTokenAuth": [
							"crypto_wallet:trade"
						]
					},
					{
						"accountApiKeyOrAccountTokenOrAccountUserTokenOrOauthTokenAuth": [
							"crypto_wallet:manage"
						]
					}
				],
				"summary": "Create Trade",
				"tags": ["Trades"],
				"x-whop-credentials": [
					"account_api_key",
					"account_token",
					"account_user_token",
					"oauth_token"
				],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create"
					}
				}
			}
		},
		"/trades/markets": {
