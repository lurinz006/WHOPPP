													"type": ["object", "null"]
												}
											},
											"required": ["primary", "backup"],
											"type": ["object", "null"]
										},
										"ads_reporting_currency": {
											"description": "Lowercase ISO currency code, such as `usd` or `eur`, used to display ad spend and stats. Defaults to `usd`.",
											"example": "usd",
											"type": "string"
										},
										"ads_scheduling_timezone": {
											"description": "IANA timezone (e.g. `America/New_York`) used to interpret campaign start/end times and to bucket reports. Defaults to `America/New_York` until explicitly overridden.",
											"example": "America/New_York",
											"type": "string"
										},
										"ads_triple_whale_integration": {
											"description": "The account's Triple Whale integration, which pushes Whop ad spend to Triple Whale's Data-In API so it reports as a `whop` channel. Available to any Triple Whale customer — Shopify, WooCommerce, or a custom checkout — by setting `shop_domain`. Requires the `ad_campaign:create` scope. Once connected, ad click-through URLs Whop serves carry `tw_source=whop` and `tw_adid=<ad id>` query parameters so Triple Whale's pixel attributes conversions back to the originating ad — no destination URL changes are needed.",
											"properties": {
												"masked_api_key": {
													"description": "The leading characters of the stored Data-In API key, followed by asterisks. The full key is never returned. `null` when no key is stored.",
													"example": "tw_live_********",
													"type": ["string", "null"]
												},
												"shop_domain": {
													"description": "The shop domain spend is reported for, such as `acme.myshopify.com` or a custom domain for a non-Shopify store. `null` when none is set.",
													"example": "shinetime.myshopify.com",
													"type": ["string", "null"]
												},
												"status": {
													"description": "Where the integration stands. `requires_shop_domain` means no shop domain is configured — set `shop_domain` before spend can be reported.",
													"enum": [
														"connected",
														"not_connected",
														"requires_shop_domain"
													],
													"example": "requires_shop_domain",
													"type": "string"
												}
											},
											"required": ["status", "masked_api_key", "shop_domain"],
											"type": "object"
										},
										"cards_auto_top_up": {
											"description": "Whether incoming funds are automatically moved to the account's cards balance. `false` when the account has no cards balance.",
											"example": false,
											"type": "boolean"
										},
										"cards_notifications": {
											"description": "Whether Whop Card notifications reach this account's team. `true` by default, including when the account has no cards balance. Set it to `false` to stop every card email and push notification for the account — application status, verification and action-required alerts, card-ready alerts, declines, large charges, and cashback summaries. Cardholder onboarding invitations still send, because they carry the only link an invited cardholder can onboard with. Requesting a card is rejected while notifications are off, since the request reaches nobody. Cards on personal accounts are unaffected.",
											"example": true,
											"type": "boolean"
										},
										"covers_connected_account_negative_balances": {
											"description": "Whether this account covers its connected accounts' negative balances. When a connected account's balance drops below zero (from refunds, disputes, or fees), this account's available balance in the same currency pays it back, up to what is available. Refunds on its connected accounts may also take them negative by up to this account's available balance. `null` when the account has no connected accounts.",
											"example": null,
											"type": ["boolean", "null"]
										},
										"customer_tracking": {
											"description": "The saved customer tracking settings for the hosted tracking page and Element, exactly as saved. `null` until set; tracking is off unless `enabled` is `true`.",
											"oneOf": [
												{
													"$ref": "#/components/schemas/CustomerTrackingPreferences"
												},
												{
													"example": null,
													"type": "null"
												}
											]
										},
										"dispute_fighter_enabled": {
											"description": "Whether Whop assembles and files the evidence response when this account's payments are disputed. Off by default; enabling it also opts the account into the success fee charged only on disputes it wins.",
											"example": false,
											"type": "boolean"
										},
										"economic_intelligence": {
											"description": "Whether Economic Intelligence is on for the account. It turns off automatically at `economic_intelligence_ends_at`.",
											"example": false,
											"type": "boolean"
										},
										"economic_intelligence_auto_renew": {
											"description": "Whether Economic Intelligence renews itself every week, with no end date. Turn it on with the `weekly` offer. Set it to `false` to stop renewing, which keeps Economic Intelligence on until the end of the current week, shown in `economic_intelligence_ends_at`; stopping before the first renewal charges the rest of that week at the `7_days` offer's fee. Set it back to `true` before then to keep renewing at the weekly fee.",
											"example": false,
											"type": "boolean"
										},
										"economic_intelligence_ends_at": {
											"description": "When the account's committed Economic Intelligence period ends, as an ISO 8601 timestamp. Economic Intelligence can't be turned off before then. `null` when Economic Intelligence is off or renews automatically.",
											"example": null,
											"type": ["string", "null"]
										},
										"economic_intelligence_fee_percentage": {
											"description": "Percentage of volume charged while Economic Intelligence is on, such as `1.5` for 1.5%. `null` when Economic Intelligence is off.",
											"example": null,
											"type": ["number", "null"]
										},
										"economic_intelligence_first_renewal_at": {
											"description": "When auto-renew first renews, as an ISO 8601 timestamp. Turning auto-renew off before then charges the rest of that week at the `7_days` offer's fee. `null` when auto-renew is off.",
											"example": null,
											"type": ["string", "null"]
										},
										"economic_intelligence_offers": {
											"description": "What the account can choose now to turn on Economic Intelligence, each with its fee. Every offer while Economic Intelligence is off; only the `weekly` auto-renew offer while a committed period is running, as an upgrade; empty while it renews automatically.",
											"items": {
												"properties": {
													"auto_renew": {
														"description": "Whether this offer renews every period until auto-renew is turned off, rather than ending after one.",
														"example": true,
														"type": "boolean"
													},
													"duration": {
														"description": "What period of time Economic Intelligence stays on. For an auto-renew offer, the length of each period it renews for.",
														"example": 7,
														"type": "integer"
													},
													"duration_unit": {
														"description": "The unit of time the duration is in (hours or days)",
														"enum": ["hours", "days"],
														"example": "days",
														"type": "string"
													},
													"fee_percentage": {
														"description": "Percentage of volume charged while Economic Intelligence is on, such as `1.5` for 1.5%.",
														"example": 1,
														"type": "number"
													},
													"key": {
														"description": "The unique identifier for this offer. Pass this value as `economic_intelligence_duration_key` to turn it on.",
														"enum": ["weekly", "7_days", "1_day", "1_hour"],
														"example": "weekly",
														"type": "string"
													},
													"recommended": {
														"description": "Whether Whop recommends this offer. At most one offer is recommended.",
														"example": true,
														"type": "boolean"
													}
												},
												"required": [
													"key",
													"duration",
													"duration_unit",
													"fee_percentage",
													"auto_renew",
													"recommended"
												],
												"type": "object"
											},
											"type": "array"
										},
										"economic_intelligence_previous_period": {
											"description": "The account's last Economic Intelligence period, once it has ended. `null` while Economic Intelligence is on, or when it has never been on.",
											"properties": {
												"ended_at": {
													"description": "When the period ended, as an ISO 8601 timestamp.",
													"example": "2026-01-01T12:00:00.000Z",
													"type": "string"
												},
												"fee_percentage": {
													"description": "Percentage of volume charged during the period, such as `3` for 3%.",
													"example": 3,
													"type": "number"
												}
											},
											"required": ["ended_at", "fee_percentage"],
											"type": ["object", "null"]
										},
										"feedback_options": {
											"description": "The account's own cancel reasons, in the order members see them when they cancel. Each is filed under a standard category, saved as the membership's `cancel_option`, so reports keep grouping cancellations. Empty when the account uses Whop's default reasons.",
											"items": {
												"properties": {
													"category": {
														"description": "The category saved as the membership's `cancel_option` when a member picks this option.",
														"enum": [
															"too_expensive",
															"switching",
															"missing_features",
															"technical_issues",
															"bad_experience",
															"unused",
															"other"
														],
														"example": "unused",
														"type": "string"
													},
													"id": {
														"description": "Feedback option ID, prefixed `fo_`. Pass it as `feedback_option_id` when canceling a membership, or back in `feedback_options` to keep the option when changing the list.",
														"example": "fo_xxxxxxxxxxxxxx",
														"type": "string"
													},
													"label": {
														"description": "The cancel reason as members see it. Up to 100 characters.",
														"example": "I don't get my car detailed often enough",
														"type": "string"
													}
												},
												"required": ["id", "label", "category"],
												"type": "object"
											},
											"type": "array"
										},
										"preferred_settlement_currency": {
											"description": "Lowercase ISO currency code every new sale settles into, regardless of the plan's currency or what the buyer paid in. Sales converted this way carry an additional 0.5% FX fee. `null` when the account settles each sale in its plan's currency.",
											"enum": ["usd", "eur", "gbp", "cad", "aud", null],
											"example": "usd",
											"type": ["string", "null"]
										},
										"preferred_settlement_currency_changeable_at": {
											"description": "When `preferred_settlement_currency` may next be changed or turned off, as an ISO 8601 timestamp. It can change at most once a day. `null` when it may change now.",
											"example": null,
											"type": ["string", "null"]
										},
										"subscription_failure_behavior": {
											"description": "What happens to a subscription once every retry of a renewal payment has failed. `cancel` (the default) cancels it. `none` leaves it past due and keeps billing it each period; access follows the account's past-due access setting.",
											"enum": ["cancel", "none"],
											"example": "cancel",
											"type": "string"
										}
									},
									"required": [
										"ads_payment_methods",
										"ads_reporting_currency",
										"ads_scheduling_timezone",
										"ads_agreement",
										"ads_certifications",
										"ads_triple_whale_integration",
										"cards_auto_top_up",
										"cards_notifications",
										"covers_connected_account_negative_balances",
										"dispute_fighter_enabled",
										"feedback_options",
										"economic_intelligence",
										"economic_intelligence_auto_renew",
										"economic_intelligence_ends_at",
										"economic_intelligence_fee_percentage",
										"economic_intelligence_first_renewal_at",
										"economic_intelligence_offers",
										"economic_intelligence_previous_period",
										"preferred_settlement_currency",
										"preferred_settlement_currency_changeable_at",
										"subscription_failure_behavior",
										"customer_tracking"
									],
									"type": "object"
								}
							}
						},
						"description": "preferences retrieved"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "unauthorized"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "account not found"
					}
				},
				"security": [
					{
						"bearerAuth": ["ad_campaign:create"]
					},
					{
						"bearerAuth": ["payout:account:update"]
					},
					{
						"bearerAuth": ["payment:dispute"]
					},
					{
						"bearerAuth": ["company:update"]
					}
				],
				"summary": "Retrieve Account Preferences",
				"tags": ["Accounts"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Retrieve Preferences"
					}
				},
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.accounts.preferences.retrieve({\n    account_id: \"account_id\"\n});\n"
					}
				]
			},
			"patch": {
				"description": "Updates the account's preferences. Each top-level key present in the body is replaced as a whole; omitted keys are left untouched.\n\nRequired scopes depend on the preferences being updated:\n\n| Preferences | Required scope |\n| --- | --- |\n| `ads_payment_methods`, `ads_reporting_currency`, `ads_scheduling_timezone`, `ads_triple_whale_integration`, `ads_certifications` | `ad_campaign:create` |\n| `cards_auto_top_up`, `cards_notifications`, `covers_connected_account_negative_balances` | `payout:account:update` |\n| `dispute_fighter_enabled` | `payment:dispute` |\n| `economic_intelligence_duration_key`, `economic_intelligence_auto_renew` | `company:update` |\n| `feedback_options`, `customer_tracking` | `company:manage_checkout` |\n\nWhen updating preferences from multiple rows, all corresponding scopes are required for the account.\n",
				"operationId": "update-preferences",
				"parameters": [
					{
						"description": "Account ID, prefixed `biz_`.",
						"in": "path",
						"name": "account_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"ads_certifications": {
										"additionalProperties": {
											"properties": {
												"status": {
													"description": "Must be `pending_information`.",
													"enum": ["pending_information"],
													"type": "string"
												}
											},
											"required": ["status"],
											"type": "object"
										},
										"description": "Opens an advertising certification application. Keyed by certification type (`prescription_drug_ads`); set the entry's `status` to `pending_information` to start, then answer the requested fields via `PATCH /verifications/{id}`. Only one application per type can be open at a time; every other status is set by Whop's review. Requires the `ad_campaign:create` scope on your API key.",
										"example": {
											"prescription_drug_ads": {
												"status": "pending_information"
											}
										},
										"type": "object"
									},
									"ads_payment_methods": {
										"description": "How the account pays for Whop Ads spend. Requires `primary`; `backup` is optional and covers the charge when the primary fails. Requires the `ad_campaign:create` scope on your API key. Configuring a `card` requires a user token; account API keys can configure only `platform_balance` sources.",
										"properties": {
											"backup": {
												"description": "Optional second method charged if the primary fails. Any pairing is allowed (two cards, card+balance, balance+card); omit it to run on a single method. Must differ from the primary.",
												"properties": {
													"id": {
														"description": "The funding source ID: a Whop balance (`ldgr_`) for `platform_balance`, or a payment method (`payt_`) for `card`. Optional for `platform_balance` — defaults to the account's default Whop balance. Required for `card`.",
														"example": "payt_xxxxxxxxxxxxxx",
														"type": "string"
													},
													"type": {
														"description": "The funding source kind.",
														"enum": ["platform_balance", "card"],
														"example": "card",
														"type": "string"
													}
												},
												"required": ["type"],
												"type": "object"
											},
											"primary": {
												"properties": {
													"id": {
														"description": "The funding source ID: a Whop balance (`ldgr_`) for `platform_balance`, or a payment method (`payt_`) for `card`. Optional for `platform_balance` — defaults to the account's default Whop balance. Required for `card`.",
														"example": "payt_xxxxxxxxxxxxxx",
														"type": "string"
													},
													"type": {
														"description": "The funding source kind.",
														"enum": ["platform_balance", "card"],
														"example": "platform_balance",
														"type": "string"
													}
												},
												"required": ["type"],
												"type": "object"
											}
										},
										"required": ["primary"],
										"type": "object"
									},
									"ads_reporting_currency": {
										"description": "Lowercase ISO currency code, such as `usd` or `eur`, used to display ad spend and stats. Defaults to `usd`. Requires the `ad_campaign:create` scope on your API key.",
										"example": "eur",
										"type": "string"
									},
									"ads_scheduling_timezone": {
										"description": "IANA timezone (e.g. `America/New_York`) used to interpret campaign start/end times and to bucket reports. Cannot be cleared once set — pass a new value to change it. Requires the `ad_campaign:create` scope on your API key.",
										"example": "PST8PDT",
										"type": "string"
									},
									"ads_triple_whale_integration": {
										"description": "Connects or disconnects the Triple Whale integration, or changes the shop it reports to. Requires the `ad_campaign:create` scope on your API key. Connecting requires a `shop_domain` to report spend against.",
										"properties": {
											"api_key": {
												"description": "A Triple Whale Data-In API key with the `Ads: Write` scope, validated against Triple Whale before it is stored. Pass `null` to disconnect. Connecting for the first time backfills the account's existing ad spend. Required unless you are only changing `shop_domain` on an already connected integration, in which case the stored key is reused.",
												"example": "tw_live_key_1234",
												"type": ["string", "null"]
											},
											"shop_domain": {
												"description": "The exact shop domain configured in Triple Whale's Settings → Store (for Shopify this is the `.myshopify.com` domain; for a custom sales platform it's whatever domain Triple Whale assigned when the shop was set up there). A leading `https://` and trailing `/` are stripped, and what remains must be a bare hostname with no path or spaces. Validated against Triple Whale — the API key must have access to it — before it is stored. Changing it on a connected integration backfills the account's ad spend onto the new shop. Omit to keep the stored domain; there is no way to clear a stored value, only to overwrite it with a new domain.",
												"example": "custom-store.example.com",
												"type": "string"
											}
										},
										"type": "object"
									},
									"cards_auto_top_up": {
										"description": "Whether incoming funds are automatically moved to the account's cards balance. Requires a cards balance on the account and the `payout:account:update` scope on your API key.",
										"example": true,
										"type": "boolean"
									},
									"cards_notifications": {
										"description": "Whether Whop Card notifications reach this account's team. Set it to `false` to stop every card email and push notification for the account — application status, verification and action-required alerts, card-ready alerts, declines, large charges, and cashback summaries. Cardholder onboarding invitations still send, because they carry the only link an invited cardholder can onboard with. Requesting a card is rejected while notifications are off, since the request reaches nobody. Cards on personal accounts are unaffected. Requires a cards balance on the account and the `payout:account:update` scope on your API key.",
										"example": true,
										"type": "boolean"
									},
									"covers_connected_account_negative_balances": {
										"description": "Whether this account covers its connected accounts' negative balances. When a connected account's balance drops below zero (from refunds, disputes, or fees), this account's available balance in the same currency pays it back, up to what is available. Only accounts with connected accounts can set it. Requires the `payout:account:update` scope on your API key.",
										"example": true,
										"type": "boolean"
									},
									"customer_tracking": {
										"additionalProperties": false,
										"description": "Customer tracking settings for the hosted tracking page and Element, replaced as a whole: fields left out are saved as unset. Pass null to clear them, which turns tracking off. Tracking is off unless `enabled` is `true`. Requires the `company:manage_checkout` scope on your API key.",
										"properties": {
											"accent_color": {
												"description": "Accent color, as a `#rrggbb` hex color. Unset uses the default.",
												"pattern": "^#[0-9a-fA-F]{6}$",
												"type": ["string", "null"]
											},
											"enabled": {
												"description": "Turns the public tracking page and guest lookup on. Unset is off.",
												"type": ["boolean", "null"]
											},
											"show_business_name": {
												"description": "Show the business name on the tracking page and Element. Unset shows it.",
												"type": ["boolean", "null"]
											},
											"show_logo": {
												"description": "Show the account logo on the tracking page and Element. Unset shows it.",
												"type": ["boolean", "null"]
											},
											"support_email": {
												"description": "Customer support email address.",
												"maxLength": 254,
												"type": ["string", "null"]
											},
											"support_url": {
												"description": "HTTPS customer support URL.",
												"maxLength": 2048,
												"type": ["string", "null"]
											}
										},
										"type": ["object", "null"]
									},
									"dispute_fighter_enabled": {
										"description": "Whether Whop assembles and files the evidence response when this account's payments are disputed. Off by default; enabling it also opts the account into the success fee charged only on disputes it wins. Requires the `payment:dispute` scope on your API key.",
										"example": true,
										"type": "boolean"
									},
									"economic_intelligence_auto_renew": {
										"description": "`false` stops renewing: Economic Intelligence stays on until the end of the current week, and stopping before the first renewal charges the rest of that week at the `7_days` offer's fee. `true` keeps it renewing again before then, or turns it on like the `weekly` offer. Can't be combined with `economic_intelligence_duration_key`. Requires the `company:update` scope on your API key.",
										"example": false,
										"type": "boolean"
									},
									"economic_intelligence_duration_key": {
										"description": "Turns on Economic Intelligence with the offer that has this `key` in `economic_intelligence_offers`, at that offer's fee. A committed duration can't be changed or turned off until `economic_intelligence_ends_at`, except to upgrade to `weekly`, which switches to auto-renew right away. Requires the `company:update` scope on your API key.",
										"enum": ["weekly", "7_days", "1_day", "1_hour"],
										"example": "weekly",
										"type": "string"
									},
									"feedback_options": {
										"description": "Replaces the account's own cancel reasons, shown to members in this order when they cancel. Pass an option's `id` to keep it, for example when renaming it; options without an `id` are added, and options left out are removed. Pass an empty array to go back to Whop's default reasons. Members who already picked an option keep the label they saw. Requires the `company:manage_checkout` scope on your API key.",
										"items": {
											"properties": {
												"category": {
													"description": "The category saved as the membership's `cancel_option` when a member picks this option, so reports keep grouping cancellations.",
													"enum": [
														"too_expensive",
														"switching",
														"missing_features",
														"technical_issues",
														"bad_experience",
														"unused",
														"other"
													],
													"example": "unused",
													"type": "string"
												},
												"id": {
													"description": "The ID of an option to keep. Omit it to add a new option.",
													"example": "fo_xxxxxxxxxxxxxx",
													"type": "string"
												},
												"label": {
													"description": "The cancel reason as members see it.",
													"example": "I don't get my car detailed often enough",
													"maxLength": 100,
													"type": "string"
												}
											},
											"required": ["label", "category"],
											"type": "object"
										},
										"maxItems": 10,
										"type": "array"
									},
									"preferred_settlement_currency": {
										"description": "Settle every new sale into this currency, regardless of the plan's currency or what the buyer paid in; sales converted this way carry an additional 0.5% FX fee. Pass `null` to go back to settling each sale in its plan's currency. Changing it never converts money already in your balances, and it can change at most once a day (see `preferred_settlement_currency_changeable_at`). Requires the `payout:account:update` scope on your API key.",
										"enum": ["usd", "eur", "gbp", "cad", "aud", null],
										"example": "eur",
										"type": ["string", "null"]
									},
									"subscription_failure_behavior": {
										"description": "What happens to a subscription once every retry of a renewal payment has failed. `cancel` (the default) cancels it. `none` leaves it past due and keeps billing it each period; access follows the account's past-due access setting. Requires company:manage_checkout permission.",
										"enum": ["cancel", "none"],
										"example": "none",
										"type": "string"
									}
								},
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"ads_agreement": {
											"description": "The account's Whop Ads services and payment authorization agreement. While `pending_signature`, campaign launch is blocked; sign by answering `requested_information` via `PATCH /verifications/{id}`.",
											"properties": {
												"accepted_at": {
													"description": "When the agreement was signed, as an ISO 8601 timestamp. `null` until signed.",
													"example": "2026-01-01T12:00:00.000Z",
													"type": ["string", "null"]
												},
												"agreement_version": {
													"description": "The agreement version signed or awaiting signature, as an ISO date. `null` when no signature is required.",
													"example": "2026-01-01",
													"type": ["string", "null"]
												},
												"printed_name": {
													"description": "The signer's printed full name. `null` until signed.",
													"example": "Marcus Webb",
													"type": ["string", "null"]
												},
												"status": {
													"description": "Where the account's ads services agreement stands.",
													"enum": [
														"not_required",
														"pending_signature",
														"signed"
													],
													"example": "not_required",
													"type": "string"
												}
											},
											"required": [
												"status",
												"agreement_version",
												"printed_name",
												"accepted_at"
											],
											"type": "object"
										},
										"ads_certifications": {
											"description": "The account's advertising certifications, one entry per certification type Whop offers. Start an application by setting a type's `status` to `pending_information` via `PATCH`, then answer the fields it requests via `GET`/`PATCH /verifications/{id}`.",
											"items": {
												"properties": {
													"approved_countries": {
														"description": "Countries every approved application of this type covers, as ISO 3166-1 alpha-2 codes. Ads targeting only these countries are exempt from the category's restrictions.",
														"items": {
															"type": "string"
														},
														"type": "array"
													},
													"business_name": {
														"description": "The business name on the latest application.",
														"example": null,
														"type": ["string", "null"]
													},
													"business_type": {
														"description": "The kind of business on the latest application. `null` until the account applies.",
														"enum": [
															"online_pharmacy",
															"pharmaceutical_manufacturer",
															"telehealth_provider",
															null
														],
														"example": "online_pharmacy",
														"type": ["string", "null"]
													},
													"certification_type": {
														"description": "The certification this entry describes.",
														"enum": ["prescription_drug_ads"],
														"example": "prescription_drug_ads",
														"type": "string"
													},
													"countries": {
														"description": "Countries the latest application covers, as ISO 3166-1 alpha-2 codes.",
														"items": {
															"type": "string"
														},
														"type": "array"
													},
													"denial_reason": {
														"description": "Why the latest application was denied. `null` unless `status` is `denied`.",
														"example": null,
														"type": ["string", "null"]
													},
													"request_id": {
														"description": "The latest application's request ID, prefixed `inrq_`. `null` until the account applies.",
														"example": "inrq_xxxxxxxxxxxxxx",
														"type": ["string", "null"]
													},
													"status": {
														"description": "`not_started` until the account applies; `pending_information` while an application waits for answers; `in_review` once submitted; then `approved` or `denied`.",
														"enum": [
															"not_started",
															"pending_information",
															"in_review",
															"approved",
															"denied"
														],
														"example": "not_started",
														"type": "string"
													},
													"url": {
														"description": "The website on the latest application.",
														"example": null,
														"type": ["string", "null"]
													}
												},
												"required": [
													"certification_type",
													"status",
													"request_id",
													"business_name",
													"url",
													"business_type",
													"countries",
													"approved_countries",
													"denial_reason"
												],
												"type": "object"
											},
											"type": "array"
										},
										"ads_payment_methods": {
											"description": "How the account pays for Whop Ads spend. `primary` is charged first; `backup` covers the charge when the primary fails. `null` until ads billing has been configured.",
											"properties": {
												"backup": {
													"properties": {
														"card_brand": {
															"description": "Card brand, present for `card` entries.",
															"example": "visa",
															"type": ["string", "null"]
														},
														"exp_month": {
															"description": "Expiration month, present for `card` entries.",
															"example": 10,
															"type": ["integer", "null"]
														},
														"exp_year": {
															"description": "Expiration year, present for `card` entries.",
															"example": 2031,
