			"post": {
				"description": "Creates one rule covering every selected target and event combination. Active rules cannot overlap for the same platform and event. Customer prices and Whop revenue stay unchanged.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "Business that owns the rule.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"adjustment_type": {
										"enum": ["fixed", "percentage"],
										"example": "fixed",
										"type": "string"
									},
									"events": {
										"description": "Events adjusted on every selected target. Every platform must support every selected event.",
										"items": {
											"properties": {
												"custom_name": {
													"description": "Exact custom event name. Required for custom events; `null` for standard events. Google does not support named custom events.",
													"nullable": true,
													"type": "string"
												},
												"event_name": {
													"enum": [
														"purchase",
														"subscribe",
														"start_trial",
														"lead",
														"complete_registration",
														"submit_application",
														"schedule",
														"contact",
														"view_content",
														"add_to_cart",
														"custom"
													],
													"example": "lead",
													"type": "string"
												}
											},
											"required": ["event_name"],
											"type": "object"
										},
										"maxItems": 100,
										"minItems": 1,
										"type": "array"
									},
									"fixed_value": {
										"nullable": true,
										"properties": {
											"amount": {
												"description": "Decimal amount with at most 2 decimal places. Fixed values must be greater than 0 and at most 99999999.99.",
												"example": "60.00",
												"pattern": "^-?(?:[0-9]+(?:\\.[0-9]{1,2})?|\\.[0-9]{1,2})$",
												"type": "string"
											},
											"currency": {
												"example": "usd",
												"type": "string"
											}
										},
										"required": ["amount", "currency"],
										"type": "object"
									},
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"type": "object"
									},
									"percentage_change": {
										"description": "Signed percent change from negative 100 to 10000. The sent value cannot go below zero.",
										"maximum": 10000,
										"minimum": -100,
										"multipleOf": 0.01,
										"nullable": true,
										"type": "number"
									},
									"replace_rule_ids": {
										"description": "Exact IDs of active rules whose overlapping selections will be replaced. Other selections keep their values; remaining selections may split into separate rules. Broader rules remain as fallbacks for other items. Rules left with no selections are paused. Stale or incomplete conflict selections fail.",
										"items": {
											"type": "string"
										},
										"maxItems": 1000,
										"type": "array",
										"uniqueItems": true
									},
									"status": {
										"description": "Initial rule status. Defaults to active.",
										"enum": ["active", "paused"],
										"example": "active",
										"type": "string"
									},
									"targets": {
										"description": "Targets sharing one scope. Every selected event applies to every target. At most 500 target and event combinations.",
										"items": {
											"properties": {
												"platform": {
													"enum": ["tiktok", "meta", "google"],
													"example": "meta",
													"type": "string"
												},
												"resource_id": {
													"description": "Campaign, ad group, or ad ID. Null for a business target.",
													"nullable": true,
													"type": "string"
												},
												"scope": {
													"enum": ["business", "campaign", "ad_group", "ad"],
													"example": "business",
													"type": "string"
												}
											},
											"required": ["scope", "platform"],
											"type": "object"
										},
										"maxItems": 100,
										"minItems": 1,
										"type": "array"
									}
								},
								"required": [
									"account_id",
									"adjustment_type",
									"targets",
									"events"
								],
								"type": "object"
							}
						}
					}
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AdConversionValueRule"
								}
							}
						},
						"description": "Created"
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"bearerAuth": ["ad_campaign:update"]
					}
				],
				"summary": "Create a conversion value rule",
				"tags": ["Ad Conversion Value Rules"],
				"x-mint": {
