						"example": "average_target",
						"type": ["string", "null"]
					},
					"budget_amount": {
						"description": "The campaign's budget in USD, which is what it is stored and billed in. `null` when each ad group sets its own budget instead.",
						"example": 50,
						"type": ["number", "null"]
					},
					"budget_amount_local": {
