		"/payments/{payment_id}/resume": {
			"post": {
				"description": "Charges the saved card again, with the buyer present, for a payment their bank declined until they authenticate (such as with 3DS). Retrieve the payment afterward to get the bank's challenge from `next_action`; once the buyer completes it, they land on `return_url`, or on Whop's hosted verification page if none was given. Only the buyer can call this, with the payment's `client_secret`, an OAuth token for their own account with the `member:payment_methods:use` scope, or the token from a verified `payment` session intent. An API key gets a `403`. Has no effect on a payment that is not waiting on authentication.",
				"operationId": "resume",
				"parameters": [
					{
						"description": "The unique identifier of the payment.",
						"in": "path",
						"name": "payment_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"return_url": {
										"description": "Where the buyer continues after completing an off-site step. Must be an absolute https URL without credentials (http is allowed for localhost), at most 2,048 characters. Defaults to Whop's hosted verification page. Ignored when the payment is not waiting on authentication.",
										"example": "https://shinetime.example/billing/recovered",
										"type": "string"
									}
								},
								"type": "object"
							}
						}
					}
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentStatus"
								}
							}
						},
						"description": "Resume requested"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "The resume could not start"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "Unauthorized"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "A seller cannot charge the buyer's saved card"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "Payment not found"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"oauthTokenAuth": []
					}
				],
				"summary": "Resume a parked renewal",
				"tags": ["Payments"],
				"x-whop-credentials": ["oauth_token"],
				"x-mint": {
					"metadata": {
						"title": "Resume a Parked Renewal",
						"sidebarTitle": "Resume a Parked Renewal"
					}
				}
			}
		},
		"/payments/{payment_id}/return_url": {
			"patch": {
				"description": "Changes where the buyer lands after completing an off-site step, up until they return. Accepts either a secret key or the payment's own `client_secret`, so the surface that knows the final destination can set it.",
				"operationId": "return_url",
				"parameters": [
					{
						"description": "The unique identifier of the payment.",
						"in": "path",
						"name": "payment_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"return_url": {
										"description": "Where the buyer continues after completing an off-site step. Must be an absolute https URL without credentials (http is allowed for localhost), at most 2,048 characters.",
										"example": "https://shinetime.example/checkout/thanks",
										"type": "string"
									}
								},
								"required": ["return_url"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentStatus"
								}
							}
						},
						"description": "Return URL updated"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "Invalid return URL"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "Unauthorized"
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				],
				"summary": "Update payment return URL",
				"tags": ["Payments"],
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.payments.updateReturnUrl({\n    payment_id: \"payment_id\",\n    return_url: \"https://shinetime.example/checkout/thanks\"\n});\n"
					}
				],
				"x-mint": {
