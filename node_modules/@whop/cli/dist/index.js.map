		"/domains/{id}/check": {
			"post": {
				"description": "Checks the domain's DNS, payment, and provider state again now instead of at its next scheduled check. Returns the domain as saved; retrieve it again to see the result.",
				"operationId": "check",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Domain ID, prefixed `dom_`.",
						"in": "path",
