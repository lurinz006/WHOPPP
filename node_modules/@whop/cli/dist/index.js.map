			"post": {
				"description": "Promotes a draft or approved app build to production so it becomes the active version served to users. Draft builds enter review first.",
				"operationId": "promote",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "App build ID, prefixed `abld_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AppBuild"
								}
							}
						},
						"description": "app build promotion started"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "the build cannot be promoted"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential lacks the build-management scope"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "no app build with that ID exists"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"bearerAuth": ["developer:manage_builds"]
					}
				],
				"summary": "Promote App Build",
				"tags": ["App Builds"],
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.appBuilds.promote({\n    id: \"id\"\n});\n"
					}
				]
			}
		},
		"/app_installations": {
			"get": {
				"description": "Lists app installations, newest first. An app's API key lists the accounts that installed it. An account lists the apps installed on it; a user passes that account's `account_id`. The developer of an app lists every installation of it by passing `app_id`. Uninstalled apps, deleted apps and deleted accounts are left out.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Only return installations on this account, prefixed `biz_`.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return installations of this app, prefixed `app_`. Pass your own app's ID to list the accounts that installed it.",
						"in": "query",
						"name": "app_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return installations of apps that have this view, such as `dashboard` for apps shown in a business's dashboard.",
						"in": "query",
						"name": "view_type",
						"required": false,
						"schema": {
							"enum": [
								"hub",
								"discover",
								"dash",
								"dashboard",
								"analytics",
								"skills",
								"openapi"
							],
							"type": "string"
						}
					},
					{
						"description": "Only return the installation with this `external_id`, the installed app's own identifier for it. Only the app and its developer can filter by it.",
						"in": "query",
						"name": "external_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return installations created before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return installations created after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Field to sort installations by. `name` sorts by app name, and only when listing the apps installed on one account.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"default": "created_at",
							"enum": ["created_at", "name"],
							"type": "string"
						}
					},
					{
						"description": "Sort direction.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"default": "desc",
							"enum": ["asc", "desc"],
							"type": "string"
						}
					}
				],
