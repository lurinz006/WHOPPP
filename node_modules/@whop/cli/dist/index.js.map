		"/disputes/summary": {
			"get": {
				"description": "Totals up the same disputes the list returns, so you can build status tabs and totals without paging through them.",
				"operationId": "summary",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Which breakdowns to return, keyed by these names under `groups`. Repeat the parameter to ask for several; omit it for all of them.",
						"in": "query",
						"name": "groups",
						"required": false,
						"schema": {
							"items": {
								"enum": ["status", "currency"],
								"example": "status",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only disputes filed against this account (`biz_` tag). Omit it to cover every account you can read.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only disputes in these statuses. Repeat the parameter to pass several. A `needs_response` dispute whose evidence deadline has passed reports and filters as `under_review` instead.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"needs_response",
									"warning_needs_response",
									"under_review",
									"warning_under_review",
									"won",
									"lost",
									"prevented",
									"warning_closed"
								],
								"example": "needs_response",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only disputes in this three-letter ISO currency.",
						"in": "query",
						"name": "currency",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only disputes opened before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only disputes opened after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Search disputes by dispute ID, payment ID, user ID, membership ID, user email, name, or username. Email filtering requires the member:email:read permission.",
						"in": "query",
						"name": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Also cover the account's connected accounts. Requires `account_id`, and is a 400 without it. Without `query`, covers the disputes of the account and every connected account, in any order. The listing is cut off after 10 seconds; add a `query` to narrow it. With `query`, matches on dispute, payment, user or membership ID, buyer email, or a card's first 6 or 8 digits and last 4 separated by a space or dash (`424242 4242`); free-text queries such as a name search only the named account. Connected accounts' disputes are returned only for connected accounts you can read disputes on.",
						"in": "query",
						"name": "include_connected_accounts",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"groups": {
											"description": "One entry per requested breakdown, keyed by the field it groups on. A field you did not ask for is absent.",
											"properties": {
												"currency": {
													"additionalProperties": {
														"type": "integer"
													},
													"description": "How many of the matching disputes are in each currency, keyed by three-letter ISO code. Only currencies with at least one dispute are present.",
													"example": {
														"usd": 1
													},
													"type": "object"
												},
												"status": {
													"description": "How many of the matching disputes are in each status. Every status is present, including those with a count of zero.",
													"properties": {
														"lost": {
															"example": 0,
															"type": "integer"
														},
														"needs_response": {
															"example": 1,
															"type": "integer"
														},
														"prevented": {
															"example": 0,
															"type": "integer"
														},
														"under_review": {
															"example": 0,
															"type": "integer"
														},
														"warning_closed": {
															"example": 0,
															"type": "integer"
														},
														"warning_needs_response": {
															"example": 0,
															"type": "integer"
														},
														"warning_under_review": {
															"example": 0,
															"type": "integer"
														},
														"won": {
															"example": 0,
															"type": "integer"
														}
													},
													"required": [
														"needs_response",
														"warning_needs_response",
														"under_review",
														"warning_under_review",
														"won",
														"lost",
														"prevented",
														"warning_closed"
													],
													"type": "object"
												}
											},
											"type": "object"
										},
										"total": {
											"description": "How many disputes match the filters.",
											"example": 1,
											"type": "integer"
										}
									},
									"required": ["total", "groups"],
									"type": "object"
								}
							}
						},
						"description": "summary returned"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "an unrecognized breakdown"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					}
				},
				"security": [
					{
						"bearerAuth": ["payment:dispute:read"]
					}
				],
