			"TeamMember": {
				"properties": {
					"account_id": {
						"description": "The account this membership belongs to, prefixed `biz_`.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"authorized_role": {
						"description": "Custom role assigned to this member, or `null` when the member has a system role.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/TeamMemberAuthorizedRole"
							},
							{
								"type": "null"
							}
						]
					},
					"created_at": {
						"description": "When the member joined or the invite was sent, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"direct_reports_count": {
						"description": "How many team members report directly to this member. `null` for invites.",
						"example": 0,
						"type": ["integer", "null"]
					},
					"email": {
						"description": "The member's email address. For accepted members, `null` unless the caller holds the `company:authorized_user:email:read` scope; for invites, the invited address.",
						"example": "marcus@shinetime.example",
						"type": ["string", "null"]
					},
					"id": {
						"description": "Team member ID — `ausr_` for accepted members, `mber_` for members whose role is held on their member record, `ausri_` for pending invites.",
						"example": "ausr_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"is_agent": {
						"description": "Whether this member is an agent (app-controlled account) rather than a human team member. Always `false` for invites.",
						"example": false,
						"type": "boolean"
					},
					"reports_to_id": {
						"description": "The team member this member reports to, prefixed `ausr_`, or `mber_` when that manager's role is held on their member record. `null` when the member reports to the business directly, and for invites.",
						"example": "ausr_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"role": {
						"description": "The member's role on the account. `custom` means a bespoke dashboard-managed role; the API can read but not grant it.",
						"enum": [
							"owner",
							"admin",
							"partner",
							"sales_manager",
							"moderator",
							"advertiser",
							"app_manager",
							"support",
							"manager",
							"workforce",
							"custom"
						],
						"example": "admin",
						"type": "string"
					},
					"status": {
						"description": "`joined` for accepted members, `pending` while the invite is pending.",
						"enum": ["joined", "pending"],
						"example": "joined",
						"type": "string"
					},
					"updated_at": {
						"description": "When the membership was last updated, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"user": {
						"description": "The user behind this team membership. `null` for an invite sent to an email with no Whop account yet.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/UserSummary"
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": [
					"id",
					"status",
					"role",
					"is_agent",
					"account_id",
					"email",
					"created_at",
					"updated_at",
					"authorized_role",
					"reports_to_id",
					"direct_reports_count",
					"user"
				],
				"type": "object"
			},
			"TeamMemberAuthorizedRole": {
				"properties": {
					"id": {
						"description": "Custom role ID, prefixed `aurl_`.",
						"type": "string"
					},
					"name": {
						"description": "Custom role name.",
						"type": "string"
					}
				},
				"required": ["id", "name"],
				"type": "object"
			},
			"Trade": {
				"properties": {
					"account_id": {
						"description": "The account that owns the trading wallet, prefixed `biz_`. `null` when a user owns it.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"amount": {
						"description": "The USDT0 that a deposit, or an order short of trading balance, sends from the wallet, or the USDC that a withdraw sends back, in native units, as a decimal string. A withdraw of `all` shows what it sent once it finishes. `null` otherwise.",
						"example": "25",
						"type": ["string", "null"]
					},
					"average_price": {
						"description": "The average fill price of the order, in USD, as a decimal string. `null` when it is not known.",
						"example": null,
						"type": ["string", "null"]
					},
					"client_order_id": {
						"description": "The caller's own ID for the trade, unique for the account. `null` when none was sent.",
						"example": null,
						"type": ["string", "null"]
					},
					"completed_at": {
						"description": "When the trade ended as completed or failed, as an ISO 8601 timestamp. `null` before that.",
						"example": null,
						"type": ["string", "null"]
					},
					"created_at": {
						"description": "When the trade was created, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"failure_code": {
						"description": "Why the trade failed, or `null`.",
						"enum": [
							"market_unavailable",
							"leverage_too_high",
							"amount_too_small",
							"isolated_position_open",
							"trading_paused",
							"funding_failed",
							"margin_unavailable",
							"builder_fee_unapproved",
							"leverage_rejected",
							"leverage_unconfirmed",
							"order_rejected",
							"close_rejected",
							"return_failed",
							"withdraw_failed",
							null
						],
						"example": "market_unavailable",
						"type": ["string", "null"]
					},
					"filled_size": {
						"description": "The size the order filled, in units of the market, as a decimal string. `null` until it fills.",
						"example": null,
						"type": ["string", "null"]
					},
					"funds_location": {
						"description": "Where the money is when the trade did not complete as asked: `wallet`, `trading_account`, or `unknown` while a person checks it. `null` otherwise.",
						"enum": ["wallet", "trading_account", "unknown", null],
						"example": "wallet",
						"type": ["string", "null"]
					},
					"id": {
						"description": "Trade ID, prefixed `tint_`.",
						"example": "tint_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"instrument_type": {
						"description": "`perpetual` or `spot` for an order, `perpetual` for a close. `null` for a deposit or withdraw.",
						"enum": ["perpetual", "spot", null],
						"example": "perpetual",
						"type": ["string", "null"]
					},
					"leverage": {
						"description": "The cross leverage set before an opening perpetual order. `null` for a spot order, close, deposit, withdraw or reduce-only order.",
						"example": 10,
						"type": ["integer", "null"]
					},
					"market": {
						"description": "The market, for example `BTC` for a perpetual or `HYPE/USDC` for spot. `null` for a deposit or withdraw.",
						"example": "BTC",
						"type": ["string", "null"]
					},
					"metadata": {
						"description": "Free-form string-to-string annotations stored on the trade.",
						"example": {},
						"type": "object"
					},
					"object": {
						"enum": ["trade"],
						"example": "trade",
						"type": "string"
					},
					"order_type": {
						"description": "`market` or `limit` for an order. `null` otherwise.",
						"enum": ["market", "limit", null],
						"example": "market",
						"type": ["string", "null"]
					},
					"price": {
						"description": "The limit price of the order in USD. A market order's price is the mid price moved by `slippage_bps`. `null` for other types.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/Money"
							},
							{
								"type": "null"
							}
						]
					},
					"reduce_only": {
						"description": "Whether the order can only reduce a position. `null` for other types.",
						"example": null,
						"type": ["boolean", "null"]
					},
					"side": {
						"description": "`buy` or `sell` for an order. `null` otherwise.",
						"enum": ["buy", "sell", null],
						"example": "buy",
						"type": ["string", "null"]
					},
					"size": {
						"description": "The order size in units of the market, as a decimal string. `null` for other types.",
						"example": null,
						"type": ["string", "null"]
					},
					"status": {
						"description": "`pending` until the trade starts. `processing` while it runs, also while an order that did not fill sends the money it bridged in back to the wallet. `completed` when it did what was asked. `failed` when it did not; `funds_location` says where the money is. `in_review` when the outcome is unknown and a person checks it.",
						"enum": [
							"pending",
							"processing",
							"in_review",
							"completed",
							"failed"
						],
						"example": "pending",
						"type": "string"
					},
					"status_detail": {
						"description": "`partial_fill` when the order filled only part of its size. `null` otherwise.",
						"enum": ["partial_fill", null],
						"example": "partial_fill",
						"type": ["string", "null"]
					},
					"type": {
						"description": "`order` places one order from the trading balance. `deposit` bridges USDT0 from the wallet to the trading balance. `withdraw` sends USDC from the trading balance back to the wallet. `close` closes the whole position in one market with a market reduce-only order; when the account is then flat, a `withdraw` trade sends the trading balance back to the wallet.",
						"enum": ["close", "order", "deposit", "withdraw"],
						"example": "order",
						"type": "string"
					},
					"updated_at": {
						"description": "When the trade last changed, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"user_id": {
						"description": "The user who owns the trading wallet, prefixed `user_`. `null` when an account owns it.",
						"example": null,
						"type": ["string", "null"]
					}
				},
				"required": [
					"id",
					"type",
					"status",
					"status_detail",
					"account_id",
					"user_id",
					"instrument_type",
					"market",
					"side",
					"order_type",
					"size",
					"price",
					"reduce_only",
					"leverage",
					"amount",
					"filled_size",
					"average_price",
					"funds_location",
					"failure_code",
					"client_order_id",
					"metadata",
					"created_at",
					"updated_at",
					"completed_at",
					"object"
				],
				"type": "object"
			},
			"TradingAccount": {
				"properties": {
					"account_id": {
						"description": "The account that owns this trading account, prefixed `biz_`. `null` when a user owns it.",
						"type": ["string", "null"]
					},
					"hyperliquid": {
						"description": "Hyperliquid-specific state. Present when `provider` is `hyperliquid`, otherwise `null`.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/TradingHyperliquidAccount"
							},
							{
								"type": "null"
							}
						]
					},
					"id": {
						"description": "The Whop wallet ID backing this trading account, prefixed `cwal_`.",
						"type": "string"
					},
					"object": {
						"enum": ["trading_account"],
						"example": "trading_account",
						"type": "string"
					},
					"provider": {
						"description": "Trading venue that holds the positions and orders.",
						"enum": ["hyperliquid"],
						"example": "hyperliquid",
						"type": "string"
					},
					"user_id": {
						"description": "The user who owns this trading account, prefixed `user_`. `null` when an account owns it.",
						"type": ["string", "null"]
					}
				},
				"required": [
					"object",
					"id",
					"account_id",
					"user_id",
					"provider",
					"hyperliquid"
				],
				"type": "object"
			},
			"TradingHyperliquidAccount": {
				"properties": {
					"address": {
						"description": "Lowercase wallet address that holds the Hyperliquid account.",
						"type": "string"
					},
					"websocket_subscriptions": {
						"items": {
							"$ref": "#/components/schemas/TradingWebsocketSubscription",
							"description": "Subscriptions for live account updates. Send each `message` unchanged after connecting to `websocket_url`."
						},
						"type": "array"
					},
					"websocket_url": {
						"description": "Hyperliquid WebSocket URL to connect to directly for live updates.",
						"type": "string"
					}
				},
				"required": ["address", "websocket_url", "websocket_subscriptions"],
				"type": "object"
			},
			"TradingWebsocketSubscription": {
				"properties": {
					"channel": {
						"description": "The live update stream this subscription opens.",
						"enum": [
							"clearinghouse_state",
							"open_orders",
							"order_updates",
							"user_fills",
							"user_events"
						],
						"example": "clearinghouse_state",
						"type": "string"
					},
					"message": {
						"description": "JSON subscription message to send unchanged over the Hyperliquid WebSocket.",
						"type": "string"
					}
				},
				"required": ["channel", "message"],
				"type": "object"
			},
			"User": {
				"properties": {
					"balance": {
						"description": "The user's balance: personal cash + other holdings + deposits still in flight, plus account balances for accounts they own. Computed only on the self view (retrieved with the reserved id `me`) for callers with balance-read scope; `null` otherwise, or when `include_balance=false`.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/UserBalance"
							},
							{
								"type": "null"
							}
						]
					},
					"balance_history": {
						"description": "The user's cumulative wallet balance over time (USD `{ t, v }` points plus last/min/max), for the balance chart. Opt in with `include_balance_history=true` when retrieving yourself with the reserved id `me`; populated only for callers with balance-read scope and `null` otherwise. A user with no wallet activity returns an empty series.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/UserBalanceHistory"
							},
							{
								"type": "null"
							}
						]
					},
					"balances": {
						"items": {
							"$ref": "#/components/schemas/AccountBalanceToken",
							"description": "The user's personal holdings, each with its USD value and breakdown, in the same shape as an account's `balances`. Empty when `total_usd` is `null`."
						},
						"type": "array"
					},
					"banner": {
						"description": "The user's profile banner wrapper. `null` when the user has no banner.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/UserBanner"
							},
							{
								"type": "null"
							}
						]
					},
					"bio": {
						"description": "The user's biography",
						"example": "Ceramic coating specialist. Detailing cars in Austin since 2016.",
						"type": ["string", "null"]
					},
					"cards": {
						"description": "Where the user's personal card application stands. Populated only on the self view (retrieved with the reserved id `me`) for callers with balance-read scope; `null` otherwise, or when the user has never applied for a card.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/AccountCards"
							},
							{
								"type": "null"
							}
						]
					},
					"created_at": {
						"description": "When the user was created, as an ISO 8601 timestamp",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"earnings_usd": {
						"description": "The user's gross USD income over time, including a Partner commission breakdown. Populated only on single-user self reads for callers with balance-read scope; `null` otherwise.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/UserEarnings"
							},
							{
								"type": "null"
							}
						]
					},
					"email": {
						"description": "The user's email address. Populated only on the self view (retrieved with the reserved id `me`) for callers with email-read scope; `null` otherwise, or while the account has no confirmed email yet.",
						"example": "marcus@shinetime.example",
						"type": ["string", "null"]
					},
					"id": {
						"description": "User ID, prefixed `user_`.",
						"example": "user_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"level": {
						"description": "The user's Whop Levels progress, counted across every account they own. Populated only on the self view (retrieved with the reserved id `me`) for callers with balance-read scope; `null` otherwise, and when none of their accounts are in Whop Levels.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/OwnerLevel"
							},
							{
								"type": "null"
							}
						]
					},
					"name": {
						"description": "The user's display name",
						"example": "Marcus Webb",
						"type": ["string", "null"]
					},
					"profile_picture": {
						"$ref": "#/components/schemas/UserProfilePicture",
						"description": "Avatar wrapper; its `url` is always present, using a generated placeholder when the user set no picture."
					},
					"social_links": {
						"items": {
							"$ref": "#/components/schemas/UserSocialLink",
							"description": "The social accounts and websites on the user's public profile. Empty when the user has none."
						},
						"type": "array"
					},
					"total_usd": {
						"description": "Total USD value of the user's personal holdings in `balances`, across those with known exchange rates. Computed only on the self view (retrieved with the reserved id `me`) for callers with balance-read scope; `null` otherwise, when `include_balance=false`, or when the balance source is unavailable.",
						"example": "6320.75",
						"type": ["string", "null"]
					},
					"trading": {
						"description": "The trading account address and its WebSocket subscriptions. Opt in with `include_trading=true` when retrieving `me`. `null` otherwise, without trading permission, or without an Ethereum wallet.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/TradingAccount"
							},
							{
								"type": "null"
							}
						]
					},
					"username": {
						"description": "The user's unique username",
						"example": "marcuswebb",
						"type": "string"
					},
					"verification": {
						"description": "Identity verification status for the user's `individual` (KYC) and `business` (KYB) profiles. Each is `null` until created, otherwise a `status` of `not_started`, `pending`, `approved`, or `rejected`.",
						"example": {
							"business": null,
							"individual": null
						},
						"type": "object"
					},
					"whop_partner_enabled_at": {
						"description": "When the user became an enrolled Whop Partner, as an ISO 8601 timestamp. `null` if never enrolled.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"whop_partner_onboarded_accounts_count": {
						"description": "Number of accounts the user referred to Whop as a Whop Partner that have processed more than $1 in volume attributed to the user. Populated only when retrieving a single user who is a Verified Whop Partner; `null` otherwise.",
						"example": 1,
						"type": ["integer", "null"]
					},
					"whop_partner_verified_at": {
						"description": "When the user became a Verified Whop Partner, as an ISO 8601 timestamp. `null` for users who are not Verified Whop Partners, including partners who left the program and suspended users.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					}
				},
				"required": [
					"id",
					"username",
					"name",
					"bio",
					"created_at",
					"profile_picture",
					"banner",
					"email",
					"balance",
					"total_usd",
					"balances",
					"earnings_usd",
					"balance_history",
					"cards",
					"trading",
					"level",
					"verification",
					"whop_partner_enabled_at",
					"whop_partner_verified_at",
					"whop_partner_onboarded_accounts_count",
					"social_links"
				],
				"type": "object"
			},
