		"/partners/referred_users": {
			"get": {
				"description": "Lists the users the caller referred onto Whop, newest first by default, each with the caller's total affiliate earnings from that user across all tiers.",
				"operationId": "referred_users",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "The selected referring partner's user_ ID. Requires user_id=global; cannot be combined with earning_partner_username.",
						"in": "query",
						"name": "earning_partner_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "The selected referring partner's exact username. Requires user_id=global; cannot be combined with earning_partner_id.",
						"in": "query",
						"name": "earning_partner_username",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "List the users this business's team members referred, past members included, instead of the caller's own. Requires company:basic:read on that business, which every team member holds, and cannot be combined with user_id. The owner role reads every team member's referrals; anyone else reads only their own and those of the people under them in the org chart. earning_partner_id or earning_partner_username then narrows to one team member.",
						"in": "query",
						"name": "referring_account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Search referred users by name or username. In global mode, matches the beginning of usernames only.",
						"in": "query",
						"name": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "When true, only referred users who brought at least one business onto Whop.",
						"in": "query",
						"name": "has_businesses",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "When true, only referred users with at least one business that has generated earnings.",
						"in": "query",
						"name": "has_earning_businesses",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "The field to sort by. created_at uses the user's signup date; earnings_usd uses the current primary referrer's cached total affiliate earnings from that user.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"default": "created_at",
							"enum": ["created_at", "earnings_usd"],
							"type": "string"
						}
					},
					{
						"description": "The direction to sort results.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"default": "desc",
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"properties": {
													"business_count": {
														"description": "Number of active businesses this user referred that credit the caller as a second-tier partner, or any earning partner in global mode. An earning-partner filter narrows the count to that partner. Excludes deleted businesses.",
														"example": 1,
														"type": "integer"
													},
													"earnings": {
														"$ref": "#/components/schemas/Money",
														"description": "Total pending and completed affiliate earnings from this user for their current primary referrer, across all tiers, in USD. Includes historical earnings from removed referrals and deleted businesses."
													},
													"joined_at": {
														"description": "When the referred user joined Whop, as an ISO 8601 timestamp.",
														"example": "2026-01-01T12:00:00.000Z",
														"format": "date-time",
														"type": "string"
													},
													"total_earnings_usd": {
														"example": "10.00",
														"type": "string"
													},
													"total_volume_usd": {
														"example": "100.00",
														"type": "string"
													},
													"user": {
														"properties": {
															"city": {
																"example": "Austin",
																"type": ["string", "null"]
															},
															"country": {
																"example": "US",
																"type": ["string", "null"]
															},
															"email": {
																"description": "The referred user's email address, so a partner can follow up with someone they brought onto Whop. Requires the `partner:email:read` scope; `null` without it, or while the account has no reachable address of its own.",
																"example": "marcus@shinetime.example",
																"type": ["string", "null"]
															},
															"id": {
																"example": "user_xxxxxxxxxxxxxx",
																"type": "string"
															},
															"name": {
																"example": "Tanya Cole",
																"type": ["string", "null"]
															},
															"profile_picture": {
																"properties": {
																	"url": {
																		"example": "https://ui-avatars.com/api/",
																		"type": ["string", "null"]
																	}
																},
																"type": "object"
															},
															"username": {
																"example": "tanyacole",
																"type": "string"
															}
														},
														"required": ["id", "username", "email"],
														"type": "object"
													},
													"volume_30d": {
														"$ref": "#/components/schemas/Money",
														"description": "Attributed volume over the last 30 days across the business referrals included in business_count, in USD."
													}
												},
												"required": [
													"total_earnings_usd",
													"total_volume_usd",
													"business_count",
													"volume_30d",
													"earnings",
													"joined_at",
													"user"
												],
												"type": "object"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": null,
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												}
											},
											"required": [
												"has_next_page",
												"end_cursor",
												"has_previous_page",
												"start_cursor"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "referred users listed"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "invalid sort field"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "partner selection is not authorized"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "selected partner not found"
					}
				},
				"security": [
					{
						"oauthTokenAuth": ["partner:basic:read"]
					},
					{
						"oauthTokenAuth": ["referral:basic:read"]
					}
				],
				"summary": "List the users the caller referred",
				"tags": ["Partners"],
				"x-whop-credentials": ["oauth_token"],
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.partners.referredUsers();\n"
					}
				],
				"x-mint": {
					"metadata": {
						"title": "List the Users the Caller Referred",
						"sidebarTitle": "List the Users the Caller Referred"
					}
				}
			}
		},
		"/partners/{id}": {
			"get": {
				"description": "Retrieves the authenticated user's partner profile: enrollment and verification status, certification completion, active direct business referral count, and default payout rates. Other users' profiles are not accessible. To create and manage referral links, use `/partner_referral_requests`.",
				"operationId": "retrieve",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Partner"
								}
							}
						},
						"description": "partner retrieved"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "missing partner read scope"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "partner is not accessible"
					}
				},
				"security": [
					{
						"oauthTokenAuth": ["partner:basic:read"]
					},
					{
						"oauthTokenAuth": ["referral:basic:read"]
					}
				],
				"summary": "Retrieve a partner",
				"tags": ["Partners"],
				"x-whop-credentials": ["oauth_token"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Retrieve",
						"title": "Retrieve a Partner"
					}
				},
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "The authenticated partner's user ID, prefixed user_, or me. Other users' profiles are not accessible.",
						"example": "me",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
		"/payment_quotes": {
			"post": {
				"description": "Prices a purchase the way a payment for it will be charged. The body is the `PaymentInput` a payment takes plus where the buyer is, which a seller that collects no tax on the purchase can leave out. The purchase is priced from exactly what you send: no buyer is looked up, so no stored registration or purchase history applies. Pass the quote's `id` as `quote_id` when you create the payment to charge exactly the purchase, promo code, and tax shown here. A quote is priced once and may be consumed by one payment before `expires_at`. Cart entries must name existing variants with `plan_id`.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "The account the purchase belongs to, prefixed `biz_`.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"plan": {
										"description": "The variant purchased, described by its attributes instead of an id: the variant with exactly these attributes is used, and one is created when none exists. Mutually exclusive with `plan_id` and `line_items`. Creating a variant requires `plan:create`; creating or updating a product requires the corresponding product permission.",
										"properties": {
											"allow_multiple_quantity": {
												"description": "Whether more than one unit can be purchased in an order.",
												"type": ["boolean", "null"]
											},
											"application_fee_amount": {
												"description": "Application fee the platform collects per unit, in the variant currency (5.00 means $5.00 for USD). Must be positive and below the initial price for one-time variants or renewal price for recurring variants. Paid to the parent account alongside other processing fees; collection is capped to remaining proceeds. Applies to subsequent payments on recurring variants. Only valid for connected accounts with a parent account.",
												"example": 2,
												"type": ["number", "null"]
											},
											"billing_period": {
												"description": "Recurring billing interval in days.",
												"type": ["integer", "null"]
											},
											"currency": {
												"description": "Currency code for the variant prices.",
												"enum": [
													"usd",
													"sgd",
													"inr",
													"aud",
													"brl",
													"cad",
													"dkk",
													"eur",
													"nok",
													"gbp",
													"sek",
													"chf",
													"hkd",
													"huf",
													"jpy",
													"mxn",
													"myr",
													"pln",
													"czk",
													"nzd",
													"aed",
													"eth",
													"ape",
													"cop",
													"ron",
													"thb",
													"bgn",
													"idr",
													"dop",
													"php",
													"try",
													"krw",
													"twd",
													"vnd",
													"pkr",
													"clp",
													"uyu",
													"ars",
													"zar",
													"dzd",
													"tnd",
													"mad",
													"kes",
													"kwd",
													"jod",
													"all",
													"xcd",
													"amd",
													"bsd",
													"bhd",
													"bob",
													"bam",
													"khr",
													"crc",
													"xof",
													"egp",
													"etb",
													"gmd",
													"ghs",
													"gtq",
													"gyd",
													"ils",
													"jmd",
													"mop",
													"mga",
													"mur",
													"mdl",
													"mnt",
													"nad",
													"ngn",
													"mkd",
													"omr",
													"pyg",
													"pen",
													"qar",
													"rwf",
													"sar",
													"rsd",
													"lkr",
													"tzs",
													"ttd",
													"uzs",
													"rub",
													"btc",
													"cny",
													"usdt",
													"kzt",
													"awg",
													"whop_usd",
													"xau"
												],
												"example": "usd",
												"type": "string"
											},
											"description": {
												"description": "Variant description.",
												"type": ["string", "null"]
											},
											"expiration_days": {
												"description": "Days until access expires.",
												"type": ["integer", "null"]
											},
											"force_create_new_plan": {
												"description": "Create a new variant instead of reusing a matching variant.",
												"type": ["boolean", "null"]
											},
											"initial_price": {
												"description": "Additional amount charged on the first purchase, in the variant currency. For recurring variants without a trial, the first charge includes this amount plus renewal_price.",
												"example": 31,
												"type": ["number", "null"]
											},
											"internal_notes": {
												"description": "Internal notes for the account.",
												"type": ["string", "null"]
											},
											"override_tax_type": {
												"description": "Whether the variant's price includes tax: `inclusive` (tax is included in the price), `exclusive` (tax is added on top), or `unspecified`. Omit it or pass `null` to use the account's tax setting. On an account enrolled in the Whop tax service, `inclusive` or `exclusive` replaces the account's setting and `unspecified` keeps it. Otherwise it applies only where the account is the merchant of record: `inclusive` or `exclusive` replaces the account's setting when the account collects tax, and `unspecified` means the variant collects no tax. Where Whop is the merchant of record, the account's setting applies. Variants that differ only in this value are different variants.",
												"enum": [null, "exclusive", "inclusive", "unspecified"],
												"example": "inclusive",
												"type": ["string", "null"]
											},
											"plan_type": {
												"description": "Billing model for the variant.",
												"enum": [null, "renewal", "one_time"],
												"example": "one_time",
												"type": ["string", "null"]
											},
											"product": {
												"description": "Find or create a product by external identifier. Mutually exclusive with product_id.",
												"properties": {
													"collect_shipping_address": {
														"description": "Whether to collect a shipping address at checkout.",
														"example": true,
														"type": ["boolean", "null"]
													},
													"custom_statement_descriptor": {
														"description": "Custom card statement descriptor for the product, starting with WHOP*.",
														"example": "WHOP*INLINE",
														"type": ["string", "null"]
													},
													"description": {
														"description": "Product description.",
														"example": "Quoted, then sent with the payment.",
														"type": ["string", "null"]
													},
													"external_identifier": {
														"description": "Your unique identifier for the product.",
														"example": "quoted-again",
														"pattern": "\\S",
														"type": "string"
													},
													"global_affiliate_percentage": {
														"description": "Percentage of revenue paid to global affiliates.",
														"type": ["number", "null"]
													},
													"global_affiliate_status": {
														"description": "Global affiliate program status.",
														"enum": [null, "enabled", "disabled"],
														"example": "enabled",
														"type": ["string", "null"]
													},
													"headline": {
														"description": "Product headline.",
														"example": "Product headline",
														"type": ["string", "null"]
													},
													"product_tax_code_id": {
														"description": "Product tax code identifier.",
														"type": ["string", "null"]
													},
													"redirect_purchase_url": {
														"description": "Where to redirect the buyer after purchase.",
														"example": "https://example.com/thanks",
														"type": ["string", "null"]
													},
													"route": {
														"description": "Product route.",
														"type": ["string", "null"]
													},
													"title": {
														"description": "Product title.",
														"example": "Quoted again",
														"pattern": "\\S",
														"type": "string"
													},
													"visibility": {
														"default": "hidden",
														"description": "Product visibility. Defaults to hidden.",
														"enum": [
															"visible",
															"hidden",
															"archived",
															"quick_link"
														],
														"example": "visible",
														"type": "string"
													}
												},
												"required": ["external_identifier", "title"],
												"type": ["object", "null"]
											},
											"product_id": {
												"description": "Existing product ID belonging to the account, prefixed `prod_`. Mutually exclusive with `product`.",
												"example": "prod_xxxxxxxxxxxxxx",
												"type": ["string", "null"]
											},
											"renewal_price": {
												"description": "Recurring price in the variant currency.",
												"type": ["number", "null"]
											},
											"title": {
												"description": "Variant title.",
												"type": ["string", "null"]
											},
											"trial_period_days": {
												"description": "Free trial days before renewal.",
												"type": ["integer", "null"]
											},
											"visibility": {
												"description": "Whether the variant is visible to customers.",
												"enum": [
													null,
													"visible",
													"hidden",
													"archived",
													"quick_link"
												],
												"example": "visible",
												"type": ["string", "null"]
											}
										},
										"required": ["currency"],
										"type": "object"
									},
									"plan_id": {
										"description": "The variant purchased, prefixed `plan_`. It must belong to the account. Mutually exclusive with `plan` and `line_items`.",
										"example": "plan_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"promo_code": {
										"description": "The promo code as the buyer typed it, matched within the account regardless of case and surrounding spaces, as checkout matches it. It must be valid for the variant. Send it or `promo_code_id`, not both; an empty or whitespace-only string counts as not sent. A code the account does not have, or one that is no longer active, is refused before anything is written, with the error code `promo_invalid`. A code this purchase cannot use, such as one with no uses left or one restricted to other variants, products or buyers, is refused with `promo_invalid` too, and the error's message says why.",
										"example": "SHINE20",
										"type": ["string", "null"]
									},
									"promo_code_id": {
										"description": "An active promo code to apply, prefixed `promo_`. It must belong to the account and be valid for the variant. Send it or `promo_code`, not both. A code this purchase cannot use is refused with the error code `promo_invalid`, and the error's message says why.",
										"example": "promo_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"address": {
										"description": "The buyer's billing address. Where tax is calculated when no shipping address is given, and the address a tax registration belongs to. A seller that collects tax on this purchase needs the buyer located by a `country` here, on `shipping_address`, a `presentment_country`, or an `ip_address`; without one the quote is refused with `quote_location_required`. Only the keys you supply are kept. The payment that consumes the quote must put the buyer in the same place, by country, state and postal code, through its own `shipping_address` or its confirmation token's billing address, or it is refused with `quote_mismatch`.",
										"properties": {
											"city": {
												"description": "City name.",
												"example": "Austin",
												"type": ["string", "null"]
											},
											"country": {
												"description": "ISO 3166-1 alpha-2 country code, such as `US`.",
												"example": "US",
												"type": ["string", "null"]
											},
											"line1": {
												"description": "First line of the street address.",
												"example": "1114 Bouldin Ave",
												"type": ["string", "null"]
											},
											"line2": {
												"description": "Second line of the street address.",
												"example": "Unit B",
												"type": ["string", "null"]
											},
											"name": {
												"description": "The full name on the address.",
												"example": "Dana Whitfield",
												"type": ["string", "null"]
											},
											"postal_code": {
												"description": "Postal or ZIP code.",
												"example": "78704",
												"type": ["string", "null"]
											},
											"state": {
												"description": "State, province, or region code, such as `CA`.",
												"example": "TX",
												"type": ["string", "null"]
											}
										},
										"type": ["object", "null"]
									},
									"ip_address": {
										"description": "The buyer's IP address, when your server makes the call on their behalf. Locates the buyer when neither address carries a country and no `presentment_country` is sent. A quote located this way (`located_by` is `ip_address`) is a preview: a payment refuses it with `quote_preview_only`, so quote again with the buyer's address before paying. Also where `presentment_currency` `auto` and `recommended_currencies` find the buyer's local currency, and where a payment method must be able to collect it.",
										"example": "203.0.113.7",
										"type": ["string", "null"]
									},
									"line_items": {
										"description": "What the buyer is purchasing. Each entry names an existing variant by plan_id. Several entries form a cart, which requires every variant to be compatible, belong to this account, and use the same currency.",
										"example": [
											{
												"plan_id": "plan_xxxxxxxxxxxxxx",
												"quantity": 1
											}
										],
										"items": {
											"properties": {
												"plan_id": {
													"description": "An existing variant to charge for, prefixed `plan_`. Each variant may appear once — use `quantity` for multiple units.",
													"example": "plan_xxxxxxxxxxxxxx",
													"type": "string"
												},
												"quantity": {
													"description": "How many units of the variant to purchase. Defaults to 1; more than 1 requires the variant to allow multiple quantities.",
													"example": 1,
													"maximum": 999999,
													"minimum": 1,
													"type": ["integer", "null"]
												}
											},
											"required": ["plan_id"],
											"type": "object"
										},
										"maxItems": 50,
										"minItems": 1,
										"type": "array"
									},
									"presentment_country": {
										"description": "The country to price the purchase for, as an ISO 3166-1 alpha-2 code such as `JP`, when the buyer chose one: a store's country picker. Prices in the currency `auto` would pick for a buyer in that country, so send it instead of `presentment_currency`, never with it. Whether a payment method can collect that currency is still judged where the buyer is: by `ip_address`, and by this country only without one. With no address that carries a country, tax is estimated for this country (`located_by` is `presentment_country`) at the country level, and a quote located this way is a preview a payment refuses with `quote_preview_only`. Send it only once the buyer has chosen a country: without it, an `ip_address` estimates more precisely, such as for a US state. For a country Whop has no currency for, the quote is priced as `auto` for the buyer's `ip_address`, and tax is still estimated for the country.",
										"example": "JP",
										"type": ["string", "null"]
									},
									"presentment_currency": {
										"description": "The currency to price and charge the purchase in. Omit it, or send null, to price in the variants' own currency. `auto` prices in the currency of the country Whop places the buyer's `ip_address` in when the purchase can be converted into it and a payment method can collect it, and in the variants' own currency otherwise, including when no `ip_address` is sent or Whop cannot place it in a country. To choose that country instead, send `presentment_country` in place of this. A three-letter ISO 4217 code, such as `eur`, prices in that currency or is refused: with `presentment_currency_unsupported` when the purchase cannot be converted into it (adaptive pricing is off for the variant, the variant is not a one-time purchase, or `plan` describes a variant that does not exist yet), and with `presentment_currency_not_payable` when no payment method can collect it. A converted quote states every amount in this currency at an `exchange_rate` fixed until `expires_at`, and the payment that consumes it is charged in this currency at that rate.",
										"example": "auto",
										"type": ["string", "null"]
									},
									"shipping_address": {
										"description": "Where physical goods ship. When present it is where tax is calculated; omit it for digital goods. Only the keys you supply are kept. The payment that consumes the quote must ship to the same place, by country, state and postal code, or it is refused with `quote_mismatch`.",
										"properties": {
											"city": {
												"description": "City name.",
												"type": ["string", "null"]
											},
											"country": {
												"description": "ISO 3166-1 alpha-2 country code, such as `US`.",
												"type": ["string", "null"]
											},
											"line1": {
												"description": "First line of the street address.",
												"type": ["string", "null"]
											},
											"line2": {
												"description": "Second line of the street address.",
												"type": ["string", "null"]
