																		"description": "The user's profile picture URL.",
																		"example": "https://ui-avatars.com/api/",
																		"type": "string"
																	}
																},
																"required": ["url"],
																"type": "object"
															},
															"username": {
																"description": "The user's unique username. Present only on the caller's own entry.",
