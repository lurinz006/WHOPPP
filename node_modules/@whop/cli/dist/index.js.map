					"state": {
						"description": "`ready` while the code waits to be used. `pending` once it has: Whop removes the domain's email, Apple Pay and pixel from this account, then moves the registration and removes the domain from this account.",
						"enum": ["ready", "pending"],
						"example": "ready",
						"type": "string"
					}
				},
				"required": ["destination", "state", "code"],
				"type": "object"
			},
