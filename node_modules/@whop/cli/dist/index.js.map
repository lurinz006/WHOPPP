		"/payment_rules/{id}/replace": {
			"post": {
				"description": "Changes a payment rule's `action` and `conditions` by deleting it and creating its successor in one step. The successor has a new ID and keeps the replaced rule's name, metadata, and `active` or `inactive` status.",
				"operationId": "replace",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "The payment rule ID.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"additionalProperties": false,
								"properties": {
									"action": {
										"description": "What this account's rule requests when every condition matches. One applicable account-rule action wins, in this order: `allow`, `block`, `review`, `enforce_3ds`. An `allow` overrides this account's other rules, never Whop's own fraud controls. A `review` requests authorization without capture for an eligible on-session card payment through Whop Payments. Automatic capture is scheduled for 48 hours after authorization; capture or void the payment before then to decide sooner. Capture may complete later or fail. Review is skipped for unsupported methods, off-session payments, and payments already configured for manual capture. An `enforce_3ds` is skipped when the account rule cannot apply a challenge. Other 3DS requirements still apply.",
										"enum": ["allow", "block", "review", "enforce_3ds"],
										"example": "review",
										"type": "string"
									},
									"conditions": {
										"additionalProperties": false,
										"description": "The conditions a payment is matched against. Up to 10 conditions, and 8 KiB once serialized.",
										"example": {
											"all": [
												{
													"field": "risk_score",
													"operator": "gte",
													"value": 70
												}
											]
										},
										"properties": {
											"all": {
												"items": {
													"additionalProperties": false,
													"properties": {
														"field": {
															"description": "The payment attribute this condition reads.",
															"enum": [
																"risk_score",
																"amount_in_usd",
																"card_country",
																"card_brand",
																"card_funding",
																"card_bin",
																"billing_country",
																"billing_postal_code",
																"billing_city",
																"customer_email",
																"email_domain",
																"ip_address",
																"ip_country"
															],
															"example": "risk_score",
															"type": "string"
														},
														"operator": {
															"description": "How the payment attribute is compared to the value.",
															"enum": [
																"eq",
																"neq",
																"gt",
																"gte",
																"lt",
																"lte",
																"in",
																"not_in",
																"starts_with",
																"contains",
																"ends_with",
																"in_cidr"
															],
															"example": "gte",
															"type": "string"
														},
														"value": {
															"$ref": "#/components/schemas/PaymentRuleConditionValue"
														}
													},
													"required": ["field", "operator", "value"],
													"type": "object"
												},
												"maxItems": 10,
												"minItems": 1,
												"type": "array"
											}
										},
										"required": ["all"],
										"type": "object"
									}
								},
								"required": ["action", "conditions"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentRule"
								}
							}
						},
						"description": "The rule that replaced this one"
					},
					"409": {
						"$ref": "#/components/responses/Conflict",
						"description": "The rule was already replaced or deleted"
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				],
				"summary": "Replace a payment rule",
				"tags": ["Payment Rules"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Replace",
						"title": "Replace a Payment Rule"
					}
				}
			}
		},
		"/payments": {
			"get": {
				"description": "Lists payments, newest first. By default, returns sales for the accounts your credential can read: an account credential's own account, or every account a user can read payments for. Set `mode` to `user_sales` to list the sales the signed-in user received personally, outside any account.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Which sales to list. `account_sales` returns sales for the accounts the caller can read. `user_sales` returns only sales the signed-in user received personally, outside any account; it requires the user's own Whop login session and cannot be combined with `account_id`.",
						"in": "query",
						"name": "mode",
						"required": false,
						"schema": {
							"default": "account_sales",
							"enum": ["account_sales", "user_sales"],
							"type": "string"
						}
					},
					{
						"description": "Only payments charged by this account, prefixed `biz_`.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only payments in this lifecycle state.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": [
								"open",
								"authorized",
								"paid",
								"pending",
								"uncollectible",
								"unresolved",
								"void"
							],
							"type": "string"
						}
					},
					{
						"description": "Only payments whose most recently attached kept shipment is in this tracking state. `missing_tracking` selects paid payments with a captured shipping address and no kept shipment, excluding fully refunded payments. `needs_tracking` selects payments with an open pre-shipment funds hold and no kept shipment. Shipment states do not imply a payment or refund state. Requires `shipment:basic:read` as well as `payment:basic:read`; user-wide lists include only accounts readable under both scopes. Only supported with `mode=account_sales`.",
						"in": "query",
						"name": "tracking_status",
						"required": false,
						"schema": {
							"enum": [
								"unknown",
								"pre_transit",
								"in_transit",
								"out_for_delivery",
								"delivered",
								"available_for_pickup",
								"return_to_sender",
								"failure",
								"cancelled",
								"error",
								"needs_tracking",
								"missing_tracking"
							],
							"type": "string"
						}
					},
					{
						"description": "Only payments charged for this reason. `subscription_cycle` also matches renewals recorded as `subscription_update`.",
						"in": "query",
						"name": "billing_reason",
						"required": false,
						"schema": {
							"enum": [
								"subscription_create",
								"subscription_cycle",
								"subscription_update",
								"one_time",
								"manual",
								"subscription"
							],
							"type": "string"
						}
					},
					{
						"description": "Only payments presented in this three-letter currency, such as `usd`.",
						"in": "query",
						"name": "currency",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only payments made by this buyer, prefixed `user_`. This filters sales the caller can read, so `me` is not accepted; list the caller's own purchases with `GET /memberships?user_id=me`.",
						"in": "query",
						"name": "user_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Search payments by payment ID, dispute ID, user ID, membership ID, user email, name, or username. Email filtering requires the member:email:read permission.",
						"in": "query",
						"name": "query",
						"required": false,
						"schema": {
							"description": "Search payments by payment ID, dispute ID, user ID, membership ID, user email, name, or username. Email filtering requires the member:email:read permission.",
							"type": "string"
						}
					},
					{
						"description": "Also cover the account's connected accounts. Requires `account_id`, and is a 400 without it. Without `query`, lists the payments of the account and every connected account, newest first by `created_at` only; another `order` is a 400. The listing is cut off after 10 seconds, which a rare filter on an account with little recent activity can reach; add a `query` to narrow it. With `query`, matches on payment, dispute, user or membership ID, buyer email, or a card's first 6 or 8 digits and last 4 separated by a space or dash (`424242 4242`); free-text queries such as a name search only the named account. Connected accounts' payments are returned only for connected accounts you can read payments on.",
						"in": "query",
						"name": "include_connected_accounts",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "Only payments made by this member, prefixed `mber_`.",
						"in": "query",
						"name": "member_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only payments billed under this membership, prefixed `mem_`.",
						"in": "query",
						"name": "membership_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only payments for this product, prefixed `prod_`.",
						"in": "query",
						"name": "product_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only payments priced by this variant, prefixed `plan_`.",
						"in": "query",
						"name": "plan_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only payments created before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Only payments created after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Only payments in any of these lifecycle states, with the same meanings as `status`. Repeat the parameter to pass several. Combined with `status` when both are sent.",
						"in": "query",
						"name": "statuses",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"open",
									"authorized",
									"paid",
									"pending",
									"uncollectible",
									"unresolved",
									"void"
								],
								"example": "paid",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments whose `substatus` is any of these. Repeat the parameter to pass several. `incomplete` also matches payments that report `incomplete` because no finer status was recorded.",
						"in": "query",
						"name": "substatuses",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"succeeded",
									"requires_capture",
									"pending",
									"failed",
									"blocked",
									"past_due",
									"canceled",
									"price_too_low",
									"uncollectible",
									"refunded",
									"auto_refunded",
									"partially_refunded",
									"dispute_warning",
									"dispute_needs_response",
									"dispute_warning_needs_response",
									"resolution_needs_response",
									"dispute_under_review",
									"dispute_warning_under_review",
									"resolution_under_review",
									"dispute_won",
									"dispute_warning_closed",
									"resolution_won",
									"dispute_lost",
									"dispute_closed",
									"resolution_lost",
									"drafted",
									"incomplete",
									"unresolved"
								],
								"example": "dispute_needs_response",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments charged for any of these reasons, with the same meanings as `billing_reason`. Repeat the parameter to pass several. Combined with `billing_reason` when both are sent.",
						"in": "query",
						"name": "billing_reasons",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"subscription_create",
									"subscription_cycle",
									"subscription_update",
									"one_time",
									"manual",
									"subscription"
								],
								"example": "subscription_cycle",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments presented in any of these three-letter currencies. Repeat the parameter to pass several. Combined with `currency` when both are sent.",
						"in": "query",
						"name": "currencies",
						"required": false,
						"schema": {
							"items": {
								"example": "eur",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments priced by any of these variants, each prefixed `plan_`. Repeat the parameter to pass several. Combined with `plan_id` when both are sent.",
						"in": "query",
						"name": "plan_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "plan_xxxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments for any of these products, each prefixed `prod_`. Repeat the parameter to pass several. Combined with `product_id` when both are sent.",
						"in": "query",
						"name": "product_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "prod_xxxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments paid with any of these methods: a card brand such as `amex`, a wallet such as `apple_pay`, or a payment method type such as `paypal`. Repeat the parameter to pass several.",
						"in": "query",
						"name": "payment_methods",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"mastercard",
									"visa",
									"amex",
									"discover",
									"unionpay",
									"jcb",
