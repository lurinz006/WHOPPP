			"AdPixel": {
				"properties": {
					"account_id": {
						"description": "The business whose claimed campaigns send conversions to this pixel, prefixed `biz_`.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"created_at": {
						"description": "When the pixel was added, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"error_message": {
						"description": "Why the ad platform rejected the last delivery. Null unless `status` is `errored`.",
						"example": null,
						"type": ["string", "null"]
					},
					"external_id": {
						"description": "The pixel's ID on the ad platform: the Meta pixel or dataset ID, the TikTok pixel code, or the Google Ads customer ID.",
						"example": "111222001",
						"type": "string"
					},
					"id": {
						"description": "Ad pixel ID, prefixed `adpx_`.",
						"example": "adpx_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"name": {
						"description": "The pixel's name on the ad platform. Null when the ad platform returned none.",
						"example": "Supplier pixel",
						"type": ["string", "null"]
					},
					"platform": {
						"description": "The ad platform the pixel belongs to.",
						"enum": ["meta", "tiktok", "google"],
						"example": "meta",
						"type": "string"
					},
					"status": {
						"description": "`active` receives conversions. `errored` stopped because the ad platform rejected the access token; update the token to resume. `disabled` was turned off by Whop.",
						"enum": ["active", "errored", "disabled"],
						"example": "active",
						"type": "string"
					},
					"updated_at": {
						"description": "When the pixel was last changed, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					}
				},
				"required": [
					"id",
					"account_id",
					"platform",
					"external_id",
					"name",
					"status",
					"error_message",
					"created_at",
					"updated_at"
				],
				"type": "object"
			},
			"AdPlatformIssue": {
