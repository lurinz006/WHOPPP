		"/stats/reports": {
			"get": {
				"description": "Lists every report: the aggregates that are not bucketed over time, with the breakdowns and columns each one accepts. Use it to discover what a report can return before you retrieve it. For a bucketed series, use `GET /stats/time_series`.",
				"operationId": "list",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"properties": {
													"breakdowns": {
														"description": "The values `breakdown_by` accepts.",
														"items": {
															"example": "product_category",
															"type": "string"
														},
														"type": "array"
													},
													"columns": {
														"description": "Every property and metric the report can return.",
														"items": {
															"properties": {
																"aggregate": {
																	"description": "Metrics only. How to combine the metric across rows. `none` cannot be rebuilt from rows.",
																	"enum": ["sum", "average", "none"],
																	"example": "sum",
																	"type": "string"
																},
																"available_on": {
																	"description": "Properties only. The breakdowns this property can ride along with.",
																	"items": {
																		"example": "industry_type",
																		"type": "string"
																	},
																	"type": "array"
																},
																"breakdowns": {
																	"description": "Metrics only. The breakdowns the metric supports, or `null` for every one.",
																	"items": {
																		"type": "string"
																	},
																	"nullable": true,
																	"type": "array"
																},
																"default": {
																	"description": "Metrics only. Whether the metric is returned when `columns` is omitted.",
																	"type": "boolean"
																},
																"key": {
																	"description": "The column's key, as `columns` accepts it and as rows carry it.",
																	"example": "product_category",
																	"type": "string"
																},
																"name": {
																	"description": "The column's display name.",
																	"example": "Product category",
																	"type": "string"
																},
																"set": {
																	"description": "Properties only. `fixed` breakdowns list every value, zero-filled; `open` ones list values with activity.",
																	"enum": ["fixed", "open"],
																	"example": "open",
																	"type": "string"
																},
																"type": {
																	"description": "Whether the column is an attribute of the row or a number measured over it.",
																	"enum": ["property", "metric"],
																	"example": "property",
																	"type": "string"
																},
																"unit": {
																	"description": "Metrics only. `money` is a Money object, `rate` a decimal fraction, the rest numbers.",
																	"enum": [
																		"money",
																		"count",
																		"rate",
																		"months",
																		"years"
																	],
																	"example": "money",
																	"type": "string"
																},
																"weight": {
																	"description": "Metrics only. For `average` metrics, the column to weight by.",
																	"nullable": true,
																	"type": "string"
																},
																"windows": {
																	"description": "Metrics only. The window tokens the metric supports, or `null` for every one.",
																	"items": {
																		"type": "string"
																	},
																	"nullable": true,
																	"type": "array"
																}
															},
															"required": ["key", "name", "type"],
															"type": "object"
														},
														"type": "array"
													},
													"description": {
														"description": "What the report measures.",
														"example": "Payments across all of Whop, by business type, industry type, product category, account country or customer country.",
														"type": "string"
													},
													"key": {
														"description": "The report's key, which is also the last segment of its path.",
														"example": "platform_trends",
														"type": "string"
													},
													"path": {
														"description": "The path that retrieves the report.",
														"example": "/api/v1/stats/reports/platform_trends",
														"type": "string"
													},
													"window_field": {
														"description": "The timestamp a range window filters on, such as `paid_at`.",
														"example": "paid_at",
														"nullable": true,
														"type": "string"
													},
													"window_kind": {
														"description": "`range` reports measure activity in a period; `as_of` reports measure state at a moment.",
														"enum": ["range", "as_of"],
														"example": "range",
														"type": "string"
													}
												},
												"required": [
													"key",
													"path",
