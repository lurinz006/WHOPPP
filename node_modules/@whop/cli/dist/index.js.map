												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"nullable": true,
													"type": "string"
												}
											},
											"required": [
												"has_next_page",
												"end_cursor",
												"has_previous_page",
												"start_cursor"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
