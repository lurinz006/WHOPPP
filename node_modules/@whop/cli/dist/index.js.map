		"/economic_intelligence": {
			"get": {
				"description": "Lists an account's recommendations and generation requests, newest first by default. When no recommendations are ready or in progress and you have `company:update` permission, listing queues generation, with a ten-minute cooldown after an unsuccessful request; unsuccessful requests are not listed. An account's executed recommendations and runs stay listed after Economic Intelligence turns off, but new recommendations are offered only while it is on. For visitor countries, page views, ad impressions and clicks, or payment volume over a time range, use `GET /stats/time_series/:metric`.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Account ID, prefixed `biz_`. Defaults to the API key's own account; omit for personal onboarding, where signed-out visitors receive a business-setup template and eligible users receive their saved setup recommendation.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Filter recommendations by their current status.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": [
								"queued",
								"pending",
								"ready",
								"running",
								"executed",
								"incomplete",
								"superseded"
							],
							"type": "string"
						}
					},
					{
						"description": "What you want recommendations for, in your own words. Up to 1000 characters. Narrows the list to the recommendations that address it. Without a `status` filter, when none do and you can update the account, new recommendations start generating for your input, and the list shows that request until they're ready. Repeating the same input while it generates doesn't start another.",
						"in": "query",
						"name": "input",
						"required": false,
						"schema": {
							"maxLength": 1000,
							"type": "string"
						}
					},
					{
						"description": "When true, only recommendations someone has started running, by any user. Without `account_id`, covers every account you can read that has Economic Intelligence. Can't be combined with `input`.",
						"in": "query",
						"name": "has_run",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "Sort field.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"default": "created_at",
							"enum": ["created_at", "run_started_at"],
							"type": "string"
						}
					},
					{
						"description": "Sort direction.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"default": "desc",
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"$ref": "#/components/schemas/EconomicIntelligence"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": null,
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												}
											},
											"required": [
												"start_cursor",
												"end_cursor",
												"has_next_page",
												"has_previous_page"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "recommendations listed"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "unknown status"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "account has no recommended actions entitlement"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "account not visible to the credential"
					}
				},
				"security": [
					{
						"bearerAuth": ["company:basic:read"]
					},
					{
						"bearerAuth": ["ai_chat:create"]
					},
					{}
				],
				"summary": "List Economic Intelligence",
				"tags": ["Economic Intelligence"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "List"
					}
				}
			}
		},
		"/economic_intelligence/{id}": {
			"patch": {
				"description": "Updates a recommendation status, records feedback, or both. Send `sentiment` to rate it. Include `status: superseded` to retire a ready recommendation and request replacements; a rating alone leaves its status unchanged. To run a recommendation yourself, send `status: running` to start, then `status: executed` when it is carried out (with `result_id` naming what it changed, or `result_page` naming where it worked, so the result links there) or `status: incomplete` if the run ended without carrying it out. Whop AI reports its own runs the same way. Send `status: acknowledged` once an executed run's result has been seen.",
				"operationId": "update",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Recommendation ID, prefixed `reca_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Account ID, prefixed `biz_`. Defaults to the API key's own account.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"input": {
										"description": "What you want the replacement recommendation for, in your own words. Up to 1000 characters. Sent when superseding, it directs the generation that replaces the rejected recommendation.",
										"example": "Focus on returning buyers instead",
										"maxLength": 1000,
										"type": "string"
									},
									"result_id": {
										"description": "With `status: executed`, the ID of what the run produced or changed, and the recommendation's `result_url` becomes where to view it: an ad (`ad_`), ad group (`adgrp_`) or ad campaign (`adcamp_`), a website (`app_`), a product (`prod_`), a plan (`plan_`), a checkout link (`ch_`), a promo code (`promo_`), or an experience (`exp_`). Without `result_id` or `result_page`, `result_url` links to the resource the recommendation was about, when it names one. Send only one of `result_id`, `result_page` and `result_url`.",
										"example": "prod_xxxxxxxxxxxxx",
										"type": "string"
									},
									"result_page": {
										"description": "With `status: executed`, the page where the run's result can be seen when it is not one resource, such as the checkout links list or the store page. The recommendation's `result_url` becomes that page on the account's dashboard, or its store page for `store_page`.",
										"enum": [
											"home",
											"products",
											"ads",
											"websites",
											"checkout_links",
											"tracking_links",
											"promo_codes",
											"payments",
											"customers",
											"affiliates",
											"analytics",
											"store_page"
										],
										"example": "promo_codes",
										"type": "string"
									},
									"result_url": {
										"description": "With `status: executed`, where to view what was produced when it is outside Whop. An http or https URL. Prefer `result_id` for anything on Whop.",
										"example": "https://atlas.whop.site/",
										"maxLength": 2048,
										"type": "string"
									},
									"sentiment": {
										"description": "A signed-in user can rate a recommendation as `positive` or `negative`. Can be sent alone or together with status.",
										"enum": ["positive", "negative"],
										"example": "positive",
										"type": "string"
									},
									"status": {
										"description": "Use `running` to start a run of a ready recommendation, `executed` to record that it was carried out, `incomplete` to record that a running recommendation's run ended without carrying it out, `superseded` to reject a ready recommendation, or `acknowledged` to mark an executed run as seen; the recommendation stays `executed` and records `acknowledged_at`.",
										"enum": [
											"running",
											"executed",
											"incomplete",
											"superseded",
											"acknowledged"
										],
										"example": "superseded",
										"type": "string"
									},
									"user_feedback": {
										"description": "An optional explanation of the rating or rejection. Negative feedback informs replacement recommendations.",
										"example": "  Focus on returning buyers  ",
										"maxLength": 2000,
										"type": "string"
									}
								},
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/EconomicIntelligence"
								}
							}
						},
						"description": "recommendation superseded"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "status is not a supported transition"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "account has no recommended actions entitlement"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "unknown id, or a recommendation of another account"
					},
					"409": {
						"$ref": "#/components/responses/Conflict",
						"description": "the recommendation is not ready"
					}
				},
				"security": [
					{
						"bearerAuth": ["company:basic:read"]
					}
				],
				"summary": "Update Recommendation",
				"tags": ["Economic Intelligence"]
			}
		},
