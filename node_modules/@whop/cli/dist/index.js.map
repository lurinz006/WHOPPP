									"tarjeta_naranja",
									"cirrus",
									"nspk_mir",
									"verve",
									"ebt",
									"private_label",
									"local_brand",
									"uatp",
									"wexcard",
									"uzcard",
									"meeza",
									"hrg_store_card",
									"girocard",
									"fuel_card",
									"dankort",
									"carnet",
									"atm_card",
									"china_union_payuzcard",
									"codensa",
									"cabal",
									"hipercard",
									"jcblankapay",
									"cmi",
									"aura",
									"accel",
									"culiance",
									"nyce",
									"pulse",
									"star",
									"eftpos",
									"alelo",
