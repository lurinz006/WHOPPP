			"post": {
				"description": "Creates an experiment or feature flag in `draft` status for an account. Nothing is served until you activate it with `POST /experiments/:id/activate`. Requires `experiment:manage` on the account.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "Owning account ID. Required; ownership cannot change.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"bucket_by": {
										"description": "Randomization unit, and the only identity the assignment is keyed on — evaluation fails rather than falling back to another. `user` (default) uses `subject[user_id]`; `account` uses `subject[account_id]`, so every user of an account gets the same arm; `anonymous` uses the anonymous id and survives sign-in. Fixed after creation.",
										"enum": ["user", "account", "anonymous"],
										"example": "user",
										"type": "string"
									},
									"control": {
										"properties": {
											"related_resource": {
												"$ref": "#/components/schemas/ExperimentResourceReference",
												"nullable": true
											}
										},
										"type": "object"
									},
									"feature_flag_only": {
										"description": "When `true`, creates a binary feature flag rather than a full experiment. Feature flags expose the same evaluation API but do not collect metric results. Defaults to `false`.",
										"type": "boolean"
									},
									"flag_key": {
										"description": "Developer-chosen handle referenced from code, used in evaluation and results calls. Interchangeable with the returned `expt_` id anywhere the API takes an experiment identifier.",
										"example": "checkout_redesign_v2",
										"type": "string"
									},
									"hypothesis": {
										"description": "Required for full experiments; rejected on feature flags. Structure it as \"If we [change] for [cohort], then [measurable behavior] will [increase/decrease], resulting in [business outcome], because [evidence]. Created by [name].\" Evidence should be something real — a baseline number, a funnel breakdown — not a guess, and [name] is you, not something to leave blank.",
										"example": "If we send a blueprint nudge email 30 minutes after business creation, then GTV within 10 hours will increase among newly created businesses, resulting in more new business operators generating GTV within 10 hours, because operators currently land on an empty dashboard with no concrete next step. Created by Jane Doe.",
										"nullable": true,
										"type": "string"
									},
									"name": {
										"description": "Human-readable display name. Defaults to `flag_key` when omitted.",
										"example": "Checkout Redesign V2",
										"type": "string"
									},
									"related_resource": {
										"$ref": "#/components/schemas/ExperimentResourceReference",
										"description": "Resource owned by the account that this experiment is bound to, such as an app or product. `null` when unbound. Fixed once the experiment first activates.",
										"nullable": true
									},
									"targeting_rules": {
										"description": "Rules that determine which subjects qualify for the experiment.",
										"items": {
											"properties": {
												"conditions": {
													"description": "Conditions within this rule. Must be non-empty. All conditions must be satisfied for the rule to match (AND logic). Rules are OR-ed together.",
													"items": {
														"properties": {
															"field": {
																"description": "Property name to read from the user context. Required when `type` is `property`.",
																"nullable": true,
																"type": "string"
															},
															"operator": {
																"description": "Comparison to apply: `any`/`none` — inclusion/exclusion list; `eq`/`neq` — equality; `gt`/`gte`/`lt`/`lte` — numeric range.",
																"enum": [
																	"any",
																	"none",
																	"eq",
																	"neq",
																	"gt",
																	"gte",
																	"lt",
																	"lte"
																],
																"example": "any",
																"type": "string"
															},
															"type": {
																"description": "`user_id` — match on subject user ID; `account_id` — match on account ID (prefixed `biz_`); `property` — match on a named user property (requires `field`).",
																"enum": ["user_id", "account_id", "property"],
																"example": "user_id",
																"type": "string"
															},
															"value": {
																"description": "Value or list of values to match against. Pass an array for `any`/`none`, a scalar for the others."
															}
														},
														"required": ["type", "operator", "value"],
														"type": "object"
													},
													"type": "array"
												},
												"type": {
													"description": "`include` — users matching this rule qualify; `exclude` — users matching this rule are always excluded, overriding any include rule. Defaults to `include`.",
													"enum": ["include", "exclude"],
													"example": "include",
													"type": "string"
												}
											},
											"required": ["conditions"],
											"type": "object"
										},
										"type": "array"
									},
									"variants": {
										"description": "Treatment arms to create. Users outside every arm form the implicit `control` group. Required unless `feature_flag_only` is `true`.",
										"items": {
											"properties": {
												"name": {
													"description": "Treatment identifier. `control` is reserved for the implicit remainder.",
													"example": "treatment",
													"type": "string"
												},
												"related_resource": {
													"$ref": "#/components/schemas/ExperimentResourceReference",
													"nullable": true
												},
												"weight": {
													"description": "Percentage of all subjects assigned to this treatment. The remainder is control.",
													"example": 50,
													"type": "integer"
												}
											},
											"required": ["name", "weight"],
											"type": "object"
										},
										"type": "array"
									}
								},
								"required": ["flag_key", "account_id"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Experiment"
								}
							}
						},
						"description": "experiment created"
					},
					"409": {
						"$ref": "#/components/responses/Conflict",
						"description": "experiment key already exists"
					}
				},
				"security": [
					{
						"accountApiKeyOrAccountTokenOrAccountUserTokenOrOauthTokenAuth": []
					}
				],
				"summary": "Create Experiment",
				"tags": ["Experiments"],
				"x-whop-credentials": [
					"account_api_key",
					"account_token",
					"account_user_token",
					"oauth_token"
				],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create"
					}
				}
			}
		},
		"/experiments/exposures": {
			"get": {
				"description": "Evaluates experiments and feature flags for a subject and records an exposure. Pass `flag_key` to evaluate one flag, or omit it to evaluate every active flag in the account and related resource scope. Requires no authentication; when a credential resolves, its authentication method, API key ID, and signed-in user ID are recorded on the exposure event.\n",
				"operationId": "exposures",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Bucketing subject: the user, account, or anonymous ID the experiment's `bucket_by` assigns on. Only the identity matching `bucket_by` is used; when it is missing, evaluating a single flag fails and a batch omits that experiment. Subjects outside every treatment range receive `control`. `subject[account_id]` also enables account-level targeting rules. Experiment ownership comes from the top-level `account_id`.",
						"explode": true,
						"in": "query",
						"name": "subject",
						"required": false,
						"schema": {
							"properties": {
								"account_id": {
									"type": "string"
								},
								"anonymous_id": {
									"type": "string"
								},
								"user_id": {
									"type": "string"
								}
							},
							"type": "object"
						},
						"style": "deepObject"
					},
					{
						"description": "Restricts batch evaluation to this related resource; omitted batches contain only unbound experiments.",
						"explode": true,
						"in": "query",
						"name": "related_resource",
						"required": false,
						"schema": {
							"$ref": "#/components/schemas/ExperimentResourceReference"
						},
						"style": "deepObject"
					},
					{
						"description": "Flag or experiment to evaluate — the flag_key handle or the `expt_` id. Omit to return all flags the caller qualifies for.",
						"in": "query",
						"name": "flag_key",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Owning account ID. Required when evaluating by flag_key or in a batch; optional for an expt_ ID.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"content": {
							"application/json": {
								"schema": {
									"additionalProperties": {
										"type": "string"
									},
									"type": "object"
								}
							}
						},
						"description": "JSON-encoded scalar values that property targeting conditions match against. Numeric and boolean strings are coerced. Nested query keys such as properties[variant]=pro remain accepted for existing callers.",
						"in": "query",
						"name": "properties",
						"required": false
					},
					{
						"description": "Set `false` to read an assignment without recording an exposure, such as when a client caches assignments up front and records the exposure when the arm is rendered. Omitted records the exposure.",
						"in": "query",
						"name": "log_exposure",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"oneOf": [
										{
											"$ref": "#/components/schemas/ExperimentExposure"
										},
										{
											"$ref": "#/components/schemas/ExperimentExposureBatch"
										}
									]
								}
							}
						},
						"description": "single flag evaluated"
					}
				},
				"security": [
					{
						"bearerAuth": []
					},
					{}
				],
				"summary": "Evaluate Experiments",
				"tags": ["Experiments"]
			}
		},
