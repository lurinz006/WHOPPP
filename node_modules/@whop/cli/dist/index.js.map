			"post": {
				"description": "Add your pixel for a business whose campaigns you claimed. Whop checks the access token with the ad platform, then sends the pixel the conversions credited to your claimed campaigns for that business. Each business takes one pixel per ad platform, and each pixel can serve one business. On Google, the pixel is your Google Ads account, which can serve several businesses, and Whop creates its conversion actions there with your service account key.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"access_token": {
										"description": "A credential that can send events to the pixel on the ad platform: a Meta Conversions API access token, a TikTok Events API access token, or for `google`, the JSON key of a Google Cloud service account. The service account needs Standard access to the Google Ads account, and its project needs the Google Ads API and the Data Manager API turned on and Explorer access or higher to the Google Ads API. Use a service account made only for Whop, with no roles in its project. Whop never returns it.",
										"example": "new-token",
										"type": "string",
										"writeOnly": true
									},
									"account_id": {
										"description": "The business whose claimed campaigns send conversions to this pixel, prefixed `biz_`. You must have claimed at least one of its campaigns.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"external_id": {
										"description": "The pixel's ID on the ad platform: the Meta pixel or dataset ID, the TikTok pixel code, or the Google Ads customer ID.",
										"example": "998877665544",
										"type": "string"
									},
									"platform": {
										"description": "The ad platform the pixel belongs to.",
										"enum": ["meta", "tiktok", "google"],
										"example": "meta",
										"type": "string"
									}
								},
								"required": [
									"account_id",
									"platform",
									"external_id",
									"access_token"
								],
								"type": "object"
							}
						}
					}
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AdPixel"
								}
							}
						},
						"description": "Created"
					},
					"400": {
						"description": "Bad request"
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					},
					"409": {
						"description": "Conflict"
					}
				},
				"security": [
					{
						"oauthTokenAuth": ["ad_pixel:manage"]
					}
				],
				"summary": "Create an ad pixel",
				"tags": ["Ad Pixels"],
				"x-whop-credentials": ["oauth_token"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create",
						"title": "Create an Ad Pixel"
					}
				}
			}
		},
