		"/swaps/{id}": {
			"get": {
				"description": "Retrieves a swap and its status. Poll it after creating a crypto swap, which finishes in the background.",
				"operationId": "get",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Swap ID returned from POST /swaps.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"account_id": {
											"description": "Account that owns the swap: a business ID prefixed `biz_`, or the user ID for a personal account.",
											"example": "biz_xxxxxxxxxxxxxx",
											"type": "string"
										},
										"error": {
											"description": "Latest error returned for a failed swap.",
											"example": "Swap reverted: quoted price moved beyond the slippage tolerance",
											"type": ["string", "null"]
										},
										"id": {
											"description": "Swap ID.",
											"example": "vault-swap-cwal_xxxxxxxxxxxxxx",
											"type": "string"
										},
										"object": {
											"enum": ["swap"],
											"example": "swap",
											"type": "string"
										},
										"status": {
											"description": "Current swap status. `complete` and `failed` are terminal.",
											"enum": ["queued", "working", "complete", "failed"],
											"example": "failed",
											"type": "string"
										},
										"tx_hashes": {
											"description": "On-chain transaction hashes produced by the swap.",
											"items": {
												"example": "0xabc",
												"type": "string"
											},
											"type": "array"
										},
										"user_id": {
											"description": "User whose personal account owns the swap, prefixed `user_`. Null for a business account.",
											"example": null,
											"type": ["string", "null"]
										}
									},
									"required": [
										"object",
										"id",
										"account_id",
										"user_id",
										"status",
										"tx_hashes"
									],
									"type": "object"
								}
							}
						},
						"description": "swap status retrieved"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "swap id is invalid"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential lacks the crypto-wallet scope"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "swap does not exist"
					}
				},
				"security": [
					{
						"bearerAuth": ["crypto_wallet:swap"]
					},
					{
						"bearerAuth": ["crypto_wallet:manage"]
					}
				],
				"summary": "Retrieve Swap",
				"tags": ["Swaps"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Retrieve"
					}
				},
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.swaps.retrieve({\n    id: \"id\"\n});\n"
					}
				]
			}
		},
		"/team_members": {
			"get": {
				"description": "Lists an account's team members, including pending invites. A user credential with `company:basic:read` may list only its own joined membership by passing its own `user_id` and `status=joined`. Listing `role=workforce` is also allowed with the `bounty:create` scope. Members with the view-only Partner role are listed after all other members.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Account ID, prefixed `biz_`.",
						"in": "query",
						"name": "account_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return members with this status: `joined` (accepted members) or `pending` (pending invites). Both are returned by default.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": ["joined", "pending"],
							"type": "string"
						}
					},
					{
						"description": "Only return the membership for this user ID, prefixed `user_`.",
						"in": "query",
						"name": "user_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return members with this role. `custom` matches members on a dashboard-managed custom role.",
						"in": "query",
						"name": "role",
						"required": false,
						"schema": {
							"enum": [
								"owner",
								"admin",
								"partner",
								"sales_manager",
								"moderator",
								"advertiser",
								"app_manager",
								"support",
								"manager",
								"workforce",
								"custom"
							],
							"type": "string"
						}
					},
					{
						"description": "Only return members whose name or username contains this text, and invites whose email contains it.",
						"in": "query",
						"name": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return the direct reports of this team member, prefixed `ausr_`. Pass the account ID, prefixed `biz_`, for the members who report to the business directly. Pending invites are excluded, and the list pages in `created_at` order without moving Partner-role members last.",
						"in": "query",
						"name": "reports_to_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return members with at least this many direct reports. Pending invites are excluded, and the list pages in `created_at` order without moving Partner-role members last.",
						"in": "query",
						"name": "direct_reports_min",
						"required": false,
						"schema": {
							"minimum": 0,
							"type": "integer"
						}
					},
					{
						"description": "Only return members with at most this many direct reports; `0` returns the people who manage no one. Pending invites are excluded, and the list pages in `created_at` order without moving Partner-role members last.",
						"in": "query",
						"name": "direct_reports_max",
						"required": false,
						"schema": {
							"minimum": 0,
							"type": "integer"
						}
					},
					{
						"description": "Only return members added before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return members added after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Field used to sort members. Members with the view-only Partner role are listed after all other members whichever way the list is sorted.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"default": "created_at",
							"enum": ["created_at"],
							"type": "string"
						}
					},
					{
						"description": "Sort direction. Defaults to `desc`.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"default": "desc",
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"$ref": "#/components/schemas/TeamMember"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": null,
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "a:WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												}
											},
											"required": [
												"end_cursor",
												"start_cursor",
												"has_next_page",
												"has_previous_page"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "Team members listed."
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "Invalid filter."
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "Missing or invalid authentication."
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "Missing the required scope."
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "Account not found."
					}
				},
				"security": [
					{
						"bearerAuth": ["company:authorized_user:read"]
					}
				],
				"summary": "List Team Members",
				"tags": ["Team Members"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "List"
					}
				},
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.teamMembers.list({\n    account_id: \"account_id\"\n});\n"
					}
				]
			},
			"post": {
				"description": "Adds a member to an account's team with a system role. Identify them by exactly one of `user_id` or `email`. If the person has not yet accepted — or the email does not belong to a Whop account yet — an invitation is sent instead and the response is `202` with an `object` of `team_member_invite`. If they already have a pending invite, the request fails with a `400`. Granting the `workforce` role is also allowed with the `bounty:create` scope.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "Account ID, prefixed `biz_`.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"email": {
										"description": "Email address to invite. Mutually exclusive with `user_id`. If the email already belongs to a Whop account it is treated the same as passing that account's `user_id`; otherwise a pending invite is created for the email.",
										"example": "marcus@shinetime.example",
										"type": "string"
									},
									"role": {
										"description": "The system role to grant. Custom roles cannot be granted through the API. The Partner role provides view-only access.",
										"enum": [
											"owner",
											"admin",
											"partner",
											"sales_manager",
											"moderator",
											"advertiser",
											"workforce"
										],
										"example": "partner",
										"type": "string"
									},
									"user_id": {
										"description": "The user to add to the team, prefixed `user_`. Mutually exclusive with `email`.",
										"example": "user_xxxxxxxxxxxxxx",
										"type": "string"
									}
								},
								"required": ["account_id", "role"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TeamMember"
								}
							}
						},
						"description": "Team member created."
					},
					"202": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"invitation_sent": {
											"example": true,
											"type": "boolean"
										},
										"object": {
											"enum": ["team_member_invite"],
											"example": "team_member_invite",
											"type": "string"
										}
									},
									"required": ["object", "invitation_sent"],
									"type": "object"
								}
							}
						},
						"description": "Invitation sent — the user must accept before they join the team."
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "Invalid request."
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "Missing or invalid authentication."
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"accountApiKeyAuth": ["authorized_user:create"]
					}
				],
				"summary": "Create Team Member",
				"tags": ["Team Members"],
				"x-whop-credentials": ["account_api_key"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create"
					}
				},
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.teamMembers.create({\n    account_id: \"biz_xxxxxxxxxxxxxx\",\n    role: \"owner\"\n});\n"
					}
				]
			}
		},
		"/team_members/{id}": {
			"delete": {
				"description": "Removes a team member from the account, or revokes a pending invite when given an `ausri_` ID. A user session may delete its own membership to leave the team without the delete scope. Removing a member on the `workforce` role is also allowed with the `bounty:create` scope. The account owner cannot be removed.",
				"operationId": "delete",
				"responses": {
