					"route",
					"hosted_url",
					"domains",
					"verified",
					"app_type",
					"origin",
					"experience_path",
					"discover_path",
					"dashboard_path",
					"skills_path",
					"openapi_path",
					"account",
					"icon",
					"banner_image",
					"creator",
					"businesses_created_count",
					"businesses_created_logo_urls",
					"businesses_with_recent_sales_count"
				],
				"type": "object"
			},
			"AppProductionBuild": {
				"properties": {
