		"/variants/{id}": {
			"delete": {
				"description": "Deletes a variant from a product. It stops selling immediately; existing memberships on it are unaffected.",
				"operationId": "delete",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"deleted": {
											"description": "Always true.",
											"example": true,
											"type": "boolean"
										},
										"id": {
											"description": "ID of the deleted variant.",
											"example": "plan_xxxxxxxxxxxxxx",
											"type": "string"
										}
									},
									"required": ["id", "deleted"],
									"type": "object"
								}
							}
						},
						"description": "variant deleted"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "no variant with that id"
					}
				},
				"security": [
					{
						"bearerAuth": ["plan:delete"]
					}
				],
				"summary": "Delete Variant",
				"tags": ["Variants"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Delete"
					}
				},
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Variant ID, prefixed `plan_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			},
			"get": {
				"description": "Retrieves a variant. Requires no authentication; fields that need a permission are `null` for callers without it.",
				"operationId": "get",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Variant ID, prefixed `plan_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "The currency to state each variant's prices in. Omit it, or send null, for each variant's own currency. `auto` states them in the currency of the country Whop places the buyer in: by `ip_address` when your server sends one, and by the request's own IP address otherwise. To choose that country instead, send `presentment_country` in place of this. A three-letter ISO 4217 code, such as `eur`, states them in that currency. A variant converts only where a payment quote for it would be priced in that currency, and stays in its own currency otherwise: a renewing variant, one with adaptive pricing off, a currency no payment method can collect, or `auto` for a buyer Whop cannot place in a country. Converted prices are an estimate at the current exchange rate. Nothing is held: the payment quote the buyer pays from fixes the rate.",
						"in": "query",
						"name": "presentment_currency",
						"required": false,
						"schema": {
							"example": "auto",
							"type": ["string", "null"]
						}
					},
					{
						"description": "The buyer's IP address, when your server reads on their behalf. Needs an API key; any other caller is placed by its own request. Where `presentment_currency` `auto` finds the buyer's local currency, and where a payment method must be able to collect it.",
						"in": "query",
						"name": "ip_address",
						"required": false,
						"schema": {
							"example": "203.0.113.7",
							"type": ["string", "null"]
						}
					},
					{
						"description": "The country to state each variant's prices for, as an ISO 3166-1 alpha-2 code such as `JP`, when the buyer chose one: a store's country picker. States them in the currency `auto` would for a buyer in that country, so send it instead of `presentment_currency`, never with it. Whether a payment method can collect that currency is still judged where the buyer is: by `ip_address`, else by the request's own IP address. A country Whop has no currency for is ignored, and the prices are stated as `auto` would state them.",
						"in": "query",
						"name": "presentment_country",
						"required": false,
						"schema": {
							"example": "JP",
							"type": ["string", "null"]
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Variant"
								}
							}
						},
						"description": "variant retrieved"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "no variant with that id"
					}
				},
				"security": [
					{},
					{
						"bearerAuth": ["plan:basic:read"]
					}
				],
				"summary": "Retrieve Variant",
				"tags": ["Variants"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Retrieve"
					}
				}
			},
			"patch": {
