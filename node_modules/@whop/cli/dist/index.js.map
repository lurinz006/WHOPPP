																	"example": "enabled",
																	"type": ["string", "null"]
																},
																"headline": {
																	"description": "Product headline.",
																	"type": ["string", "null"]
																},
																"product_tax_code_id": {
																	"description": "Product tax code identifier.",
																	"type": ["string", "null"]
																},
																"redirect_purchase_url": {
																	"description": "Where to redirect the buyer after purchase.",
																	"type": ["string", "null"]
																},
																"route": {
																	"description": "Product route.",
																	"type": ["string", "null"]
																},
																"title": {
																	"description": "Product title.",
																	"pattern": "\\S",
																	"type": "string"
																},
																"visibility": {
																	"default": "hidden",
																	"description": "Product visibility. Defaults to hidden.",
																	"enum": [
																		"visible",
																		"hidden",
																		"archived",
																		"quick_link"
																	],
																	"example": "visible",
																	"type": "string"
																}
															},
															"required": ["external_identifier", "title"],
															"type": ["object", "null"]
														},
														"product_id": {
															"description": "Existing product ID belonging to the account, prefixed `prod_`. Mutually exclusive with `product`.",
															"example": "prod_xxxxxxxxxxxxxx",
															"type": ["string", "null"]
														},
														"renewal_price": {
															"description": "Recurring price in the variant currency.",
															"type": ["number", "null"]
														},
														"title": {
															"description": "Variant title.",
															"type": ["string", "null"]
														},
														"trial_period_days": {
															"description": "Free trial days before renewal.",
															"type": ["integer", "null"]
														},
														"visibility": {
															"description": "Whether the variant is visible to customers.",
															"enum": [
																null,
																"visible",
																"hidden",
																"archived",
																"quick_link"
															],
															"example": "visible",
															"type": ["string", "null"]
														}
													},
													"required": ["currency"],
													"type": "object"
												},
												"plan_id": {
													"description": "An existing variant belonging to the account, identified by its plan_ ID.",
													"example": "plan_xxxxxxxxxxxxxx",
													"type": "string"
												},
												"quantity": {
													"default": 1,
													"maximum": 999999,
													"minimum": 1,
													"type": "integer"
												}
											},
											"type": "object"
										},
										"maxItems": 50,
										"minItems": 1,
										"type": "array"
									},
									"mailing_address_id": {
										"description": "An address associated with the member. Mutually exclusive with billing_address.",
										"type": ["string", "null"]
									},
									"member_id": {
										"description": "The billed customer, a member of the account. Changing email recipients does not change this buyer.",
										"example": "mber_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"description": "Up to 50 caller-owned string key/value pairs.",
										"example": {
											"purchase_order": "PO-42"
										},
										"type": "object"
									},
									"payment_method_id": {
										"description": "A saved payment method belonging to the member. Issuing the invoice charges it.",
										"example": "payt_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"recipient_emails": {
										"description": "Email addresses saved for invoice delivery, independent of the billed customer. Saving them sends no email. Defaults to the customer email when omitted on create. Can be updated on draft, open, or uncollectible invoices.",
										"items": {
											"format": "email",
											"type": "string"
										},
										"maxItems": 50,
										"type": "array"
									}
								},
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Invoice"
								}
							}
						},
						"description": "draft updated"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "invoice already issued"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "unauthenticated"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "missing permission"
					}
				},
				"security": [
					{
						"bearerAuth": ["invoice:update"]
					}
				],
				"summary": "Update Invoice",
				"tags": ["Invoices"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Update"
					}
				}
			}
		},
