						"description": "Currency every money metric is converted into. Defaults to `usd`.",
						"in": "query",
						"name": "convert_to",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only counts payments to businesses of these comma-separated business types, such as `education`.",
						"in": "query",
						"name": "business_type",
						"required": false,
						"schema": {
							"type": "string"
