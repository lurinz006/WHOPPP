						"$ref": "#/components/responses/NotFound",
						"description": "no ledger for that account"
					}
				},
				"security": [
					{
						"bearerAuth": ["company:balance:read"]
					}
				],
				"summary": "Get Financial Report",
				"tags": ["Ledgers"],
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.ledgers.getFinancialReport({\n    account_id: \"account_id\",\n    report_type: \"balance_summary\"\n});\n"
					}
				]
			}
		},
		"/financial_reports/breakdown": {
			"get": {
				"description": "Breaks one bucket of a financial report, such as payments received or card spend, into the customers, accounts, merchants, or campaigns that contributed most, with the rest summed as a remainder. Use it to explain a total from `GET /financial_reports`.",
				"operationId": "breakdown",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "The owning account ID (a biz_ identifier).",
						"in": "query",
						"name": "account_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "The high-level report bucket to explain.",
						"in": "query",
						"name": "bucket",
						"required": true,
						"schema": {
							"enum": [
								"transfers",
								"payments",
								"refunds",
								"ads",
								"application_fees",
								"card_spend",
								"card_authorization_releases",
								"withdrawals",
								"withdrawal_markup",
								"platform_markup",
								"clawbacks",
								"disputes",
								"affiliate_earnings",
								"affiliate_payouts",
								"revenue_share",
								"swaps",
								"card_loads"
							],
							"type": "string"
						}
					},
					{
						"description": "Whether to explain money received or money sent.",
						"in": "query",
						"name": "direction",
						"required": true,
						"schema": {
							"enum": ["money_in", "money_out"],
							"type": "string"
						}
					},
					{
						"description": "The report currency to explain.",
						"in": "query",
						"name": "currency",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Start of the report window as an ISO 8601 timestamp.",
						"in": "query",
						"name": "from",
						"required": true,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Exclusive end of the report window as an ISO 8601 timestamp.",
						"in": "query",
						"name": "to",
						"required": true,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Period grouping used by the parent report.",
						"in": "query",
						"name": "group_by",
						"required": false,
						"schema": {
							"default": "month",
							"enum": ["hour", "day", "week", "month"],
							"type": "string"
						}
					},
					{
						"description": "IANA timezone used by the parent report to bucket periods. Defaults to UTC.",
						"in": "query",
						"name": "timezone",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"activity_filters": {
											"properties": {
												"direction": {
													"enum": ["money_in", "money_out"],
													"example": "money_out",
													"type": "string"
												},
												"line_types": {
													"items": {
														"example": "platform_balance_transfer_outgoing",
														"type": "string"
													},
													"type": "array"
												}
											},
											"required": ["line_types", "direction"],
											"type": "object"
										},
										"bucket": {
											"enum": [
												"transfers",
												"payments",
												"refunds",
												"ads",
												"application_fees",
												"card_spend",
												"card_authorization_releases",
												"withdrawals",
												"withdrawal_markup",
												"platform_markup",
												"clawbacks",
												"disputes",
												"affiliate_earnings",
												"affiliate_payouts",
												"revenue_share",
												"swaps",
												"card_loads"
											],
											"example": "transfers",
											"type": "string"
										},
										"currency": {
											"example": "usd",
											"type": "string"
										},
										"direction": {
											"enum": ["money_in", "money_out"],
											"example": "money_out",
											"type": "string"
										},
										"items": {
											"items": {
												"properties": {
													"amount": {
														"$ref": "#/components/schemas/Money"
													},
													"avatar": {
														"description": "How to draw the row's icon. `null` when the row has nothing to show (balances, adjustments, ad campaigns), so clients render no icon rather than a placeholder.",
														"oneOf": [
															{
																"properties": {
																	"shape": {
																		"enum": ["circle", "square"],
																		"example": "circle",
																		"type": "string"
																	},
																	"url": {
																		"description": "The image to show, or `null` to fall back to the row's initials.",
																		"type": ["string", "null"]
																	}
																},
																"required": ["url", "shape"],
																"type": "object"
															},
															{
																"type": "null"
															}
														]
													},
													"image_url": {
														"type": ["string", "null"]
													},
													"key": {
														"description": "An opaque identifier for this grouping within the breakdown.",
														"type": "string"
													},
													"name": {
														"type": "string"
													},
													"object": {
														"enum": [
															"user",
															"account",
															"merchant",
															"payout_destination",
															"balance",
															"withdrawal_adjustment",
															"ad_campaign"
														],
														"example": "user",
														"type": "string"
													},
													"resource_id": {
														"description": "The prefixed identifier of the represented Whop resource, when one exists.",
														"type": ["string", "null"]
													}
												},
												"required": [
													"key",
													"resource_id",
													"object",
													"name",
													"image_url",
													"avatar",
													"amount"
												],
												"type": "object"
											},
											"maxItems": 5,
											"type": "array"
										},
										"other_amount": {
											"oneOf": [
												{
													"$ref": "#/components/schemas/Money"
												},
												{
													"example": null,
													"type": "null"
												}
											]
										},
										"other_name": {
											"example": "Other",
											"type": "string"
										}
									},
									"required": [
										"bucket",
										"direction",
										"currency",
										"items",
										"other_amount",
										"other_name",
										"activity_filters"
									],
									"type": "object"
								}
							}
						},
						"description": "breakdown returned"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "invalid breakdown parameters"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential lacks the required balance-read scope"
					}
				},
				"security": [
					{
						"bearerAuth": ["company:balance:read"]
					}
				],
				"summary": "Get Financial Report Breakdown",
				"tags": ["Ledgers"]
			}
		},
		"/financing_applications": {
			"get": {
				"description": "Lists payment-financing applications. Without `account_id`, an account credential lists its own account and its direct connected accounts, but not deeper descendants, and a user credential lists every account it can read applications for.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Only applications for this account, prefixed `biz_`.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only applications in this review state.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": [
								"requires_collection",
								"awaiting_review",
								"completed",
								"approved",
								"denied"
							],
							"type": "string"
						}
					},
					{
						"description": "Applications created at or before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Applications created at or after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Field to sort by. Defaults to created_at.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"enum": ["created_at", "updated_at"],
							"type": "string"
						}
					},
					{
						"description": "Sort direction. Defaults to desc.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"$ref": "#/components/schemas/FinancingApplication"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": null,
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": null,
													"type": ["string", "null"]
												}
											},
											"required": [
												"start_cursor",
												"end_cursor",
												"has_next_page",
												"has_previous_page"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
