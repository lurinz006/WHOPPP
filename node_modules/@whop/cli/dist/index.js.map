									},
									"description": {
										"description": "Product description.",
										"example": "Quoted, then sent with the payment.",
										"type": ["string", "null"]
									},
									"external_identifier": {
										"description": "Your unique identifier for the product.",
										"example": "quoted-again",
										"pattern": "\\S",
										"type": "string"
									},
									"global_affiliate_percentage": {
										"description": "Percentage of revenue paid to global affiliates.",
										"type": ["number", "null"]
									},
									"global_affiliate_status": {
										"description": "Global affiliate program status.",
										"enum": [null, "enabled", "disabled"],
										"example": "enabled",
										"type": ["string", "null"]
									},
									"headline": {
										"description": "Product headline.",
										"example": "Product headline",
										"type": ["string", "null"]
									},
									"product_tax_code_id": {
										"description": "Product tax code identifier.",
										"type": ["string", "null"]
									},
									"redirect_purchase_url": {
										"description": "Where to redirect the buyer after purchase.",
										"example": "https://example.com/thanks",
										"type": ["string", "null"]
									},
									"route": {
										"description": "Product route.",
										"type": ["string", "null"]
									},
									"title": {
										"description": "Product title.",
										"example": "Quoted again",
										"pattern": "\\S",
										"type": "string"
									},
									"visibility": {
										"default": "hidden",
										"description": "Product visibility. Defaults to hidden.",
										"enum": ["visible", "hidden", "archived", "quick_link"],
										"example": "visible",
										"type": "string"
									}
								},
								"required": ["external_identifier", "title"],
								"type": ["object", "null"]
							},
							"product_id": {
								"description": "Existing product ID belonging to the account, prefixed `prod_`. Mutually exclusive with `product`.",
								"example": "prod_xxxxxxxxxxxxxx",
								"type": ["string", "null"]
							},
							"renewal_price": {
								"description": "Recurring price in the variant currency.",
								"type": ["number", "null"]
							},
							"title": {
								"description": "Variant title.",
								"type": ["string", "null"]
							},
							"trial_period_days": {
								"description": "Free trial days before renewal.",
								"type": ["integer", "null"]
							},
							"visibility": {
								"description": "Whether the variant is visible to customers.",
								"enum": [null, "visible", "hidden", "archived", "quick_link"],
								"example": "visible",
								"type": ["string", "null"]
							}
						},
						"required": ["currency"],
						"type": "object"
					},
					"plan_id": {
						"description": "The variant purchased, prefixed `plan_`. It must belong to the account. Mutually exclusive with `plan` and `line_items`.",
						"example": "plan_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"promo_code": {
						"description": "The promo code as the buyer typed it, matched within the account regardless of case and surrounding spaces, as checkout matches it. It must be valid for the variant. Send it or `promo_code_id`, not both; an empty or whitespace-only string counts as not sent. A code the account does not have, or one that is no longer active, is refused before anything is written, with the error code `promo_invalid`. A code this purchase cannot use, such as one with no uses left or one restricted to other variants, products or buyers, is refused with `promo_invalid` too, and the error's message says why.",
						"example": "SHINE20",
						"type": ["string", "null"]
					},
					"promo_code_id": {
						"description": "An active promo code to apply, prefixed `promo_`. It must belong to the account and be valid for the variant. Send it or `promo_code`, not both. A code this purchase cannot use is refused with the error code `promo_invalid`, and the error's message says why.",
						"example": "promo_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					}
				},
				"required": ["account_id"],
				"type": "object"
			},
			"PaymentInstructions": {
				"description": "What to show the buyer so they can pay. `kind` picks the shape and the details sit under the key named for it, so switching on `kind` gives you exactly that kind's payload. Every detail field is optional — the rails behind these methods publish them unevenly — but a kind that arrives with `document_url` can always fall back to sending the buyer to that hosted copy of the instructions.",
				"discriminator": {
					"mapping": {
						"bank_transfer": "#/components/schemas/PaymentBankTransferInstructions",
						"qr": "#/components/schemas/PaymentQrInstructions",
						"voucher": "#/components/schemas/PaymentVoucherInstructions"
