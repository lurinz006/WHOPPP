				"required": ["type"],
				"type": "object"
			},
			"AdLeadFormQuestionOption": {
				"properties": {
					"key": {
						"description": "Stable identifier the choice's answers are stored under. Absent for simple choices.",
						"example": "ceramic_coating",
						"type": ["string", "null"]
					},
					"logic": {
						"$ref": "#/components/schemas/AdLeadFormOptionLogic",
