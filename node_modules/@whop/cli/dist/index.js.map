			"AccountFinancing": {
				"properties": {
					"application_id": {
						"description": "The ID of the account's most recent financing application, starting with inrq_. Retrieve it for requirements and review feedback.",
						"example": "inrq_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"status": {
						"description": "The most recent financing application's review state: `requires_collection` (waiting on the merchant, including after a request for more information), `awaiting_review`, `approved`, `denied`, or `completed`. Whether financing payment methods are enabled is `capabilities.accept_bnpl_payments`.",
						"enum": [
							"requires_collection",
							"awaiting_review",
							"completed",
							"approved",
							"denied"
						],
						"example": "awaiting_review",
						"type": "string"
					}
				},
				"required": ["application_id", "status"],
				"type": "object"
			},
			"AccountLevel": {
				"properties": {
					"boosted": {
						"description": "`true` when this account's own points this month fall short of `current`, so the owner's other accounts lift it to this level.",
						"example": true,
						"type": "boolean"
					},
					"current": {
						"description": "Current level, from `0` before the first threshold up to `10`.",
						"example": 1,
						"type": "integer"
					},
					"points": {
						"description": "Points earned this month across every account the owner owns.",
						"example": 41000,
						"type": "integer"
					},
					"points_by_source": {
						"$ref": "#/components/schemas/OwnerLevelPoints",
						"description": "This month's points, split by where they were earned."
					},
					"points_to_next": {
						"description": "Points still needed this month to reach the next level, or `null` at level `10`.",
						"example": 59000,
						"type": ["integer", "null"]
					},
					"resets_at": {
						"description": "When this month's points reset to zero, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					}
				},
				"required": [
					"current",
					"points",
					"points_by_source",
					"points_to_next",
					"resets_at",
					"boosted"
				],
				"type": "object"
			},
			"AccountParent": {
				"properties": {
					"fees": {
						"additionalProperties": {
							"properties": {
								"fixed_fee_usd": {
									"description": "Fixed markup in US dollars per transaction.",
									"type": "number"
								},
								"percentage_fee": {
									"description": "Percentage of the transaction charged as markup.",
									"type": "number"
								}
							},
							"required": ["percentage_fee", "fixed_fee_usd"],
							"type": "object"
						},
						"description": "Markup rates this parent charges the connected account being read, keyed by fee type (for example `crypto_deposit_markup`), each with `percentage_fee` and `fixed_fee_usd`. Resolved with the connected account's own overrides winning over the platform default.",
						"example": {
							"crypto_swap_markup": {
								"fixed_fee_usd": 0,
								"percentage_fee": 3
							},
							"transfer_markup": {
								"fixed_fee_usd": 0,
								"percentage_fee": 0
							}
						},
						"type": "object"
					},
					"id": {
						"description": "Account ID, prefixed `biz_`.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"logo_url": {
						"description": "Account logo image URL.",
						"example": "https://whop-assets-example.s3.amazonaws.com/uploads/image/2026-01-01/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"route": {
						"description": "Account public route identifier.",
						"example": "shine-time-holdings",
						"type": "string"
					},
					"title": {
						"description": "Account display name.",
						"example": "Shine Time Holdings",
						"type": "string"
					}
				},
				"required": ["id", "title", "route", "logo_url"],
				"type": "object"
			},
			"AccountPartner": {
				"properties": {
					"email": {
						"description": "Email address for contacting the partner. Null when the partner has not added their own email address.",
						"type": ["string", "null"]
					},
					"id": {
						"description": "User ID, prefixed `user_`.",
