		"/disputes/{id}": {
			"get": {
				"description": "Retrieves a single dispute.",
				"operationId": "get",
				"parameters": [
					{
						"description": "The dispute ID (`dspt_` tag).",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
