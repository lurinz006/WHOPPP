									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "The fields a condition can read, with the operators and values each one accepts"
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				],
				"summary": "List fields",
				"tags": ["Payment Rules"],
				"x-mint": {
					"metadata": {
						"title": "List Fields",
						"sidebarTitle": "List Fields"
					}
				},
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					}
				]
			}
		},
