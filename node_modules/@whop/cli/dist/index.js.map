		"/payments/{id}/refund": {
			"post": {
				"description": "Refunds all or part of a payment through the processor that charged it, and updates its membership to match. The buyer is emailed, the affiliate commission on the payment is clawed back, and any open Resolution Center case on the payment is closed.",
				"operationId": "refund",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "The payment to refund, prefixed `pay_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"description": "Your own key-value data to attach to the refund, returned on it and on its `refund.created` and `refund.updated` webhooks. At most 50 keys; keys up to 100 characters and values up to 500.",
										"example": {
											"refund_id": "ref_8f2k1"
										},
										"type": ["object", "null"]
									},
									"partial_amount": {
										"description": "The amount to refund, stated in this payment's `currency` like every other amount on it. When the buyer was billed in a different currency, it is converted at the payment's own exchange rate before the refund is issued. An amount that covers everything still refundable refunds the rest of the payment — omit it to refund the rest without having to work out what that is.",
										"example": 49,
										"type": ["number", "null"]
									}
								},
								"type": "object"
							}
						}
					}
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Payment"
								}
							}
						},
						"description": "payment refunded"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/V1ErrorResponse"
								}
							}
						},
						"description": "partial_amount is not a number"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "unauthenticated"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential without payment:manage"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "payment not found"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"bearerAuth": ["payment:manage"]
					}
				],
				"summary": "Refund Payment",
				"tags": ["Payments"]
			}
		},
