		"/transfers/{id}": {
			"get": {
				"description": "Retrieves a single transfer.",
				"operationId": "get",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"description": "A transfer between Whop accounts or users.",
									"properties": {
										"amount": {
											"description": "Amount credited to the recipient. Null while the transfer has not succeeded.",
											"oneOf": [
												{
													"$ref": "#/components/schemas/Money"
												},
												{
													"type": "null"
												}
											]
										},
										"created_at": {
											"description": "When the transfer was created.",
											"example": "2026-01-01T12:00:00.000Z",
											"format": "date-time",
											"type": "string"
										},
										"destination": {
											"description": "Business account or user receiving the transfer.",
											"properties": {
												"id": {
													"description": "Account or user ID.",
													"example": "biz_xxxxxxxxxxxxxx",
													"type": "string"
												},
												"logo_url": {
													"description": "Business logo or user avatar URL. Null when no image is available.",
													"example": "https://whop-assets-example.s3.amazonaws.com/uploads/image/2026-01-01/shine-time-logo",
													"type": ["string", "null"]
												},
												"name": {
													"description": "Business or user display name.",
													"example": "Shine Time Auto Detailing",
													"type": ["string", "null"]
												},
												"object": {
													"description": "Whether the profile is a business account or a user.",
													"enum": ["account", "user"],
													"example": "account",
													"type": "string"
												}
											},
											"required": ["object", "id", "name", "logo_url"],
											"title": "TransferParty",
											"type": ["object", "null"]
										},
										"failed_at": {
											"description": "Recorded failure time. Null unless the transfer has failed.",
											"example": null,
											"format": "date-time",
											"type": ["string", "null"]
										},
										"failure_code": {
											"description": "Machine-readable failure code. Null unless the transfer has failed.",
											"example": null,
											"type": ["string", "null"]
										},
										"failure_reason": {
											"description": "Failure explanation. Null unless the transfer has failed.",
											"example": null,
											"type": ["string", "null"]
										},
										"fee": {
											"description": "All applicable transfer fees, including platform markup. Null when the authoritative total is unavailable.",
											"oneOf": [
												{
													"$ref": "#/components/schemas/Money"
												},
												{
													"type": "null"
												}
											]
										},
										"id": {
											"description": "Transfer ID.",
											"example": "ctt_xxxxxxxxxxxxxx",
											"type": "string"
										},
										"metadata": {
											"additionalProperties": true,
											"description": "Custom metadata attached to the transfer.",
											"example": {
												"order_id": "SHINE-1042"
											},
											"type": "object"
										},
										"notes": {
											"description": "Transfer note.",
											"example": "Refund for the rescheduled interior detail",
											"type": ["string", "null"]
										},
										"object": {
											"description": "The object type.",
											"enum": ["transfer"],
											"example": "transfer",
											"type": "string"
										},
										"origin": {
											"description": "Business account or user sending the transfer.",
											"properties": {
												"id": {
													"description": "Account or user ID.",
													"example": "biz_xxxxxxxxxxxxxx",
													"type": "string"
												},
												"logo_url": {
													"description": "Business logo or user avatar URL. Null when no image is available.",
													"example": "https://whop-assets-example.s3.amazonaws.com/uploads/image/2026-01-01/shine-time-logo",
													"type": ["string", "null"]
												},
												"name": {
													"description": "Business or user display name.",
													"example": "Shine Time Auto Detailing",
													"type": ["string", "null"]
												},
												"object": {
													"description": "Whether the profile is a business account or a user.",
													"enum": ["account", "user"],
													"example": "account",
													"type": "string"
												}
											},
											"required": ["object", "id", "name", "logo_url"],
											"title": "TransferParty",
											"type": ["object", "null"]
										},
										"status": {
											"description": "Current transfer status. A transfer can be created `processing` and settle a few seconds later; poll Retrieve Transfer or listen for the `transfer.completed` and `transfer.failed` webhooks instead of treating the create response as final. `succeeded` and `failed` are final.",
											"enum": ["processing", "succeeded", "failed"],
											"example": "succeeded",
											"type": "string"
										},
										"status_changed_at": {
											"description": "Recorded time of the current transition. Null when the historical transition time is unknown.",
											"example": null,
											"format": "date-time",
											"type": ["string", "null"]
										},
										"succeeded_at": {
											"description": "Recorded success time. Null when unknown.",
											"example": null,
											"format": "date-time",
											"type": ["string", "null"]
										},
										"tracking_url": {
											"description": "Tracking page for the transfer. Viewing it requires sign-in and access to the transfer.",
											"example": "https://whop.com/ctt_xxxxxxxxxxxxxx/",
											"format": "uri",
											"type": "string"
										}
									},
									"required": [
										"object",
										"id",
										"status",
										"origin",
										"destination",
										"amount",
										"fee",
										"created_at",
										"status_changed_at",
										"succeeded_at",
										"failed_at",
										"failure_code",
										"failure_reason",
										"notes",
										"metadata",
										"tracking_url"
									],
									"title": "Transfer",
									"type": "object"
								}
							}
						},
						"description": "transfer retrieved"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "transfer not found"
					}
				},
