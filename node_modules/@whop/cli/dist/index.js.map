																"rwf",
																"sar",
																"rsd",
																"lkr",
																"tzs",
																"ttd",
																"uzs",
																"rub",
																"btc",
																"cny",
																"usdt",
																"kzt",
																"awg",
																"whop_usd",
																"xau"
															],
															"example": "usd",
															"type": "string"
														},
														"description": {
															"description": "Variant description.",
															"type": ["string", "null"]
														},
														"expiration_days": {
															"description": "Days until access expires.",
															"type": ["integer", "null"]
														},
														"force_create_new_plan": {
															"description": "Create a new variant instead of reusing a matching variant.",
															"type": ["boolean", "null"]
														},
														"initial_price": {
															"description": "Additional amount charged on the first purchase, in the variant currency. For recurring variants without a trial, the first charge includes this amount plus renewal_price.",
															"type": ["number", "null"]
														},
														"internal_notes": {
															"description": "Internal notes for the account.",
															"type": ["string", "null"]
														},
														"override_tax_type": {
															"description": "Whether the variant's price includes tax: `inclusive` (tax is included in the price), `exclusive` (tax is added on top), or `unspecified`. Omit it or pass `null` to use the account's tax setting. On an account enrolled in the Whop tax service, `inclusive` or `exclusive` replaces the account's setting and `unspecified` keeps it. Otherwise it applies only where the account is the merchant of record: `inclusive` or `exclusive` replaces the account's setting when the account collects tax, and `unspecified` means the variant collects no tax. Where Whop is the merchant of record, the account's setting applies. Variants that differ only in this value are different variants.",
															"enum": [
																null,
																"exclusive",
																"inclusive",
																"unspecified"
															],
															"example": "exclusive",
															"type": ["string", "null"]
														},
														"plan_type": {
															"description": "Billing model for the variant.",
															"enum": [null, "renewal", "one_time"],
															"example": "renewal",
															"type": ["string", "null"]
														},
														"product": {
															"description": "Find or create a product by external identifier. Mutually exclusive with product_id.",
															"properties": {
																"collect_shipping_address": {
																	"description": "Whether to collect a shipping address at checkout.",
																	"type": ["boolean", "null"]
																},
																"custom_statement_descriptor": {
																	"description": "Custom card statement descriptor for the product, starting with WHOP*.",
																	"type": ["string", "null"]
																},
																"description": {
																	"description": "Product description.",
																	"type": ["string", "null"]
																},
																"external_identifier": {
																	"description": "Your unique identifier for the product.",
																	"pattern": "\\S",
																	"type": "string"
																},
																"global_affiliate_percentage": {
																	"description": "Percentage of revenue paid to global affiliates.",
																	"type": ["number", "null"]
																},
																"global_affiliate_status": {
																	"description": "Global affiliate program status.",
																	"enum": [null, "enabled", "disabled"],
																	"example": "enabled",
																	"type": ["string", "null"]
																},
																"headline": {
																	"description": "Product headline.",
																	"type": ["string", "null"]
																},
																"product_tax_code_id": {
																	"description": "Product tax code identifier.",
																	"type": ["string", "null"]
																},
																"redirect_purchase_url": {
																	"description": "Where to redirect the buyer after purchase.",
																	"type": ["string", "null"]
																},
																"route": {
																	"description": "Product route.",
																	"type": ["string", "null"]
																},
																"title": {
																	"description": "Product title.",
																	"pattern": "\\S",
																	"type": "string"
																},
																"visibility": {
																	"default": "hidden",
																	"description": "Product visibility. Defaults to hidden.",
																	"enum": [
																		"visible",
																		"hidden",
																		"archived",
																		"quick_link"
																	],
																	"example": "visible",
																	"type": "string"
																}
															},
															"required": ["external_identifier", "title"],
															"type": ["object", "null"]
														},
														"product_id": {
															"description": "Existing product ID belonging to the account, prefixed `prod_`. Mutually exclusive with `product`.",
															"type": ["string", "null"]
														},
														"renewal_price": {
															"description": "Recurring price in the variant currency.",
															"type": ["number", "null"]
														},
														"title": {
															"description": "Variant title.",
															"type": ["string", "null"]
														},
														"trial_period_days": {
															"description": "Free trial days before renewal.",
															"type": ["integer", "null"]
														},
														"visibility": {
															"description": "Whether the variant is visible to customers.",
															"enum": [
																null,
																"visible",
																"hidden",
																"archived",
																"quick_link"
															],
															"example": "visible",
															"type": ["string", "null"]
														}
													},
													"required": ["currency"],
													"type": "object"
												},
												"plan_id": {
													"description": "An existing variant to charge for, prefixed `plan_`. Mutually exclusive with `plan`. Each variant may appear once — use `quantity` for multiple units.",
													"example": "plan_xxxxxxxxxxxxxx",
													"type": "string"
												},
												"quantity": {
													"description": "How many units of the variant to purchase. Defaults to 1; more than 1 requires the variant to allow multiple quantities.",
													"example": 1,
													"maximum": 999999,
													"minimum": 1,
													"type": ["integer", "null"]
												}
											},
											"type": "object"
										},
										"maxItems": 50,
										"minItems": 1,
										"type": "array"
									},
									"member_id": {
										"description": "The member to charge, prefixed `mber_`. Required with `payment_method_id` unless `confirmation_token` is provided.",
										"example": "mber_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"description": "Custom metadata to attach to the payment.",
										"example": {
											"register": "front"
										},
										"type": ["object", "null"]
									},
									"off_session": {
										"description": "Whether the buyer is absent from your checkout and can't authenticate. Pass true when you charge the card without the buyer, such as a renewal on your own schedule. Pass false when the buyer is present, such as a one-click upsell right after checkout: the charge is processed as a customer-initiated card-on-file payment, and if the issuer asks the buyer to authenticate, the payment's status is `requires_action` with a `next_action` to send them to, after which they return to `return_url`. From API version 2026-10-07-1 it defaults to false when `return_url` is provided and to true otherwise; before that version it defaults to true. A saved Apple Pay, Google Pay or PayPal payment method is always charged with `off_session` true. Ignored unless `member_id` and `payment_method_id` are provided.",
										"example": true,
										"type": ["boolean", "null"]
									},
									"payment_method": {
										"description": "A payment method collected on the seller's device rather than described by a confirmation token. `type` names it and the member named after it carries what the device needs. Today only `card_present` (Tap to Pay): nothing is collected on this call, the payment is created first and the reader then collects against it with the client secret the status endpoint serves in `next_action`. Mutually exclusive with `confirmation_token`, `member_id` and `payment_method_id`.",
										"properties": {
											"card_present": {
												"description": "Present when `type` is `card_present`.",
												"properties": {
													"platform": {
														"description": "Which Tap to Pay SDK collects the payment. Stripe offers Tap to Pay in different countries per platform, so eligibility is checked for the named one, as it is for the connection-token session.",
														"enum": ["ios", "android"],
														"example": "ios",
														"type": "string"
													}
												},
												"required": ["platform"],
												"type": "object"
											},
											"type": {
												"description": "The kind of payment method the device collects; the member named after it carries its details.",
												"enum": ["card_present"],
												"example": "card_present",
												"type": "string"
											}
										},
										"required": ["type", "card_present"],
										"type": ["object", "null"]
									},
									"payment_method_id": {
										"description": "The stored payment method to charge, prefixed `payt_`. It must belong to the member. Required unless `confirmation_token` is provided.",
										"example": "payt_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"quote_id": {
										"description": "A payment quote from `POST /payment_quotes`, prefixed `pq_`. The payment charges exactly the quote: its purchase (its variants and quantities, or the `plan` it priced), which this body may then omit, its promo code, and its tax, the quote's `tax_amount` rather than a figure calculated now. Omit it, or send null, to have tax calculated when the payment is charged. The quote must belong to `account_id`. A purchase field you omit or send as null takes the quote's value; the buyer's email, the addresses and the payment method are this request's own, never the quote's. Whatever you do send must describe the quoted purchase: the same variants, quantities and promo code. A quote that priced `plan` takes only the same `plan` you sent to `POST /payment_quotes` (or omit the purchase to take the quoted one), never `plan_id` or `line_items`, and a quote that priced variants by id never takes `plan`. Unless the quote located no buyer (`located_by` is null), the address the payment carries (its shipping address, else its billing address) must put the buyer where the quote priced tax, by country, state and postal code; otherwise the payment is refused with 400 before the payment method is used. A quote located by IP address or by the country the buyer chose (`located_by` is `ip_address` or `presentment_country`) is a preview and cannot be paid. A quote is consumed by one payment: a declined payment keeps it and can be retried; a new payment needs a new quote. A quote cannot be charged by a processor that doesn't take quotes, such as a seller's own connected PayPal account; such a payment is refused before the payment method is used. A quote priced in a `presentment_currency` is charged in that currency at the quote's `exchange_rate`. A payment refused over its quote carries an error `code`. `quote_expired`: the quote has expired; quote again. `quote_tax_unavailable`: the quote could not price tax; quote again, or omit `quote_id`. `quote_preview_only`: the quote was located by IP address or by the country the buyer chose; quote again with the buyer's address. `quote_in_use` (409): another payment holds the quote. `quote_mismatch`: the purchase or the buyer's address is not the one quoted. `quote_rate_expired`: the exchange rate the quote was priced at has moved too far to charge; quote again. `payment_method_currency_unsupported`: the payment method cannot pay in the quote's currency; use another method, or quote again in another currency. `quote_processor_unsupported`: the payment would be processed by a processor that doesn't take quotes, such as a seller's own connected PayPal account; use another method, or omit `quote_id` to have tax calculated when the payment is charged.",
										"example": "pq_xxxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"return_url": {
										"description": "Where the buyer continues after completing an off-site step such as 3D Secure. An absolute https URL without credentials, at most 2,048 characters. Required when a saved payment method is charged with `off_session` false; otherwise ignored unless `confirmation_token` is provided.",
										"example": "https://shinetime.example/checkout/done",
										"type": ["string", "null"]
									},
									"shipping_address": {
										"description": "Where physical goods ship, returned on the payment as `shipping_address`. Only the keys you supply are kept; omit it for digital goods.",
										"properties": {
											"city": {
												"description": "City name.",
												"example": "Austin",
												"type": ["string", "null"]
											},
											"country": {
												"description": "ISO 3166-1 alpha-2 country code, such as `US`.",
												"example": "US",
												"type": ["string", "null"]
											},
											"line1": {
												"description": "First line of the street address.",
												"example": "1114 Bouldin Ave",
												"type": ["string", "null"]
											},
											"line2": {
												"description": "Second line of the street address.",
												"example": "Unit B",
												"type": ["string", "null"]
											},
											"name": {
												"description": "The recipient's full name, as it should appear on the shipping label.",
												"example": "Dana Whitfield",
												"type": ["string", "null"]
											},
											"postal_code": {
												"description": "Postal or ZIP code.",
												"example": "78704",
												"type": ["string", "null"]
											},
											"state": {
												"description": "State, province, or region code, such as `CA`.",
												"example": "TX",
												"type": ["string", "null"]
											}
										},
										"type": ["object", "null"]
									},
									"statement_descriptor": {
										"description": "Overrides the text on the buyer's card statement for this payment only. Takes precedence over the product's and account's custom descriptors, and changes neither. Must start with `WHOP*` unless the business processes as the merchant of record. For businesses processing as the merchant of record, omit the `WHOP*` prefix; the descriptor appears as provided. Must be 5-22 characters, contain at least one letter, and use only Latin letters, numbers, spaces, underscores, hyphens, or asterisks.",
										"example": "WHOP*SHINETIME",
										"type": ["string", "null"]
									}
								},
								"required": ["account_id"]
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Payment"
								}
							}
						},
						"description": "payment created from a stored payment method"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/V1ErrorResponse"
								}
							}
						},
						"description": "confirmation_token combined with a stored method"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "unauthenticated"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential without payment:charge"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "payment method not on file for the member"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"bearerAuth": ["payment:charge"]
					}
				],
				"summary": "Create Payment",
				"tags": ["Payments"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create"
					}
				}
			}
		},
		"/payments/summary": {
			"get": {
				"description": "Totals up the same payments the list returns, so you can build status tabs and filter options without paging through them. Takes the same filters as List Payments.",
				"operationId": "summary",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Which breakdowns to return, keyed by these names under `groups`. Repeat the parameter to ask for several; omit it for all of them.",
						"in": "query",
						"name": "groups",
						"required": false,
						"schema": {
							"items": {
								"enum": ["substatus", "currency"],
								"example": "substatus",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments charged by this account, prefixed `biz_`.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only payments in any of these lifecycle states. Repeat the parameter to pass several.",
						"in": "query",
						"name": "statuses",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"open",
									"authorized",
									"paid",
									"pending",
									"uncollectible",
									"unresolved",
									"void"
								],
								"example": "paid",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments whose `substatus` is any of these. Repeat the parameter to pass several.",
						"in": "query",
						"name": "substatuses",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"succeeded",
									"requires_capture",
									"pending",
									"failed",
									"blocked",
									"past_due",
									"canceled",
									"price_too_low",
									"uncollectible",
									"refunded",
									"auto_refunded",
									"partially_refunded",
									"dispute_warning",
									"dispute_needs_response",
									"dispute_warning_needs_response",
									"resolution_needs_response",
									"dispute_under_review",
									"dispute_warning_under_review",
									"resolution_under_review",
									"dispute_won",
									"dispute_warning_closed",
									"resolution_won",
									"dispute_lost",
									"dispute_closed",
									"resolution_lost",
									"drafted",
									"incomplete",
									"unresolved"
								],
								"example": "succeeded",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments charged for any of these reasons. Repeat the parameter to pass several.",
						"in": "query",
						"name": "billing_reasons",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"subscription_create",
									"subscription_cycle",
									"subscription_update",
									"one_time",
									"manual",
									"subscription"
								],
								"example": "subscription_cycle",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments presented in any of these three-letter currencies. Repeat the parameter to pass several.",
						"in": "query",
						"name": "currencies",
						"required": false,
						"schema": {
							"items": {
								"example": "usd",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments priced by any of these variants, each prefixed `plan_`. Repeat the parameter to pass several.",
						"in": "query",
						"name": "plan_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "plan_xxxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments for any of these products, each prefixed `prod_`. Repeat the parameter to pass several.",
						"in": "query",
						"name": "product_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "prod_xxxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments paid with any of these methods. Repeat the parameter to pass several.",
						"in": "query",
						"name": "payment_methods",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"mastercard",
									"visa",
									"amex",
									"discover",
									"unionpay",
									"jcb",
									"diners",
									"link",
									"troy",
									"visadankort",
									"visabancontact",
									"china_union_pay",
									"rupay",
									"jcbrupay",
									"elo",
									"maestro",
									"tarjeta_naranja",
									"cirrus",
									"nspk_mir",
									"verve",
									"ebt",
									"private_label",
									"local_brand",
									"uatp",
									"wexcard",
									"uzcard",
									"meeza",
									"hrg_store_card",
									"girocard",
									"fuel_card",
									"dankort",
									"carnet",
									"atm_card",
									"china_union_payuzcard",
									"codensa",
									"cabal",
									"hipercard",
									"jcblankapay",
									"cmi",
									"aura",
