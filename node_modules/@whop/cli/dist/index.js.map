			"post": {
				"description": "Charges a buyer for one or more variants with a payment method already on file (`member_id` and `payment_method_id`), or with a `confirmation_token` for a method the buyer just supplied. Collection runs in the background, so the response is the payment as created, not its outcome: poll Retrieve payment status for how far it has got and what the buyer must still do.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "The account the purchase belongs to, prefixed `biz_`.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"plan": {
										"description": "The variant purchased, described by its attributes instead of an id: the variant with exactly these attributes is used, and one is created when none exists. Mutually exclusive with `plan_id` and `line_items`. Creating a variant requires `plan:create`; creating or updating a product requires the corresponding product permission.",
										"properties": {
											"allow_multiple_quantity": {
												"description": "Whether more than one unit can be purchased in an order.",
												"type": ["boolean", "null"]
											},
											"application_fee_amount": {
												"description": "Application fee the platform collects per unit, in the variant currency (5.00 means $5.00 for USD). Must be positive and below the initial price for one-time variants or renewal price for recurring variants. Paid to the parent account alongside other processing fees; collection is capped to remaining proceeds. Applies to subsequent payments on recurring variants. Only valid for connected accounts with a parent account.",
												"example": 2,
												"type": ["number", "null"]
											},
											"billing_period": {
												"description": "Recurring billing interval in days.",
												"type": ["integer", "null"]
											},
											"currency": {
												"description": "Currency code for the variant prices.",
												"enum": [
													"usd",
													"sgd",
													"inr",
													"aud",
													"brl",
													"cad",
													"dkk",
													"eur",
													"nok",
													"gbp",
													"sek",
													"chf",
													"hkd",
													"huf",
													"jpy",
													"mxn",
													"myr",
													"pln",
													"czk",
													"nzd",
													"aed",
													"eth",
													"ape",
													"cop",
													"ron",
													"thb",
													"bgn",
													"idr",
													"dop",
													"php",
													"try",
													"krw",
													"twd",
													"vnd",
													"pkr",
													"clp",
													"uyu",
													"ars",
													"zar",
													"dzd",
													"tnd",
													"mad",
													"kes",
													"kwd",
													"jod",
													"all",
													"xcd",
													"amd",
													"bsd",
													"bhd",
													"bob",
													"bam",
													"khr",
													"crc",
													"xof",
													"egp",
													"etb",
													"gmd",
													"ghs",
													"gtq",
													"gyd",
													"ils",
													"jmd",
													"mop",
													"mga",
													"mur",
													"mdl",
													"mnt",
													"nad",
													"ngn",
													"mkd",
													"omr",
													"pyg",
													"pen",
													"qar",
													"rwf",
													"sar",
													"rsd",
													"lkr",
													"tzs",
													"ttd",
													"uzs",
													"rub",
													"btc",
													"cny",
													"usdt",
													"kzt",
													"awg",
													"whop_usd",
													"xau"
												],
												"example": "usd",
												"type": "string"
											},
											"description": {
												"description": "Variant description.",
												"type": ["string", "null"]
											},
											"expiration_days": {
												"description": "Days until access expires.",
												"type": ["integer", "null"]
											},
											"force_create_new_plan": {
												"description": "Create a new variant instead of reusing a matching variant.",
												"type": ["boolean", "null"]
											},
											"initial_price": {
												"description": "Additional amount charged on the first purchase, in the variant currency. For recurring variants without a trial, the first charge includes this amount plus renewal_price.",
												"example": 31,
												"type": ["number", "null"]
											},
											"internal_notes": {
												"description": "Internal notes for the account.",
												"type": ["string", "null"]
											},
											"override_tax_type": {
												"description": "Whether the variant's price includes tax: `inclusive` (tax is included in the price), `exclusive` (tax is added on top), or `unspecified`. Omit it or pass `null` to use the account's tax setting. On an account enrolled in the Whop tax service, `inclusive` or `exclusive` replaces the account's setting and `unspecified` keeps it. Otherwise it applies only where the account is the merchant of record: `inclusive` or `exclusive` replaces the account's setting when the account collects tax, and `unspecified` means the variant collects no tax. Where Whop is the merchant of record, the account's setting applies. Variants that differ only in this value are different variants.",
												"enum": [null, "exclusive", "inclusive", "unspecified"],
												"example": "inclusive",
												"type": ["string", "null"]
											},
											"plan_type": {
												"description": "Billing model for the variant.",
												"enum": [null, "renewal", "one_time"],
												"example": "one_time",
												"type": ["string", "null"]
											},
											"product": {
												"description": "Find or create a product by external identifier. Mutually exclusive with product_id.",
												"properties": {
													"collect_shipping_address": {
														"description": "Whether to collect a shipping address at checkout.",
														"example": true,
														"type": ["boolean", "null"]
													},
													"custom_statement_descriptor": {
														"description": "Custom card statement descriptor for the product, starting with WHOP*.",
														"example": "WHOP*INLINE",
														"type": ["string", "null"]
													},
													"description": {
														"description": "Product description.",
														"example": "Quoted, then sent with the payment.",
														"type": ["string", "null"]
													},
													"external_identifier": {
														"description": "Your unique identifier for the product.",
														"example": "quoted-again",
														"pattern": "\\S",
														"type": "string"
													},
													"global_affiliate_percentage": {
														"description": "Percentage of revenue paid to global affiliates.",
														"type": ["number", "null"]
													},
													"global_affiliate_status": {
														"description": "Global affiliate program status.",
														"enum": [null, "enabled", "disabled"],
														"example": "enabled",
														"type": ["string", "null"]
													},
													"headline": {
														"description": "Product headline.",
														"example": "Product headline",
														"type": ["string", "null"]
													},
													"product_tax_code_id": {
														"description": "Product tax code identifier.",
														"type": ["string", "null"]
													},
													"redirect_purchase_url": {
														"description": "Where to redirect the buyer after purchase.",
														"example": "https://example.com/thanks",
														"type": ["string", "null"]
													},
													"route": {
														"description": "Product route.",
														"type": ["string", "null"]
													},
													"title": {
														"description": "Product title.",
														"example": "Quoted again",
														"pattern": "\\S",
														"type": "string"
													},
													"visibility": {
														"default": "hidden",
														"description": "Product visibility. Defaults to hidden.",
														"enum": [
															"visible",
															"hidden",
															"archived",
															"quick_link"
														],
														"example": "visible",
														"type": "string"
													}
												},
												"required": ["external_identifier", "title"],
												"type": ["object", "null"]
											},
											"product_id": {
												"description": "Existing product ID belonging to the account, prefixed `prod_`. Mutually exclusive with `product`.",
												"example": "prod_xxxxxxxxxxxxxx",
												"type": ["string", "null"]
											},
											"renewal_price": {
												"description": "Recurring price in the variant currency.",
												"type": ["number", "null"]
											},
											"title": {
												"description": "Variant title.",
												"type": ["string", "null"]
											},
											"trial_period_days": {
												"description": "Free trial days before renewal.",
												"type": ["integer", "null"]
											},
											"visibility": {
												"description": "Whether the variant is visible to customers.",
												"enum": [
													null,
													"visible",
													"hidden",
													"archived",
													"quick_link"
												],
												"example": "visible",
												"type": ["string", "null"]
											}
										},
										"required": ["currency"],
										"type": "object"
									},
									"plan_id": {
										"description": "The variant purchased, prefixed `plan_`. It must belong to the account. Mutually exclusive with `plan` and `line_items`.",
										"example": "plan_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"promo_code": {
										"description": "The promo code as the buyer typed it, matched within the account regardless of case and surrounding spaces, as checkout matches it. It must be valid for the variant. Send it or `promo_code_id`, not both; an empty or whitespace-only string counts as not sent. A code the account does not have, or one that is no longer active, is refused before anything is written, with the error code `promo_invalid`. A code this purchase cannot use, such as one with no uses left or one restricted to other variants, products or buyers, is refused with `promo_invalid` too, and the error's message says why.",
										"example": "SHINE20",
										"type": ["string", "null"]
									},
									"promo_code_id": {
										"description": "An active promo code to apply, prefixed `promo_`. It must belong to the account and be valid for the variant. Send it or `promo_code`, not both. A code this purchase cannot use is refused with the error code `promo_invalid`, and the error's message says why.",
										"example": "promo_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"affiliate_code": {
										"description": "The code an affiliate link carries, which is the affiliate's username. The affiliate is credited for this payment as on a checkout session. A code naming no one eligible to earn on the product is ignored, and the payment goes ahead. A promo code with its own affiliate takes precedence. No affiliate is credited on a variant without a product or on a purchase of several variants. At most 255 characters. Not supported with `payment_method`.",
										"example": "priyaraman",
										"type": ["string", "null"]
									},
									"auto_capture_after_minutes": {
										"description": "Minutes after authorization at which Whop captures the hold automatically unless it has been voided. Requires `capture: false`. Between 5 and 5760 (4 days).",
										"example": 60,
										"maximum": 5760,
										"minimum": 5,
										"type": ["integer", "null"]
									},
									"capture": {
										"description": "Whether to capture a card payment immediately. Defaults to true. Pass false to place an authorization hold that must be captured in full within five days via the capture endpoint, or automatically after `auto_capture_after_minutes`.",
										"example": false,
										"type": ["boolean", "null"]
									},
									"confirmation_token": {
										"description": "A confirmation token describing a payment method the buyer just supplied. Provide this instead of `member_id` and `payment_method_id`; the buyer is resolved from the token's billing email, or from `email`. The buyer may still have a step to complete — poll the payment's status for what to do next.",
										"example": "ctok_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"email": {
										"description": "The buyer's email, resolving or creating the user the payment belongs to. With `confirmation_token` it overrides the email the token carries, and is ignored when the token was created by a signed-in buyer; with `payment_method` it names a buyer the point of sale already knows, otherwise the sale belongs to a guest until a buyer is attached. Ignored with `member_id`.",
										"example": "dana@shinetime.example",
										"type": ["string", "null"]
									},
									"ip_address": {
										"description": "The buyer's IPv4 or IPv6 address, used to assess the charge's risk and passed to the processor. Ignored unless a saved payment method is charged with `off_session` set to false.",
										"example": "203.0.113.24",
										"type": ["string", "null"]
									},
									"line_items": {
										"description": "What the buyer is purchasing. Each entry takes exactly one of `plan_id` or an inline `plan`. One entry charges that variant; several entries form a cart, which requires every variant to be compatible, belong to this account, and use the same currency. Mutually exclusive with `plan_id` and `plan`.",
										"example": [
											{
												"plan_id": "plan_xxxxxxxxxxxxxx",
												"quantity": 1
											}
										],
										"items": {
											"oneOf": [
												{
													"required": ["plan_id"]
												},
												{
													"required": ["plan"]
												}
											],
											"properties": {
												"plan": {
													"description": "Find or create the variant for this entry through the compatibility input `plan`. Unknown properties return an error. Creating a variant requires `plan:create`, and creating or updating a product requires the matching product permission.",
													"properties": {
														"allow_multiple_quantity": {
															"description": "Whether more than one unit can be purchased in an order.",
															"type": ["boolean", "null"]
														},
														"application_fee_amount": {
															"description": "Application fee the platform collects per unit, in the variant currency (5.00 means $5.00 for USD). Must be positive and below the initial price for one-time variants or renewal price for recurring variants. Paid to the parent account alongside other processing fees; collection is capped to remaining proceeds. Applies to subsequent payments on recurring variants. Only valid for connected accounts with a parent account.",
															"type": ["number", "null"]
														},
														"billing_period": {
															"description": "Recurring billing interval in days.",
															"type": ["integer", "null"]
														},
														"currency": {
															"description": "Currency code for the variant prices.",
															"enum": [
																"usd",
																"sgd",
																"inr",
																"aud",
																"brl",
																"cad",
																"dkk",
																"eur",
																"nok",
																"gbp",
																"sek",
																"chf",
																"hkd",
																"huf",
																"jpy",
																"mxn",
																"myr",
																"pln",
																"czk",
																"nzd",
																"aed",
																"eth",
																"ape",
																"cop",
																"ron",
																"thb",
																"bgn",
																"idr",
																"dop",
																"php",
