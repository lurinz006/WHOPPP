		"/cashback_rules/payout": {
			"post": {
				"description": "Pays out cashback on demand from the authenticated platform's available USD balance to its direct connected accounts. Covers completed, unpaid card transactions created before the request, each under its latest matching rule, which must be funded by the authenticated platform. Filters combine, and an empty body includes every eligible transaction. Payouts process in the background and amounts are calculated then, so the response confirms queuing, not payment. If a payout fails for insufficient funds, add USD to the platform's balance. Requires `payout:transfer_funds`. Supports `Idempotency-Key`, and overlapping requests cannot pay the same card transaction twice.",
				"operationId": "payout",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Client-generated key for replaying the same request safely for 24 hours.",
						"in": "header",
						"name": "Idempotency-Key",
						"required": false,
						"schema": {
							"maxLength": 255,
							"minLength": 1,
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"additionalProperties": false,
								"properties": {
									"account_id": {
										"description": "Pay only this direct connected account.",
										"pattern": "^biz_",
										"type": ["string", "null"]
									},
									"cashback_rule_id": {
										"description": "Pay only transactions whose winning cashback rule has this ID and is funded by the authenticated platform.",
										"pattern": "^cicbr_",
										"type": ["string", "null"]
									},
									"transaction_id": {
										"description": "Pay only this card transaction belonging to a direct connected account.",
										"example": "citx_xxxxxxxxxxxxxx",
										"pattern": "^citx_",
										"type": ["string", "null"]
									}
								},
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CashbackPayout"
								}
							}
						},
						"description": "queue rejected the request"
					},
					"202": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CashbackPayout"
								}
							}
						},
						"description": "payout queued"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "invalid filter"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "authentication required"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				],
				"summary": "Pay Out Cashback",
				"tags": ["Cashback Rules"]
			}
		},
		"/cashback_rules/{id}": {
			"patch": {
				"description": "Updates the merchant filters, description, or expiration of a cashback rule funded by the authenticated platform account; its start, rate, and accounts can't change. Omitted fields stay unchanged. Scheduled, active, and expired rules can be updated, but discarded rules can't. Updating a rule does not transfer funds. Requires `payout:transfer_funds`.",
				"operationId": "update",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "ID of the cashback rule, prefixed cicbr_.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"additionalProperties": false,
								"properties": {
									"description": {
										"description": "Description of the rule. Set null to clear it.",
										"example": "Cloud cashback",
										"maxLength": 255,
										"type": ["string", "null"]
									},
									"expires_at": {
										"description": "Exclusive end as an ISO 8601 timestamp, strictly later than the original starts_at. May be in the past to end an active rule. Set null to remove the expiration.",
										"example": "2026-01-01T12:00:00.000Z",
										"format": "date-time",
										"type": ["string", "null"]
									},
									"merchant_category_code": {
										"description": "Four-digit MCC, including leading zeros. Null matches any MCC. When both merchant filters are absent, scoped_account_id is required.",
										"example": "7372",
										"maxLength": 4,
										"minLength": 4,
										"pattern": "^[0-9]{4}$",
										"type": ["string", "null"]
									},
									"merchant_name": {
										"description": "Raw merchant name reported by the card provider. Set null to match any merchant name. Supplied names must contain a non-whitespace character and match together with any MCC filter. Clearing both filters requires an existing scoped_account_id.",
										"example": "ACME CLOUD",
										"maxLength": 128,
										"minLength": 1,
										"type": ["string", "null"]
									}
								},
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CashbackRule"
								}
							}
						},
						"description": "cashback rule updated"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "invalid update or discarded rule"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "authentication required"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "insufficient funding permissions"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "cashback rule not found for this funding account"
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				],
				"summary": "Update Cashback Rule",
				"tags": ["Cashback Rules"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Update"
					}
				}
			}
		},
