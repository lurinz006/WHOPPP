				"type": "object"
			},
			"AccountPartnerReward": {
				"properties": {
					"id": {
						"description": "Reward definition ID, prefixed `prwd_`. Progress and status apply to the containing account.",
						"type": "string"
					},
					"qualification_amount": {
						"$ref": "#/components/schemas/Money",
						"description": "Qualifying USD volume required to earn this reward."
					},
					"qualification_progress": {
						"$ref": "#/components/schemas/Money",
						"description": "Qualifying USD volume for the reward’s activity accumulated by this account since attribution, calculated using the fulfillment rules."
					},
					"qualification_type": {
						"description": "Activity that qualifies this account for the reward.",
						"enum": ["sales", "ad_spend"],
						"example": "sales",
						"type": "string"
					},
					"reward_amount": {
						"$ref": "#/components/schemas/Money",
						"description": "USD amount credited for this reward. Uses the saved grant amount once fulfillment has started."
					},
					"status": {
						"description": "This account's reward state. Credited requires a posted ledger entry; processing includes a met requirement awaiting fulfillment. Reversing and reversed reflect a subsequent reward reversal.",
						"enum": [
							"in_progress",
							"processing",
							"credited",
							"reversing",
							"reversed",
							"unavailable"
						],
						"example": "in_progress",
						"type": "string"
					}
				},
				"required": [
