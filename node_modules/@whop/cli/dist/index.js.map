												"example": "average_target",
												"type": ["string", "null"]
											},
											"budget_amount": {
												"description": "This ad group's budget in USD, which is what it is stored and billed in. `null` when the budget is set on the campaign instead.",
												"example": 60,
												"type": ["number", "null"]
