		"/payment_rules": {
			"get": {
				"description": "Lists the payment rules on an account.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Only return rules belonging to this account. Defaults to the account the request is acting for.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return rules with this status.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": ["active", "inactive", "deleted"],
							"type": "string"
						}
					},
					{
						"description": "Only return rules that take this action.",
						"in": "query",
						"name": "action",
						"required": false,
						"schema": {
							"enum": ["allow", "block", "review", "enforce_3ds"],
							"type": "string"
						}
					},
					{
						"description": "The field to sort by.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"enum": ["created_at"],
							"type": "string"
						}
					},
					{
						"description": "The sort direction.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"$ref": "#/components/schemas/PaymentRule"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": null,
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												}
											},
											"required": [
												"end_cursor",
												"start_cursor",
												"has_next_page",
												"has_previous_page"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "A list of payment rules"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "The status filter is not a known status"
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				],
				"summary": "List payment rules",
				"tags": ["Payment Rules"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "List",
						"title": "List Payment Rules"
					}
				}
			},
			"post": {
				"description": "Creates a payment rule. It is created `active` and applies its `action` to new payments that match all of its `conditions`.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"additionalProperties": false,
								"properties": {
									"account_id": {
										"description": "The account to create the rule on. Defaults to the account the request is acting for.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"action": {
										"description": "What this account's rule requests when every condition matches. One applicable account-rule action wins, in this order: `allow`, `block`, `review`, `enforce_3ds`. An `allow` overrides this account's other rules, never Whop's own fraud controls. A `review` requests authorization without capture for an eligible on-session card payment through Whop Payments. Automatic capture is scheduled for 48 hours after authorization; capture or void the payment before then to decide sooner. Capture may complete later or fail. Review is skipped for unsupported methods, off-session payments, and payments already configured for manual capture. An `enforce_3ds` is skipped when the account rule cannot apply a challenge. Other 3DS requirements still apply.",
										"enum": ["allow", "block", "review", "enforce_3ds"],
										"example": "review",
										"type": "string"
									},
									"conditions": {
										"additionalProperties": false,
										"description": "The conditions a payment is matched against. Up to 10 conditions, and 8 KiB once serialized.",
										"example": {
											"all": [
												{
													"field": "risk_score",
													"operator": "gte",
													"value": 70
												}
											]
										},
										"properties": {
											"all": {
												"items": {
													"additionalProperties": false,
													"properties": {
														"field": {
															"description": "The payment attribute this condition reads.",
															"enum": [
																"risk_score",
																"amount_in_usd",
																"card_country",
																"card_brand",
																"card_funding",
																"card_bin",
																"billing_country",
																"billing_postal_code",
																"billing_city",
																"customer_email",
																"email_domain",
																"ip_address",
																"ip_country"
															],
															"example": "risk_score",
															"type": "string"
														},
														"operator": {
															"description": "How the payment attribute is compared to the value.",
															"enum": [
																"eq",
																"neq",
																"gt",
																"gte",
																"lt",
																"lte",
																"in",
																"not_in",
																"starts_with",
																"contains",
																"ends_with",
																"in_cidr"
															],
															"example": "gte",
															"type": "string"
														},
														"value": {
															"$ref": "#/components/schemas/PaymentRuleConditionValue"
														}
													},
													"required": ["field", "operator", "value"],
													"type": "object"
												},
												"maxItems": 10,
												"minItems": 1,
												"type": "array"
											}
										},
										"required": ["all"],
										"type": "object"
									},
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"description": "Custom string-to-string values for your integration. Maximum 50 keys, 40 characters per key, 500 characters per value.",
										"example": {
											"team": "risk"
										},
										"type": "object"
									},
									"name": {
										"description": "A name for this rule. Up to 255 characters.",
										"example": "Review risky cards",
										"maxLength": 255,
										"minLength": 1,
										"type": "string"
									}
								},
								"required": ["name", "action", "conditions"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentRule"
								}
							}
						},
						"description": "The created rule"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "The action is not a supported action"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "The caller cannot write to this account"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				],
				"summary": "Create a payment rule",
				"tags": ["Payment Rules"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create",
						"title": "Create a Payment Rule"
					}
				}
			}
		},
		"/payment_rules/fields": {
			"get": {
				"description": "Lists the payment attributes a rule condition can read, with the operators and values each one accepts. Small and returned in full on one page.",
				"operationId": "fields",
				"responses": {
