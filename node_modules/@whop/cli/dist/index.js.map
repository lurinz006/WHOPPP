		"/stats/time_series": {
			"get": {
				"description": "Lists the metrics you can chart over time, with the unit each reports and the properties you can filter or break it down by. Aggregates that are not bucketed over time are reports, listed at `GET /stats/reports`.",
				"operationId": "list",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"description": "The available metrics.",
											"items": {
												"properties": {
													"breakdowns": {
														"description": "Supported breakdown_by values when they differ from the filter properties.",
														"items": {
															"type": "string"
														},
														"type": "array"
													},
													"description": {
														"description": "A short description of what the metric measures.",
														"example": "Ad platform delivery over time (spend, impressions, clicks) on the unified source language: source scopes by a whop:<campaign>:<group>:<ad> path, exact or with a trailing :* prefix (whop alone or no source = the whole account), and group_by=source groups one path segment deeper than the filter prefix. Only whop:* paths report delivery today; other roots return nothing. breakdown_by=metric returns each delivery measure per bucket plus whole-window data.totals. breakdown_by can instead split delivery by a dimension — age, gender, age_gender, placement, publisher_platform, country, region, device_platform, or impression_device — with the metric parameter picking the measure (spend, impressions, or clicks; defaults to spend). On the placement and publisher_platform dimensions the metric parameter also accepts results, roas, and cost_per_result: conversion-side measures attributed from your own tracked events rather than reported by the ad platform, with results counting conversions that match each ad group's conversion event. Dimension entries don't sum exactly to the totals (the ad platform withholds tiny cells) and are grouped by the ad account's calendar day — they can't re-bucket into time_zone. Spend converts to convert_to (defaults to usd). Whole-account attribution numbers live in the events and people metrics.",
														"type": "string"
													},
													"key": {
														"description": "The metric's key. Pass it to GET /stats/time_series/{metric} to query its values.",
														"example": "ad_xxxxxxxxxxxxxx",
														"type": "string"
													},
													"name": {
														"description": "Human-readable display name for the metric.",
														"example": "Ad delivery",
														"type": "string"
													},
													"properties": {
														"description": "The properties you can use with this metric — pass one as a filter (property=value) to narrow the series, or as breakdown_by=property to split it.",
														"items": {
															"example": "source",
															"type": "string"
														},
														"type": "array"
													},
													"unit": {
														"description": "How to read the metric's values: count is an integer, currency is a decimal amount, and percent is a number where 1.6 means 1.6%.",
														"enum": ["count", "currency", "percent"],
														"example": "currency",
														"type": "string"
													},
													"windows": {
														"description": "Snapshot metrics only: the trailing windows you can pass as snapshot_window, for example 30d. Absent on live metrics, which use from/to instead.",
														"items": {
															"example": "7d",
															"type": "string"
														},
														"type": "array"
													}
												},
												"required": [
													"key",
													"name",
													"unit",
													"properties",
													"description"
												],
												"type": "object"
											},
											"type": "array"
										}
									},
									"required": ["data"],
									"type": "object"
								}
							}
						},
						"description": "metric catalog"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					}
