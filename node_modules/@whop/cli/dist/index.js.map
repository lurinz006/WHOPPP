					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"buyer_account_id": {
										"description": "The account to join on behalf of, prefixed `biz_`. Leave it out to join as yourself. Required with an account credential, which passes its own account and records the account's owner as the user who joined.",
										"type": "string"
									},
									"custom_field_responses": {
										"description": "Answers to the variant's checkout questions. Every required question must be answered.",
										"items": {
											"properties": {
												"answer": {
													"description": "The buyer's answer.",
													"type": "string"
												},
												"custom_field_id": {
													"description": "The checkout question being answered, prefixed `field_`.",
													"type": "string"
												}
