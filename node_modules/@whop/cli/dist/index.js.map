									"dynamic_creative": false,
									"ends_at": null,
									"frequency_cap": null,
									"id": "adgrp_xxxxxxxxxxxxxx",
									"issues": [],
									"languages": [],
									"learning_progress": null,
									"message_apps": [],
									"minimum_daily_spend": null,
									"optimization_goal": null,
