		"/members": {
			"get": {
				"description": "Lists the members of an account. A member is one buyer's relationship with the account, regardless of how many memberships they hold.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "The account to list members for (`biz_` tag). Defaults to the account the credential acts as.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Filter by what the member can reach on the account.",
						"in": "query",
						"name": "access_level",
						"required": false,
						"schema": {
							"enum": ["no_access", "admin", "customer"],
							"type": "string"
						}
					},
					{
						"description": "Filter by whether the member is still part of the account.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": ["joined", "left"],
							"type": "string"
						}
					},
					{
						"description": "Only return members whose users match these `user_` identifiers.",
						"in": "query",
						"name": "user_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "user_xxxxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only return members whose `most_recent_action` is one of these values.",
						"in": "query",
						"name": "most_recent_actions",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"canceling",
									"churned",
									"finished_split_pay",
									"paused",
									"paid_subscriber",
									"paid_once",
									"expiring",
									"joined",
									"left",
									"trialing",
									"pending_entry",
									"renewing",
									"past_due"
								],
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "`active` returns members holding at least one membership that currently grants access; `inactive` returns members holding at least one membership that does not. Combined with `product_ids`, `plan_ids`, or `promo_code_ids`, one membership must match all of them.",
						"in": "query",
						"name": "membership_status",
						"required": false,
						"schema": {
							"enum": ["active", "inactive"],
							"type": "string"
						}
					},
					{
						"description": "Only return members holding a membership to one of these products, prefixed `prod_`. Unknown IDs match nothing.",
						"in": "query",
						"name": "product_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "prod_xxxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only return members holding a membership on one of these plans, prefixed `plan_`. Unknown IDs match nothing.",
						"in": "query",
						"name": "plan_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "plan_xxxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only return members holding a membership bought with one of these promo codes, prefixed `promo_`. Unknown IDs match nothing.",
						"in": "query",
						"name": "promo_code_ids",
						"required": false,
						"schema": {
							"items": {
								"example": "promo_xxxxxxxxxxxx",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Search members by name or username. An exact email address also matches when the credential holds the member:email:read scope.",
						"in": "query",
						"name": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only members who joined after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only members who joined before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Sort field. `most_recent_action_at` places members without one first when ascending and last when descending.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"default": "created_at",
							"enum": [
								"created_at",
								"joined_at",
								"last_accessed_at",
								"most_recent_action_at",
								"usd_total_spent"
							],
							"type": "string"
						}
					},
					{
						"description": "Sort direction.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"default": "desc",
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"items": {
												"$ref": "#/components/schemas/Member"
											},
											"type": "array"
										},
										"page_info": {
											"properties": {
												"end_cursor": {
													"example": null,
													"type": ["string", "null"]
												},
												"has_next_page": {
													"example": false,
													"type": "boolean"
												},
												"has_previous_page": {
													"example": false,
													"type": "boolean"
												},
												"start_cursor": {
													"example": "WyJjdXJzb3IiLDFd",
													"type": ["string", "null"]
												}
											},
											"required": [
												"end_cursor",
												"start_cursor",
												"has_next_page",
												"has_previous_page"
											],
											"type": "object"
										}
									},
									"required": ["data", "page_info"],
									"type": "object"
								}
							}
						},
						"description": "members listed"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "invalid access_level filter"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing credentials"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential lacks the member-read scope"
					}
				},
				"security": [
					{
						"bearerAuth": ["member:basic:read"]
					}
				],
				"summary": "List Members",
				"tags": ["Members"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "List"
					}
				},
				"x-codeSamples": [
					{
						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.members.list();\n"
					}
				]
			}
		},
