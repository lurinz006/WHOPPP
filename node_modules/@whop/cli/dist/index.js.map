		"/financing_applications/{id}/submit": {
			"post": {
				"description": "Submits a complete application for financing review, recording the merchant's acceptance, who submitted, and when, then moving it to `awaiting_review`. Before calling, present the application's `terms.content`, policies, and disclosure to the merchant and collect affirmative acceptance; every resubmission needs acceptance again. Only an application in `requires_collection` can be submitted, including after a reviewer requests more information. Retry with the same `Idempotency-Key`: submitting an application already in review without a replay returns an error. Approval does not by itself enable financing payment methods.",
				"operationId": "submit",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Financing application ID, prefixed `inrq_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "A unique key for safely retrying the same request for up to 24 hours.",
						"in": "header",
						"name": "Idempotency-Key",
						"required": false,
						"schema": {
							"maxLength": 255,
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"merchant_acceptance": {
										"properties": {
											"accepted": {
												"description": "Affirmation that the merchant accepted the presented terms.",
												"enum": [true],
												"example": true,
												"type": "boolean"
											},
											"terms_version": {
												"description": "Exact `terms.version` returned by the application and presented to the merchant. A stale version is rejected.",
												"example": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
												"type": "string"
											}
										},
										"required": ["accepted", "terms_version"],
										"type": "object"
									}
								},
								"required": ["merchant_acceptance"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/FinancingApplication"
								}
							}
						},
						"description": "Application submitted"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "Invalid answers, acceptance, or application state"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "Authentication required"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "Update permission required"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "Application not found"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"accountApiKeyOrAccountTokenOrOauthTokenAuth": [
							"payout:account:update"
						]
					}
				],
				"summary": "Submit Financing Application",
				"tags": ["Financing Applications"],
				"x-whop-credentials": [
					"account_api_key",
					"account_token",
					"oauth_token"
				]
			}
		},
