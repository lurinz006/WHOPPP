																"vnd",
																"pkr",
																"clp",
																"uyu",
																"ars",
																"zar",
																"dzd",
																"tnd",
																"mad",
																"kes",
																"kwd",
																"jod",
																"all",
																"xcd",
																"amd",
																"bsd",
																"bhd",
																"bob",
																"bam",
																"khr",
																"crc",
																"xof",
																"egp",
																"etb",
																"gmd",
																"ghs",
