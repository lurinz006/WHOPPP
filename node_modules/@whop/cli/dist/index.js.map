						"description": "payout not found"
					},
					"409": {
						"$ref": "#/components/responses/Conflict",
						"description": "payout is already processing"
					}
				},
				"security": [
					{
						"bearerAuth": ["payout:withdraw_funds"]
					}
				],
				"summary": "Cancel Payout",
				"tags": ["Payouts"]
			}
		},
		"/people": {
			"get": {
