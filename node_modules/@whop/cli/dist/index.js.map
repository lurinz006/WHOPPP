					},
					"plan_type": {
						"description": "Billing model for this variant: `one_time` or `renewal`.",
						"enum": ["renewal", "one_time"],
						"example": "renewal",
						"type": "string"
					},
					"renewal_price": {
						"$ref": "#/components/schemas/Money",
						"description": "The recurring charge every `billing_period` days. `amount` is `\"0.00\"` for one-time variants."
					},
					"title": {
						"description": "Variant display name shown to customers. `null` if no title has been set.",
						"example": null,
						"type": ["string", "null"]
					},
					"trial_period_days": {
						"description": "Free trial days configured before the first renewal charge. `null` if no trial is configured.",
						"example": null,
						"type": ["number", "null"]
					}
