						"description": "The note text.",
						"example": "Asked about annual billing.",
						"type": "string"
					},
					"created_at": {
						"description": "When the note was added, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"id": {
						"description": "Member note ID, prefixed `note_`.",
						"example": "note_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"member_id": {
						"description": "The member the note is about, prefixed `mber_`.",
						"example": "mber_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"user_id": {
						"description": "The customer the note is about, prefixed `user_`.",
						"example": "user_xxxxxxxxxxxxxx",
						"type": "string"
					}
				},
				"required": [
					"id",
					"content",
					"member_id",
					"user_id",
					"created_at",
					"author"
				],
				"type": "object"
			},
			"Membership": {
				"properties": {
					"account": {
						"$ref": "#/components/schemas/StorefrontAccount",
						"description": "The account (seller) this membership belongs to."
					},
					"affiliate": {
						"description": "The membership's affiliate commission. `null` without an affiliate, without `affiliate:basic:read` on the account, and always in webhooks.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/MembershipAffiliate"
							},
							{
								"type": "null"
							}
						]
					},
					"billing_period_days": {
						"description": "Number of days between recurring charges. `null` for non-renewing memberships or memberships with multiple renewal schedules.",
						"example": 30,
						"type": ["integer", "null"]
					},
					"cancel_at_period_end": {
						"description": "Whether the membership is set to cancel when the current billing period ends. Only meaningful for recurring variants.",
						"example": true,
						"type": "boolean"
					},
					"cancel_option": {
						"description": "The category the member picked for why they canceled. `null` when no category was picked.",
						"enum": [
							"too_expensive",
							"switching",
							"missing_features",
							"technical_issues",
							"bad_experience",
							"unused",
							"other",
							"testing",
							null
						],
						"example": "too_expensive",
						"type": ["string", "null"]
					},
					"canceled_at": {
						"description": "When cancellation was requested, or when the membership was canceled if no request time is recorded, as an ISO 8601 timestamp. `null` when neither is recorded.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"cancellation_reason": {
						"description": "Free-text explanation provided when canceling. `null` when no reason was provided.",
						"example": "Too expensive",
						"type": ["string", "null"]
					},
					"collection_method": {
						"description": "How renewals are collected. `charge_automatically` charges the saved payment method each period; `send_invoice` emails the buyer an invoice each period. `null` when not set.",
						"enum": ["charge_automatically", "send_invoice", null],
						"example": "send_invoice",
						"type": ["string", "null"]
					},
					"created_at": {
						"description": "When the membership was created, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"current_period_end": {
						"description": "When the current billing period renews, or when a non-renewing membership expires, as an ISO 8601 timestamp. `null` for one-time purchases with no expiration.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"current_period_start": {
						"description": "When the current billing period started, as an ISO 8601 timestamp. `null` when no billing period is recorded.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"expires_at": {
						"description": "When access ends for a membership with a fixed expiration, as an ISO 8601 timestamp. `null` when the membership has no expiration, such as a renewing membership.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"feedback_option": {
						"description": "The account's own cancel reason the member picked, as they saw it. `null` when the member picked a default category or gave no reason.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/MembershipFeedbackOption"
							},
							{
								"type": "null"
							}
						]
					},
					"id": {
						"description": "Membership ID, prefixed `mem_`.",
						"example": "mem_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"initial_price": {
						"$ref": "#/components/schemas/Money",
						"description": "The variant's current up-front price, in the variant's currency. A list price, not necessarily what the buyer paid. `amount` is `\"0.00\"` when the first charge is free."
					},
					"license_key": {
						"description": "The software license key for this membership. Only present when the product includes a software licensing experience.",
						"example": "WHOP-XXXX-XXXX-XXXX",
						"type": ["string", "null"]
					},
					"manage_url": {
						"description": "URL where the buyer can sign in to manage billing. `null` without a member record or unless the caller is the buyer or has `member:manage` on the account.",
						"example": "https://whop.com/billing/manage/mber_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"member": {
						"description": "The caller's member row on the account. Present only when the membership belongs to the caller; `null` on seller-side reads.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/MembershipMember"
							},
							{
								"type": "null"
							}
						]
					},
					"member_id": {
						"description": "The buyer's member record on the account, prefixed `mber_`. `null` when the membership has no member record, such as an unclaimed membership.",
						"example": "mber_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"metadata": {
						"description": "Custom key-value pairs stored on the membership, commonly used for software licensing.",
						"example": {},
						"type": "object"
					},
					"most_recent_action": {
						"description": "The membership's latest lifecycle event, such as `renewing_on` or `canceled_on`. Pair it with `most_recent_action_at`. `null` when none is recorded.",
						"enum": [
							"canceled_on",
							"finished_split_pay_at",
							"canceling_on",
							"ending_on",
							"renewing_on",
							"past_due",
							"next_payment_attempt",
							"paused_at",
							"trial_ends_at",
							"unresolved_at",
							"trial_canceling_on",
							null
						],
						"example": "renewing_on",
						"type": ["string", "null"]
					},
					"most_recent_action_at": {
						"description": "When `most_recent_action` happened or is scheduled to happen, as an ISO 8601 timestamp. A future time for upcoming events such as `renewing_on`. `null` when no action is recorded.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"phone_number": {
						"description": "The buyer's phone number recorded for this membership, or `null`. The number collected (or verified) at checkout when the seller's phone collection is on; falls back to the buyer's account number when they have shared one with this seller.",
						"example": "+xxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"plan_id": {
						"description": "The variant the buyer purchased, prefixed `plan_`.",
						"example": "plan_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"product": {
						"$ref": "#/components/schemas/MembershipProduct",
						"description": "The product this membership grants access to."
					},
					"product_id": {
						"description": "The product this membership grants access to, prefixed `prod_`.",
						"example": "prod_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"promo_code_id": {
						"description": "The promo code discounting this membership, prefixed `promo_`. `null` when none is applied. Set at checkout or by Apply Promo Code to Membership.",
						"example": "promo_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"renewal_price": {
						"description": "What the next renewal charges, after any promo code that still applies. `null` for non-renewing memberships.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/Money"
							},
							{
								"type": "null"
							}
						]
					},
					"split_pay_current_payments": {
						"description": "Paid installments counted so far on a split pay membership. `null` when the membership is not on split pay, or before its first installment is counted.",
						"example": null,
						"type": ["integer", "null"]
					},
					"split_pay_required_payments": {
						"description": "Installment payments required before the membership stops billing. `null` when the membership is not on split pay.",
						"example": null,
						"type": ["integer", "null"]
					},
					"status": {
						"description": "Billing state of the membership. `active`/`trialing` memberships grant access; `past_due` is the grace period after a failed payment; `completed` one-time purchases keep access; `canceled`/`expired` do not.",
						"enum": [
							"trialing",
							"active",
							"past_due",
							"completed",
							"canceled",
							"expired",
							"unresolved"
						],
						"example": "active",
						"type": "string"
					},
					"updated_at": {
						"description": "When the membership was last changed, as an ISO 8601 timestamp. Reflects the most recent change to the membership itself, so you can reconcile against webhook retries, replays, and backfills.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"user_id": {
						"description": "The buyer, prefixed `user_`. `null` when the buyer is another business or the membership is unclaimed.",
						"example": "user_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					}
				},
				"required": [
					"id",
					"status",
					"user_id",
					"member_id",
					"product_id",
					"product",
					"plan_id",
					"promo_code_id",
					"billing_period_days",
					"initial_price",
					"renewal_price",
					"split_pay_current_payments",
					"split_pay_required_payments",
					"collection_method",
					"license_key",
					"phone_number",
					"cancel_at_period_end",
					"current_period_start",
					"current_period_end",
					"expires_at",
					"canceled_at",
					"cancel_option",
					"cancellation_reason",
					"feedback_option",
					"most_recent_action",
					"most_recent_action_at",
					"manage_url",
					"metadata",
					"created_at",
					"updated_at",
					"member",
					"affiliate",
					"account"
				],
				"type": "object"
			},
			"MembershipAffiliate": {
				"properties": {
					"applies_to_payments": {
						"description": "Whether the commission is paid on the membership's first payment only or on all its payments.",
