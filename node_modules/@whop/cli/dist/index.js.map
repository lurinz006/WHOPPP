		"/partners/businesses/{id}/resend_invite": {
			"post": {
				"description": "Re-emails an outstanding invite to claim ownership of a referred business. Find the invite in the business's `pending_owner_invites`. Only the first-tier partner can resend, from a whop.com session or the Whop CLI or MCP with `partner:handoff`. Rate limited to one resend per invite every five minutes.",
				"operationId": "businesses-resend_invite",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "The partner business ID (a coma_ identifier).",
