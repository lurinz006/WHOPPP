			"post": {
				"description": "Saves a buyer's payment method for later without charging it — one the buyer just supplied through the payment elements in setup mode, or one already on file to re-verify. The setup completes in the background, so the response is the setup intent as created, not its outcome: hand `client_secret` to the elements' `handleNextAction`, or poll Retrieve setup status. A buyer's own token holding `member:payment_methods:use` may create a setup intent for itself from a confirmation token.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "The account to save the payment method for, prefixed `biz_`.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": "string"
									},
									"confirmation_token": {
										"description": "A confirmation token describing a payment method the buyer just supplied, collected by the payment elements in setup mode. Provide this or `payment_method_id`, not both. The buyer is resolved from the token's billing email, or from `email`, and may still have a step to complete — poll Retrieve setup status for what to do next.",
										"example": "ctok_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"currency": {
										"description": "The currency the saved payment method will be used with, as a lowercase ISO 4217 code. Controls which currency-specific payment methods are available. Defaults to `usd`.",
										"example": "usd",
										"type": ["string", "null"]
									},
									"email": {
										"description": "Overrides the buyer email carried on the confirmation token, resolving or creating the user the method belongs to. Ignored unless `confirmation_token` is provided, and when the token was created by a signed-in buyer or the caller is the buyer.",
										"example": "dana@shinetime.example",
										"type": ["string", "null"]
									},
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"description": "Custom metadata to attach to the setup intent. Returned on the setup intent and its webhooks.",
										"example": {
											"customer_id": "cus_4417"
										},
										"type": ["object", "null"]
									},
									"owner_id": {
										"description": "Who the saved payment method belongs to. Pass `account_id` to save it on the account itself, which needs `payment:charge` on the account. Pass your own user ID, prefixed `user_`, to save it on the authenticated user. Omit it to save it on the buyer: the caller when it is the buyer, otherwise the user the confirmation token names. Not available with `payment_method_id`, which keeps its current owner, or with `purpose`.",
										"example": "biz_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"payment_method_id": {
										"description": "An existing payment method to re-verify and save, prefixed `payt_`. Provide this or `confirmation_token`, not both. Not available to a buyer credential.",
										"example": "payt_xxxxxxxxxxxxxx",
										"type": ["string", "null"]
									},
									"purpose": {
										"description": "What the saved payment method will pay for. Set to `ads_billing` when saving a card to pay for Whop Ads on `account_id`: the card is verified by Whop Ads, the merchant that charges it, which helps minimize security declines on ad payments, and it requires `ad_campaign:create` on `account_id`. Omit it for any other payment method.",
										"enum": ["ads_billing", null],
										"example": "ads_billing",
										"type": ["string", "null"]
									},
									"return_url": {
										"description": "Where the buyer continues after completing an off-site step. An absolute https URL without credentials, at most 2,048 characters.",
										"example": "https://shinetime.example/billing/saved",
										"type": ["string", "null"]
									},
									"three_ds_level": {
										"description": "3D Secure behavior for supported on-session card payments. `mandate_challenge` requires a 3DS challenge before payment processing; `mandate_if_required` mandates a challenge only when the payment processor requires it; `frictionless_if_required` uses the regular frictionless 3DS flow. Payments of $1,000 or more use `mandate_if_required` unless `mandate_challenge` is selected. Risk and authentication recovery requirements can override the preference. Applies to this setup only, and only while the buyer is present: ignored with `payment_method_id`, which re-verifies off session. Not available with `purpose: ads_billing`. Defaults to `frictionless_if_required`.",
										"enum": [
											"mandate_challenge",
											"mandate_if_required",
											"frictionless_if_required",
											null
										],
										"example": "mandate_challenge",
										"type": ["string", "null"]
									}
								},
								"required": ["account_id"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SetupIntent"
								}
							}
						},
						"description": "setup intent created from a confirmation token"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/V1ErrorResponse"
								}
							}
						},
						"description": "confirmation token combined with a stored payment method"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "unauthenticated"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential without payment:charge"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "confirmation token from another account"
					},
					"409": {
						"$ref": "#/components/responses/Conflict"
					}
				},
				"security": [
					{
						"bearerAuth": ["payment:charge"]
					}
				],
				"summary": "Create Setup Intent",
				"tags": ["Setup Intents"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create"
					}
				}
			}
		},
