						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "The account the token was minted for, prefixed `biz_`. It must match the token's account.",
						"in": "query",
						"name": "account_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
