				],
				"type": "object"
			},
			"DomainDnsRecord": {
				"properties": {
					"name": {
						"description": "Full hostname where the record must be published.",
						"example": "_whop.shop.example.com",
						"type": "string"
					},
					"type": {
						"description": "DNS record type.",
						"enum": ["TXT", "CNAME", "A", "AAAA"],
						"example": "TXT",
						"type": "string"
					},
					"value": {
						"description": "DNS record content.",
						"example": "whop-domain-verification=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
						"type": "string"
					}
				},
				"required": ["type", "name", "value"],
				"type": "object"
			},
			"DomainEmail": {
				"properties": {
					"state": {
						"description": "`pending` while Whop sets the domain up with its email provider and publishes its DNS records, `ready` once the provider verified them, and `action_required` when it couldn't; its issue says what happens next. `releasing` while Whop removes email from the domain.",
						"enum": ["pending", "ready", "action_required", "releasing"],
						"example": "pending",
						"type": "string"
					}
				},
				"required": ["state"],
				"type": "object"
			},
			"DomainIssue": {
				"properties": {
					"capability": {
						"description": "The capability the issue is about.",
						"enum": [
							"verification",
							"registration",
							"platform",
							"website",
							"apple_pay",
							"pixel",
							"email",
							"transfer"
						],
						"example": "verification",
						"type": "string"
					},
					"code": {
						"description": "What needs attention, as a stable code.",
						"enum": [
							"verification_required",
							"verification_expired",
							"ownership_conflict",
							"ownership_lost",
							"dns_required",
							"provider_validation",
							"certificate_pending",
							"expiring_soon",
							"account_unavailable",
							"check_failed",
							"purchase_expired",
							"domain_unavailable",
							"unsupported_tld",
							"registration_unavailable",
							"registration_failed",
							"renewal_failed",
							"payment_action_required",
							"domain_on_whop",
							"domain_transfer_unavailable",
							"transfer_locked",
							"transfer_auth_code_rejected",
							"transfer_rejected",
							"transfer_not_cancellable",
							"domain_transfer_failed",
							"apple_pay_unverified",
							"pixel_not_seen",
							"pixel_not_installed",
							"pixel_waiting",
							"pixel_unreachable",
							"pixel_quiet",
							"email_needs_whop_dns",
							"email_unreachable",
							"email_identity_in_use",
							"email_verification_failed"
						],
						"example": "verification_required",
						"type": "string"
					},
					"code_block": {
						"description": "Code to add to the site to fix the issue, ready to copy. `null` when the issue needs none.",
						"example": null,
						"type": ["string", "null"]
					},
					"dns_records": {
						"items": {
							"$ref": "#/components/schemas/DomainDnsRecord",
							"description": "DNS records to publish to fix the issue. Empty when the issue needs no DNS change."
						},
						"type": "array"
					},
					"message": {
						"description": "What needs attention and how to fix it.",
						"example": "Publish this TXT record to prove you own the domain. Verification runs automatically.",
						"type": "string"
					}
				},
				"required": [
					"capability",
					"code",
					"message",
					"dns_records",
					"code_block"
				],
				"type": "object"
			},
			"DomainListItem": {
				"properties": {
					"account_id": {
						"description": "ID of the account the domain belongs to, prefixed `biz_`.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"apple_pay": {
						"description": "Offering Apple Pay at checkouts served from the domain. `null` when not enrolled or not visible to you.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainApplePay"
							},
							{
								"type": "null"
							}
						]
					},
					"availability": {
						"description": "Whether you can register the hostname and what it costs. Set only when no domain on Whop has it.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainAvailability"
							},
							{
								"type": "null"
							}
						]
					},
					"created_at": {
						"description": "When the domain was created, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"domain": {
						"description": "Normalized hostname, such as checkout.example.com.",
						"example": "shop.example.com",
						"type": "string"
					},
					"email": {
						"description": "Sending and receiving email on the domain through Whop. `null` when not wanted, or when the domain belongs to an account you can't read.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainEmail"
							},
							{
								"type": "null"
							}
						]
					},
					"id": {
						"description": "Domain ID, prefixed `dom_`. `null` when no domain on Whop has this hostname.",
						"example": "dom_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"issues": {
						"items": {
							"$ref": "#/components/schemas/DomainIssue",
							"description": "What needs attention, each tagged with its capability. Empty when nothing does or when the domain isn't yours."
						},
						"type": "array"
					},
					"metadata": {
						"description": "Custom string keys and values attached to this domain. Empty when the domain isn't yours.",
						"example": {},
						"type": "object"
					},
					"owned_by": {
						"description": "The account that has proven it owns this hostname on Whop, which can be your own. `null` when no account has.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainOwner"
							},
							{
								"type": "null"
							}
						]
					},
					"pixel": {
						"description": "Tracking page views on the domain with the Whop pixel. `null` when not tracked or not visible to you.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainPixel"
							},
							{
								"type": "null"
							}
						]
					},
					"platform": {
						"description": "An address on a zone Whop runs, such as example.whop.site, that follows its app's route. `null` for other domains or when not visible to you.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainPlatform"
							},
							{
								"type": "null"
							}
						]
					},
					"registration": {
						"description": "Buying the domain through Whop, renewing it, and running its DNS. `null` when not wanted or not visible to you.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainRegistration"
							},
							{
								"type": "null"
							}
						]
					},
					"stats": {
						"description": "Traffic on the domain. `null` when the domain isn't on Whop or isn't visible to you.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainStats"
							},
							{
								"type": "null"
							}
						]
					},
					"status": {
						"description": "The most pressing state of the domain's capabilities: `releasing`, then `action_required`, then `pending`, then `ready`. `idle` when it wants nothing.",
						"enum": [
							"idle",
							"pending",
							"ready",
							"action_required",
							"releasing",
							null
						],
						"example": "pending",
						"type": ["string", "null"]
					},
					"transfer": {
						"description": "Moving the domain to another Whop account. `null` when not turned on or not visible to you.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainTransfer"
							},
							{
								"type": "null"
							}
						]
					},
					"updated_at": {
						"description": "When the domain was last updated, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"verification": {
						"description": "Proving you control the domain's DNS with a TXT record. `null` when not wanted or not visible to you.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainVerification"
							},
							{
								"type": "null"
							}
						]
					},
					"website": {
						"description": "Serving a Whop website on the domain. `null` when not wanted.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainWebsite"
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": [
					"id",
					"domain",
					"status",
					"account_id",
					"verification",
					"registration",
					"platform",
					"website",
					"apple_pay",
					"pixel",
					"email",
					"transfer",
					"owned_by",
					"issues",
					"stats",
					"metadata",
					"created_at",
					"updated_at",
					"availability"
				],
				"type": "object"
			},
			"DomainOwner": {
				"properties": {
					"id": {
						"description": "ID of the account that owns the domain, prefixed `biz_`.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"logo_url": {
						"description": "Account logo image URL.",
						"example": null,
						"type": ["string", "null"]
					},
					"route": {
						"description": "Account public route identifier.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"title": {
						"description": "Account display name.",
						"example": "Rival Shop",
						"type": "string"
					}
				},
				"required": ["id", "title", "route", "logo_url"],
				"type": "object"
			},
			"DomainPixel": {
				"properties": {
					"state": {
						"description": "`ready` while the Whop pixel recorded a page view on the domain in the last 7 days. `pending` until a pixel you asked for records its first one, and `action_required` once it goes 7 days without one; its issue says what to do.",
						"enum": ["pending", "ready", "action_required"],
						"example": "pending",
						"type": "string"
					}
				},
				"required": ["state"],
				"type": "object"
			},
			"DomainPlatform": {
				"properties": {
					"state": {
						"description": "Whether Whop holds this address for the account. A platform address is ready as soon as its route is claimed.",
						"enum": ["pending", "ready", "action_required", "releasing"],
						"example": "pending",
						"type": "string"
					}
				},
				"required": ["state"],
				"type": "object"
			},
			"DomainPublicRecord": {
				"properties": {
					"dnssec": {
						"description": "Whether the domain's delegation is signed with DNSSEC, or `null` when the registry doesn't say.",
						"example": false,
						"type": ["boolean", "null"]
					},
					"expires_at": {
						"description": "When the current registration expires, as an ISO 8601 timestamp, or `null` when the record omits it.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"name_servers": {
						"items": {
							"description": "The name servers the domain delegates to, lowercase, such as `ns1.example.com`. Empty when the record lists none.",
							"example": "ns1.example.com",
							"type": "string"
						},
						"type": "array"
					},
					"registered_at": {
						"description": "When the domain was first registered, as an ISO 8601 timestamp, or `null` when the record omits it.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"registrant": {
						"description": "Who the domain is registered to, often a privacy service or `Redacted For Privacy`. `null` when the record publishes no registrant.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainRegistrant"
							},
							{
								"type": "null"
							}
						]
					},
					"registrar": {
						"description": "The registrar that manages the domain, or `null` when the record doesn't name one.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/DomainRegistrar"
							},
							{
								"type": "null"
							}
						]
					},
					"statuses": {
						"items": {
							"description": "The domain's registry statuses in RDAP form, such as `client transfer prohibited`. Empty when the record lists none.",
							"example": "client transfer prohibited",
							"type": "string"
						},
						"type": "array"
					},
					"updated_at": {
						"description": "When the registration record last changed, as an ISO 8601 timestamp, or `null` when the record omits it.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					}
				},
				"required": [
					"registrar",
					"registrant",
					"registered_at",
					"expires_at",
					"updated_at",
					"statuses",
					"name_servers",
					"dnssec"
				],
				"type": "object"
			},
			"DomainRegistrant": {
				"properties": {
					"address": {
						"description": "Registrant postal address as published, with lines separated by line breaks. Often only a state or region. `null` when withheld.",
						"example": "Burlington\nMA",
						"type": ["string", "null"]
					},
					"contact_url": {
						"description": "A web form for contacting the registrant, published when the registrar withholds their email. `null` when there is none.",
						"example": "https://registrar.example/contact/example.com",
						"type": ["string", "null"]
					},
					"country": {
						"description": "Registrant country as an ISO 3166-1 alpha-2 code, such as `US`, or `null` when withheld.",
						"example": "US",
						"type": ["string", "null"]
					},
					"email": {
						"description": "Registrant email address, often a privacy forwarding address, or `null` when withheld.",
						"example": null,
						"type": ["string", "null"]
					},
					"name": {
						"description": "Registrant name, or `null` when withheld.",
						"example": null,
						"type": ["string", "null"]
					},
					"organization": {
						"description": "Registrant organization, often a privacy service, or `null` when withheld.",
						"example": "Privacy Protect, LLC",
						"type": ["string", "null"]
					},
					"phone": {
						"description": "Registrant phone number, or `null` when withheld.",
						"example": null,
						"type": ["string", "null"]
					}
				},
				"required": [
					"name",
					"organization",
					"email",
					"phone",
					"address",
					"country",
					"contact_url"
				],
				"type": "object"
			},
			"DomainRegistrar": {
				"properties": {
					"iana_id": {
						"description": "The registrar's IANA registrar ID, or `null` when the record omits it.",
						"example": "9999",
						"type": ["string", "null"]
					},
					"name": {
						"description": "Registrar name, such as `GoDaddy.com, LLC`.",
						"example": "Example Registrar, Inc.",
						"type": "string"
					},
					"url": {
						"description": "The registrar's website, or `null` when the record omits it.",
						"example": "https://registrar.example",
						"type": ["string", "null"]
					}
				},
				"required": ["name", "iana_id", "url"],
				"type": "object"
			},
			"DomainRegistration": {
				"properties": {
					"amount_due": {
						"description": "What the domain owes now. `null` when nothing is owed.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/Money"
							},
							{
								"type": "null"
							}
						]
					},
					"auto_renew": {
						"description": "Whether Whop charges the saved payment method to renew the domain before it expires.",
						"example": true,
						"type": "boolean"
					},
					"expires_at": {
						"description": "When the registration expires unless renewed, as an ISO 8601 timestamp. `null` until it's registered.",
						"example": null,
						"type": ["string", "null"]
					},
					"method": {
						"description": "How the domain came to Whop: `registration` when it was bought through Whop, `transfer` when it was moved from another registrar.",
						"enum": ["registration", "transfer"],
						"example": "transfer",
						"type": "string"
					},
					"payment_method_id": {
						"description": "ID of the saved card charged for the domain, prefixed `payt_`. `null` when none is set.",
						"example": null,
						"type": ["string", "null"]
					},
					"phase": {
						"description": "Where the registration is: awaiting payment, ordering at the registrar, transferring from another registrar, delegating DNS to Whop, held, expired, or releasing.",
						"enum": [
							"awaiting_payment",
							"ordering",
							"transferring",
							"delegating",
							"held",
							"expired",
							"failed",
							"releasing"
						],
						"example": "awaiting_payment",
						"type": "string"
					},
					"purchase_url": {
						"description": "Link to pay what the domain owes now: its registration or transfer, or a yearly renewal. `null` when nothing is owed.",
						"example": "https://whop.com/checkout/ch_xxxxxxxxxxxxxx/",
						"type": ["string", "null"]
					},
					"renewal_price": {
						"description": "What each yearly renewal costs at the registrar's current price. Set when the response is a single domain; `null` in lists, while the domain is being released, or when the price can't be read right now.",
						"oneOf": [
