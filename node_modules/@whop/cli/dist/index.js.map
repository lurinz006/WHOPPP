						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Search payments by payment ID, dispute ID, user ID, membership ID, user email, name, or username.",
						"in": "query",
						"name": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only for searches: with `query`, also search the account's connected accounts. Requires `account_id` and `query`, and is a 400 without either; it never lists connected accounts' payments on its own. Matches on payment, dispute, user or membership ID, buyer email, or a card's first 6 or 8 digits and last 4 separated by a space or dash (`424242 4242`). Free-text queries such as a name search only the named account. Connected accounts' payments are returned only for connected accounts you can read payments on.",
						"in": "query",
						"name": "include_connected_accounts",
						"required": false,
						"schema": {
