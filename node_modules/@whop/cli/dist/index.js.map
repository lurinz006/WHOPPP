								"description": "Processor used by the payment source.",
								"type": ["string", "null"]
							},
							"payout_amount": {
								"description": "Withdrawal principal sent to the destination, excluding fees, in the withdrawal currency. Requires payout:withdrawal:read.",
								"oneOf": [
