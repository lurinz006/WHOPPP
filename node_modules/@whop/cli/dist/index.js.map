						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentQuote"
								}
							}
						},
						"description": "payment quote retrieved"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "unauthenticated"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "credential without read access to the quote's account"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "unknown payment quote"
					}
				},
