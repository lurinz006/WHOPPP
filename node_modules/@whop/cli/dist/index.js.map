						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Filter to accounts located in one country, as an ISO 3166-1 alpha-2 code such as `US`. Pair with `breakdown_by=account_country` to split by account country. Available on metrics that list `account_country`.",
						"in": "query",
						"name": "account_country",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Filter to one card-issuing bank, named as the processor reports it, for example JPMORGAN CHASE BANK N A, or unknown for payments with no reported bank. Available on metrics that list issuer.",
						"in": "query",
						"name": "issuer",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Funnel only. Time allowed from the first event to the final event: integer minutes, hours, or days, up to 30d.",
						"in": "query",
						"name": "conversion_window",
						"required": false,
						"schema": {
							"default": "7d",
							"pattern": "^[1-9][0-9]*[mhd]$",
							"type": "string"
						}
					},
					{
						"description": "Funnel only. Include only entrants whose full conversion window has elapsed. Required for confidence intervals and comparisons.",
						"in": "query",
						"name": "mature_only",
						"required": false,
						"schema": {
							"default": false,
							"type": "boolean"
						}
					},
					{
						"description": "Funnel only. Required when metric=funnel. 2 to 10 ordered events per person, as consecutive one-based bracket parameters such as `steps[1][event]=pixel.page&steps[1][page]=/pricing*&steps[2][event]=payment.completed`. Values are scalar strings, never JSON. A person's first step 1 match inside `from`/`to` anchors their cohort, breakdown, and conversion window; later matches do not restart it. Other events may occur between steps, and conversions may land after `to`. For an experiment funnel, make `experiment.exposure` step 1 and pass `breakdown_by=variant`.",
						"explode": true,
						"in": "query",
						"name": "steps",
						"required": false,
						"schema": {
							"additionalProperties": false,
							"properties": {
