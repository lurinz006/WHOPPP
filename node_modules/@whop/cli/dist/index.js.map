				"tags": ["App Installations"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "List"
					}
				}
			}
		},
		"/app_installations/{id}": {
			"get": {
				"description": "Retrieves an app installation, with the metadata the app stores on it. The app, its developer and the account it's installed on can retrieve it.",
				"operationId": "get",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AppInstallation"
								}
							}
						},
						"description": "app installation retrieved"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "the caller cannot read this installation"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "the installation does not belong to this app or is no longer active"
					}
				},
				"security": [
					{
						"bearerAuth": ["developer:app_installation:read"]
					},
					{
						"bearerAuth": ["company:basic:read"]
					},
					{
						"bearerAuth": ["developer:basic:read"]
					}
				],
				"summary": "Retrieve App Installation",
				"tags": ["App Installations"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Retrieve"
					}
				},
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "App installation ID, prefixed `aag_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			},
			"patch": {
				"description": "Updates the `metadata` and `external_id` your app keeps on an installation. Only the metadata keys you send change, so separate jobs can each keep their own keys.",
				"operationId": "update",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "App installation ID, prefixed `aag_`.",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"external_id": {
										"description": "Your app's own identifier for this installation, such as the ID of the linked account in another system, or `null` when none is set. At most 255 characters and unique across your app's installations, so you can find an installation with `GET /app_installations?external_id=`; setting one another installation already has returns a `409`. Only the app and its developer see it; for the account the app is installed on it is always `null`.",
										"example": "acme-store",
										"type": ["string", "null"]
									},
									"metadata": {
										"additionalProperties": {
											"type": ["string", "null"]
										},
										"description": "Metadata keys to set, as string values. A key set to `null` is removed and keys you leave out don't change; an empty object clears every key. At most 50 keys; keys are at most 100 characters and values at most 500.",
										"example": {
											"last_synced_at": "2026-10-16T21:00:00Z"
										},
										"type": "object"
									}
								},
								"required": [],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AppInstallation"
								}
							}
						},
						"description": "app installation updated"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "the update is invalid"
					},
					"401": {
						"$ref": "#/components/responses/Unauthorized",
						"description": "missing or invalid authentication"
					},
					"403": {
						"$ref": "#/components/responses/Forbidden",
						"description": "the caller is not the app, or its key doesn't grant the update scope"
					},
					"404": {
						"$ref": "#/components/responses/NotFound",
						"description": "the installation does not belong to this app"
					},
					"409": {
						"$ref": "#/components/responses/Conflict",
						"description": "another installation of this app already has the external_id"
					}
				},
				"security": [
					{
						"appApiKeyAuth": ["developer:app_installation:update"]
					}
				],
				"summary": "Update App Installation",
				"tags": ["App Installations"],
				"x-whop-credentials": ["app_api_key"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Update"
					}
				}
			}
		},
		"/apps": {
			"get": {
				"description": "Lists apps on the Whop platform: the app store's live apps, or — with `account_id` and developer access to that account — every app the account owns. Requires authentication except for Whop's public app and website discovery lists. Public website discovery includes built official blueprints (verified apps with a product) and built, live community blueprints that Whop recommends.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Only return apps created by this account (`biz_` tag). With developer access to the account this includes its unlisted and hidden apps.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Filter apps by the type of end-user they are built for. Apps of type `website` are left out unless you ask for them by name.",
						"in": "query",
						"name": "app_type",
						"required": false,
						"schema": {
							"enum": [
								"b2b_app",
								"b2c_app",
								"company_app",
								"component",
								"website"
							],
							"type": "string"
						}
					},
					{
						"description": "Only return apps supporting this view type, such as `dashboard` or `hub`.",
						"in": "query",
						"name": "view_type",
						"required": false,
						"schema": {
							"enum": [
								"hub",
								"discover",
								"dash",
								"dashboard",
								"analytics",
								"skills",
								"openapi"
							],
							"type": "string"
						}
					},
					{
						"description": "Only return apps whose Whop verification status matches this value. Omit this filter to include every verification status the caller can see.",
						"in": "query",
						"name": "verified",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"deprecated": true,
						"description": "Legacy compatibility filter. Use `verified` for field equality. `true` returns verified apps; clients pinned before `2026-08-25-2` retain the earlier public website discovery behavior.",
						"in": "query",
