						"lang": "TypeScript",
						"source": "import { WhopClient } from \"@whop/sdk\";\n\nconst client = new WhopClient({ token: \"YOUR_TOKEN\", apiVersionDate: \"2026-08-21-1\", idempotencyKey: \"YOUR_IDEMPOTENCY_KEY\" });\nawait client.bountySubmissions.create({\n    bounty_id: \"bnty_xxxxxxxxxxxxxx\"\n});\n"
					}
				]
			}
		},
