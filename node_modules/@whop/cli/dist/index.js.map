		"/waitlist_entries": {
			"get": {
				"description": "Lists the waitlist signups you can see. `waitlist_entry:read` returns your own signups, and `plan:waitlist:read` returns signups to the seller accounts you are authorized on; with both, you get both sets. Signups submitted on behalf of an account are not in this list; pass `buyer_account_id` to list them instead, which needs `waitlist_entry:read` on that account. Account credentials see the signups submitted to their own account, and pass their own account as `buyer_account_id` to see the ones it submitted.",
				"operationId": "list",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return signups for this variant, prefixed `plan_`.",
						"in": "query",
						"name": "plan_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return signups submitted to this seller account, prefixed `biz_`.",
						"in": "query",
						"name": "account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return signups for variants on this product, prefixed `prod_`.",
						"in": "query",
						"name": "product_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "List the signups submitted on behalf of this account, prefixed `biz_`, instead of your own and seller signups. Requires `waitlist_entry:read` on the account. The other filters still apply.",
						"in": "query",
						"name": "buyer_account_id",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return signups in this state. Canceled signups are returned only when `status` is `canceled`.",
						"in": "query",
						"name": "status",
						"required": false,
						"schema": {
							"enum": ["pending", "approved", "denied", "canceled"],
							"type": "string"
						}
					},
					{
						"description": "Search signups by the user's name or username, or the name of the account they were submitted on behalf of. An account ID, prefixed `biz_`, matches signups submitted on behalf of that account, and an exact email address matches that user's signups.",
						"in": "query",
						"name": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Only return signups submitted at or before this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_before",
						"required": false,
						"schema": {
							"format": "date_time",
							"type": "string"
						}
					},
					{
						"description": "Only return signups submitted at or after this ISO 8601 timestamp.",
						"in": "query",
						"name": "created_after",
						"required": false,
						"schema": {
							"format": "date_time",
							"type": "string"
						}
					},
					{
						"description": "The field to sort results by. Defaults to `created_at`.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"enum": ["created_at"],
							"type": "string"
						}
					},
					{
						"description": "The sort direction for results. Defaults to descending.",
