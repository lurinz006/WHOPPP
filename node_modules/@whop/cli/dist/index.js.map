						"description": "Whether the variant has unlimited stock.",
						"example": true,
						"type": "boolean"
					},
					"visibility": {
						"description": "Where this variant can be seen. `visible` variants appear on the product page.",
						"enum": ["visible", "hidden", "archived", "quick_link"],
						"example": "visible",
						"type": "string"
					}
				},
				"required": [
