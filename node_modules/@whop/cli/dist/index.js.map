				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"days": {
										"description": "Days of access from now (1-1095), which sets `current_period_end`. Omit to keep the original `current_period_end`; required once it has passed. Ignored for lifetime memberships.",
