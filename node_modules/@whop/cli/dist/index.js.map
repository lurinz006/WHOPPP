		"/stats/reports/platform_trends": {
			"get": {
				"description": "Retrieves payments across all of Whop for up to four windows at once, optionally broken down by business type, industry type, product category, account country or customer country. The report covers the whole platform, so it takes no `account_id` and any authenticated caller can read it.",
				"operationId": "platform_trends",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"description": "What each row is. Omit it for one row per window, holding the window's total.",
						"in": "query",
						"name": "breakdown_by",
						"required": false,
						"schema": {
							"enum": [
								"business_type",
								"industry_type",
								"product_category",
								"account_country",
								"customer_country"
							],
							"type": "string"
						}
					},
					{
						"description": "Comma-separated properties and metrics to return on each row. `business_type` can ride along on `industry_type` rows. Defaults to `gross_revenue,businesses`.",
						"in": "query",
						"name": "columns",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Comma-separated windows, at most four: `1d`, `7d`, `30d`, `90d`, `365d`, `mtd`, `qtd`, `ytd`, `all_time`, an explicit `2026-09-01..2026-10-01`, any of these prefixed `prev:` for the equal-length period before, or suffixed `@2026-09-01` to end earlier. Defaults to `30d`.",
						"in": "query",
						"name": "windows",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "IANA zone that day, month, quarter and year boundaries fall in. Defaults to `Etc/UTC`.",
						"in": "query",
						"name": "time_zone",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "The requested metric that ranks rows, by its value in the first window. Defaults to the first requested metric.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"enum": [
								"gross_revenue",
								"businesses",
								"products",
								"payments",
								"customers",
								"aov",
								"repeat_rate",
								"median_gross_revenue",
								"new_businesses",
								"avg_business_age",
								"avg_owner_age",
