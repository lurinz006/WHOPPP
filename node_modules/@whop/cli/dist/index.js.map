			"EconomicIntelligence": {
				"properties": {
					"account_id": {
						"description": "ID of the account this recommendation is for, prefixed `biz_`, or null for personal onboarding.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"acknowledged_at": {
						"description": "When the executed run was first marked as seen, as an ISO 8601 timestamp, or `null` if it has not been.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"action_type": {
						"description": "Type of action recommended, or `null` when no type is assigned. New values may be added; handle unknown types gracefully.",
						"example": "cut_losing_ad_spend",
						"type": ["string", "null"]
					},
					"ai_chat_id": {
						"description": "The chat that ran the recommendation, shown only to the user who ran it, or `null` otherwise.",
						"example": "aich_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"created_at": {
						"description": "When the recommendation was created, as an ISO 8601 timestamp, or null for an unsaved recommendation.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"executed_at": {
						"description": "When the recommendation was carried out, as an ISO 8601 timestamp, or `null` if it has not been.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"expected_tool_calls": {
						"items": {
							"$ref": "#/components/schemas/EconomicIntelligenceOperation",
							"description": "Expected API operations or tools, in execution order, or null when no execution plan was recorded."
						},
						"type": ["array", "null"]
					},
					"id": {
						"description": "Recommendation ID, prefixed `reca_`, or `create_business` for an unsaved setup recommendation. Authenticate and list again before executing an unsaved recommendation.",
						"example": "reca_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"input": {
						"description": "What you requested, in your own words, or `null` for recommendations generated without your input.",
						"example": "more sales from ads",
						"type": ["string", "null"]
					},
					"inputs": {
						"items": {
							"$ref": "#/components/schemas/EconomicIntelligenceInput",
							"description": "Decisions this recommendation leaves to you. Pick one option for each before it runs, or write your own for a `whop_ai` recommendation; empty when there is nothing to decide."
						},
						"type": "array"
					},
					"prompt": {
						"description": "Step-by-step instructions for Whop AI, or `null` when no instructions are available.",
						"example": "Create a 20% off promo code for my members.",
						"type": ["string", "null"]
					},
					"reasoning": {
						"description": "Evidence and metrics supporting the recommendation, or `null` when no reasoning was provided.",
						"example": "Capped 9 of 14 days.",
						"type": ["string", "null"]
					},
					"result_url": {
						"description": "Where to view what the run produced, such as the published website or created product, or `null` when the result is only in the chat.",
						"example": "https://atlas.whop.site/",
						"type": ["string", "null"]
					},
					"run_by_user_id": {
						"description": "The user who started the run, prefixed `user_`, or `null` if it has not run or was started without a user, such as with an API key.",
						"example": "user_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"run_ended_at": {
						"description": "When the run ended, whether executed or incomplete, as an ISO 8601 timestamp, or `null` if it has not ended.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"run_started_at": {
						"description": "When the run started, by Whop AI or the recommendation's API calls, as an ISO 8601 timestamp, or `null` if it has not run.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"sentiment": {
						"description": "How the user rated this recommendation, or `null` if they have not rated it",
						"enum": ["positive", "negative", null],
						"example": "negative",
						"type": ["string", "null"]
					},
					"status": {
						"description": "`queued` when awaiting generation; `pending` while generating; `ready` when available to run; `running` while Whop AI or the recommendation's API calls carry it out; `executed` when carried out; `incomplete` when the run ended without carrying it out; `superseded` when rejected or replaced.",
						"enum": [
							"queued",
							"pending",
							"ready",
							"running",
							"executed",
							"incomplete",
							"superseded"
						],
						"example": "executed",
						"type": "string"
					},
					"superseded_at": {
						"description": "When the recommendation was rejected or replaced, as an ISO 8601 timestamp, or `null` if neither has occurred.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					},
					"target_url": {
						"description": "Website URL selected for pixel setup, or `null` when no website was captured for this recommendation.",
						"example": "https://example.com/join",
						"type": ["string", "null"]
					},
					"title": {
						"description": "Recommended action and its expected benefit, or `null` until generated.",
						"example": "Move $180 from 3 dead ad groups into BATCH#3, +1.7x return",
						"type": ["string", "null"]
					},
					"user_feedback": {
						"description": "The user's written feedback, or `null` if they have not provided any.",
						"example": "They already do this",
						"type": ["string", "null"]
					}
				},
				"required": [
					"id",
					"account_id",
					"action_type",
					"title",
					"prompt",
					"reasoning",
					"expected_tool_calls",
					"inputs",
					"input",
					"status",
					"executed_at",
					"superseded_at",
					"run_started_at",
					"run_ended_at",
					"run_by_user_id",
					"result_url",
					"ai_chat_id",
					"created_at",
					"sentiment",
					"user_feedback",
					"acknowledged_at"
				],
				"type": "object"
			},
			"EconomicIntelligenceInput": {
				"properties": {
					"answer": {
						"description": "What the run used: one of the options, or your own text for a `whop_ai` recommendation. `null` until a run starts.",
						"example": null,
						"type": ["string", "null"]
					},
					"id": {
						"description": "Identifies the input when you answer it.",
						"example": "audience",
						"type": "string"
					},
					"label": {
						"description": "What you are choosing, such as the daily ad budget.",
						"example": "Guide audience",
						"type": "string"
					},
					"options": {
						"items": {
							"description": "Three suggested values, strongest first. You can answer with one of them, or with your own text for a `whop_ai` recommendation.",
							"example": "Daily drivers",
							"type": "string"
						},
						"type": "array"
					},
					"template": {
						"description": "A plan sentence with one {answer} blank to fill with the selected answer.",
						"example": "Guide audience: {answer}",
						"type": "string"
					}
				},
				"required": ["id", "label", "template", "options", "answer"],
				"type": "object"
			},
			"EconomicIntelligenceOperation": {
				"properties": {
					"description": {
						"description": "Concise description of the operation and affected resource, or null for older recommendations.",
						"example": "Increase the summer campaign budget",
						"type": ["string", "null"]
					},
					"tool_name": {
						"description": "API operation or assistant tool name.",
						"example": "updateAdCampaign",
						"type": "string"
					}
				},
				"required": ["tool_name", "description"],
				"type": "object"
			},
			"EmailAddress": {
				"properties": {
					"account_id": {
						"description": "ID of the account the address belongs to, prefixed `biz_`.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"address": {
						"description": "The full address in lowercase, such as support@example.com.",
						"example": "marcus@shinetime.example",
						"type": "string"
					},
					"created_at": {
						"description": "When the address was created, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"domain_id": {
						"description": "ID of the domain the address is on, prefixed `dom_`.",
						"example": "whopappdomain0000001",
						"type": "string"
					},
					"id": {
						"description": "Email address ID, prefixed `emaddr_`.",
						"example": "emaddr_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"password": {
						"description": "The password mail apps sign in to the mailbox with over IMAP and SMTP, using the address as the username. `null` unless you can use the mailbox: you own it, or nobody owns it and you have `email:read` and `email:send`.",
						"example": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"updated_at": {
						"description": "When the address was last updated, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"user_id": {
						"description": "ID of the team member who owns the mailbox, prefixed `user_`. Only they can read it or send from it. `null` when the whole account shares it.",
						"example": "user_xxxxxxxxxxxxxx",
						"type": ["string", "null"]
					}
				},
				"required": [
					"id",
					"address",
					"account_id",
					"domain_id",
					"user_id",
					"password",
					"created_at",
					"updated_at"
				],
				"type": "object"
			},
			"ExperienceNotificationPreference": {
				"properties": {
					"level": {
						"description": "What the user is notified about in the experience: `all` notifications, only `mentions`, or `nothing`.",
						"enum": ["all", "mentions", "nothing"],
						"example": "all",
						"type": "string"
					},
					"object": {
						"description": "The type of object. Always `experience_notification_preference`.",
						"enum": ["experience_notification_preference"],
						"example": "experience_notification_preference",
						"type": "string"
					},
					"scope": {
						"$ref": "#/components/schemas/NotificationPreferenceScope",
						"description": "What the preference applies to. Echo it back to `PATCH /users/me/preferences/notifications` to change this preference."
					}
				},
				"required": ["object", "scope", "level"],
				"type": "object"
			},
			"Experiment": {
				"properties": {
					"account_id": {
						"description": "Owning account ID.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"assignment_seed": {
						"description": "Assignment hashes UTF-8 seed + subject ID with CRC32 modulo 100 and selects the stored end-exclusive range.",
						"example": "checkout_redesign_v21768435200",
						"type": "string"
					},
					"bucket_by": {
						"description": "Randomization unit — `user` buckets each user independently, `account` buckets whole accounts (every user of an account gets the same arm). `null` for feature flags.",
						"enum": ["user", "account", "anonymous"],
						"example": "user",
						"nullable": true,
						"type": "string"
					},
					"configuration_revision": {
						"description": "Revision of the serving configuration. Increments on every configuration change, so a cached definition with a lower revision is stale. Does not change the assignment seed.",
						"example": 1,
						"type": "integer"
					},
					"control": {
						"properties": {
							"related_resource": {
								"$ref": "#/components/schemas/ExperimentResourceReference",
								"nullable": true
							}
						},
						"type": "object"
					},
					"created_at": {
						"description": "When the experiment was created, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"nullable": true,
						"type": "string"
					},
					"created_by": {
						"description": "ID of the user who created the experiment, prefixed `user_`. `null` for experiments created before creators were recorded.",
						"example": "user_xxxxxxxxxxxxxx",
						"nullable": true,
						"type": "string"
					},
					"ended_at": {
						"description": "When the experiment stopped collecting data, as an ISO 8601 timestamp. `null` while still running.",
						"example": "2026-01-01T12:00:00.000Z",
						"nullable": true,
						"type": "string"
					},
					"feature_flag_only": {
						"description": "`true` when this was created as a feature flag rather than a full experiment. Feature flags share the same evaluation API but do not collect metric results.",
						"example": false,
						"nullable": true,
						"type": "boolean"
					},
					"findings": {
						"description": "What was learned and why this outcome, recorded when the experiment was ended. `null` until then.",
						"example": "Treatment lifted conversion 8%",
						"nullable": true,
						"type": "string"
					},
					"flag_key": {
						"description": "Developer-chosen handle referenced from code. Anywhere the API takes an experiment identifier, the `expt_` id and the flag_key are interchangeable.",
						"example": "checkout_redesign_v2",
						"type": "string"
					},
					"hypothesis": {
						"description": "Hypothesis for this experiment. `null` when none is set, and always `null` for feature flags.",
						"example": "Users will convert more",
						"nullable": true,
						"type": "string"
					},
					"id": {
						"description": "Unique identifier for the experiment, prefixed `expt_`.",
						"example": "expt_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"name": {
						"description": "Human-readable display name.",
						"example": "Checkout Redesign V2",
						"type": "string"
					},
					"related_resource": {
						"$ref": "#/components/schemas/ExperimentResourceReference",
						"description": "Resource owned by the account that this experiment is bound to, such as an app or product. `null` when unbound. Fixed once the experiment first activates.",
						"nullable": true
					},
					"started_at": {
						"description": "When the experiment began collecting data, as an ISO 8601 timestamp. `null` for drafts.",
						"example": "2026-01-01T12:00:00.000Z",
						"nullable": true,
						"type": "string"
					},
					"status": {
						"description": "Lifecycle state. `draft` — not yet live; `active` — currently running; `paused` — traffic paused; `ended` — concluded.",
						"enum": ["draft", "active", "paused", "ended"],
						"example": "draft",
						"type": "string"
					},
					"targeting_rules": {
						"description": "Rules gating who is in the experiment at all. Conditions within a rule are AND-ed, rules are OR-ed, and `exclude` rules always win. Empty means everyone qualifies.",
						"items": {
							"properties": {
								"conditions": {
									"description": "Conditions within this rule, all of which must match.",
									"items": {
										"properties": {
											"field": {
												"description": "Property name to read from the user context. Present when `type` is `property`.",
												"nullable": true,
												"type": "string"
											},
											"operator": {
												"description": "Comparison to apply.",
												"enum": [
													"any",
													"none",
													"eq",
													"neq",
													"gt",
													"gte",
													"lt",
													"lte"
												],
												"example": "any",
												"type": "string"
											},
											"type": {
												"description": "What the condition matches on: the user ID, the account ID, or a named user property.",
												"enum": ["user_id", "account_id", "property"],
												"example": "user_id",
												"type": "string"
											},
											"value": {
												"description": "Value or list of values to match against."
											}
										},
										"required": ["type", "operator", "value"],
										"type": "object"
									},
									"type": "array"
								},
								"type": {
									"description": "`include` — users matching this rule qualify; `exclude` — users matching this rule are always excluded, overriding any include rule.",
									"enum": ["include", "exclude"],
									"example": "include",
									"type": "string"
								}
							},
							"required": ["conditions"],
							"type": "object"
						},
						"type": "array"
					},
					"updated_at": {
						"example": "2026-01-01T12:00:00.000Z",
						"format": "date_time",
						"nullable": true,
						"type": "string"
					},
					"variants": {
						"description": "Treatment arms. Users outside every arm's allocation form the implicit `control` group. Weights only ever grow and arms are never removed, so a user moves from control into a treatment at most once.",
						"items": {
							"properties": {
								"name": {
									"description": "Treatment identifier. `control` is reserved — it is the implicit remainder.",
									"example": "treatment",
									"type": "string"
								},
								"ranges": {
									"description": "Granted bucket ranges (1% units, end-exclusive) recording this arm's allocation history. Server-managed; ranges are only ever appended, which is what keeps assignments permanent.",
									"items": {
										"example": [0, 50],
										"items": {
											"type": "integer"
										},
										"maxItems": 2,
										"minItems": 2,
										"type": "array"
									},
									"type": "array"
								},
								"related_resource": {
									"$ref": "#/components/schemas/ExperimentResourceReference",
									"nullable": true
								},
								"weight": {
									"description": "Percentage of all users assigned to this treatment, 1–100. All weights together sum to at most 100; the remainder is control.",
									"example": 50,
									"type": "integer"
								}
							},
							"required": ["name", "weight"],
							"type": "object"
						},
						"type": "array"
					},
					"winning_arm": {
						"description": "The treatment that won, set when the experiment was ended. Once set, every evaluation returns this arm to every caller regardless of targeting or allocation, and no further exposures are recorded. `null` means control won — an ended experiment with no winning arm evaluates to `control` for everyone. Always `null` for feature flags, which simply evaluate to disabled once ended.",
						"example": "treatment",
						"nullable": true,
						"type": "string"
					}
				},
				"required": [
					"id",
					"account_id",
					"related_resource",
					"control",
					"configuration_revision",
					"assignment_seed",
					"updated_at",
					"flag_key",
					"name",
					"status",
					"variants",
					"targeting_rules"
				],
				"type": "object"
			},
			"ExperimentExposure": {
				"properties": {
					"configuration_revision": {
						"type": "integer"
					},
					"enabled": {
						"description": "Whether the subject receives a treatment or enabled feature flag.",
						"example": true,
						"type": "boolean"
					},
					"experiment_id": {
						"description": "Unique experiment ID, included for account experiments.",
						"type": "string"
					},
					"flag_key": {
						"description": "Present when evaluating a single experiment.",
						"example": "checkout_redesign",
						"type": "string"
					},
					"related_resource": {
						"$ref": "#/components/schemas/ExperimentResourceReference",
						"nullable": true
					},
					"variant": {
						"description": "Treatment name, control, or null for an inactive flag or excluded subject.",
						"example": "treatment",
						"nullable": true,
						"type": "string"
					}
				},
				"required": ["enabled", "variant"],
				"type": "object"
			},
			"ExperimentExposureBatch": {
				"properties": {
					"exposures": {
						"additionalProperties": {
							"$ref": "#/components/schemas/ExperimentExposure"
						},
						"type": "object"
					}
				},
				"required": ["exposures"],
				"type": "object"
			},
			"ExperimentResourceReference": {
				"properties": {
					"id": {
						"description": "Referenced resource tag, belonging to the experiment owner.",
						"type": "string"
					},
					"object": {
						"enum": ["app", "app_build", "product", "plan"],
						"example": "app",
						"type": "string"
					}
				},
				"required": ["object", "id"],
				"type": "object"
			},
			"Export": {
				"properties": {
					"created_at": {
						"description": "When the export was requested, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"download_url": {
						"description": "A short-lived link to download the finished file. `null` until `status` is `completed`, and again once the export has expired.",
						"example": "https://whop-assets-example.s3.amazonaws.com/uploads/image/2026-01-01/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
						"type": ["string", "null"]
					},
					"expires_at": {
						"description": "When the file is deleted and the export moves to `expired`, as an ISO 8601 timestamp. Exports are retained for 30 days.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"id": {
						"description": "Export ID, prefixed `exprt_`.",
						"example": "exprt_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"progress_percent": {
						"description": "Estimated completion percentage from 0 to 100.",
						"example": 0,
						"type": ["integer", "null"]
					},
					"resource": {
						"description": "The resource that was exported, e.g. `receipts`, `members`, or `payouts`.",
						"enum": [
							"ad_campaigns",
							"ad_groups",
							"ads",
							"apps",
							"audiences",
							"bounties",
							"bounty_submissions",
							"card_transactions",
							"checkout_configurations",
							"disputes",
							"events",
							"external_accounts",
							"financial-activity",
							"payout_methods",
							"payouts",
							"people",
							"plans",
							"products",
							"resolution_center_cases",
							"shipments",
							"social_accounts",
							"team_members",
							"transfers",
							"webhooks",
							"members",
							"receipts",
							"unclaimed_memberships",
							"memberships",
							"tracking_links",
							"promo_codes",
							"resolutions",
							"entries",
							"leads",
							"invoices",
							"cancelation_reasons",
							"child_companies",
							"ledger_lines",
							"withdrawal_lines"
						],
						"example": "members",
						"type": "string"
					},
					"status": {
						"description": "`pending` or `processing` while the file is generated, `completed` when the download is ready, `failed` if it errored, `expired` once the file has been deleted.",
						"enum": ["pending", "processing", "completed", "failed", "expired"],
						"example": "completed",
						"type": "string"
					},
					"updated_at": {
						"description": "When the export last changed, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					}
				},
				"required": [
					"id",
					"resource",
					"status",
					"progress_percent",
					"download_url",
					"expires_at",
					"created_at",
					"updated_at"
				],
				"type": "object"
			},
			"ExternalAccount": {
				"properties": {
					"error": {
						"description": "Why this external account currently can't be used for advertising — a failed share or a Meta-side restriction. Null when the account is healthy.",
						"example": "You don't have permission to share this account. Ask an admin of its Meta Business Portfolio to grant you full control, then share it again.",
						"type": ["string", "null"]
					},
					"external_id": {
						"description": "The platform-specific ID for this external account.",
						"example": "1234567891",
						"type": ["string", "null"]
					},
					"id": {
						"description": "Unique identifier for the external account.",
						"example": "sacc_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"name": {
						"description": "The display name of the external account on the platform.",
						"example": "Shine Time Auto Detailing",
						"type": ["string", "null"]
					},
					"parent_external_account": {
						"description": "The external account this one belongs to on the platform, such as the Facebook page that owns an Instagram account. Null when the external account stands on its own, or when it is a partner.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/ExternalAccountParent"
							},
							{
								"type": "null"
							}
						]
					},
					"partnership_status": {
						"description": "Where a partner creator's permission to run partnership ads stands. `pending` until the creator approves it in the Instagram app, `approved` once they have, and `revoked` once it no longer holds. Null when the external account isn't a partner.",
						"enum": [null, "pending", "approved", "revoked"],
						"example": "pending",
						"type": ["string", "null"]
					},
					"platform": {
