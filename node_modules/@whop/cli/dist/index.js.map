											"postal_code": {
												"description": "Postal or ZIP code.",
												"type": ["string", "null"]
											},
											"state": {
												"description": "State, province, or region code, such as `CA`.",
												"type": ["string", "null"]
											}
										},
										"type": ["object", "null"]
									},
									"tax_ids": {
										"description": "The buyer's tax registration, for a business purchase. One entry. Prices the purchase as business-to-business where that applies (EU reverse charge, for one) and requires an `address` to belong to.",
										"items": {
											"properties": {
