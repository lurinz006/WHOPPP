			"post": {
				"description": "Adds a domain to your account with the capabilities you want.\n\nPass `registration` to buy the domain through Whop; it's the default when you pass no capability. Pay its `amount_due` at `purchase_url`, or pass `registration.payment_method_id` to charge a saved card. Whop then registers it, runs its DNS, and renews it every year while `auto_renew` is on.\n\nPass `registration.auth_code` to transfer in a domain you own at another registrar. The transfer starts once its `amount_due` is paid, or at once when `amount_due` is `null`. While `registration.phase` is `transferring`, its `issues` say what the transfer needs from you.\n\nPass `verification` to connect a domain you registered elsewhere: its `issues` list the TXT and routing records to publish. Pass `website` with an `app_id` to serve that app on the domain.\n\nTo change a domain you already have, update it instead. Adding a domain this account deleted revives it under its original ID.",
				"operationId": "create",
				"parameters": [
					{
						"$ref": "#/components/parameters/ApiVersionDate"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"account_id": {
										"description": "Account ID, prefixed biz_. Required for user credentials; otherwise defaults to the credential's account.",
										"type": "string"
									},
									"apple_pay": {
										"description": "Accept Apple Pay at checkout on the domain. It needs no other capability. Whop registers the domain with Apple: it stays `pending` until Apple answers, then turns `ready`, or `action_required` when Apple couldn't fetch the domain association file. Serve the file, then check the domain to register it again. Pass `null` to turn Apple Pay off: Whop removes the domain from Apple, and the domain stays, like releasing any other capability.",
										"properties": {},
										"type": ["object", "null"]
									},
									"domain": {
										"description": "Bare hostname, such as example.com or checkout.example.com. A bought domain must be a root domain. Wildcards, paths, schemes, and ports are not accepted.",
										"example": "store.example.com",
										"type": "string"
									},
									"email": {
										"description": "Send and receive email on the domain. Only a domain bought through Whop, or a subdomain of one in the same account, can have it. Whop publishes the DNS records and stays `pending` until its email provider verifies them, then turns `ready`. Pass `null` to remove email.",
										"properties": {},
										"type": ["object", "null"]
									},
									"metadata": {
										"additionalProperties": {
											"type": "string"
										},
										"description": "Custom string keys and values.",
										"example": {
											"project": "website"
										},
										"type": "object"
									},
									"pixel": {
										"description": "Track page views on the domain with the Whop pixel. It needs no other capability: it stays `pending` until the pixel records a page view, and turns `action_required` if it goes 7 days without one. Pass `null` to stop tracking.",
										"properties": {},
										"type": ["object", "null"]
									},
									"registration": {
										"description": "Buy the domain through Whop, or transfer in a domain you own elsewhere with `auth_code`, then renew it every year and let Whop run its DNS. Pass `null` to release an unpaid or failed purchase, or to cancel a transfer while its current registrar can still stop it.",
										"properties": {
											"auth_code": {
												"description": "Transfer the domain to Whop instead of buying it. This is the transfer authorization code (also called an EPP code) from the domain's current registrar, which you usually find in its domain settings after unlocking the domain. Whop becomes the domain's registrant, and the domain moves to Whop DNS once the transfer completes, so its current DNS records, including email, stop working. After the transfer, the registry may lock the domain against another transfer for 60 days. While it's `transferring`, pass the same or a new code again to resubmit. Whop never returns the code. To take a domain from another Whop account instead, pass the `whop_dt_` code from its `transfer`: the domain moves without a payment, keeps its expiry and Whop DNS, and can't be cancelled once entered.",
												"example": "Tr4nsfer-Code",
												"type": "string",
												"writeOnly": true
											},
											"auto_renew": {
												"default": true,
												"description": "Whether Whop charges the saved card to renew the domain before it expires.",
												"type": "boolean"
											},
											"payment_method_id": {
												"description": "Saved card to charge, prefixed `payt_`. It must belong to the signed-in user. Pass `null` to remove it.",
												"type": ["string", "null"]
											}
										},
										"type": ["object", "null"]
									},
									"transfer": {
										"description": "Move a domain registered through Whop to another Whop account. Turning it on returns a code in `transfer.code`; the receiving account enters it as `registration.auth_code` on its own copy of the domain. Whop then removes the domain's email, email addresses and Apple Pay from this account, moves the registration with its expiry, stops charging this account to renew it, and removes the domain from this account. Pass `null` to turn it off and invalidate the code, until another account has entered it.",
										"properties": {
											"destination": {
												"default": "internal",
												"description": "Where the domain moves. `internal` moves it to another Whop account.",
												"enum": ["internal"],
												"example": "internal",
												"type": "string"
											}
										},
										"type": ["object", "null"]
									},
									"verification": {
										"description": "Prove you control the domain's DNS: Whop returns a TXT record to publish in `issues`, and whoever publishes it owns the domain on Whop. Pass `null` to release it. Can't be combined with `registration`.",
										"properties": {},
										"type": ["object", "null"]
									},
									"website": {
										"description": "Serve a Whop website on the domain. Pass `null` to stop serving it; the domain keeps its other capabilities.",
										"properties": {
											"app_id": {
												"description": "App ID, prefixed app_, of the website to serve. The app must belong to the account. Leave it out to point the domain at Whop before the website exists; it shows a placeholder until you choose one. Pass `null` to detach the app and keep the domain pointed at Whop.",
												"example": "app_xxxxxxxxxxxxxx",
												"type": ["string", "null"]
											}
										},
										"type": ["object", "null"]
									}
								},
								"required": ["domain"],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Domain"
								}
							}
						},
						"description": "Domain created"
					},
					"400": {
						"$ref": "#/components/responses/InvalidParameters",
						"description": "The domain can't be bought"
					},
					"409": {
						"$ref": "#/components/responses/Conflict",
						"description": "The account already has this domain"
					}
				},
				"security": [
					{
						"accountUserTokenOrOauthTokenAuth": ["domain:manage"]
					}
				],
				"summary": "Create Domain",
				"tags": ["Domains"],
				"x-whop-credentials": ["account_user_token", "oauth_token"],
				"x-mint": {
					"metadata": {
						"sidebarTitle": "Create"
					}
				}
			}
		},
		"/domains/{id}": {
