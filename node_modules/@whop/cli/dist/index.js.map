					{
						"description": "Only payments whose shipment is in any of these tracking states, or that still need a tracking number (`needs_tracking`). Repeat the parameter to pass several. Requires `account_id` and the shipment:basic:read permission.",
						"in": "query",
						"name": "tracking_states",
						"required": false,
						"schema": {
							"items": {
								"enum": [
									"unknown",
									"pre_transit",
									"in_transit",
									"out_for_delivery",
									"delivered",
									"available_for_pickup",
									"return_to_sender",
									"failure",
									"cancelled",
									"error",
									"needs_tracking",
									"missing_tracking"
								],
								"example": "needs_tracking",
								"type": "string"
							},
							"type": "array"
						}
					},
					{
						"description": "Only payments refunded after this ISO 8601 timestamp.",
						"in": "query",
						"name": "refunded_after",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Only payments refunded before this ISO 8601 timestamp.",
						"in": "query",
						"name": "refunded_before",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Only payments with a dispute alert after this ISO 8601 timestamp.",
						"in": "query",
						"name": "dispute_alerted_after",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Only payments with a dispute alert before this ISO 8601 timestamp.",
						"in": "query",
						"name": "dispute_alerted_before",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Only payments with a dispute opened after this ISO 8601 timestamp.",
						"in": "query",
						"name": "dispute_created_after",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "Only payments with a dispute opened before this ISO 8601 timestamp.",
						"in": "query",
						"name": "dispute_created_before",
						"required": false,
						"schema": {
							"format": "date-time",
							"type": "string"
						}
					},
					{
						"description": "The field to sort by. `amount` sorts by the amount charged, in the currency it was charged in.",
						"in": "query",
						"name": "order",
						"required": false,
						"schema": {
							"enum": ["created_at", "paid_at", "amount"],
							"type": "string"
						}
					},
					{
						"description": "The sort direction.",
						"in": "query",
						"name": "direction",
						"required": false,
						"schema": {
							"enum": ["asc", "desc"],
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the start of the range.",
						"in": "query",
						"name": "first",
						"required": false,
						"schema": {
							"default": 20,
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results after this cursor. Use `page_info.end_cursor` from the previous response to fetch the next page.",
						"in": "query",
						"name": "after",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Number of results to return from the end of the range.",
						"in": "query",
						"name": "last",
						"required": false,
						"schema": {
							"maximum": 100,
							"type": "integer"
						}
					},
					{
						"description": "Return results before this cursor. Use `page_info.start_cursor` from the previous response to fetch the previous page.",
						"in": "query",
						"name": "before",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
