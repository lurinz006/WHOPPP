						"items": {
							"$ref": "#/components/schemas/FinancingProviderCurrency",
							"description": "The currencies checkout charges this provider in for this account, each with its maximum payment."
						},
						"type": "array"
					},
					"details": {
						"description": "The dispute rates behind a `dispute_rate_near_limit` or `dispute_rate_exceeded` reason; `null` for every other reason.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/FinancingProviderDetails"
							},
							{
								"type": "null"
							}
						]
					},
					"provider": {
						"description": "The financing provider.",
						"enum": [
							"afterpay_clearpay",
							"zip",
							"sezzle",
							"tabby",
							"tamara",
							"kueski",
							"addi",
							"klarna",
							"oney",
							"splitit",
							"claritypay",
							"flex_pay"
						],
						"example": "zip",
						"type": "string"
					},
					"provider_reviewed_at": {
						"description": "When the provider received or decided on this account, as an ISO 8601 timestamp. Set only for providers that review merchants themselves (Splitit); `null` otherwise.",
						"example": null,
						"type": ["string", "null"]
					},
					"reason": {
						"description": "Why the provider has this status, when known. On `active` it is `dispute_rate_near_limit` when the provider is close to being turned off. On `inactive` it names what keeps it off, including `not_included` when the account's approval doesn't cover it, `turned_off` when it was switched off after setup, `setup_failed`, and `declined` when the provider turned the account down without a reason Whop recognizes. More reasons may be added.",
						"enum": [
							"account_not_supported",
							"payin_account_required",
							"payment_account_required",
							"processor_connection_required",
							"minimum_volume_not_met",
							"turned_off_in_checkout_settings",
							"provider_review",
							"dispute_rate_near_limit",
							"dispute_rate_exceeded",
							"whop_risk_control",
							"not_included",
							"turned_off",
							"declined",
							"setup_failed",
							"payout_account_country_unsupported",
							"seller_country_unsupported",
							"approved_dispute_rate_too_high",
							"restricted_industry",
							"income_claims",
							"missing_store_details",
							"duplicate_account",
							"invalid_website",
							"unspecified",
							null
						],
						"example": "payin_account_required",
						"type": ["string", "null"]
					},
					"status": {
						"description": "Where the provider stands for this account: `eligible` (included if the account applies), `needs_action` (waiting on the merchant, see `action`), `in_review` (waiting on Whop's review, or on the provider's own when `reason` is `provider_review`), `active` (offered at checkout), or `inactive` (not offered, see `reason`).",
						"enum": [
							"eligible",
							"needs_action",
							"in_review",
							"active",
							"inactive"
						],
						"example": "inactive",
						"type": "string"
					}
				},
				"required": [
					"provider",
					"status",
					"currencies",
					"reason",
					"action",
					"details",
