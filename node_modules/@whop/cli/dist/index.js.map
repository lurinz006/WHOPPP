			"AdConversionValueRule": {
				"properties": {
					"account_id": {
						"description": "Business that owns this shared, editable rule.",
						"example": "biz_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"adjustment_type": {
						"description": "Set a fixed amount or change the original value by a signed percentage.",
						"enum": ["fixed", "percentage"],
						"example": "fixed",
						"type": "string"
					},
					"created_at": {
						"description": "When the rule was created, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					},
					"events": {
						"items": {
							"$ref": "#/components/schemas/AdConversionValueRuleEvent",
							"description": "Events adjusted on every selected target."
						},
						"type": "array"
					},
					"fixed_value": {
						"description": "Amount sent for a fixed rule. Null for a percentage rule.",
						"oneOf": [
							{
								"$ref": "#/components/schemas/Money"
							},
							{
								"type": "null"
							}
						]
					},
					"id": {
						"description": "Conversion value rule ID, prefixed adcvr_.",
						"example": "adcvr_xxxxxxxxxxxxxx",
						"type": "string"
					},
					"metadata": {
						"description": "Free-form string keys and values for the caller.",
						"example": {},
						"type": "object"
					},
					"percentage_change": {
						"description": "Signed percent change: 20 increases by 20%, negative 20 decreases by 20%. The sent value cannot go below zero. Null for a fixed rule.",
						"example": null,
						"type": ["number", "null"]
					},
					"status": {
						"description": "Whether this rule is active or paused.",
						"enum": ["active", "paused"],
						"example": "active",
						"type": "string"
					},
					"targets": {
						"items": {
							"$ref": "#/components/schemas/AdConversionValueRuleTarget",
							"description": "Targets covered by this rule. Every selected event applies to every target."
						},
						"type": "array"
					},
					"updated_at": {
						"description": "When the rule was edited, as an ISO 8601 timestamp.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": "string"
					}
				},
				"required": [
					"id",
					"account_id",
					"status",
					"targets",
					"events",
					"adjustment_type",
					"fixed_value",
					"percentage_change",
					"metadata",
					"created_at",
					"updated_at"
				],
				"type": "object"
			},
