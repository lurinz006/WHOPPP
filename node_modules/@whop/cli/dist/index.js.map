											"example": "Marcus",
											"type": ["string", "null"]
										},
										"id": {
											"description": "Verification profile ID, prefixed `idpf_`.",
											"example": "idpf_xxxxxxxxxxxx",
											"type": "string"
										},
										"kind": {
											"enum": ["individual", "business"],
											"example": "individual",
											"type": "string"
										},
										"last_name": {
											"example": "Webb",
											"type": ["string", "null"]
										},
										"owners": {
											"description": "Owners of the business and the progress of each one's own verification. Empty for individual verifications.",
											"items": {
												"properties": {
													"first_name": {
														"example": "Riley",
														"type": ["string", "null"]
													},
													"id": {
														"description": "Owner ID, prefixed `own_`. Send it in Update Verification's `owners` to change or remove the owner, including one added in the hosted session.",
														"example": "own_xxxxxxxxxxxxxx",
														"type": "string"
													},
													"last_name": {
														"example": "Owner",
														"type": ["string", "null"]
													},
