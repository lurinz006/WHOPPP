		"/email_addresses/{id}/mobileconfig": {
			"get": {
				"description": "Downloads an Apple configuration profile that adds the mailbox to Mail on a Mac, iPhone or iPad, signed in and ready to send. Only the owner can download it for an owned mailbox; a shared one needs `email:read` and `email:send`.",
				"operationId": "mobileconfig",
				"responses": {
					"200": {
						"content": {
							"application/x-apple-aspen-config": {
								"schema": {
