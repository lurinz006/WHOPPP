							"in_transit",
							"out_for_delivery",
							"delivered",
							"available_for_pickup",
							"return_to_sender",
							"failure",
							"cancelled",
							"error"
						],
						"example": "in_transit",
						"type": "string"
					},
					"timestamp": {
						"description": "When the carrier recorded the scan, as an ISO 8601 timestamp. Null when the carrier sent no scan time.",
						"example": "2026-01-01T12:00:00.000Z",
						"type": ["string", "null"]
					}
				},
				"required": ["status", "message", "location", "timestamp"],
				"type": "object"
			},
